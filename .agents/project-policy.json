{
  "$schema": "skills/skill-manager/assets/schemas/project-policy.schema.json",
  "commands": {
    "component_latency_ms": {
      "startup-context": 1500
    },
    "latency_ms": {
      "changed-context": 3000,
      "changed-evidence": 3000,
      "check-changed": 75000,
      "command-budget-check": 180000,
      "context-use-check": 40000,
      "finish": 180000,
      "next-action": 25000,
      "review-autopilot": 180000,
      "review-loop": 180000,
      "review-next": 12000,
      "smoke-workflows": 45000,
      "startup-context": 2500,
      "status-fast": 4000,
      "status-full": 15000
    },
    "output_tokens": {
      "changed-context": 1600,
      "changed-evidence": 1400,
      "check-changed": 2400,
      "command-budget-check": 2200,
      "context-use-check": 1200,
      "finish": 1800,
      "next-action": 1400,
      "review-autopilot": 1400,
      "review-loop": 1400,
      "review-next": 900,
      "smoke-workflows": 1800,
      "startup-context": 1600,
      "status-fast": 2000,
      "status-full": 3500
    }
  },
  "cost_policy": {
    "budgets": {
      "phases": {
        "default_tokens": 6000,
        "overrides": {
          "evidence": 12000,
          "handoff": 2500,
          "implementation": 8000,
          "planning": 6000,
          "routing": 1500,
          "test-authoring": 6000,
          "validation": 3000
        }
      }
    },
    "context": {
      "always_loaded": {
        "budget_tokens": 3500,
        "files": [
          "AGENTS.md",
          ".agents/routing.md",
          "automations/routing.md"
        ]
      },
      "beginner": {
        "budget_tokens": 5000,
        "files": [
          "README.md",
          "docs/start-here.md"
        ]
      }
    },
    "delegation": {
      "gates": {
        "delegation-balanced-v1": {
          "maximum_median_provider_token_increase_percent": 25,
          "maximum_seconds_per_trial": 600,
          "maximum_tokens_per_trial": 80000,
          "minimum_median_wall_time_improvement_percent": 20,
          "minimum_trials_per_arm": 3
        }
      }
    },
    "guidance": {
      "baseline": {
        "files": [
          "AGENTS.md",
          ".agents/routing.md",
          "automations/routing.md",
          "README.md",
          "docs/start-here.md",
          "automations/navigation/artifacts/maps/HANDOFF.md",
          "automations/navigation/artifacts/maps/NAVIGATION.md",
          "automations/navigation/artifacts/maps/TECHNICAL_CONTEXT.md",
          "automations/navigation/artifacts/maps/CONVENTIONS.md"
        ]
      },
      "default": {
        "budget_tokens": 5000,
        "files": [
          "AGENTS.md",
          ".agents/routing.md",
          "automations/routing.md",
          "automations/navigation/artifacts/maps/HANDOFF.md"
        ]
      },
      "minimum_saved_percent": 25,
      "startup": {
        "max_added_percent": 10,
        "max_added_tokens": 250
      }
    },
    "local_ai": {
      "warm_batch": {
        "min_items": 2,
        "prefer_for_tasks": [
          "changed-files-summary",
          "failure-cluster",
          "test-gap-summary",
          "handoff-draft"
        ]
      }
    },
    "review": {
      "loop": {
        "max_elapsed_ms": 180000,
        "max_estimated_tokens": 8000,
        "max_hunks_per_batch": 12,
        "max_units": 20
      }
    },
    "routing": {
      "default_paid_model_fallback": "explicit-after-local-ai-or-deterministic-summary",
      "tasks": {
        "context-discovery": {
          "authoritative_evidence": "repo files and exact search output",
          "fallback": "direct file reads from cited paths",
          "local_ai_use_cases": [
            "inventory-summary"
          ],
          "max_context_tokens": 4000,
          "paid_model_fallback": "allowed-after-bounded-evidence",
          "prefer": "exact-search-then-read"
        },
        "handoff": {
          "authoritative_evidence": "run report, validation, and skipped checks",
          "fallback": "orchestrator verifies local draft",
          "local_ai_use_cases": [
            "handoff-draft",
            "changed-files-summary"
          ],
          "max_context_tokens": 2500,
          "paid_model_fallback": "disabled-by-default",
          "prefer": "local-ai"
        },
        "implementation": {
          "authoritative_evidence": "source files and tests",
          "fallback": "paid implementation model",
          "local_ai_use_cases": [
            "changed-files-summary"
          ],
          "max_context_tokens": 8000,
          "paid_model_fallback": "allowed-for-code",
          "prefer": "orchestrator"
        },
        "planning": {
          "authoritative_evidence": "plan, project context, and deterministic checks",
          "fallback": "paid planning model after local evidence packet",
          "local_ai_use_cases": [
            "inventory-summary",
            "test-gap-summary"
          ],
          "max_context_tokens": 6000,
          "paid_model_fallback": "allowed-for-decisions",
          "prefer": "orchestrator-with-local-evidence"
        },
        "review": {
          "authoritative_evidence": "git diff, changed files, and deterministic reports",
          "fallback": "paid review model after diff summary",
          "local_ai_use_cases": [
            "changed-files-summary",
            "duplicate-overlap-detection"
          ],
          "max_context_tokens": 5000,
          "paid_model_fallback": "allowed-after-delta-summary",
          "prefer": "delta-only"
        },
        "routing": {
          "authoritative_evidence": "routing files and deterministic route scores",
          "fallback": "deterministic-routing",
          "local_ai_use_cases": [
            "skill-routing",
            "workflow-routing"
          ],
          "max_context_tokens": 1500,
          "paid_model_fallback": "disabled-by-default",
          "prefer": "local-ai"
        },
        "test-authoring": {
          "authoritative_evidence": "test files, coverage, and acceptance criteria",
          "fallback": "paid implementation or test-authoring model",
          "local_ai_use_cases": [
            "test-gap-summary"
          ],
          "max_context_tokens": 6000,
          "paid_model_fallback": "allowed-for-tests",
          "prefer": "orchestrator-with-local-gap-summary"
        },
        "validation": {
          "authoritative_evidence": "command exit codes and raw validation output",
          "fallback": "deterministic failed-output packet",
          "local_ai_use_cases": [
            "failure-cluster"
          ],
          "max_context_tokens": 3000,
          "paid_model_fallback": "allowed-after-deterministic-evidence",
          "prefer": "deterministic"
        }
      }
    }
  },
  "limits": {
