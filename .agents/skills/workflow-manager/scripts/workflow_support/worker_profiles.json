  "model_prompt_overlays": {
    "generic-v1": {
      "version": 1,
      "generation": "generic",
      "promotion_state": "portable-default",
      "instructions": [
        "Follow the semantic task profile exactly.",
        "Use only capabilities attested for the current host surface.",
        "Do not change tools, authority, output contract, delegation, or validation requirements."
      ],
      "source_refs": []
    },
    "openai-5.5-v1": {
      "version": 1,
      "generation": "gpt-5.5",
      "promotion_state": "existing-default",
      "instructions": [
        "State the expected outcome, success criteria, allowed side effects, evidence rules, output shape, and stopping rule.",
        "Leave the solution path to the model unless the product requires an exact process; keep tool and delegation expectations explicit.",
        "Do not change tools, authority, output contract, delegation, or validation requirements."
      ],
      "source_refs": [
        "openai-gpt-5-5-guide"
      ]
    },
    "openai-5.6-v1": {
      "version": 1,
      "generation": "gpt-5.6",
      "promotion_state": "experimental",
      "instructions": [
        "Keep the prompt lean and state each instruction once; avoid repeated scaffolding.",
        "Lead with the conclusion and retain required evidence, material caveats, and the next action.",
        "Do not change tools, authority, output contract, delegation, or validation requirements."
      ],
      "source_refs": [
        "openai-gpt-5-6-guide"
      ]
    },
    "anthropic-claude-v1": {
      "version": 1,
      "generation": "claude",
      "promotion_state": "existing-default",
      "instructions": [
        "Describe the outcome, relevant context, constraints, and verifiable success criteria clearly.",
        "Use examples or explicit output structure when they materially reduce ambiguity.",
        "Do not change tools, authority, output contract, delegation, or validation requirements."
      ],
      "source_refs": [
        "anthropic-prompting-guide"
      ]
    }
  },
  "execution_modes": {
    "serial": {
      "authority": "default",
      "lifecycle_owner": "current task",
      "write_policy": "shared workspace writes remain serial",
      "required_evidence": [
        "task or run identifier",
        "observed host and model or explicit unattested fallback"
      ],
      "fallback": "serial"
    },
    "direct-child-agent": {
      "authority": "explicit subagent request or workflow owner declaration",
      "lifecycle_owner": "parent task",
      "write_policy": "read-only unless declared isolation and disjoint write scopes are proven",
      "required_evidence": [
        "parent and direct-child identifiers",
        "observed host surface, model provider, and model",
        "complete direct-child usage tree",
        "isolation and cleanup evidence for writes"
      ],
      "fallback": "serial active-model worker"
    },
    "independent-thread": {
      "authority": "explicit user request for separately visible durable work",
      "lifecycle_owner": "user-owned task",
      "write_policy": "isolated workspace and resources required before concurrent writes",
      "required_evidence": [
        "thread identifier and user authorization",
        "observed host surface, model provider, and model",
        "handoff and validation ownership",
        "aggregate usage across manager and workers"
      ],
      "fallback": "direct child or serial worker in the current task"
    }
  },
  "risk_routing": {
    "status": "benchmark-gated",
    "selection_mode": "declarative-manual",
    "source_refs": [
      "openai-model-catalog",
      "anthropic-model-catalog"
    ],
    "verified_at": "2026-07-19",
    "availability_boundary": "Catalog entries are guidance, not proof that a host selected a model or exposed a transport capability; trusted runtime observation remains required.",
    "selection_basis": [
      "blast radius and reversibility",
      "security data migration and public-contract consequence",
      "scope clarity and bounded acceptance criteria",
      "repeated deterministic failure or conflicting evidence"
    ],
    "routes": [
      {
        "id": "high-consequence",
        "when_any": [
          "security or privacy boundary",
          "data migration or irreversible change",
          "public contract or architecture decision",
          "conflicting evidence after focused validation"
        ],
        "profiles": [
          "planning-high",
          "review-high"
        ]
      },
      {
        "id": "simple-bounded",
        "when_all": [
          "clear reversible write scope with no security privacy migration architecture or public-contract consequence",
          "one owning deterministic verifier is known",
          "one serial implementation pass is sufficient unless failure or new evidence changes scope"
        ],
        "profiles": [
          "implementation-low"
        ]
      },
      {
        "id": "bounded-implementation",
        "when_all": [
          "approved bounded write scope",
          "acceptance criteria and verifier are known"
        ],
        "profiles": [
          "implementation-medium",
          "implementation-mini"
        ]
      },
      {
        "id": "coordination-and-evidence",
        "when_all": [
          "read-only or handoff-only work",
          "no architecture or final validation authority"
        ],
        "profiles": [
          "coordination-low-cost",
          "evidence-mini",
          "handoff-mini"
        ]
      }
    ],
    "rules": [
      "Route by consequence and task shape, not perceived difficulty, host name, or model nickname.",
      "A model overlay cannot alter authority, tools, validation, or surface capabilities.",
      "A surface adapter cannot infer model identity or weaken the semantic contract.",
      "Simple bounded work stays serial, uses one scoped implementation pass and one owning verifier, then stops unless failure or new evidence changes scope.",
      "Independent threads are opt-in user-owned workstreams, not a replacement for requested subagents.",
      "Promotion evidence is scoped to the measured host surface, model provider, task class, and execution mode."
    ],
    "promotion_gate": "Provider-backed repeated trials must show noninferior quality and rework for each promoted host surface and task class."
  },
  "validation_authority": {
    "authoritative": [
      "deterministic command exit codes",
      "test output",
      "build output",
      "lint/static-analysis output",
      "recorded workflow evidence"
    ],
    "advisory": [
      "local-AI validation triage",
      "paid-model validation triage",
      "model-written summaries of validation output"
    ],
    "required_record": "run.json checks and validation evidence must record host surface, model-provider identity or fallback, command results, skipped checks, and unavailable capabilities."
  },
