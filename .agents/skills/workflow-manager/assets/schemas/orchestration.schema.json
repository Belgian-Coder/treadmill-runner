{
  "$id": "https://schemas.skills-harness.invalid/orchestration-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project orchestration routes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_task_set",
    "chains",
    "task_sets",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "default_task_set": {
      "$ref": "#/$defs/id"
    },
    "chains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hosts"
        ],
        "properties": {
          "hosts": {
            "type": "object",
            "required": [
              "default"
            ],
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/candidate"
              }
            }
          }
        }
      }
    },
    "task_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "responsibility",
          "execution"
        ],
        "properties": {
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "deterministic",
              "orchestrator-decides",
              "primary"
            ]
          },
          "chain": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "responsibility",
          "task_set"
        ],
        "properties": {
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "task_set": {
            "$ref": "#/$defs/id"
          },
          "chain": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "enum": [
            "inherit",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
