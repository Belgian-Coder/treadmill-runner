      "expect": {
        "ok": true,
        "title": "x",
        "expandedStepCount": 1,
        "totalDurationSeconds": 60,
        "definition": {
          "schemaVersion": 1,
          "title": "x",
          "description": null,
          "blocks": [
            {
              "kind": "step",
              "goal": {
                "kind": "time",
                "durationTicks": 600000000
              },
              "speed": {
                "kind": "open"
              },
              "incline": {
                "kind": "fixed",
                "percent": 0
              },
              "cue": null,
              "notes": null
            }
          ]
        },
        "warnings": [
          {
            "code": "native.unknown-field",
            "message": "The root field 'future' is not supported and was ignored."
          },
          {
            "code": "native.unknown-field",
            "message": "The step field 'futureStep' is not supported and was ignored."
          },
          {
            "code": "native.open-speed",
            "message": "A native workout step has no speed target and requires review before execution."
          }
        ]
      }
    },
