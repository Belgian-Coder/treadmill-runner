{
  "description": "Native JSON import (P1): source file -> accepted definition + warnings, or rejection message.",
  "vectors": [
    {
      "id": "native-authoring-progression",
      "sourceFile": "imports/native/authoring-progression.json",
      "fileName": "workout.json",
      "notes": "Unit test 'Imports_time_distance_hr_ramp_and_repeat_blocks'. cue wins over name.",
      "expect": {
        "ok": true,
        "title": "Progression",
        "expandedStepCount": 4,
        "totalDurationSeconds": null,
        "definition": {
          "schemaVersion": 1,
          "title": "Progression",
          "description": "A safe fixture",
          "blocks": [
            {
              "kind": "step",
              "goal": {
                "kind": "time",
                "durationTicks": 3000000000
              },
              "speed": {
                "kind": "ramp",
                "startKilometersPerHour": 5,
                "endKilometersPerHour": 7
              },
              "incline": {
                "kind": "fixed",
                "percent": 1
              },
              "cue": "Relax",
              "notes": null
            },
            {
              "kind": "repeat",
              "repetitions": 3,
              "blocks": [
                {
                  "kind": "step",
                  "goal": {
                    "kind": "distance",
                    "kilometers": 0.4
                  },
                  "speed": {
                    "kind": "heartRateZone",
                    "zoneNumber": 3,
                    "initialKilometersPerHour": 7,
                    "minimumKilometersPerHour": 7,
                    "maximumKilometersPerHour": 10
                  },
                  "incline": {
                    "kind": "fixed",
                    "percent": 0
                  },
                  "cue": null,
                  "notes": null
                }
              ]
            }
          ]
        },
        "warnings": []
      }
    },
