        "minimum": 0.0,
        "maximum": 12.0,
        "increment": 0.1,
        "evidence": "ProtocolReported"
      },
      "note": "Encoding of the Omega Z reported range (decoded values only in evidence)."
    }
  ],
  "rangeRejects": [
