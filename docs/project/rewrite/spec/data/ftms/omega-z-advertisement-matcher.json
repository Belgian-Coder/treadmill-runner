      "name": "JFTMOmega Z 1234",
      "serviceUuids": [],
      "expectedMatch": true
    },
    {
      "source": "legacy-test",
      "name": null,
      "serviceUuids": [
        "00001816-0000-1000-8000-00805f9b34fb",
        "00001826-0000-1000-8000-00805f9b34fb"
      ],
      "expectedMatch": true
    },
    {
