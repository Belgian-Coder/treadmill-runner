{
  "schema": "treadmillrunner.golden.v1",
  "codec": "ftms-control-point",
  "characteristic": "0x2AD9 Fitness Machine Control Point (service 0x1826)",
  "notes": [
    "Hex strings are uppercase, no separators, wire order. 'source' = 'legacy-test' (ported verbatim from the existing automated tests), 'derived' (computed by the specified algorithm; not in the legacy tests), or 'synthetic' (constructed for coverage; not a device capture).",
    "Speed parameter: uint16 little-endian, 0.01 km/h, value = roundHalfAwayFromZero(kph*100). Valid input: finite, 0 <= kph <= 655.35.",
    "Inclination parameter: sint16 little-endian, 0.1 %, value = roundHalfAwayFromZero(percent*10). Valid input: finite, -3276.8 <= percent <= 3276.7.",
    "Response indication/notification: exactly 3 bytes 80 <requestOpcode> <resultCode>. requestOpcode must be one of 00,02,03,07,08 (the opcodes this app knows); resultCode must be 01..05. Anything else is unparseable (treated as an invalid response)."
  ],
  "encode": [
    {
      "source": "legacy-test",
      "operation": "RequestControl",
      "expectedHex": "00"
    },
    {
      "source": "legacy-test",
      "operation": "StartOrResume",
      "expectedHex": "07"
    },
    {
      "source": "legacy-test",
      "operation": "Stop",
      "expectedHex": "0801"
    },
    {
      "source": "legacy-test",
      "operation": "Pause",
      "expectedHex": "0802",
      "note": "Encoded for completeness only. The raw FTMS Pause is NEVER sent by the app (Pause = Stop 0801)."
    },
    {
      "source": "legacy-test",
      "operation": "SetTargetSpeed",
      "inputKph": 1.0,
      "expectedHex": "026400"
    },
    {
      "source": "legacy-test",
      "operation": "SetTargetInclination",
      "inputPercent": 2.5,
      "expectedHex": "031900"
    },
    {
      "source": "derived",
      "operation": "SetTargetSpeed",
      "inputKph": 0.8,
      "expectedHex": "025000"
    },
    {
      "source": "derived",
