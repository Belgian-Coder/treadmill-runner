    },
    {
      "source": "legacy-test",
      "operation": "SetTargetInclination",
      "input": 3276.8
    }
  ],
  "parseResponse": [
    {
      "source": "legacy-test",
      "hex": "800001",
      "expected": {
        "requestOpcode": "RequestControl",
        "resultCode": "Success",
        "isSuccess": true
      }
    },
    {
      "source": "legacy-test",
      "hex": "800705",
      "expected": {
        "requestOpcode": "StartOrResume",
        "resultCode": "ControlNotPermitted",
        "isSuccess": false
      }
    },
    {
      "source": "legacy-test",
      "hex": "800804",
      "expected": {
        "requestOpcode": "StopOrPause",
        "resultCode": "OperationFailed",
        "isSuccess": false
      }
    },
    {
      "source": "derived",
      "hex": "800201",
      "expected": {
        "requestOpcode": "SetTargetSpeed",
        "resultCode": "Success",
        "isSuccess": true
      }
    },
    {
      "source": "derived",
      "hex": "800303",
      "expected": {
        "requestOpcode": "SetTargetInclination",
        "resultCode": "InvalidParameter",
        "isSuccess": false
      }
    },
    {
      "source": "derived",
      "hex": "800702",
      "expected": {
        "requestOpcode": "StartOrResume",
        "resultCode": "OpCodeNotSupported",
        "isSuccess": false
      }
    },
    {
      "source": "derived",
      "hex": "800801",
      "expected": {
        "requestOpcode": "StopOrPause",
        "resultCode": "Success",
        "isSuccess": true
      }
    }
  ],
  "parseResponseRejects": [
    {
      "source": "legacy-test",
      "hex": "",
      "reason": "empty"
    },
    {
      "source": "legacy-test",
      "hex": "8000",
      "reason": "too short"
    },
    {
      "source": "legacy-test",
      "hex": "810001",
      "reason": "first byte is not 0x80"
    },
    {
      "source": "legacy-test",
      "hex": "800000",
      "reason": "result code 0x00 undefined"
    },
    {
      "source": "legacy-test",
      "hex": "800006",
      "reason": "result code 0x06 undefined"
    },
    {
      "source": "legacy-test",
      "hex": "80000100",
      "reason": "too long (must be exactly 3 bytes)"
    },
    {
      "source": "derived",
      "hex": "808001",
      "reason": "request opcode 0x80 is the response opcode itself"
    },
    {
      "source": "derived",
      "hex": "800101",
      "reason": "request opcode 0x01 (Reset) is not an opcode this app uses"
    }
  ],
  "resultCodes": {
    "01": "Success",
    "02": "OpCodeNotSupported",
    "03": "InvalidParameter",
    "04": "OperationFailed",
    "05": "ControlNotPermitted"
  },
  "opcodes": {
    "00": "RequestControl",
    "02": "SetTargetSpeed",
    "03": "SetTargetInclination",
    "07": "StartOrResume",
    "08": "StopOrPause",
    "80": "ResponseCode"
  }
}
