      "inputKph": 1.5,
      "expectedHex": "029600"
    },
    {
      "source": "derived",
      "operation": "SetTargetSpeed",
      "inputKph": 20.0,
      "expectedHex": "02D007"
    },
    {
      "source": "derived",
      "operation": "SetTargetSpeed",
      "inputKph": 0.0,
      "expectedHex": "020000"
    },
    {
      "source": "derived",
      "operation": "SetTargetInclination",
      "inputPercent": 0.0,
      "expectedHex": "030000"
    },
    {
      "source": "derived",
      "operation": "SetTargetInclination",
      "inputPercent": 0.1,
      "expectedHex": "030100"
    },
    {
      "source": "derived",
      "operation": "SetTargetInclination",
      "inputPercent": 0.5,
      "expectedHex": "030500"
    },
    {
      "source": "derived",
      "operation": "SetTargetInclination",
      "inputPercent": 1.0,
      "expectedHex": "030A00"
    },
    {
      "source": "derived",
