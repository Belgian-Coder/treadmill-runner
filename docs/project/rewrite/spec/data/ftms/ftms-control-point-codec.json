      "inputPercent": 12.0,
      "expectedHex": "037800"
    },
    {
      "source": "derived",
      "operation": "SetTargetInclination",
      "inputPercent": -1.5,
      "expectedHex": "03F1FF"
    }
  ],
  "encodeRejects": [
    {
      "source": "legacy-test",
      "operation": "SetTargetSpeed",
      "input": "NaN"
    },
    {
