      { "name": "Chest belt", "kind": "ChestStrap", "family": "Other", "priority": 1 },
      { "name": "Running Watch", "kind": "Watch", "family": "Other", "priority": 2 },
      { "name": "HRM", "kind": "Sensor", "family": "Other", "priority": 3 },
      { "name": "Venu 3", "family": "Garmin" },
