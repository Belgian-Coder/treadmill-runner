{
  "description": "Heart-rate reconnect / H10 locator resolution. Advertisements from one bounded scan (default 5 s) are merged per address (name = last non-empty trimmed name; service UUIDs = union). 'HR evidence' = advertised 0x180D or 0xFEEE. Resolution order: (1) exact current address observed -> ExactDeviceId; (2) if allowed, exactly one candidate with HR evidence whose name equals enrollment displayName (case-insensitive) -> ExactDisplayName; (3) if allowed and effective family != Other, exactly one candidate with HR evidence whose classified family AND kind equal the enrollment's -> UniqueFamilyAndKind; otherwise null (keep the enrolled address). For the H10 memory locator: nameFallback allowed only if no other active HR enrollment has the same displayName; family fallback allowed only if no other active HR enrollment has the same effective family+kind. The locator returns early as soon as the enrolled address is observed.",
  "uuids": { "hrs": "0000180d-0000-1000-8000-00805f9b34fb", "polar": "0000feee-0000-1000-8000-00805f9b34fb" },
  "scenarios": [
    { "name": "prefers-exact-address", "enrollment": { "address": "102030405060", "displayName": "Garmin Forerunner 965", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "102030405060", "name": "Different name", "services": ["hrs"] }, { "address": "AABBCCDDEEFF", "name": "Garmin Forerunner 965", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "expected": { "address": "102030405060", "match": "ExactDeviceId" } },
    { "name": "merges-split-advertisements-then-exact-name", "enrollment": { "address": "102030405060", "displayName": "Polar H10", "kind": "ChestStrap", "family": "Polar" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": null, "services": ["hrs"] }, { "address": "AABBCCDDEEFF", "name": "Polar H10", "services": [] } ],
      "allowName": true, "allowFamily": true, "expected": { "address": "AABBCCDDEEFF", "match": "ExactDisplayName" } },
    { "name": "unique-family-and-kind-for-custom-name", "enrollment": { "address": "102030405060", "displayName": "Basement heart-rate strap", "kind": "ChestStrap", "family": "Polar" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Polar H10 12345678", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "expected": { "address": "AABBCCDDEEFF", "match": "UniqueFamilyAndKind" } },
    { "name": "generic-stored-metadata-reclassified-from-name", "enrollment": { "address": "102030405060", "displayName": "Runner Polar H10", "kind": "Sensor", "family": "Other" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Polar H10", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "expected": { "address": "AABBCCDDEEFF", "match": "UniqueFamilyAndKind" },
      "note": "Stored Sensor/Other is generic, so effective kind/family are re-derived from the display name (ChestStrap/Polar)." },
    { "name": "ambiguous-family-refused", "enrollment": { "address": "102030405060", "displayName": "My watch", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Garmin Forerunner 965", "services": ["hrs"] }, { "address": "112233445566", "name": "Venu 3", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "expected": null },
    { "name": "family-without-hr-evidence-refused", "enrollment": { "address": "102030405060", "displayName": "My Garmin watch", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Garmin Edge 1040", "services": [] } ],
      "allowName": true, "allowFamily": true, "expected": null },
    { "name": "cycling-computer-kind-mismatch-refused", "enrollment": { "address": "102030405060", "displayName": "My Garmin watch", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Garmin Edge 1040", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "expected": null, "note": "Edge classifies as Sensor, not Watch" },
    { "name": "exact-name-without-hr-evidence-refused", "enrollment": { "address": "102030405060", "displayName": "Garmin Forerunner 965", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Garmin Forerunner 965", "services": [] } ],
      "allowName": true, "allowFamily": true, "expected": null },
    { "name": "exclude-failed-current-address", "enrollment": { "address": "102030405060", "displayName": "Garmin Forerunner 965", "kind": "Watch", "family": "Garmin" },
      "advertisements": [ { "address": "102030405060", "name": "Garmin Forerunner 965", "services": ["hrs"] }, { "address": "AABBCCDDEEFF", "name": "Garmin Forerunner 965", "services": ["hrs"] } ],
      "allowName": true, "allowFamily": true, "excluded": "102030405060", "expected": { "address": "AABBCCDDEEFF", "match": "ExactDisplayName" } },
    { "name": "h10-locator-adopts-unique-rotated-address", "enrollment": { "address": "102030405060", "displayName": "Polar heart-rate sensor", "kind": "ChestStrap", "family": "Polar" },
      "activeHeartRateEnrollments": ["self"],
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": null, "services": ["polar"] }, { "address": "AABBCCDDEEFF", "name": "Polar H10", "services": ["hrs"] } ],
      "expected": { "address": "AABBCCDDEEFF" } },
    { "name": "h10-locator-fails-closed-with-second-polar-strap", "enrollment": { "address": "102030405060", "displayName": "Primary chest strap", "kind": "ChestStrap", "family": "Polar" },
      "activeHeartRateEnrollments": ["self", { "address": "112233445566", "displayName": "Spare chest strap", "kind": "ChestStrap", "family": "Polar" }],
      "advertisements": [ { "address": "AABBCCDDEEFF", "name": "Polar H10", "services": ["hrs", "polar"] } ],
      "expected": { "address": "102030405060" }, "note": "Family+kind not unique among enrollments and name does not match, so the enrolled address is kept (connect will then fail rather than bind the wrong strap)." }
  ],
  "classifier": {
    "kind": "ChestStrap if advertised 0xFEEE or name contains any of [polar h10, polar h9, chest, strap, belt]; else Watch if name contains any of [watch, garmin watch, forerunner, fenix, fēnix, epix, vivoactive, vívoactive, venu, instinct, enduro, tactix, quatix, marq, lily, descent, approach, apple, pixel, galaxy, coros, suunto]; else Sensor. Name is trimmed and lower-cased.",
    "family": "Polar if name contains 'polar h10' or advertises 0xFEEE or name contains 'polar'; Garmin if name contains any of [garmin, forerunner, fenix, fēnix, epix, vivoactive, vívoactive, venu, instinct, enduro, tactix, quatix, marq, lily, descent, approach]; else Other.",
    "priority": "0 = Polar H10 name or 0xFEEE; 1 = other ChestStrap; 2 = Watch; 3 = Sensor",
    "vectors": [
      { "name": "Polar H10", "kind": "ChestStrap", "family": "Polar", "priority": 0 },
      { "name": "Garmin Forerunner 965", "kind": "Watch", "family": "Garmin", "priority": 2 },
