      "candidates": [{"remoteId": "watch-no-hr", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:43:15Z", "durationSeconds": 2010, "distanceKilometers": 3.10, "averageHeartRate": null, "maximumHeartRate": null, "heartRateSamples": []}],
      "expected": {"disposition": "Single", "remoteId": "watch-no-hr", "evidence": "One watch activity matched by treadmill shape: start 0s, duration 0s, distance 0.00km; local Polar heart rate remains authoritative"},
      "source": "matcher test"
    },
    {
