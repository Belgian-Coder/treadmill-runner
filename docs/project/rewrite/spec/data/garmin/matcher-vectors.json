{
  "description": "Watch-activity matcher vectors. 'local' is the match reference built from the completed session (start = session start UTC, durationSeconds = timer duration excluding pauses, distanceKilometers = session distance). Candidates come from the search contract. Heart rate is carried in both but is NOT used by the current matcher (see 11-garmin.md section 6.2).",
  "rules": {
    "isPlausibleShape": [
      "lower(candidate.activityType) == 'treadmill_running'",
      "|candidate.start - local.start| <= 600 s (inclusive)",
      "|candidate.duration - local.duration| <= max(180 s, 0.15 * local.duration) (inclusive)",
      "distance is evidence only and never vetoes"
    ],
    "match": [
      "plausible = candidates filtered by isPlausibleShape",
      "0 => None, evidence 'No Garmin treadmill activity has a close start, duration, and distance.'",
      ">1 => Multiple, candidate null, evidence '<n> Garmin treadmill activities are plausible; normal upload remains enabled.' (the worker turns this into ReviewRequired)",
      "1 => Single with evidence 'One watch activity matched by treadmill shape: start <|dStart| F0>s, duration <|dDuration| F0>s, distance <|dDistance| F2>km; local Polar heart rate remains authoritative'"
    ],
    "isCanonicalLocalCopy": [
      "lower(activityType) == 'treadmill_running'",
      "|dStart| <= 45 s, |dDuration| <= 45 s, |dDistance| <= 0.08 km (all inclusive)"
    ]
  },
  "matchVectors": [
    {
      "name": "selects one treadmill activity with close shape",
