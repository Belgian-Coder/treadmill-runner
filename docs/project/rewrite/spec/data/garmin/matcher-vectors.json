      "local": {"startedAtUtc": "2026-08-21T18:00:00Z", "durationSeconds": 4000, "distanceKilometers": 10.0},
      "candidates": [{"remoteId": "b5", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:00:00Z", "durationSeconds": 3400, "distanceKilometers": 10.0}],
      "expected": {"disposition": "Single", "remoteId": "b5"},
      "source": "derived boundary (limit 600 s)"
    },
    {
      "name": "distance never vetoes",
      "local": {"startedAtUtc": "2026-08-21T18:00:00Z", "durationSeconds": 1800, "distanceKilometers": 3.0},
      "candidates": [{"remoteId": "b6", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:00:00Z", "durationSeconds": 1800, "distanceKilometers": 9.0}],
      "expected": {"disposition": "Single", "remoteId": "b6", "evidence": "One watch activity matched by treadmill shape: start 0s, duration 0s, distance 6.00km; local Polar heart rate remains authoritative"},
