      "candidates": [{"remoteId": "24064793770", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:45:15Z", "durationSeconds": 2091, "distanceKilometers": 3.10, "averageHeartRate": 136, "maximumHeartRate": 161}],
      "expected": {"disposition": "Single", "remoteId": "24064793770", "evidence": "One watch activity matched by treadmill shape: start 120s, duration 81s, distance 0.00km; local Polar heart rate remains authoritative"},
      "source": "matcher test"
    },
    {
      "name": "more than one plausible activity is left for manual review",
      "local": {"startedAtUtc": "2026-08-21T18:43:15Z", "durationSeconds": 2010, "distanceKilometers": 3.10},
      "candidates": [
        {"remoteId": "one", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:44:15Z", "durationSeconds": 2050, "distanceKilometers": 3.08},
        {"remoteId": "two", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:46:15Z", "durationSeconds": 2100, "distanceKilometers": 3.12}
      ],
      "expected": {"disposition": "Multiple", "remoteId": null, "evidence": "2 Garmin treadmill activities are plausible; normal upload remains enabled."},
      "source": "matcher test"
    },
    {
      "name": "rejects a candidate outside the ten-minute start window",
      "local": {"startedAtUtc": "2026-08-21T18:43:15Z", "durationSeconds": 2010, "distanceKilometers": 3.10},
      "candidates": [{"remoteId": "late", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:54:15Z", "durationSeconds": 2091, "distanceKilometers": 3.10}],
      "expected": {"disposition": "None", "remoteId": null},
      "source": "matcher test"
    },
    {
      "name": "unique treadmill shape matches without local heart rate",
      "local": {"startedAtUtc": "2026-08-21T18:43:15Z", "durationSeconds": 2010, "distanceKilometers": 3.10, "averageHeartRate": null, "maximumHeartRate": null, "heartRateSamples": []},
      "candidates": [{"remoteId": "review", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:45:15Z", "durationSeconds": 2091, "distanceKilometers": 3.10, "averageHeartRate": 136, "maximumHeartRate": 161}],
      "expected": {"disposition": "Single", "remoteId": "review", "evidenceContains": "treadmill shape"},
      "source": "matcher test"
    },
    {
