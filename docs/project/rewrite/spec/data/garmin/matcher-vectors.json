      "candidates": [{"remoteId": "watch-different-hr", "activityType": "treadmill_running", "startedAtUtc": "2026-08-21T18:46:15Z", "durationSeconds": 1830, "distanceKilometers": 3.08, "averageHeartRate": 95, "maximumHeartRate": 110}],
