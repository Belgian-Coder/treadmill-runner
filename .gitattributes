# Candidate imports are raw upstream/source material. Preserve them as staged
# inputs instead of normalizing or diff-checking them like maintained files.
_candidate-imports/** -text -diff

# Local AI license/model-card snapshots and raw benchmark outputs are preserved
# as downloaded/generated evidence.
.agents/local-ai/bundle/licenses/** -whitespace
automations/agent-benchmarking/runs/**/raw/** -whitespace
