{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Urls": "http://0.0.0.0:5180"
  },
  "OperatorAccess": {
    "Enabled": false,
    "SessionMinutes": 30,
    "MaximumFailedAttempts": 5,
    "FailureWindowMinutes": 5
  },
  "GarminConnect": {
    "Provider": "Disabled",
    "FutureCalendarDays": 180,
    "RequestTimeoutSeconds": 20
  },
  "GarminActivityUpload": {
    "PythonExecutable": "tools/garmin/runtime/python.exe",
    "AdapterScriptPath": "tools/garmin/garmin_activity_adapter.py",
    "TimeoutSeconds": 45
  },
  "AllowedHosts": "*"
}
