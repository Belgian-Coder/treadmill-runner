<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>TreadmillRunner</title>
    <meta name="description" content="Plan workouts, connect devices, and track runs with TreadmillRunner." />
    <base href="/" />
    <meta name="theme-color" content="#071f29" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TreadmillRunner" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon-180.png" />
    <script src="@Assets["pwa-shell.js"]" defer></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    <div id="app-boot-shell" class="app-boot-shell" role="status" aria-live="polite" aria-label="Loading TreadmillRunner">
        <header class="app-boot-shell__header" aria-hidden="true"><span>TR</span><strong>TreadmillRunner</strong></header>
        @if (IsOperationsRequest)
        {
            <OperationsBootShell />
        }
        else
        {
            <main class="app-boot-shell__main" aria-hidden="true">
                <p class="eyebrow">Connected household runner</p>
                <h1>Loading TreadmillRunner…</h1>
                <div class="app-boot-shell__cards"><span></span><span></span><span></span></div>
            </main>
        }
    </div>
    <div id="app-interactive-shell" class="app-interactive-shell">
        <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
    </div>
    <script src="@Assets["runner-sound.js"]" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]" defer></script>
</body>

</html>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool IsOperationsRequest =>
        string.Equals(
            Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'),
            "operations",
            StringComparison.OrdinalIgnoreCase);
}
