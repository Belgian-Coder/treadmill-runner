{
  "name": "TreadmillRunner",
  "short_name": "Runner",
  "description": "Local treadmill workouts and controls.",
  "id": "/",
  "start_url": "/?source=homescreen",
  "scope": "/",
  "display": "standalone",
  "background_color": "#071f29",
  "theme_color": "#071f29",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    { "name": "Run", "short_name": "Run", "description": "Prepare or continue today's treadmill run.", "url": "/" },
    { "name": "Calendar", "short_name": "Calendar", "description": "Review scheduled training.", "url": "/calendar" },
    { "name": "History", "short_name": "History", "description": "Review completed treadmill sessions.", "url": "/history" },
    { "name": "Operations", "short_name": "Operations", "description": "Review local health, backups, and updates.", "url": "/operations" }
  ],
  "icons": [
    { "src": "/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
