@inject Microsoft.AspNetCore.Components.WebAssembly.Services.LazyAssemblyLoader AssemblyLoader

<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="lazyLoadedAssemblies" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="LoadRouteAssembliesAsync">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private static readonly string[] OperationsAssemblies = ["TreadmillRunner.Web.Operations.dll"];
    private readonly List<System.Reflection.Assembly> lazyLoadedAssemblies = [];

    private async Task LoadRouteAssembliesAsync(NavigationContext context)
    {
        string route = context.Path.Split('?', '#')[0].Trim('/');
        string[] assemblies = route == "operations" ? OperationsAssemblies : [];
        if (assemblies.Length == 0) return;
        IEnumerable<System.Reflection.Assembly> loaded = await AssemblyLoader.LoadAssembliesAsync(assemblies);
        foreach (System.Reflection.Assembly assembly in loaded)
        {
            if (!lazyLoadedAssemblies.Contains(assembly)) lazyLoadedAssemblies.Add(assembly);
        }
    }
}
