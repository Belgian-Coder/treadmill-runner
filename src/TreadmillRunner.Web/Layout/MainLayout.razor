@inherits LayoutComponentBase

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject TreadmillRunner.Web.ClientRuntimeState Runtime

<a class="skip-link" href="#main-content">Skip to main content</a>

<header id="site-header" class="site-header" data-scroll-state="shown">
    <a class="site-brand" href="/" aria-label="TreadmillRunner run dashboard">
        <span aria-hidden="true">TR</span>
        <strong>TreadmillRunner</strong>
    </a>
    <nav class="primary-nav primary-nav--desktop" aria-label="Primary navigation">
        <RunNavLink />
        <NavLink href="/workouts">Workouts</NavLink>
        <NavLink href="/calendar">Calendar</NavLink>
        <NavLink href="/history">History</NavLink>
        <NavLink href="/devices">Devices</NavLink>
        <NavLink href="/profiles">Profiles</NavLink>
        <NavLink href="/operations">Operations</NavLink>
    </nav>
    <nav class="primary-nav primary-nav--mobile" aria-label="Primary navigation">
        <RunNavLink />
        <NavLink href="/workouts">Plan</NavLink>
        <NavLink href="/history">History</NavLink>
        <details class="nav-more">
            <summary>More</summary>
            <div class="nav-more__menu">
                <NavLink href="/calendar">Calendar</NavLink>
                <NavLink href="/devices">Devices</NavLink>
                <NavLink href="/profiles">Profiles</NavLink>
                <NavLink href="/workouts/import">Import</NavLink>
                <NavLink href="/operations">Operations</NavLink>
            </div>
        </details>
    </nav>
</header>

<main id="main-content" class="app-shell" tabindex="-1">
    @if (Runtime.UpdateRequired)
    {
        <section class="runtime-banner runtime-banner--update" role="alert">
            <span><strong>Update ready</strong> — reload before continuing.</span>
            <button type="button" @onclick="ReloadAsync">Reload</button>
        </section>
    }
    else if (!Runtime.IsConnected)
    {
        <section class="runtime-banner" role="alert">
            <strong>Live updates unavailable — the treadmill may still be moving.</strong>
            <span>Use the physical console or physical Stop if needed. Reconnecting automatically; dashboard controls remain disabled.</span>
        </section>
    }
    @Body
</main>

<div id="blazor-error-ui" role="alert" aria-live="assertive" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button class="dismiss" type="button" aria-label="Dismiss error">&#x2715;</button>
</div>

@code {
    private CancellationTokenSource? monitorCancellation;
    private DotNetObjectReference<MainLayout>? selfReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Runtime.Changed += RuntimeChanged;
        await JS.InvokeVoidAsync("treadmillRunnerView.initializeAutoHideHeader", "site-header");
        selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("treadmillRunnerRuntime.initialize", selfReference);
        monitorCancellation = new CancellationTokenSource();
        await Runtime.CheckAsync(Http, monitorCancellation.Token);
        _ = MonitorVersionAsync(monitorCancellation.Token);
    }

    [JSInvokable]
    public async Task BrowserVisibleAsync() => await Runtime.CheckAsync(Http);

    private async Task MonitorVersionAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await Runtime.CheckAsync(Http, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void RuntimeChanged() => _ = InvokeAsync(StateHasChanged);
    private async Task ReloadAsync() => await JS.InvokeVoidAsync("treadmillRunnerRuntime.reloadNow", Runtime.ServerFingerprint ?? Runtime.ExpectedFingerprint);

    public async ValueTask DisposeAsync()
    {
        Runtime.Changed -= RuntimeChanged;
        monitorCancellation?.Cancel();
        try { await JS.InvokeVoidAsync("treadmillRunnerView.disposeAutoHideHeader"); }
        catch (JSDisconnectedException) { }
        try { await JS.InvokeVoidAsync("treadmillRunnerRuntime.dispose"); }
        catch (JSDisconnectedException) { }
        selfReference?.Dispose();
        monitorCancellation?.Dispose();
    }
}
