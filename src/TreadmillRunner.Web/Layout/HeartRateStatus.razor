@implements IDisposable
@inject GatewayConnectionSupervisor Gateway

<a class="global-hr-status @StatusClass"
   href="/devices"
   role="status"
   aria-live="polite"
   aria-label="@AccessibleLabel">
    <span class="global-hr-status__icons" aria-hidden="true">
        <svg class="heart-sensor-icon" viewBox="0 0 24 24"><path d="M12 21s-8-5.1-8-11a4.5 4.5 0 0 1 8-3.3A4.5 4.5 0 0 1 20 10c0 5.9-8 11-8 11Z" /></svg>
        @if (!IsConnected)
        {
            <span class="heart-sensor-slash"></span>
        }
        else if (SensorKind == HeartRateDeviceKind.Watch)
        {
            <svg class="heart-device-icon" viewBox="0 0 24 24"><path d="M8 3h8l1 4v10l-1 4H8l-1-4V7l1-4Zm1 5v8h6V8H9Z" /></svg>
        }
        else
        {
            <svg class="heart-device-icon" viewBox="0 0 24 24"><path d="M3 8h4v8H3V8Zm14 0h4v8h-4V8ZM7 10h10v4H7v-4Zm3-3h4v10h-4V7Z" /></svg>
        }
    </span>
    <span class="global-hr-status__copy">
        <strong>@PrimaryText</strong>
        <small>@SecondaryText</small>
    </span>
</a>

@code {
    [Parameter] public bool Compact { get; set; }

    private static readonly TimeSpan FreshnessLimit = TimeSpan.FromSeconds(5);
    private string? sensorName;
    private DeviceConnectionState sensorState = DeviceConnectionState.Disconnected;
    private ushort? heartRateBpm;
    private TimeSpan? heartRateAge;
    private HeartRateSignalQuality heartRateQuality = HeartRateSignalQuality.Unavailable;
    private HeartRateContactState heartRateContactState = HeartRateContactState.Unknown;
    private HeartRateDeviceKind? sensorKind;
    private bool gatewayAvailable = true;

    protected override async Task OnInitializedAsync()
    {
        Gateway.HeartRateChanged += GatewayHeartRateChanged;
        Gateway.ConnectionChanged += GatewayConnectionChanged;
        await Gateway.EnsureStartedAsync();
        ApplyGatewayState();
    }

    private bool HasSensor => !string.IsNullOrWhiteSpace(sensorName);
    private bool HasFreshReading => gatewayAvailable && HasSensor &&
        heartRateBpm is not null &&
        heartRateQuality == HeartRateSignalQuality.Valid &&
        heartRateContactState != HeartRateContactState.NotDetected &&
        heartRateAge <= FreshnessLimit;
    private bool IsConnected => gatewayAvailable && HasSensor &&
        (HasFreshReading || sensorState is DeviceConnectionState.Ready or
            DeviceConnectionState.Subscribing or DeviceConnectionState.DiscoveringServices);

    private HeartRateDeviceKind SensorKind => sensorKind ?? HeartRateDeviceClassifier.Classify(sensorName);

    private string PrimaryText => !gatewayAvailable
        ? "HR unavailable"
        : !IsConnected
            ? "No HR sensor"
            : HasFreshReading
                ? $"{heartRateBpm} bpm"
                : StateText;

    private string SecondaryText => !IsConnected
        ? HasSensor ? $"{sensorName} is offline" : "Connect a band or watch"
        : Compact ? $"{CompactKindLabel} · {CompactSensorName}" : $"{KindLabel} · {sensorName}";

    private string CompactSensorName => sensorName switch
    {
        string name when name.Contains("Polar H10", StringComparison.OrdinalIgnoreCase) => "Polar H10",
        string name when name.Contains("Fenix 8", StringComparison.OrdinalIgnoreCase) => "Fenix 8",
        string name when name.Contains("Vivoactive", StringComparison.OrdinalIgnoreCase) => "Vivoactive",
        string name when name.Contains("Simulated", StringComparison.OrdinalIgnoreCase) => "Simulated",
        { Length: <= 14 } name => name,
        string name => name[..14],
        _ => "Sensor",
    };

    private string StateText => sensorState switch
    {
        DeviceConnectionState.Connecting => "Connecting…",
        DeviceConnectionState.Reconnecting => "Reconnecting…",
        DeviceConnectionState.Faulted => "Sensor fault",
        DeviceConnectionState.Ready when heartRateContactState == HeartRateContactState.NotDetected ||
            heartRateQuality == HeartRateSignalQuality.ContactLost => "No sensor contact",
        DeviceConnectionState.Ready when heartRateQuality == HeartRateSignalQuality.Invalid => "Reading unavailable",
        DeviceConnectionState.Ready when heartRateAge > FreshnessLimit => "Signal stale",
        DeviceConnectionState.Ready => "Waiting for pulse",
        _ => "Sensor offline",
    };

    private string KindLabel => SensorKind switch
    {
        HeartRateDeviceKind.ChestStrap => "Chest strap",
        HeartRateDeviceKind.Watch => "Watch",
        _ => "HR sensor",
    };

    private string CompactKindLabel => SensorKind switch
    {
        HeartRateDeviceKind.ChestStrap => "Strap",
        HeartRateDeviceKind.Watch => "Watch",
        _ => "Sensor",
    };

    private string StatusClass => (Compact ? "global-hr-status--compact " : string.Empty) + (HasFreshReading
        ? "global-hr-status--ready"
        : IsConnected
            ? "global-hr-status--waiting"
            : "global-hr-status--absent");

    private string AccessibleLabel => !IsConnected
        ? $"Pulse sensor status: {PrimaryText}. {SecondaryText}."
        : $"Pulse sensor status: {PrimaryText}. {KindLabel}: {sensorName}.";

    private void GatewayHeartRateChanged()
    {
        ApplyGatewayState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void GatewayConnectionChanged()
    {
        ApplyGatewayState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyGatewayState()
    {
        gatewayAvailable = Gateway.Current.IsConnected;
        LiveSnapshot? incoming = Gateway.Current.Live;
        if (incoming is null) return;
        sensorName = incoming.HeartRateDeviceName;
        sensorState = incoming.HeartRateConnectionState;
        heartRateBpm = incoming.HeartRateBpm;
        heartRateAge = incoming.HeartRateTelemetryAge;
        heartRateQuality = incoming.HeartRateQuality;
        heartRateContactState = incoming.HeartRateContactState;
        sensorKind = incoming.HeartRateDeviceKind;
    }

    public void Dispose()
    {
        Gateway.HeartRateChanged -= GatewayHeartRateChanged;
        Gateway.ConnectionChanged -= GatewayConnectionChanged;
    }
}
