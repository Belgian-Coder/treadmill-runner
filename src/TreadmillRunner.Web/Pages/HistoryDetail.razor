    private async Task LoadGarminRecoveryAsync()
    {
        if (session?.Garmin is null) { garminRecovery = null; return; }
        try
        {
            garminRecovery = await Http.GetFromJsonAsync<GarminHistoricalRecoveryView>(
                $"api/integrations/garmin/activity-upload/profiles/{session.Definition.UserProfileId}/sessions/{SessionId}/historical-recovery");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            garminRecovery = null;
        }
    }

    private void SelectGarminRecovery(string action)
    {
        if (action is "MergeIntoOne" or "UndoMerge") garminRecoveryChoice = action;
    }

    private void CancelGarminRecovery() => garminRecoveryChoice = string.Empty;

    private async Task StartGarminRecoveryAsync()
    {
        if (session?.Garmin is null || garminRecovery is not { Available: true } ||
            garminRecoveryChoice is not ("MergeIntoOne" or "UndoMerge") || garminActionBusy) return;
        string action = garminRecoveryChoice;
        string confirmation = action == "MergeIntoOne" ? "MERGE INTO ONE" : "UNDO GARMIN MERGE";
        garminActionBusy = true;
        garminActionMessage = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/integrations/garmin/activity-upload/profiles/{session.Definition.UserProfileId}/sessions/{SessionId}/historical-recovery",
                new { operationId = Guid.NewGuid(), action, confirmation });
            if (!response.IsSuccessStatusCode)
            {
                GarminRecoveryErrorView? error = null;
                try { error = await response.Content.ReadFromJsonAsync<GarminRecoveryErrorView>(); }
                catch (System.Text.Json.JsonException) { }
                garminActionMessage = error?.Error ?? "The historical Garmin recovery could not be started. Nothing was changed.";
                return;
            }
            garminActionMessage = action == "MergeIntoOne"
                ? "Keeping one Garmin activity. The app will identify the existing uploads before deleting anything."
                : "Restoring two Garmin activities from verified source files. Your local History remains unchanged.";
            await Task.Delay(750);
            await LoadSessionAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            garminActionMessage = "The gateway is unavailable. No additional Garmin recovery request was sent.";
        }
        finally { garminActionBusy = false; }
    }

    private async Task AcknowledgeGarminFoundAsync()
    {
        if (session?.Garmin is not { Status: "Unknown" } garmin || garminActionBusy) return;
        garminActionBusy = true;
        garminActionMessage = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/integrations/garmin/activity-upload/profiles/{session.Definition.UserProfileId}/jobs/{garmin.Id}/acknowledge-found",
                new { operationId = Guid.NewGuid() });
            if (!response.IsSuccessStatusCode)
            {
                garminActionMessage = "The Garmin record could not be acknowledged.";
                return;
            }
            garminActionMessage = "Acknowledged as found in Garmin. Local deletion is now available.";
            await LoadSessionAsync();
        }
        catch (HttpRequestException)
        {
            garminActionMessage = "The gateway is unavailable. Nothing was acknowledged.";
        }
        finally { garminActionBusy = false; }
    }

    private async Task LoadDeletionPreviewAsync()
    {
        if (session is null) return;
        deletionMessage = string.Empty;
        previewLoading = true;
        try
        {
            deletionOperationId = Guid.NewGuid();
            deletionPreview = await Http.GetFromJsonAsync<HistoryDeletionPreview>(
                $"api/history/{SessionId}/deletion-preview?profileId={session.Definition.UserProfileId}");
            if (deletionPreview is null) deletionMessage = "The deletion preview is unavailable. No local data was changed.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            deletionPreview = null;
            deletionMessage = "The gateway is unavailable. No local data was changed.";
        }
        finally { previewLoading = false; }
    }

    private async Task DeleteSessionAsync()
    {
        if (session is null || deletionPreview is null || !deletionPreview.CanDelete) return;
        deleting = true;
        deletionMessage = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/history/{SessionId}/delete", new
            {
                operationId = deletionOperationId,
                profileId = session.Definition.UserProfileId,
                expectedRevision = deletionPreview.Revision,
                confirmed = true,
            });
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/history", replace: true);
                return;
            }
            deletionMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "The session or upload state changed. Review the deletion preview again."
                : "The local session could not be deleted.";
        }
        catch (HttpRequestException)
        {
            deletionMessage = "The gateway is unavailable. No local data was deleted.";
        }
        finally { deleting = false; }
    }

    private void CancelDeletion()
    {
        deletionPreview = null;
        deletionMessage = string.Empty;
        deletionOperationId = Guid.Empty;
    }

    private string BuildMetricPath(Func<SessionSample, double?> selector, int axisMaximum)
    {
        if (session?.Samples.Count is null or 0) return string.Empty;

        IReadOnlyList<SessionSample> points = RenderSamples(session.Samples);
        var path = new StringBuilder();
        bool started = false;
        foreach (SessionSample point in points)
        {
            if (selector(point) is not { } value)
            {
                started = false;
                continue;
            }
            double x = ChartX(point.Elapsed);
            double y = ChartY(value, axisMaximum);
            path.Append(started ? " L" : "M");
            path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
            started = true;
        }

        return path.ToString();
    }

    private string BuildHeartRatePath()
    {
        if (session?.Samples.Count is null or 0) return string.Empty;
        var path = new StringBuilder();
        bool started = false;
        foreach (SessionSample point in RenderSamples(session.Samples))
        {
            if (point.HeartRateBpm is not { } heartRate)
            {
                started = false;
                continue;
            }
            path.Append(started ? " L" : "M");
            path.Append(ChartX(point.Elapsed).ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(HeartRateChartY(heartRate).ToString("0.##", CultureInfo.InvariantCulture));
            started = true;
        }
        return path.ToString();
    }

    private static IReadOnlyList<SessionSample> RenderSamples(IReadOnlyList<SessionSample> samples)
    {
        const int maximumRenderedPoints = 720;
        if (samples.Count <= maximumRenderedPoints) return samples;
        const int bucketCount = maximumRenderedPoints / 12;
        int bucketSize = (int)Math.Ceiling(samples.Count / (double)bucketCount);
        var selected = new List<SessionSample>(maximumRenderedPoints);
        for (int start = 0; start < samples.Count; start += bucketSize)
        {
            SessionSample[] bucket = samples.Skip(start).Take(Math.Min(bucketSize, samples.Count - start)).ToArray();
            var extrema = new List<SessionSample>
            {
                bucket[0], bucket[^1],
                bucket.MinBy(static sample => sample.MeasuredSpeedKph)!, bucket.MaxBy(static sample => sample.MeasuredSpeedKph)!,
                bucket.MinBy(static sample => sample.RequestedSpeedKph)!, bucket.MaxBy(static sample => sample.RequestedSpeedKph)!,
                bucket.MinBy(static sample => sample.MeasuredInclinePercent)!, bucket.MaxBy(static sample => sample.MeasuredInclinePercent)!,
                bucket.MinBy(static sample => sample.RequestedInclinePercent)!, bucket.MaxBy(static sample => sample.RequestedInclinePercent)!,
            };
            SessionSample[] heartRate = bucket.Where(static sample => sample.HeartRateBpm is not null).ToArray();
            if (heartRate.Length > 0)
            {
                extrema.Add(heartRate.MinBy(static sample => sample.HeartRateBpm)!);
                extrema.Add(heartRate.MaxBy(static sample => sample.HeartRateBpm)!);
            }
            SessionSample[] planned = bucket.Where(static sample => sample.PlannedSpeedKph is not null).ToArray();
            if (planned.Length > 0)
            {
                extrema.Add(planned.MinBy(static sample => sample.PlannedSpeedKph)!);
                extrema.Add(planned.MaxBy(static sample => sample.PlannedSpeedKph)!);
            }
            SessionSample[] plannedIncline = bucket.Where(static sample => sample.PlannedInclinePercent is not null).ToArray();
            if (plannedIncline.Length > 0)
            {
                extrema.Add(plannedIncline.MinBy(static sample => sample.PlannedInclinePercent)!);
                extrema.Add(plannedIncline.MaxBy(static sample => sample.PlannedInclinePercent)!);
            }
            int[] transitions = Enumerable.Range(1, bucket.Length - 1)
                .Where(index => bucket[index - 1].PlannedSpeedKph.HasValue != bucket[index].PlannedSpeedKph.HasValue)
                .ToArray();
            foreach (int transition in transitions.Length <= 2 ? transitions : new[] { transitions[0], transitions[^1] })
            {
                extrema.Add(bucket[transition - 1]);
                extrema.Add(bucket[transition]);
            }
            selected.AddRange(extrema.Distinct().OrderBy(static sample => sample.Elapsed));
        }
        return selected;
    }

    private int SpeedAxisMaximum => session is null ? 10 : Projection.SpeedAxisMaximum;
    private int InclineAxisMaximum => session is null ? 10 : Projection.InclineAxisMaximum;

    private IEnumerable<int> SpeedAxisTicks => Enumerable.Range(1, SpeedAxisMaximum).Reverse();
    private IEnumerable<int> InclineAxisTicks => Enumerable.Range(1, InclineAxisMaximum).Reverse();
    private IReadOnlyList<SessionHeartRateZoneSnapshot> HeartRateBoundaryZones => session is null ? [] : Projection.HeartRateBoundaryZones;
    private int HeartRateAxisMinimum => session is null ? 60 : Projection.HeartRateAxisMinimum;
    private int HeartRateAxisMaximum => session is null ? 180 : Projection.HeartRateAxisMaximum;
    private IEnumerable<int> HeartRateAxisTicks
    {
        get
        {
            int range = HeartRateAxisMaximum - HeartRateAxisMinimum;
            int interval = range <= 60 ? 10 : 20;
            return Enumerable.Range(0, (range / interval) + 1).Select(index => HeartRateAxisMinimum + (index * interval)).Reverse();
        }
    }
    private double ChartX(TimeSpan elapsed) => 10 + (Math.Clamp(elapsed.TotalSeconds / Math.Max(1, ChartDuration.TotalSeconds), 0, 1) * 700);
    private static double ChartY(double value, int axisMaximum) => 210 - (Math.Clamp(value / axisMaximum, 0, 1) * 200);
    private double HeartRateChartY(double value) => 210 - (Math.Clamp((value - HeartRateAxisMinimum) / Math.Max(1, HeartRateAxisMaximum - HeartRateAxisMinimum), 0, 1) * 200);
    private IReadOnlyList<ChartInspectionPoint> GetSpeedInclineInspectionPoints() => session is null ? [] : Projection.SpeedInclineInspectionPoints;
    private IReadOnlyList<ChartInspectionPoint> GetHeartRateInspectionPoints() => session is null ? [] : Projection.HeartRateInspectionPoints;

    private TimeSpan ChartDuration => session is null ? TimeSpan.Zero : Projection.Duration;

    private IReadOnlyList<ChartTimeTick> ChartTimeTicks
    {
        get
        {
            TimeSpan duration = ChartDuration;
            double minutes = duration.TotalMinutes;
            int intervalMinutes = AxisIntervalMinutes(minutes);
            var ticks = new List<ChartTimeTick> { new(TimeSpan.Zero, 0) };
            for (double minute = intervalMinutes; minute < minutes; minute += intervalMinutes)
            {
                TimeSpan elapsed = TimeSpan.FromMinutes(minute);
                ticks.Add(new ChartTimeTick(elapsed, elapsed.TotalSeconds / Math.Max(1, duration.TotalSeconds) * 100));
            }
            if (ticks.Count > 1 && (duration - ticks[^1].Elapsed).TotalMinutes < intervalMinutes * .75) ticks.RemoveAt(ticks.Count - 1);
            if (duration > TimeSpan.Zero) ticks.Add(new ChartTimeTick(duration, 100));
            return ticks;
        }
    }

    private static string FormatAxisTime(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm", CultureInfo.InvariantCulture)
        : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);

    private static int AxisIntervalMinutes(double durationMinutes)
    {
        double desired = durationMinutes / 5;
        return desired <= 1 ? 1 : desired <= 2 ? 2 : desired <= 5 ? 5 : desired <= 10 ? 10 : desired <= 15 ? 15 : 30;
    }

    private sealed record ChartTimeTick(TimeSpan Elapsed, double PositionPercent);
    private sealed record PwaStatusModel(bool ShareSupported);
    private sealed record PwaActionResult(string State, string Message);

    private static string EventLabel(System.Text.Json.JsonElement sessionEvent)
    {
        string eventType = sessionEvent.TryGetProperty("eventType", out var type) ? type.GetString() ?? "event" : "event";
        if (eventType == "manual-speed-override" &&
            sessionEvent.TryGetProperty("previousSpeedKph", out var previous) &&
            sessionEvent.TryGetProperty("requestedSpeedKph", out var requested))
        {
            return $"Manual speed override: {previous.GetDouble():0.0} → {requested.GetDouble():0.0} km/h";
        }

        if (eventType == "manual-incline-override" &&
            sessionEvent.TryGetProperty("previousInclinePercent", out var previousIncline) &&
            sessionEvent.TryGetProperty("requestedInclinePercent", out var requestedIncline))
        {
            return $"Manual incline override: {previousIncline.GetDouble():0.0} → {requestedIncline.GetDouble():0.0}%";
        }

        return eventType switch
        {
            "physical-movement-detected" or "session-warning" when sessionEvent.TryGetProperty("message", out var message) => message.GetString() ?? "Session warning",
            "workout-step-transition" => "Workout step changed",
            "workout-progress-reset" when sessionEvent.TryGetProperty("message", out var resetMessage) => resetMessage.GetString() ?? "Workout progress reset",
            "session-completed" => "Session completed",
            _ => eventType.Replace('-', ' '),
        };
    }
