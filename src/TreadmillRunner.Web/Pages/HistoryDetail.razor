@page "/history/{SessionId:guid}"
@using TreadmillRunner.Web.Live
@using System.Globalization
@using System.Text
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Session detail · TreadmillRunner</PageTitle>

@if (loading)
{
    <p class="empty-state" role="status">Loading session detail…</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="empty-state" role="alert">
        <p>@loadError</p>
        <button class="secondary-action" type="button" @onclick="LoadSessionAsync">Try again</button>
    </div>
}
else if (session is null)
{
    <div class="empty-state"><p>This local session was not found. It may have been deleted.</p><a class="secondary-action" href="/history">Back to history</a></div>
}
else
{
    <section class="page-stack" aria-labelledby="session-title">
        <header class="page-heading">
            <div><p class="eyebrow">@session.State · @session.Definition.UserProfileName</p><h1 id="session-title">@session.Definition.WorkoutTitle</h1></div>
        </header>

        <section class="history-summary-grid">
            <article><span>Duration</span><strong>@session.Duration.ToString(@"hh\:mm\:ss")</strong></article>
            <article><span>Distance</span><strong>@session.DistanceKilometers.ToString("0.00") km</strong></article>
            <article><span>Estimated kcal</span><strong>@session.EstimatedKilocalories.ToString("0")</strong></article>
            <article><span>Average HR</span><strong>@AverageHeartRateLabel</strong></article>
        </section>
        @if (comparison is { } sameRevision)
        {
            <section class="panel-card" aria-labelledby="comparison-title">
                <div class="panel-heading"><div><p class="eyebrow">Same saved workout revision</p><h2 id="comparison-title">Previous comparison</h2></div><span>@sameRevision.ComparisonCount prior</span></div>
                @if (sameRevision.Previous is { } previous)
                {
                    <div class="weekly-summary">
                        <article><span>Time change</span><strong>@FormatDelta(session.Duration - previous.Duration)</strong></article>
                        <article><span>Distance change</span><strong>@((session.DistanceKilometers - previous.DistanceKilometers).ToString("+0.00;-0.00;0.00")) km</strong></article>
                        <article><span>Previous avg speed</span><strong>@previous.AverageSpeedKph.ToString("0.0") km/h</strong></article>
                    </div>
                }
                <p class="field-hint">@sameRevision.Explanation</p>
            </section>
        }
        <section class="controls-card session-export-actions" aria-label="Session exports">
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.csv")" download>Download CSV</a>
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.fit")" download>Download FIT Activity</a>
            <button class="touch-action danger-action" type="button" disabled="@previewLoading" @onclick="LoadDeletionPreviewAsync">@(previewLoading ? "Checking…" : "Delete local session")</button>
        </section>
        <section class="panel-card adviser-card" aria-labelledby="adviser-title">
            <div class="panel-heading"><div><p class="eyebrow">Deterministic local adviser</p><h2 id="adviser-title">What next?</h2></div><span>No plan changes without confirmation</span></div>
            <p class="field-hint">Accepting or rejecting records your decision only. It never edits the saved workout or active training plan.</p>
            @if (localInsightsLoading)
            {
                <p class="muted" role="status">Loading comparison and adviser receipts…</p>
            }
            else if (!string.IsNullOrWhiteSpace(localInsightsMessage))
            {
                <p class="field-error" role="status">@localInsightsMessage</p>
                <button class="secondary-action" type="button" @onclick="LoadLocalInsightsAsync">Try again</button>
            }
            else if (recommendation is null)
            {
                <p>Use this run’s recorded completion, adherence, RPE, heart-rate coverage, interruptions, and telemetry quality to create an explainable suggestion.</p>
                <button class="secondary-action" type="button" @onclick="CreateRecommendationAsync" disabled="@recommendationBusy">@(recommendationBusy ? "Reviewing…" : "Create local suggestion")</button>
            }
            else
            {
                <p><strong>@recommendation.Recommendation.Action:</strong> @recommendation.Recommendation.Reason</p>
                <p class="field-hint">Algorithm @recommendation.Recommendation.AlgorithmVersion · receipt @recommendation.Status</p>
                @if (recommendation.Status == "Pending")
                {
                    <div class="controls-card adviser-actions">
                        <button class="primary-action" type="button" @onclick="() => DecideRecommendationAsync(true)" disabled="@recommendationBusy">Record as accepted</button>
                        <button class="secondary-action" type="button" @onclick="() => DecideRecommendationAsync(false)" disabled="@recommendationBusy">Record as rejected</button>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(recommendationMessage)) { <p role="status">@recommendationMessage</p> }
        </section>
        @if (deletionPreview is null && !string.IsNullOrWhiteSpace(deletionMessage))
        {
            <p class="field-error" role="status">@deletionMessage</p>
        }

        @if (deletionPreview is not null)
        {
            <section class="panel-card deletion-preview" aria-labelledby="deletion-preview-title">
                <h2 id="deletion-preview-title">Permanent deletion preview</h2>
                <p>@deletionPreview.Reason</p>
                <dl class="device-facts">
                    <div><dt>Samples</dt><dd>@deletionPreview.SampleCount</dd></div>
                    <div><dt>Events</dt><dd>@deletionPreview.EventCount</dd></div>
                    <div><dt>Origin</dt><dd>@deletionPreview.Origin</dd></div>
                    <div><dt>Garmin</dt><dd>@(deletionPreview.GarminStatus ?? "No upload job")</dd></div>
                </dl>
                @if (deletionPreview.MaintenanceDistanceImpactKilometers > 0)
                {
                    <p class="field-error">Deleting this record removes @deletionPreview.MaintenanceDistanceImpactKilometers.ToString("0.00") km from the app-tracked maintenance total.</p>
                }
                @if (deletionPreview.GarminRemoteActivityMayRemain)
                {
                    <p class="field-error"><strong>This deletes local data only.</strong> Delete any uploaded test activity separately in Garmin Connect.</p>
                }
                <div class="form-actions">
                    <button class="touch-action danger-action" type="button" disabled="@(!deletionPreview.CanDelete || deleting)" @onclick="DeleteSessionAsync">@(deleting ? "Deleting…" : "Permanently delete")</button>
                    <button class="touch-action secondary-action" type="button" @onclick="CancelDeletion">Cancel</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(deletionMessage)) { <p class="field-error" role="status">@deletionMessage</p> }
            </section>
        }

        <section class="route-card">
            <h2>Planned versus actual</h2>
            <div class="chart-plot-grid">
                <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@SpeedAxisMaximum, 1fr)">
                    <strong class="chart-axis-unit">km/h</strong>
                    @foreach (int tick in SpeedAxisTicks)
                    {
                        <span>@tick</span>
                    }
                </div>
                <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Historical speed in kilometers per hour over elapsed time">
                    @foreach (int tick in SpeedAxisTicks)
                    {
                        double y = ChartY(tick);
                        <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                    }
                    <path class="chart-plan" d="@BuildSpeedPath(static sample => sample.PlannedSpeedKph)" />
                    <path class="chart-requested" d="@BuildSpeedPath(static sample => sample.RequestedSpeedKph)" />
                    <path class="chart-current" d="@BuildSpeedPath(static sample => sample.MeasuredSpeedKph)" />
                    @if (session.Samples.LastOrDefault() is { } latest)
                    {
                        <circle class="chart-marker" cx="@ChartX(latest.Elapsed)" cy="@ChartY(latest.MeasuredSpeedKph)" r="5" />
                    }
                </svg>
                <div></div>
                <div class="chart-time-scale" aria-label="Elapsed time axis" data-midpoint="@FormatAxisTime(TimeSpan.FromTicks(ChartDuration.Ticks / 2))">
                    @foreach (ChartTimeTick tick in ChartTimeTicks)
                    {
                        <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatAxisTime(tick.Elapsed)</span>
                    }
                </div>
            </div>
            <div class="legend" aria-label="Chart legend"><span><i class="legend-line legend-line--plan"></i>Planned</span><span><i class="legend-line legend-line--requested"></i>Requested</span><span><i class="legend-line legend-line--measured"></i>Measured</span></div>
            <p>@session.Samples.Count persisted one-second sample(s). The chart is generated from the stored planned, requested, and measured speed values.</p>
        </section>

        <details class="panel-card advanced-settings">
            <summary>Time in heart-rate zones</summary>
            @if (session.Analytics.HeartRateZones.Count == 0)
            {
                <p>No heart-rate zone snapshot is available for this session.</p>
            }
            else
            {
                <dl class="zone-list">
                    @foreach (HeartRateZoneDuration zone in session.Analytics.HeartRateZones)
                    {
                        <div><dt>Zone @zone.ZoneNumber · @zone.Name</dt><dd>@zone.Duration.ToString(@"hh\:mm\:ss")</dd></div>
                    }
                </dl>
            }
            <p><strong>Plan adherence:</strong> @session.Analytics.AdherencePercentage.ToString("0.0")%</p>
        </details>

        <details class="panel-card advanced-settings">
            <summary>Session events</summary>
            <p class="event-counts">@session.Analytics.EventCounts.ManualSpeedOverrides speed override(s) · @session.Analytics.EventCounts.ManualInclineOverrides incline override(s) · @session.Analytics.EventCounts.Pauses pause(s) · @session.Analytics.EventCounts.Disconnects disconnect(s) · @session.Analytics.EventCounts.Warnings warning(s)</p>
            @if (session.Events.Count == 0)
            {
                <p>No overrides, pauses, disconnects, or warnings were recorded.</p>
            }
            else
            {
                <ol class="event-list">
                    @foreach (System.Text.Json.JsonElement sessionEvent in session.Events)
                    {
                        <li>@EventLabel(sessionEvent)</li>
                    }
                </ol>
            }
        </details>

        <details class="panel-card advanced-settings">
            <summary>Runner debrief</summary>
            <p><strong>RPE:</strong> @(session.Debrief?.PerceivedExertion?.ToString() ?? "Not recorded")</p>
            <p>@(session.Debrief?.Note ?? "No note was added.")</p>
        </details>
    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }
    private StoredWorkoutSessionView? session;
    private int speedAxisMaximum = 10;
    private HistoryDeletionPreview? deletionPreview;
    private Guid deletionOperationId;
    private bool previewLoading;
    private bool deleting;
    private string deletionMessage = string.Empty;
    private RecommendationView? recommendation;
    private ComparisonView? comparison;
    private bool recommendationBusy;
    private string recommendationMessage = string.Empty;
    private bool loading = true;
    private string? loadError;
    private bool localInsightsLoading;
    private string? localInsightsMessage;
    private string AverageHeartRateLabel => session?.AverageHeartRateBpm is { } heartRate ? $"{heartRate:0} bpm" : "Not recorded";

    protected override async Task OnParametersSetAsync()
    {
        await LoadSessionAsync();
    }

    private async Task LoadSessionAsync()
    {
        loading = true;
        loadError = null;
        session = null;
        recommendation = null;
        comparison = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync($"api/history/{SessionId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
            if (!response.IsSuccessStatusCode)
            {
                loadError = "Session detail could not be loaded from the local gateway.";
                return;
            }
            session = await response.Content.ReadFromJsonAsync<StoredWorkoutSessionView>();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            loadError = "Session detail could not be loaded from the local gateway. No stored data was changed.";
            return;
        }
        finally
        {
            loading = false;
        }

        double observedMaximum = session?.Samples.Count is > 0
            ? session.Samples.SelectMany(static sample => new[] { sample.PlannedSpeedKph ?? 0, sample.RequestedSpeedKph, sample.MeasuredSpeedKph }).Max()
            : 0;
        speedAxisMaximum = (int)Math.Ceiling(Math.Max(10, observedMaximum));
        if (session is not null)
        {
            await LoadLocalInsightsAsync();
        }
    }

    private async Task LoadLocalInsightsAsync()
    {
        if (session is null) return;
        localInsightsLoading = true;
        localInsightsMessage = null;
        try
        {
            comparison = await Http.GetFromJsonAsync<ComparisonView>($"api/local-first/profiles/{session.Definition.UserProfileId}/comparisons/{SessionId}");
            RecommendationView[] existing = await Http.GetFromJsonAsync<RecommendationView[]>($"api/local-first/profiles/{session.Definition.UserProfileId}/recommendations") ?? [];
            recommendation = existing.FirstOrDefault(item => item.SessionId == SessionId);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            localInsightsMessage = "Comparison and adviser receipts are temporarily unavailable. The session itself is still available.";
        }
        finally
        {
            localInsightsLoading = false;
        }
    }

    private async Task CreateRecommendationAsync()
    {
        if (session is null) return;
        recommendationBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/local-first/profiles/{session.Definition.UserProfileId}/recommendations", new { OperationId = Guid.NewGuid(), SessionId });
            recommendation = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<RecommendationView>() : null;
            recommendationMessage = response.IsSuccessStatusCode ? "Suggestion stored locally for review." : "A suggestion could not be created from this session.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            recommendationMessage = "The local gateway could not create a suggestion. No plan or workout was changed.";
        }
        finally { recommendationBusy = false; }
    }

    private async Task DecideRecommendationAsync(bool accepted)
    {
        if (session is null || recommendation is null) return;
        recommendationBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/local-first/profiles/{session.Definition.UserProfileId}/recommendations/{recommendation.Id}/decision", new { Accepted = accepted, ExpectedVersion = recommendation.Version });
            if (response.IsSuccessStatusCode) recommendation = await response.Content.ReadFromJsonAsync<RecommendationView>();
            recommendationMessage = response.IsSuccessStatusCode
                ? accepted ? "Accepted decision recorded. The active plan and immutable workout remain unchanged." : "Rejected decision recorded; the receipt was retained."
                : "The decision could not be recorded. The active plan and workout remain unchanged.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            recommendationMessage = "The local gateway could not record the decision. The active plan and workout remain unchanged.";
        }
        finally { recommendationBusy = false; }
    }

    private sealed record RecommendationValue(string Action, string Reason, string AlgorithmVersion);
    private sealed record RecommendationView(Guid Id, Guid ProfileId, Guid SessionId, RecommendationValue Recommendation, string Status, int Version, DateTimeOffset CreatedAtUtc, DateTimeOffset? DecidedAtUtc);
    private sealed record ComparisonView(Guid WorkoutRevisionId, int ComparisonCount, SessionSummary? Previous, string Explanation);
    private static string FormatDelta(TimeSpan value) =>
        $"{(value < TimeSpan.Zero ? "−" : value > TimeSpan.Zero ? "+" : string.Empty)}{value.Duration().ToString(@"hh\:mm\:ss")}";

    private async Task LoadDeletionPreviewAsync()
    {
        if (session is null) return;
        deletionMessage = string.Empty;
        previewLoading = true;
        try
        {
            deletionOperationId = Guid.NewGuid();
            deletionPreview = await Http.GetFromJsonAsync<HistoryDeletionPreview>(
                $"api/history/{SessionId}/deletion-preview?profileId={session.Definition.UserProfileId}");
            if (deletionPreview is null) deletionMessage = "The deletion preview is unavailable. No local data was changed.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            deletionPreview = null;
            deletionMessage = "The gateway is unavailable. No local data was changed.";
        }
        finally { previewLoading = false; }
    }

    private async Task DeleteSessionAsync()
    {
        if (session is null || deletionPreview is null || !deletionPreview.CanDelete) return;
        deleting = true;
        deletionMessage = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/history/{SessionId}/delete", new
            {
                operationId = deletionOperationId,
                profileId = session.Definition.UserProfileId,
                expectedRevision = deletionPreview.Revision,
                confirmed = true,
            });
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/history", replace: true);
                return;
            }
            deletionMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "The session or upload state changed. Review the deletion preview again."
                : "The local session could not be deleted.";
        }
        catch (HttpRequestException)
        {
            deletionMessage = "The gateway is unavailable. No local data was deleted.";
        }
        finally { deleting = false; }
    }

    private void CancelDeletion()
    {
        deletionPreview = null;
        deletionMessage = string.Empty;
        deletionOperationId = Guid.Empty;
    }

    private string BuildSpeedPath(Func<SessionSample, double?> selector)
    {
        if (session?.Samples.Count is null or 0) return string.Empty;

        IReadOnlyList<SessionSample> points = RenderSamples(session.Samples);
        var path = new StringBuilder();
        bool started = false;
        foreach (SessionSample point in points)
        {
            if (selector(point) is not { } speed)
            {
                started = false;
                continue;
            }
            double x = ChartX(point.Elapsed);
            double y = ChartY(speed);
            path.Append(started ? " L" : "M");
            path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
            started = true;
        }

        return path.ToString();
    }

    private static IReadOnlyList<SessionSample> RenderSamples(IReadOnlyList<SessionSample> samples)
    {
        const int maximumRenderedPoints = 720;
        if (samples.Count <= maximumRenderedPoints) return samples;
        const int bucketCount = maximumRenderedPoints / 12;
        int bucketSize = (int)Math.Ceiling(samples.Count / (double)bucketCount);
        var selected = new List<SessionSample>(maximumRenderedPoints);
        for (int start = 0; start < samples.Count; start += bucketSize)
        {
            SessionSample[] bucket = samples.Skip(start).Take(Math.Min(bucketSize, samples.Count - start)).ToArray();
            var extrema = new List<SessionSample>
            {
                bucket[0], bucket[^1],
                bucket.MinBy(static sample => sample.MeasuredSpeedKph)!, bucket.MaxBy(static sample => sample.MeasuredSpeedKph)!,
                bucket.MinBy(static sample => sample.RequestedSpeedKph)!, bucket.MaxBy(static sample => sample.RequestedSpeedKph)!,
            };
            SessionSample[] planned = bucket.Where(static sample => sample.PlannedSpeedKph is not null).ToArray();
            if (planned.Length > 0)
            {
                extrema.Add(planned.MinBy(static sample => sample.PlannedSpeedKph)!);
                extrema.Add(planned.MaxBy(static sample => sample.PlannedSpeedKph)!);
            }
            int[] transitions = Enumerable.Range(1, bucket.Length - 1)
                .Where(index => bucket[index - 1].PlannedSpeedKph.HasValue != bucket[index].PlannedSpeedKph.HasValue)
                .ToArray();
            foreach (int transition in transitions.Length <= 2 ? transitions : new[] { transitions[0], transitions[^1] })
            {
                extrema.Add(bucket[transition - 1]);
                extrema.Add(bucket[transition]);
            }
            selected.AddRange(extrema.Distinct().OrderBy(static sample => sample.Elapsed));
        }
        return selected;
    }

    private int SpeedAxisMaximum => speedAxisMaximum;

    private IEnumerable<int> SpeedAxisTicks => Enumerable.Range(1, SpeedAxisMaximum).Reverse();
    private double ChartX(TimeSpan elapsed) => 10 + (Math.Clamp(elapsed.TotalSeconds / Math.Max(1, ChartDuration.TotalSeconds), 0, 1) * 700);
    private double ChartY(double speed) => 210 - (Math.Clamp(speed / SpeedAxisMaximum, 0, 1) * 200);

    private TimeSpan ChartDuration => session is null
        ? TimeSpan.Zero
        : session.Samples.Count > 0 && session.Samples[^1].Elapsed > session.Duration
            ? session.Samples[^1].Elapsed
            : session.Duration;

    private IReadOnlyList<ChartTimeTick> ChartTimeTicks
    {
        get
        {
            TimeSpan duration = ChartDuration;
            double minutes = duration.TotalMinutes;
            int intervalMinutes = AxisIntervalMinutes(minutes);
            var ticks = new List<ChartTimeTick> { new(TimeSpan.Zero, 0) };
            for (double minute = intervalMinutes; minute < minutes; minute += intervalMinutes)
            {
                TimeSpan elapsed = TimeSpan.FromMinutes(minute);
                ticks.Add(new ChartTimeTick(elapsed, elapsed.TotalSeconds / Math.Max(1, duration.TotalSeconds) * 100));
            }
            if (ticks.Count > 1 && (duration - ticks[^1].Elapsed).TotalMinutes < intervalMinutes * .75) ticks.RemoveAt(ticks.Count - 1);
            if (duration > TimeSpan.Zero) ticks.Add(new ChartTimeTick(duration, 100));
            return ticks;
        }
    }

    private static string FormatAxisTime(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm", CultureInfo.InvariantCulture)
        : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);

    private static int AxisIntervalMinutes(double durationMinutes)
    {
        double desired = durationMinutes / 5;
        return desired <= 1 ? 1 : desired <= 2 ? 2 : desired <= 5 ? 5 : desired <= 10 ? 10 : desired <= 15 ? 15 : 30;
    }

    private sealed record ChartTimeTick(TimeSpan Elapsed, double PositionPercent);

    private static string EventLabel(System.Text.Json.JsonElement sessionEvent)
    {
        string eventType = sessionEvent.TryGetProperty("eventType", out var type) ? type.GetString() ?? "event" : "event";
        if (eventType == "manual-speed-override" &&
            sessionEvent.TryGetProperty("previousSpeedKph", out var previous) &&
            sessionEvent.TryGetProperty("requestedSpeedKph", out var requested))
        {
            return $"Manual speed override: {previous.GetDouble():0.0} → {requested.GetDouble():0.0} km/h";
        }

        if (eventType == "manual-incline-override" &&
            sessionEvent.TryGetProperty("previousInclinePercent", out var previousIncline) &&
            sessionEvent.TryGetProperty("requestedInclinePercent", out var requestedIncline))
        {
            return $"Manual incline override: {previousIncline.GetDouble():0.0} → {requestedIncline.GetDouble():0.0}%";
        }

        return eventType switch
        {
            "physical-movement-detected" or "session-warning" when sessionEvent.TryGetProperty("message", out var message) => message.GetString() ?? "Session warning",
            "workout-step-transition" => "Workout step changed",
            "session-completed" => "Session completed",
            _ => eventType.Replace('-', ' '),
        };
    }
}
