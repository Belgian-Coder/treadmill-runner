@page "/history/{SessionId:guid}"
@using TreadmillRunner.Web.Live
@using System.Globalization
@using System.Text
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Session detail · TreadmillRunner</PageTitle>

@if (loading)
{
    <p class="empty-state" role="status">Loading session detail…</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="empty-state" role="alert">
        <p>@loadError</p>
        <button class="secondary-action" type="button" @onclick="LoadSessionAsync">Try again</button>
    </div>
}
else if (session is null)
{
    <div class="empty-state"><p>This local session was not found. It may have been deleted.</p><a class="secondary-action" href="/history">Back to history</a></div>
}
else
{
    <section class="page-stack" aria-labelledby="session-title">
        <header class="page-heading">
            <div><p class="eyebrow">@session.State · @session.Definition.UserProfileName</p><h1 id="session-title">@session.Definition.WorkoutTitle</h1></div>
        </header>

        <section class="history-summary-grid">
            <article><span>Duration</span><strong>@session.Duration.ToString(@"hh\:mm\:ss")</strong></article>
            <article><span>Distance</span><strong>@session.DistanceKilometers.ToString("0.00") km</strong></article>
            <article><span>Estimated kcal</span><strong>@session.EstimatedKilocalories.ToString("0")</strong></article>
            <article><span>Average HR</span><strong>@AverageHeartRateLabel</strong></article>
            <article><span>Elevation gain</span><strong>@session.TotalAscentMeters.ToString("0.0") m</strong></article>
            <article><span>Elevation loss</span><strong>@session.TotalDescentMeters.ToString("0.0") m</strong></article>
        </section>
        @if (comparison is { } sameRevision)
        {
            <section class="panel-card" aria-labelledby="comparison-title">
                <div class="panel-heading"><div><p class="eyebrow">Same saved workout revision</p><h2 id="comparison-title">Previous comparison</h2></div><span>@sameRevision.ComparisonCount prior</span></div>
                @if (sameRevision.Previous is { } previous)
                {
                    <div class="weekly-summary">
                        <article><span>Time change</span><strong>@FormatDelta(session.Duration - previous.Duration)</strong></article>
                        <article><span>Distance change</span><strong>@((session.DistanceKilometers - previous.DistanceKilometers).ToString("+0.00;-0.00;0.00")) km</strong></article>
                        <article><span>Previous avg speed</span><strong>@previous.AverageSpeedKph.ToString("0.0") km/h</strong></article>
                    </div>
                }
                <p class="field-hint">@sameRevision.Explanation</p>
            </section>
        }
        <section class="panel-card debrief-card" aria-labelledby="debrief-title">
            <div class="panel-heading">
                <div><p class="eyebrow">Post-run debrief</p><h2 id="debrief-title">How did this run feel?</h2></div>
                @if (!debriefEditing && session.Debrief is not null)
                {
                    <button class="secondary-action compact-action" type="button" @onclick="EditDebrief">Edit</button>
                }
            </div>
            @if (debriefEditing)
            {
                <div class="form-grid">
                    <label class="field">Effort (RPE 1–10)
                        <input aria-label="Perceived exertion" @bind="debriefPerceivedExertion" type="number" min="1" max="10" placeholder="Optional" />
                    </label>
                    <label class="field field--wide">Note
                        <textarea aria-label="Debrief note" @bind="debriefNote" maxlength="1000" rows="4" placeholder="Optional notes about effort, comfort, or conditions"></textarea>
                        <small>@debriefNote.Length / 1000</small>
                    </label>
                </div>
                <div class="form-actions">
                    <button class="primary-action" type="button" disabled="@debriefBusy" @onclick="() => SaveDebriefAsync(false)">@(debriefBusy ? "Saving…" : "Save debrief")</button>
                    <button class="secondary-action" type="button" disabled="@debriefBusy" @onclick="() => SaveDebriefAsync(true)">Skip</button>
                    @if (session.Debrief is not null)
                    {
                        <button class="secondary-action" type="button" disabled="@debriefBusy" @onclick="CancelDebriefEdit">Cancel</button>
                    }
                </div>
            }
            else if (session.Debrief is { } debrief)
            {
                <dl class="device-facts">
                    <div><dt>Perceived effort</dt><dd>@(debrief.PerceivedExertion is { } rpe ? $"{rpe} / 10" : "Skipped")</dd></div>
                    <div><dt>Updated</dt><dd>@debrief.UpdatedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</dd></div>
                </dl>
                <p>@(debrief.Note ?? "No note added.")</p>
            }
            @if (!string.IsNullOrWhiteSpace(debriefMessage))
            {
                <p role="status">@debriefMessage</p>
            }
        </section>
        <section class="controls-card session-export-actions" aria-label="Session exports">
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.csv")" download>Download CSV</a>
            @if (shareSupported)
            {
                <button class="secondary-action" type="button" disabled="@shareBusy" @onclick="ShareCsvAsync">Share CSV</button>
            }
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.fit")" download>Download FIT Activity</a>
            @if (shareSupported)
            {
                <button class="secondary-action" type="button" disabled="@shareBusy" @onclick="ShareFitAsync">Share FIT Activity</button>
            }
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.tcx")" download>Download TCX Activity</a>
            <a class="secondary-action" href="@($"/api/history/{SessionId}/export.json")" download>Download native JSON</a>
            <button class="touch-action danger-action" type="button" disabled="@previewLoading" @onclick="LoadDeletionPreviewAsync">@(previewLoading ? "Checking…" : "Delete local session")</button>
        </section>
        @if (!string.IsNullOrWhiteSpace(shareMessage))
        {
            <p class="action-status" role="status" aria-live="polite">@shareMessage</p>
        }
        @if (session.Garmin is { } garmin)
        {
            <section class="panel-card garmin-status-card" aria-labelledby="garmin-reconciliation-title">
                <div class="panel-heading">
                    <div><p class="eyebrow">Garmin activity</p><h2 id="garmin-reconciliation-title">@GarminStatusTitle(garmin)</h2></div>
                </div>
                @if (garminRecovery is { Busy: true } busyRecovery)
                {
                    <div class="controls-card garmin-acknowledgement" role="status">
                        <p>@busyRecovery.Message</p>
                        <button class="touch-action secondary-action" type="button" disabled="@loading" @onclick="LoadSessionAsync">Refresh status</button>
                    </div>
                }
                else if (garminRecovery is { Available: true } recovery)
                {
                    <div class="controls-card garmin-acknowledgement">
                        <p><strong>Choose how this run appears in Garmin</strong></p>
                        <p>Your run stays in TreadmillRunner either way. Only the Garmin activities are changed.</p>
                        @if (string.IsNullOrWhiteSpace(garminRecoveryChoice))
                        {
                            <div class="garmin-choice-grid">
                                <div>
                                    <button class="touch-action primary-action" type="button" disabled="@(garminActionBusy || !recovery.CanMergeIntoOne)" @onclick='() => SelectGarminRecovery("MergeIntoOne")'>Keep one Garmin activity</button>
                                    <small>Keep the verified combined activity and remove proven duplicates.</small>
                                </div>
                                <div>
                                    <button class="touch-action secondary-action" type="button" disabled="@(garminActionBusy || !recovery.CanUndoMerge)" @onclick='() => SelectGarminRecovery("UndoMerge")'>Restore two Garmin activities</button>
                                    <small>Restore the original watch activity beside the verified TreadmillRunner activity.</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="inline-confirmation" role="alert">
                                <p>@GarminRecoveryConfirmationText</p>
                                <div class="form-actions">
                                    <button class="touch-action primary-action" type="button" disabled="@garminActionBusy" @onclick="StartGarminRecoveryAsync">@(garminActionBusy ? "Starting…" : "Confirm")</button>
                                    <button class="touch-action secondary-action" type="button" disabled="@garminActionBusy" @onclick="CancelGarminRecovery">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (garminRecovery is { } unavailableRecovery)
                {
                    <p class="field-hint" role="status">@unavailableRecovery.Message</p>
                }
                @if (garmin.Status == "Unknown" && garminRecovery?.Available != true)
                {
                    <div class="controls-card garmin-acknowledgement" role="status">
                        <p><strong>Can you see this run in Garmin?</strong> Mark it as found to settle the local status. This does not change Garmin.</p>
                        <button class="touch-action primary-action" type="button" disabled="@garminActionBusy" @onclick="AcknowledgeGarminFoundAsync">@(garminActionBusy ? "Saving…" : "I found it in Garmin")</button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(garminActionMessage))
                {
                    <p class="action-status" role="status" aria-live="polite">@garminActionMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(garmin.LastError))
                {
                    <p class="field-error">@garmin.LastError</p>
                }
                <details class="garmin-technical-details">
                    <summary>Technical details</summary>
                    <dl class="device-facts">
                        <div><dt>Status</dt><dd>@garmin.Status</dd></div>
                        <div><dt>Operation phase</dt><dd>@garmin.OperationPhase</dd></div>
                        <div><dt>Failure phase</dt><dd>@(garmin.FailureKind ?? "None")</dd></div>
                        <div><dt>Updated</dt><dd>@garmin.UpdatedAtUtc.ToLocalTime().ToString("d MMM yyyy · HH:mm:ss")</dd></div>
                        <div><dt>Retry time</dt><dd>@FormatOptionalTimestamp(garmin.RetryAtUtc)</dd></div>
                        <div><dt>Acknowledged</dt><dd>@FormatOptionalTimestamp(garmin.AcknowledgedAtUtc)</dd></div>
                        <div><dt>Retry eligible</dt><dd>@(garmin.CanRetry ? "Yes" : "No")</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(garmin.MatchEvidence))
                    {
                        <p><strong>Match evidence:</strong> @garmin.MatchEvidence</p>
                    }
                    <div class="form-grid">
                        <label class="field field--wide">Upload job ID
                            <span class="field-inline"><input readonly value="@garmin.Id" /><button class="secondary-action compact-action" type="button" @onclick="CopyGarminJobIdAsync">Copy</button></span>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(garmin.RemoteId))
                        {
                            <label class="field field--wide">Garmin activity ID
                                <span class="field-inline"><input readonly value="@garmin.RemoteId" /><button class="secondary-action compact-action" type="button" @onclick="CopyGarminRemoteIdAsync">Copy</button></span>
                            </label>
                        }
                        @if (!string.IsNullOrWhiteSpace(garmin.MatchedRemoteId))
                        {
                            <label class="field field--wide">Matched activity ID
                                <span class="field-inline"><input readonly value="@garmin.MatchedRemoteId" /><button class="secondary-action compact-action" type="button" @onclick="CopyGarminMatchedIdAsync">Copy</button></span>
                            </label>
                        }
                        @if (!string.IsNullOrWhiteSpace(garmin.ReplacementRemoteId))
                        {
                            <label class="field field--wide">Replacement activity ID
                                <span class="field-inline"><input readonly value="@garmin.ReplacementRemoteId" /><button class="secondary-action compact-action" type="button" @onclick="CopyGarminReplacementIdAsync">Copy</button></span>
                            </label>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(identifierCopyMessage))
                    {
                        <p class="field-hint" role="status">@identifierCopyMessage</p>
                    }
                </details>
            </section>
        }
        @if (deletionPreview is null && !string.IsNullOrWhiteSpace(deletionMessage))
        {
            <p class="field-error" role="status">@deletionMessage</p>
        }

        @if (deletionPreview is not null)
        {
            <section class="panel-card deletion-preview" aria-labelledby="deletion-preview-title">
                <h2 id="deletion-preview-title">Permanent deletion preview</h2>
                <p>@deletionPreview.Reason</p>
                <dl class="device-facts">
                    <div><dt>Samples</dt><dd>@deletionPreview.SampleCount</dd></div>
                    <div><dt>Events</dt><dd>@deletionPreview.EventCount</dd></div>
                    <div><dt>Origin</dt><dd>@deletionPreview.Origin</dd></div>
                    <div><dt>Garmin</dt><dd>@(deletionPreview.GarminStatus ?? "No upload job")</dd></div>
                </dl>
                @if (deletionPreview.MaintenanceDistanceImpactKilometers > 0)
                {
                    <p class="field-error">Deleting this record removes @deletionPreview.MaintenanceDistanceImpactKilometers.ToString("0.00") km from the app-tracked maintenance total.</p>
                }
                @if (deletionPreview.GarminRemoteActivityMayRemain)
                {
                    <p class="field-error"><strong>This deletes local data only.</strong> Delete any uploaded test activity separately in Garmin Connect.</p>
                }
                <div class="form-actions">
                    <button class="touch-action danger-action" type="button" disabled="@(!deletionPreview.CanDelete || deleting)" @onclick="DeleteSessionAsync">@(deleting ? "Deleting…" : "Permanently delete")</button>
                    <button class="touch-action secondary-action" type="button" @onclick="CancelDeletion">Cancel</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(deletionMessage)) { <p class="field-error" role="status">@deletionMessage</p> }
            </section>
        }

        <section class="route-card">
            <h2>Planned versus actual</h2>
            <div class="chart-plot-grid chart-plot-grid--dual">
                <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@SpeedAxisMaximum, 1fr)">
                    <strong class="chart-axis-unit">km/h</strong>
                    @foreach (int tick in SpeedAxisTicks)
                    {
                        <span>@tick</span>
                    }
                </div>
                <ChartInspector Series="@SpeedInclineInspectionSeries" PointFactory="@GetSpeedInclineInspectionPoints" ProjectionVersion="@Projection.Version" AriaLabel="Interactive historical speed and incline chart. Hover, touch and drag, or use Left and Right arrow keys to inspect every plotted value.">
                    <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Historical speed and incline over elapsed time">
                        @foreach (int tick in SpeedAxisTicks)
                        {
                            double y = ChartY(tick, SpeedAxisMaximum);
                            <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                        }
                        <path class="chart-plan" data-series="planned-speed" d="@Projection.PlannedSpeedPath" />
                        <path class="chart-requested" data-series="requested-speed" d="@Projection.RequestedSpeedPath" />
                        <path class="chart-current" data-series="measured-speed" d="@Projection.MeasuredSpeedPath" />
                        <path class="chart-plan chart-plan--incline" data-series="planned-incline" d="@Projection.PlannedInclinePath" />
                        <path class="chart-requested chart-requested--incline" data-series="requested-incline" d="@Projection.RequestedInclinePath" />
                        <path class="chart-current chart-current--incline" data-series="measured-incline" d="@Projection.MeasuredInclinePath" />
                        @if (session.Samples.LastOrDefault() is { } latest)
                        {
                            <circle class="chart-marker" cx="@ChartX(latest.Elapsed)" cy="@ChartY(latest.MeasuredSpeedKph, SpeedAxisMaximum)" r="5" />
                        }
                    </svg>
                </ChartInspector>
                <div class="chart-y-scale chart-y-scale--ticks chart-y-scale--secondary" aria-label="Incline axis in percent" style="grid-template-rows: repeat(@InclineAxisMaximum, 1fr)">
                    <strong class="chart-axis-unit">%</strong>
                    @foreach (int tick in InclineAxisTicks)
                    {
                        <span>@tick</span>
                    }
                </div>
                <div></div>
                <div class="chart-time-scale" aria-label="Elapsed time axis" data-midpoint="@FormatAxisTime(TimeSpan.FromTicks(ChartDuration.Ticks / 2))">
                    @foreach (ChartTimeTick tick in ChartTimeTicks)
                    {
                        <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatAxisTime(tick.Elapsed)</span>
                    }
                </div>
                <div></div>
            </div>
            <div class="control-chart-legend" aria-label="Chart legend">
                <span class="control-chart-legend__group" aria-label="Speed legend"><strong>Speed</strong><span><i class="legend-line legend-line--plan"></i>Planned</span><span><i class="legend-line legend-line--requested"></i>Requested</span><span><i class="legend-line legend-line--measured"></i>Measured</span></span>
                <span class="control-chart-legend__group" aria-label="Incline legend"><strong>Incline</strong><span><i class="legend-line legend-line--plan legend-line--incline-plan"></i>Planned</span><span><i class="legend-line legend-line--requested legend-line--incline-target"></i>Requested</span><span><i class="legend-line legend-line--measured legend-line--incline-measured"></i>Measured</span></span>
            </div>
            <p>@HistoryGraphSampleSummary The chart is generated from the stored planned, requested, and measured speed and incline values; full-resolution data remains available in the exports.</p>
        </section>

        <section class="route-card">
            <h2>Heart rate</h2>
            @if (!HasHeartRateSamples)
            {
                <p>No heart-rate readings were recorded for this session.</p>
            }
            else
            {
                <div class="chart-plot-grid chart-plot-grid--dual">
                    <div class="chart-y-scale chart-y-scale--ticks" aria-label="Heart rate axis in beats per minute" style="grid-template-rows: repeat(@HeartRateAxisTicks.Count(), 1fr)">
                        <strong class="chart-axis-unit">bpm</strong>
                        @foreach (int tick in HeartRateAxisTicks)
                        {
                            <span>@tick</span>
                        }
                    </div>
                    <ChartInspector Series="@HeartRateInspectionSeries" PointFactory="@GetHeartRateInspectionPoints" ProjectionVersion="@Projection.Version" AriaLabel="Interactive historical heart-rate chart. Hover, touch and drag, or use Left and Right arrow keys to inspect heart rate.">
                        <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Historical heart rate over elapsed time">
                            @foreach (int tick in HeartRateAxisTicks)
                            {
                                double y = HeartRateChartY(tick);
                                <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                            }
                            @foreach (SessionHeartRateZoneSnapshot zone in HeartRateBoundaryZones)
                            {
                                double y = HeartRateChartY(zone.MinimumBpm);
                                double labelY = Math.Clamp(y - 5, 12, 208);
                                <g class="chart-zone-boundary-group" data-zone-boundary="@zone.Number" role="img" aria-label="Zone @zone.Number · @zone.Name starts at @zone.MinimumBpm bpm">
                                    <line class="chart-zone-boundary" x1="10" y1="@y" x2="710" y2="@y" />
                                    <text class="chart-zone-label" x="16" y="@labelY" dominant-baseline="middle" aria-hidden="true">Zone @zone.Number · @zone.MinimumBpm</text>
                                </g>
                            }
                            <path class="chart-current chart-current--heart-rate" data-series="heart-rate" d="@Projection.HeartRatePath" />
                        </svg>
                    </ChartInspector>
                    <div></div>
                    <div></div>
                    <div class="chart-time-scale" aria-label="Heart rate elapsed time axis" data-midpoint="@FormatAxisTime(TimeSpan.FromTicks(ChartDuration.Ticks / 2))">
                        @foreach (ChartTimeTick tick in ChartTimeTicks)
                        {
                            <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatAxisTime(tick.Elapsed)</span>
                        }
                    </div>
                    <div></div>
                </div>
                <div class="control-chart-legend" aria-label="Heart rate chart legend">
                    <span class="control-chart-legend__group"><strong>Heart rate</strong><span><i class="legend-line legend-line--heart-rate"></i>Measured</span></span>
                </div>
                <p>The graph uses the stored heart-rate readings from this workout. Gaps indicate periods without a valid sensor reading.</p>
            }
        </section>

        <details class="panel-card advanced-settings">
            <summary>Time in heart-rate zones</summary>
            @if (session.Analytics.HeartRateZones.Count == 0)
            {
                <p>No heart-rate zone snapshot is available for this session.</p>
            }
            else
            {
                <dl class="zone-list">
                    @foreach (HeartRateZoneDuration zone in session.Analytics.HeartRateZones)
                    {
                        <div><dt>Zone @zone.ZoneNumber · @zone.Name</dt><dd>@zone.Duration.ToString(@"hh\:mm\:ss")</dd></div>
                    }
                </dl>
            }
            <p><strong>Plan adherence:</strong> @session.Analytics.AdherencePercentage.ToString("0.0")%</p>
        </details>

        <details class="panel-card advanced-settings">
            <summary>Session events</summary>
            <p class="event-counts">@session.Analytics.EventCounts.ManualSpeedOverrides speed override(s) · @session.Analytics.EventCounts.ManualInclineOverrides incline override(s) · @session.Analytics.EventCounts.Pauses pause(s) · @session.Analytics.EventCounts.Disconnects disconnect(s) · @session.Analytics.EventCounts.Warnings warning(s)</p>
            @if (session.Events.Count == 0)
            {
                <p>No overrides, pauses, disconnects, or warnings were recorded.</p>
            }
            else
            {
                <ol class="event-list">
                    @foreach (System.Text.Json.JsonElement sessionEvent in session.Events)
                    {
                        <li>@EventLabel(sessionEvent)</li>
                    }
                </ol>
            }
        </details>

    </section>
}

@code {
    [Parameter] public Guid SessionId { get; set; }
    private static readonly IReadOnlyList<ChartInspectionSeries> SpeedInclineInspectionSeries =
    [
        new("Speed", "Plan", "km/h", 1, "legend-line--plan"),
        new("Speed", "Target", "km/h", 1, "legend-line--requested"),
        new("Speed", "Measured", "km/h", 1, "legend-line--measured"),
        new("Incline", "Plan", "%", 1, "legend-line--incline-plan"),
        new("Incline", "Target", "%", 1, "legend-line--incline-target"),
        new("Incline", "Measured", "%", 1, "legend-line--incline-measured"),
    ];
    private static readonly IReadOnlyList<ChartInspectionSeries> HeartRateInspectionSeries =
    [
        new("Heart rate", "Measured", "bpm", 0, "legend-line--heart-rate"),
    ];
    private StoredWorkoutSessionView? session;
    private readonly SessionChartProjectionCache projectionCache = new();
    private SessionChartProjection Projection => projectionCache.Get(session!);
    private HistoryDeletionPreview? deletionPreview;
    private Guid deletionOperationId;
    private bool previewLoading;
    private bool deleting;
    private string deletionMessage = string.Empty;
    private ComparisonView? comparison;
    private bool loading = true;
    private string? loadError;
    private bool shareSupported;
    private bool shareBusy;
    private string? shareMessage;
    private int? debriefPerceivedExertion;
    private string debriefNote = string.Empty;
    private bool debriefEditing;
    private bool debriefBusy;
    private string? debriefMessage;
    private string? identifierCopyMessage;
    private bool garminActionBusy;
    private string garminActionMessage = string.Empty;
    private GarminHistoricalRecoveryView? garminRecovery;
    private string garminRecoveryChoice = string.Empty;
    private string GarminRecoveryConfirmationText => garminRecoveryChoice == "UndoMerge"
        ? "Restore two Garmin activities? The app will restore the original watch activity and one verified TreadmillRunner activity, then remove only proven merged or duplicate copies. Your local History remains unchanged."
        : "Keep one Garmin activity? The app will keep the verified combined activity in Garmin and remove only the backed-up original and proven duplicates. Your local History remains unchanged.";
    private string AverageHeartRateLabel => session?.AverageHeartRateBpm is { } heartRate ? $"{heartRate:0} bpm" : "Not recorded";
    private bool HasHeartRateSamples => session?.Samples.Any(static sample => sample.HeartRateBpm is not null) == true;
    private string HistoryGraphSampleSummary => session is null
        ? "No telemetry samples were persisted."
        : session.SamplesAreDownsampled
            ? $"Showing {session.Samples.Count:N0} representative graph samples from {session.PersistedSampleCount:N0} persisted one-second samples."
            : $"{session.PersistedSampleCount:N0} persisted one-second sample(s).";

    protected override async Task OnParametersSetAsync()
    {
        await LoadSessionAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            PwaStatusModel status = await JS.InvokeAsync<PwaStatusModel>("treadmillRunnerPwa.getStatus");
            shareSupported = status.ShareSupported;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            shareSupported = false;
        }
    }

    private async Task ShareSessionAsync(string extension, string mimeType)
    {
        shareBusy = true;
        shareMessage = null;
        try
        {
            PwaActionResult result = await JS.InvokeAsync<PwaActionResult>(
                "treadmillRunnerPwa.shareOrDownload",
                $"/api/history/{SessionId}/export.{extension}",
                $"treadmillrunner-session-{SessionId}.{extension}",
                $"TreadmillRunner session {extension.ToUpperInvariant()}");
            shareMessage = result.State == "Canceled" ? null : result.Message;
        }
        catch (JSException)
        {
            shareMessage = $"The browser could not share the {mimeType} file. Use Download instead.";
        }
        finally
        {
            shareBusy = false;
        }
    }

    private Task ShareCsvAsync() => ShareSessionAsync("csv", "CSV");
    private Task ShareFitAsync() => ShareSessionAsync("fit", "FIT Activity");

    private async Task LoadSessionAsync()
    {
        loading = true;
        loadError = null;
        session = null;
        garminRecovery = null;
        garminRecoveryChoice = string.Empty;
        comparison = null;
        debriefPerceivedExertion = null;
        debriefNote = string.Empty;
        debriefEditing = false;
        debriefMessage = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync($"api/history/{SessionId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound) return;
            if (!response.IsSuccessStatusCode)
            {
                loadError = "Session detail could not be loaded from the local gateway.";
                return;
            }
            session = await response.Content.ReadFromJsonAsync<StoredWorkoutSessionView>();
            debriefPerceivedExertion = session?.Debrief?.PerceivedExertion;
            debriefNote = session?.Debrief?.Note ?? string.Empty;
            debriefEditing = session?.Debrief is null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            loadError = "Session detail could not be loaded from the local gateway. No stored data was changed.";
            return;
        }
        finally
        {
            loading = false;
        }

        if (session is not null)
        {
            await Task.WhenAll(LoadComparisonAsync(), LoadGarminRecoveryAsync());
        }
    }

    private void EditDebrief()
    {
        debriefPerceivedExertion = session?.Debrief?.PerceivedExertion;
        debriefNote = session?.Debrief?.Note ?? string.Empty;
        debriefMessage = null;
        debriefEditing = true;
    }

    private void CancelDebriefEdit()
    {
        debriefPerceivedExertion = session?.Debrief?.PerceivedExertion;
        debriefNote = session?.Debrief?.Note ?? string.Empty;
        debriefMessage = null;
        debriefEditing = false;
    }

    private async Task SaveDebriefAsync(bool skip)
    {
        if (session is null || debriefBusy) return;
        debriefBusy = true;
        debriefMessage = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                $"api/history/{SessionId}/debrief",
                new
                {
                    ProfileId = session.Definition.UserProfileId,
                    PerceivedExertion = skip ? null : debriefPerceivedExertion,
                    Note = skip ? null : debriefNote,
                });
            if (!response.IsSuccessStatusCode)
            {
                debriefMessage = "The debrief could not be saved. Check the effort and note, then try again.";
                return;
            }

            SessionDebrief? saved = await response.Content.ReadFromJsonAsync<SessionDebrief>();
            if (saved is null)
            {
                debriefMessage = "The gateway saved an unreadable debrief response. Reload before editing again.";
                return;
            }

            session = session with { Debrief = saved };
            debriefPerceivedExertion = saved.PerceivedExertion;
            debriefNote = saved.Note ?? string.Empty;
            debriefEditing = false;
            debriefMessage = skip ? "Debrief skipped." : "Debrief saved.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            debriefMessage = "The local gateway could not save the debrief. No existing debrief was changed.";
        }
        finally
        {
            debriefBusy = false;
        }
    }

    private async Task LoadComparisonAsync()
    {
        if (session is null) return;
        try
        {
            comparison = await Http.GetFromJsonAsync<ComparisonView>($"api/local-first/profiles/{session.Definition.UserProfileId}/comparisons/{SessionId}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            comparison = null;
        }
    }

