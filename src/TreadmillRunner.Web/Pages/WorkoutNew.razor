@page "/workouts/new"
@implements IDisposable
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ActiveProfileState ActiveProfile
@inject IJSRuntime JS

<PageTitle>Workout editor · TreadmillRunner</PageTitle>

<div class="planning-page planning-page--editor">
    <header class="planning-hero">
        <div><p class="eyebrow">Touch editor</p><h1>@(WorkoutId is null ? "New workout" : "New immutable revision")</h1><p>Time or distance goals, fixed or heart-rate-guided speed, incline ramps, cues, notes, and repeat blocks are saved as an immutable definition. Heart-rate guidance can be used for one step or the whole workout.</p></div>
        <a class="secondary-action" href="@(ReturnToPlan ? "/workouts?mode=programs" : "/workouts")">@(ReturnToPlan ? "Back to training plan" : "Back to library")</a>
    </header>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="notice" role="status">@message</p>
    }
    @if (pendingDraft is not null)
    {
        <section class="notice draft-recovery" role="status"><strong>Unfinished workout found.</strong><span>Continue where you left off or discard the browser-local draft.</span><button type="button" @onclick="ContinueDraftAsync">Continue draft</button><button type="button" @onclick="DiscardDraftAsync">Discard draft</button></section>
    }

    <div class="workout-editor-shell @(ReturnToPlan ? "workout-editor-shell--direct" : null)">
    @if (!ReturnToPlan)
    {
    <details class="planning-panel existing-workout-browser">
        <summary><span><strong>Start from an existing workout</strong><small>@FilteredExistingWorkouts.Count available</small></span></summary>
        <div class="existing-workout-browser__body" aria-labelledby="existing-workouts-title">
            <h2 id="existing-workouts-title" class="visually-hidden">Existing workouts</h2>
            <label class="field">Search existing workouts
                <input type="search" @bind="existingWorkoutSearch" @bind:event="oninput" placeholder="Title or description" />
            </label>
            <a class="existing-workout-link @(WorkoutId is null ? "existing-workout-link--active" : null)" href="/workouts/new">
                <strong>Blank workout</strong><span>Start a new plan</span>
            </a>
            <div class="existing-workout-list">
                @foreach (WorkoutSummaryView workout in FilteredExistingWorkouts)
                {
                    <a class="existing-workout-link @(WorkoutId == workout.Id ? "existing-workout-link--active" : null)" href="@($"/workouts/new?workoutId={workout.Id:D}")">
                        <strong>@workout.Name</strong>
                        <span>@(string.IsNullOrWhiteSpace(workout.Description) ? "No description" : workout.Description)</span>
                        <small>@workout.ExpandedStepCount steps · @(workout.DurationMinutes is null ? "Distance-based" : $"{workout.DurationMinutes:0} min")</small>
                    </a>
                }
            </div>
        </div>
    </details>
    }

    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="workout-form" class="editor-layout workout-builder" @oninput="QueueDraftSave" @onchange="QueueDraftSave">
        <section class="planning-panel workout-builder__meta">
            <div class="form-grid">
                <label class="field field--wide">Workout name<input @bind="form.Name" @bind:event="oninput" maxlength="160" required /></label>
                <label class="field field--wide">Description<textarea @bind="form.Description" @bind:event="oninput" rows="2" maxlength="500"></textarea></label>
            </div>
        </section>

        <div class="workout-builder__workspace">
            <section class="planning-panel workout-builder__rows" aria-labelledby="blocks-title">
                <div class="panel-heading"><div><h2 id="blocks-title">Workout blocks</h2><span class="field-help">Build the exact sequence. Every row shows its cumulative start time.</span></div></div>
                <div class="workout-quick-add" aria-label="Quick add workout block">
                    <button type="button" aria-label="Warm-up" @onclick="AddWarmUp"><strong>Warm-up</strong><small>05:00 · 4.5→6 km/h</small></button>
                    <button type="button" aria-label="Steady" @onclick="AddSteady"><strong>Steady</strong><small>10:00 · 7 km/h</small></button>
                    <button type="button" aria-label="Intervals" @onclick="AddIntervals"><strong>Intervals</strong><small>4× fast/recovery</small></button>
                    <button type="button" aria-label="Cool-down" @onclick="AddCooldown"><strong>Cool-down</strong><small>05:00 · 6→4.5 km/h</small></button>
                </div>
                @if (SelectedBlockCount > 0 || copiedBlocks.Count > 0)
                {
                    <div class="builder-selection-toolbar" role="toolbar" aria-label="Selected workout rows">
                        <strong>@SelectedBlockCount selected</strong>
                        <button class="secondary-action compact-action" type="button" @onclick="CopySelectedBlocks" disabled="@(SelectedBlockCount == 0)">Copy selected</button>
                        <button class="secondary-action compact-action" type="button" @onclick="InsertCopiedBlocks" disabled="@(copiedBlocks.Count == 0)">Insert @copiedBlocks.Count at end</button>
                        <button class="text-action" type="button" @onclick="ClearBlockSelection" disabled="@(SelectedBlockCount == 0)">Clear selection</button>
                    </div>
                }
                <div class="builder-row-head" aria-hidden="true"><span></span><span>Start / block</span><span>Duration</span><span>Speed</span><span>Incline</span><span>Cue</span><span>Actions</span></div>
                <div class="step-list workout-builder__list">
                    @for (int index = 0; index < form.Blocks.Count; index++)
                    {
                        BlockForm block = form.Blocks[index];
                        @BlockEditor(block, index, 0, form.Blocks)
                    }
                </div>
                <div class="workout-block-actions">
                    <button class="secondary-action" type="button" @onclick="AddStep">Add step</button>
                    <button class="secondary-action" type="button" @onclick="AddRepeat">Add repeat group</button>
                </div>
            </section>

            <aside class="workout-builder__preview">
                <WorkoutPreviewChart Blocks="@PreviewBlocks" Title="@(string.IsNullOrWhiteSpace(form.Name) ? "Workout preview" : form.Name)" />
                <div class="sticky-actions workout-builder__save">
                    <span>@ExpandedStepCount steps · @PlannedDurationLabel</span>
                    <button class="primary-action" type="submit" disabled="@(!CanSubmit)">@(saving ? "Saving…" : WorkoutId is null ? "Create workout" : "Save new revision")</button>
                </div>
            </aside>
        </div>

    </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public Guid? WorkoutId { get; set; }

    [SupplyParameterFromQuery]
    public bool ReturnToPlan { get; set; }

    [SupplyParameterFromQuery]
    public Guid? EditPlanId { get; set; }

    private readonly WorkoutForm form = new();
    private bool saving;
    private bool loading;
    private bool CanSubmit => !saving && !loading && form.Blocks.SelectMany(FlattenSteps).All(static step => step.DurationIsValid) &&
        (WorkoutId is null || form.LoadedWorkoutId == WorkoutId);
    private string? message;
    private Guid pendingOperationId = Guid.NewGuid();
    private IReadOnlyList<WorkoutSummaryView> existingWorkouts = Array.Empty<WorkoutSummaryView>();
    private string existingWorkoutSearch = string.Empty;
    private string? pendingDraft;
    private string? draftKey;
    private CancellationTokenSource? draftDebounce;
    private Guid? activeProfileId;
    private int profileGeneration;
    private readonly List<BlockForm> copiedBlocks = [];
    private IReadOnlyList<WorkoutBlockInput> PreviewBlocks => form.Blocks.Select(ToInput).ToArray();
    private int SelectedBlockCount => EnumerateBlocks(form.Blocks).Count(static block => block.Selected);

    private IReadOnlyList<WorkoutSummaryView> FilteredExistingWorkouts => existingWorkouts
        .Where(workout => string.IsNullOrWhiteSpace(existingWorkoutSearch) ||
            workout.Name.Contains(existingWorkoutSearch, StringComparison.CurrentCultureIgnoreCase) ||
            (workout.Description?.Contains(existingWorkoutSearch, StringComparison.CurrentCultureIgnoreCase) ?? false))
        .OrderBy(static workout => workout.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        ActiveProfile.Changed += ActiveProfileChanged;
        existingWorkouts = await Http.GetFromJsonAsync<WorkoutSummaryView[]>("api/planning/workouts")
            ?? Array.Empty<WorkoutSummaryView>();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (WorkoutId is null)
        {
            if (form.LoadedWorkoutId is not null) ResetBlankWorkout();
            return;
        }
        if (loading || form.LoadedWorkoutId == WorkoutId)
        {
            return;
        }

        loading = true;
        form.LoadedWorkoutId = null;
        form.Name = string.Empty;
        form.Description = null;
        form.Blocks.Clear();
        message = "Loading the selected workout…";
        try
        {
            List<WorkoutRevisionView> revisions = await Http.GetFromJsonAsync<List<WorkoutRevisionView>>($"api/planning/workouts/{WorkoutId}/revisions") ?? [];
            WorkoutRevisionView? latest = revisions.OrderByDescending(static revision => revision.RevisionNumber).FirstOrDefault();
            if (latest is not null)
            {
                form.LoadedWorkoutId = WorkoutId;
                form.Name = latest.Name;
                form.Description = latest.Description;
                form.Blocks.Clear();
                form.Blocks.AddRange(latest.Blocks.Select(ToForm));
                message = null;
            }
            else message = "The selected workout has no revision to edit.";
        }
        catch (HttpRequestException)
        {
            message = "The latest immutable revision could not be loaded.";
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        int generation = profileGeneration;
        Guid? profileId = await ActiveProfile.GetAsync();
        if (generation != profileGeneration) return;
        activeProfileId = profileId;
        draftKey = BuildDraftKey(profileId);
        pendingDraft = await JS.InvokeAsync<string?>("treadmillRunnerDrafts.load", draftKey);
        if (generation != profileGeneration) return;
        if (pendingDraft is not null) StateHasChanged();
    }

    private void ActiveProfileChanged(Guid? profileId)
    {
        int generation = ++profileGeneration;
        activeProfileId = profileId;
        _ = InvokeAsync(() => ApplyActiveProfileAsync(profileId, generation));
    }

    private async Task ApplyActiveProfileAsync(Guid? profileId, int generation)
    {
        string nextDraftKey = BuildDraftKey(profileId);
        draftDebounce?.Cancel();
        draftKey = nextDraftKey;
        pendingDraft = await JS.InvokeAsync<string?>("treadmillRunnerDrafts.load", nextDraftKey);
        if (generation != profileGeneration || activeProfileId != profileId) return;
        QueueDraftSave();
        await InvokeAsync(StateHasChanged);
    }

    private string BuildDraftKey(Guid? profileId) =>
        $"{profileId?.ToString("N") ?? "household"}.workout.{WorkoutId?.ToString("N") ?? "new"}";

    private void QueueDraftSave()
    {
        draftDebounce?.Cancel();
        draftDebounce = new CancellationTokenSource();
        _ = SaveDraftAfterDelayAsync(draftDebounce.Token, draftKey);
    }

    private async Task SaveDraftAfterDelayAsync(CancellationToken cancellationToken, string? key)
    {
        try
        {
            await Task.Delay(450, cancellationToken);
            if (key is null) return;
            string payload = System.Text.Json.JsonSerializer.Serialize(new WorkoutDraft(form.Name, form.Description, form.Blocks.Select(ToInput).ToArray()));
            bool saved = await JS.InvokeAsync<bool>("treadmillRunnerDrafts.save", key, payload);
            if (!saved) message = "Browser draft recovery is unavailable because this draft is too large or local storage is unavailable.";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private Task ContinueDraftAsync()
    {
        try
        {
            WorkoutDraft? draft = System.Text.Json.JsonSerializer.Deserialize<WorkoutDraft>(pendingDraft!);
            if (draft is not null)
            {
                form.Name = draft.Name;
                form.Description = draft.Description;
                form.Blocks.Clear();
                form.Blocks.AddRange(draft.Blocks.Select(ToForm));
                pendingDraft = null;
                message = "Browser-local draft restored.";
            }
        }
        catch (System.Text.Json.JsonException) { return DiscardDraftAsync(); }
        return Task.CompletedTask;
    }

    private async Task DiscardDraftAsync()
    {
        if (draftKey is not null) await JS.InvokeVoidAsync("treadmillRunnerDrafts.remove", draftKey);
        pendingDraft = null;
    }

    private void ResetBlankWorkout()
    {
        form.LoadedWorkoutId = null;
        form.Name = string.Empty;
        form.Description = null;
        form.Blocks.Clear();
        form.Blocks.Add(new BlockForm());
        pendingOperationId = Guid.NewGuid();
        message = null;
    }

    private RenderFragment BlockEditor(BlockForm block, int index, int depth, List<BlockForm> owner) => @<div class="@(block.Kind == "repeat" ? "builder-repeat-group" : $"builder-step-row builder-step-row--depth-{Math.Min(depth, 2)}")">
            @if (block.Kind == "repeat")
            {
                <div class="builder-repeat-header">
                    <input class="builder-row-select" type="checkbox" @bind="block.Selected" aria-label="Select @BlockLabel(block, index + 1, depth)" />
                    <span class="builder-drag" aria-hidden="true">≡</span>
                    <span class="builder-row-identity"><strong>@BlockLabel(block, index + 1, depth)</strong><small>Starts @StartLabel(block) · @block.Children.Count block(s) per repeat</small></span>
                    <label class="builder-repeat-count">Repeat <input @bind="block.Repetitions" type="number" min="1" max="100" required /> times</label>
                    <span class="builder-row-actions">
                        <button type="button" @onclick="() => MoveBlock(owner, index, -1)" disabled="@(index == 0)">Up</button>
                        <button type="button" @onclick="() => MoveBlock(owner, index, 1)" disabled="@(index == owner.Count - 1)">Down</button>
                        <button class="danger-action" type="button" @onclick="() => RemoveBlock(owner, index)" disabled="@(owner.Count == 1)">Delete</button>
                    </span>
                </div>
                <div class="step-list builder-repeat-children">
                    @for (int childIndex = 0; childIndex < block.Children.Count; childIndex++)
                    {
                        BlockForm child = block.Children[childIndex];
                        @BlockEditor(child, childIndex, depth + 1, block.Children)
                    }
                </div>
                <div class="builder-repeat-add">
                    <button class="secondary-action compact-action" type="button" @onclick="() => block.Children.Add(new BlockForm())">Add step to group</button>
                    <button class="secondary-action compact-action" type="button" @onclick="() => block.Children.Add(NewRepeatBlock())">Add nested group</button>
                </div>
            }
            else
            {
                <input class="builder-row-select" type="checkbox" @bind="block.Selected" aria-label="Select @BlockLabel(block, index + 1, depth)" />
                <span class="builder-row-identity"><span class="builder-start-time">@StartLabel(block)</span><strong>@BlockLabel(block, index + 1, depth)</strong></span>
                @StepEditor(block.Step)
                <span class="builder-row-actions">
                    <button type="button" @onclick="() => MoveBlock(owner, index, -1)" disabled="@(index == 0)">Up</button>
                    <button type="button" @onclick="() => MoveBlock(owner, index, 1)" disabled="@(index == owner.Count - 1)">Down</button>
                    <button class="danger-action" type="button" @onclick="() => RemoveBlock(owner, index)" disabled="@(owner.Count == 1)">Delete</button>
                </span>
            }
        </div>;

    private static string BlockLabel(BlockForm block, int sequence, int depth) => block.Kind == "repeat"
        ? depth == 0 ? $"Repeat block {sequence}" : $"Nested repeat block {sequence}"
        : depth == 0 ? $"Step {sequence}" : $"Repeated step {sequence}";

    private RenderFragment StepEditor(StepForm step) => @<div class="builder-step-fields">
            <label class="builder-compact-field"><span>Duration</span>
                @if (step.GoalKind == "time")
                {
                    <input class="builder-duration" @bind="step.DurationText" inputmode="numeric" placeholder="01:30" aria-label="Duration in minutes and seconds" required />
                }
                else
                {
                    <input @bind="step.GoalValue" type="number" min="0.01" max="1000" step="0.01" aria-label="Distance in kilometers" required />
                }
            </label>
            <label class="builder-compact-field"><span>Speed (km/h)</span><input @bind="step.PrimarySpeedKph" type="number" min="0" max="40" step="0.1" required /></label>
            <label class="builder-compact-field"><span>Incline (%)</span><input @bind="step.InclineStartPercent" type="number" min="-5" max="40" step="0.1" required /></label>
            <label class="builder-compact-field"><span>Cue</span><input @bind="step.Cue" maxlength="120" placeholder="Optional" /></label>
            <details class="builder-advanced">
                <summary>Advanced targets and notes</summary>
                <div class="form-grid form-grid--steps">
                    <label class="field">Goal type<select @bind="step.GoalKind"><option value="time">Time</option><option value="distance">Distance</option></select></label>
                    <label class="field">Speed target<select @bind="step.SpeedKind"><option value="open">Open/manual</option><option value="fixed">Fixed</option><option value="ramp">Ramp</option><option value="heartRate">HR range</option><option value="heartRateZone">HR zone</option></select></label>
                    @if (step.SpeedKind == "ramp")
                    {
                        <label class="field">End speed (km/h)<input @bind="step.SpeedEndKph" type="number" min="0" max="40" step="0.1" required /></label>
                    }
            @if (step.SpeedKind == "heartRate")
            {
                <label class="field">Minimum bpm<input @bind="step.HeartRateMinimumBpm" type="number" min="1" max="250" required /></label>
                <label class="field">Maximum bpm<input @bind="step.HeartRateMaximumBpm" type="number" min="1" max="250" required /></label>
            }
            @if (step.SpeedKind == "heartRateZone")
            {
                <label class="field">HR zone<input @bind="step.HeartRateZoneNumber" type="number" min="1" max="10" required /></label>
            }
            @if (step.SpeedKind is "heartRate" or "heartRateZone")
            {
                <p class="field-help field--wide" role="note">This step follows your live heart rate. A fresh chest-strap, watch, or HR-sensor reading is required before the workout can start; Polar H10 is preferred when enrolled.</p>
                <label class="field">Initial speed<input @bind="step.HeartRateInitialSpeedKph" type="number" min="0" max="40" step="0.1" /></label>
                <label class="field">Minimum speed<input @bind="step.HeartRateMinimumSpeedKph" type="number" min="0" max="40" step="0.1" /></label>
                <label class="field">Maximum speed<input @bind="step.HeartRateMaximumSpeedKph" type="number" min="0" max="40" step="0.1" /></label>
            }
            <label class="field">Incline target<select @bind="step.InclineKind"><option value="fixed">Fixed</option><option value="ramp">Ramp</option></select></label>
            @if (step.InclineKind == "ramp")
            {
                <label class="field">End incline (%)<input @bind="step.InclineEndPercent" type="number" min="-5" max="40" step="0.1" required /></label>
            }
            <label class="field field--wide">Notes<input @bind="step.Notes" maxlength="300" /></label>
                </div>
            </details>
        </div>;

    private void AddStep() => form.Blocks.Add(new BlockForm());
    private void AddRepeat() => form.Blocks.Add(NewRepeatBlock());

    private void AddWarmUp() => form.Blocks.Add(NewStepBlock(5, "ramp", 4.5, 6, .5, "Ease into your run"));
    private void AddSteady() => form.Blocks.Add(NewStepBlock(10, "fixed", 7, 7, 1, "Settle into a steady rhythm"));
    private void AddCooldown() => form.Blocks.Add(NewStepBlock(5, "ramp", 6, 4.5, .5, "Let your heart rate come down"));

    private void AddIntervals()
    {
        form.Blocks.Add(new BlockForm
        {
            Kind = "repeat",
            Repetitions = 4,
            Children =
            [
                NewStepBlock(2, "fixed", 8, 8, 1, "Fast interval"),
                NewStepBlock(2, "fixed", 5.5, 5.5, .5, "Recovery"),
            ],
        });
    }

    private static BlockForm NewStepBlock(double minutes, string speedKind, double startSpeed, double endSpeed, double incline, string cue) => new()
    {
        Step = new StepForm
        {
            GoalKind = "time",
            GoalValue = minutes,
            SpeedKind = speedKind,
            SpeedStartKph = startSpeed,
            SpeedEndKph = endSpeed,
            InclineKind = "fixed",
            InclineStartPercent = incline,
            InclineEndPercent = incline,
            Cue = cue,
        },
    };

    private static void MoveBlock(List<BlockForm> blocks, int index, int direction)
    {
        int target = index + direction;
        if (index < 0 || index >= blocks.Count || target < 0 || target >= blocks.Count) return;
        BlockForm block = blocks[index];
        blocks.RemoveAt(index);
        blocks.Insert(target, block);
    }

    private static void DuplicateBlock(List<BlockForm> blocks, int index)
    {
        if (index < 0 || index >= blocks.Count) return;
        blocks.Insert(index + 1, CloneBlock(blocks[index]));
    }

    private static void RemoveBlock(List<BlockForm> blocks, int index)
    {
        if (blocks.Count <= 1 || index < 0 || index >= blocks.Count) return;
        blocks.RemoveAt(index);
    }

    private static BlockForm CloneBlock(BlockForm block) => ToForm(ToInput(block));

    private void CopySelectedBlocks()
    {
        copiedBlocks.Clear();
        copiedBlocks.AddRange(EnumerateBlocks(form.Blocks).Where(static block => block.Selected).Select(CloneBlock));
    }

    private void InsertCopiedBlocks()
    {
        form.Blocks.AddRange(copiedBlocks.Select(CloneBlock));
        ClearBlockSelection();
        QueueDraftSave();
    }

    private void ClearBlockSelection()
    {
        foreach (BlockForm block in EnumerateBlocks(form.Blocks)) block.Selected = false;
    }

    private static IEnumerable<BlockForm> EnumerateBlocks(IEnumerable<BlockForm> blocks)
    {
        foreach (BlockForm block in blocks)
        {
            yield return block;
            foreach (BlockForm child in EnumerateBlocks(block.Children)) yield return child;
        }
    }

    private static IEnumerable<StepForm> FlattenSteps(BlockForm block) => block.Kind == "repeat"
        ? block.Children.SelectMany(FlattenSteps)
        : [block.Step];

    private string StartLabel(BlockForm target)
    {
        double elapsedMinutes = 0;
        bool exact = true;
        if (Find(form.Blocks)) return exact ? FormatMinutes(elapsedMinutes) : "—";
        return "—";

        bool Find(IReadOnlyList<BlockForm> blocks)
        {
            foreach (BlockForm block in blocks)
            {
                if (ReferenceEquals(block, target)) return true;
                if (block.Kind == "repeat")
                {
                    double groupStart = elapsedMinutes;
                    if (Find(block.Children)) return true;
                    (double groupMinutes, bool groupComplete) = block.Children.Aggregate((0d, true), static (current, child) =>
                    {
                        (double minutes, bool complete) = PlannedMinutes(child);
                        return (current.Item1 + minutes, current.Item2 && complete);
                    });
                    elapsedMinutes = groupStart + (groupMinutes * block.Repetitions);
                    exact &= groupComplete;
                }
                else
                {
                    if (block.Step.GoalKind == "time" && block.Step.DurationIsValid) elapsedMinutes += block.Step.GoalValue;
                    else exact = false;
                }
            }
            return false;
        }
    }

    private static string FormatMinutes(double minutes)
    {
        TimeSpan value = TimeSpan.FromMinutes(Math.Max(0, minutes));
        return WorkoutSegmentTimeline.FormatStart(value);
    }

    private int ExpandedStepCount => form.Blocks.Sum(ExpandedSteps);
    private string PlannedDurationLabel
    {
        get
        {
            (double minutes, bool complete) = form.Blocks.Aggregate((Minutes: 0d, Complete: true), static (current, block) =>
            {
                (double blockMinutes, bool blockComplete) = PlannedMinutes(block);
                return (current.Minutes + blockMinutes, current.Complete && blockComplete);
            });
            return complete ? $"{minutes:0.#} min" : "mixed time/distance";
        }
    }

    private static int ExpandedSteps(BlockForm block) => block.Kind == "repeat"
        ? block.Repetitions * block.Children.Sum(ExpandedSteps)
        : 1;

    private static (double Minutes, bool Complete) PlannedMinutes(BlockForm block)
    {
        if (block.Kind != "repeat") return block.Step.GoalKind == "time" ? (block.Step.GoalValue, true) : (0, false);
        (double minutes, bool complete) = block.Children.Aggregate((Minutes: 0d, Complete: true), static (current, child) =>
        {
            (double childMinutes, bool childComplete) = PlannedMinutes(child);
            return (current.Minutes + childMinutes, current.Complete && childComplete);
        });
        return (minutes * block.Repetitions, complete);
    }

    private static BlockForm NewRepeatBlock() => new() { Kind = "repeat", Children = [new()] };

    public void Dispose()
    {
        ActiveProfile.Changed -= ActiveProfileChanged;
        draftDebounce?.Cancel();
        draftDebounce?.Dispose();
    }

    private async Task SaveAsync(EditContext _)
    {
        saving = true;
        var request = new WorkoutSaveRequest(
            pendingOperationId,
            form.Name,
            form.Description,
            form.Blocks.Select(ToInput).ToArray(),
            ReturnToPlan && WorkoutId is null ? "PlanInternal" : "Structured");
        HttpResponseMessage response = WorkoutId is null
            ? await Http.PostAsJsonAsync("api/planning/workouts", request)
            : await Http.PostAsJsonAsync($"api/planning/workouts/{WorkoutId}/revisions", request);
        if (response.IsSuccessStatusCode)
        {
            if (draftKey is not null) await JS.InvokeVoidAsync("treadmillRunnerDrafts.remove", draftKey);
            pendingOperationId = Guid.NewGuid();
            WorkoutSaveResponse? saved = await response.Content.ReadFromJsonAsync<WorkoutSaveResponse>();
            message = $"Saved immutable revision {saved?.RevisionNumber ?? 1}.";
            Navigation.NavigateTo(ReturnToPlan && saved is not null
                ? $"/workouts?mode=programs&addRevisionId={saved.RevisionId:D}{(EditPlanId is { } planId ? $"&editPlanId={planId:D}" : string.Empty)}"
                : "/workouts");
        }
        else
        {
            message = "The workout could not be saved. Check every block and retry; the same operation ID will be reused safely.";
        }

        saving = false;
    }

    private static WorkoutBlockInput ToInput(BlockForm block) => block.Kind == "repeat"
        ? EmptyInput with { Kind = "repeat", Repetitions = block.Repetitions, Blocks = block.Children.Select(ToInput).ToArray() }
        : new WorkoutBlockInput("step", 1, [], block.Step.GoalKind, block.Step.GoalValue, block.Step.SpeedKind,
            block.Step.SpeedStartKph, block.Step.SpeedEndKph, block.Step.HeartRateMinimumBpm, block.Step.HeartRateMaximumBpm,
            block.Step.HeartRateZoneNumber, block.Step.HeartRateInitialSpeedKph, block.Step.HeartRateMinimumSpeedKph,
            block.Step.HeartRateMaximumSpeedKph, block.Step.InclineKind, block.Step.InclineStartPercent,
            block.Step.InclineEndPercent, block.Step.Cue, block.Step.Notes);

    private static BlockForm ToForm(WorkoutBlockInput input) => input.Kind == "repeat"
        ? new BlockForm { Kind = "repeat", Repetitions = input.Repetitions, Children = input.Blocks.Select(ToForm).ToList() }
        : new BlockForm { Step = new StepForm
        {
            GoalKind = input.GoalKind, GoalValue = input.GoalValue, SpeedKind = input.SpeedKind,
            SpeedStartKph = input.SpeedStartKph, SpeedEndKph = input.SpeedEndKph,
            HeartRateMinimumBpm = input.HeartRateMinimumBpm, HeartRateMaximumBpm = input.HeartRateMaximumBpm,
            HeartRateZoneNumber = input.HeartRateZoneNumber, HeartRateInitialSpeedKph = input.HeartRateInitialSpeedKph,
            HeartRateMinimumSpeedKph = input.HeartRateMinimumSpeedKph, HeartRateMaximumSpeedKph = input.HeartRateMaximumSpeedKph,
            InclineKind = input.InclineKind, InclineStartPercent = input.InclineStartPercent,
            InclineEndPercent = input.InclineEndPercent, Cue = input.Cue, Notes = input.Notes,
        } };

    private static readonly WorkoutBlockInput EmptyInput = new("step", 1, [], "time", 5, "fixed", 7, 7, 120, 150, 1, 7, 4, 10, "fixed", 0, 0, null, null);

    private sealed class WorkoutForm
    {
        public Guid? LoadedWorkoutId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public List<BlockForm> Blocks { get; } = [new()];
    }

    private sealed record WorkoutDraft(string Name, string? Description, IReadOnlyList<WorkoutBlockInput> Blocks);

    private sealed class BlockForm
    {
        public string Kind { get; set; } = "step";
        public int Repetitions { get; set; } = 2;
        public bool Selected { get; set; }
        public StepForm Step { get; set; } = new();
        public List<BlockForm> Children { get; set; } = [];
    }

    private sealed class StepForm
    {
        private string? durationText;
        public string GoalKind { get; set; } = "time";
        public double GoalValue { get; set; } = 5;
        public string DurationText
        {
            get => durationText ?? FormatGoalDuration(GoalValue);
            set
            {
                durationText = value;
                if (TryParseGoalDuration(value, out double minutes)) GoalValue = minutes;
            }
        }
        public bool DurationIsValid => GoalKind != "time" || TryParseGoalDuration(DurationText, out _);
        public string SpeedKind { get; set; } = "fixed";
        public double SpeedStartKph { get; set; } = 7;
        public double SpeedEndKph { get; set; } = 9;
        public double PrimarySpeedKph
        {
            get => SpeedStartKph;
            set
            {
                SpeedStartKph = value;
                if (SpeedKind == "fixed") SpeedEndKph = value;
            }
        }
        public ushort HeartRateMinimumBpm { get; set; } = 120;
        public ushort HeartRateMaximumBpm { get; set; } = 150;
        public int HeartRateZoneNumber { get; set; } = 2;
        public double HeartRateInitialSpeedKph { get; set; } = 7;
        public double HeartRateMinimumSpeedKph { get; set; } = 4;
        public double HeartRateMaximumSpeedKph { get; set; } = 10;
        public string InclineKind { get; set; } = "fixed";
        public double InclineStartPercent { get; set; }
        public double InclineEndPercent { get; set; }
        public string? Cue { get; set; }
        public string? Notes { get; set; }

        private static string FormatGoalDuration(double minutes)
        {
            int seconds = Math.Max(1, (int)Math.Round(minutes * 60, MidpointRounding.AwayFromZero));
            return $"{seconds / 60:00}:{seconds % 60:00}";
        }

        private static bool TryParseGoalDuration(string? value, out double minutes)
        {
            minutes = 0;
            string[] parts = value?.Trim().Split(':') ?? [];
            if (parts.Length != 2 || !int.TryParse(parts[0], NumberStyles.None, CultureInfo.InvariantCulture, out int wholeMinutes) ||
                !int.TryParse(parts[1], NumberStyles.None, CultureInfo.InvariantCulture, out int seconds) || wholeMinutes < 0 || seconds is < 0 or > 59)
                return false;
            int totalSeconds = (wholeMinutes * 60) + seconds;
            if (totalSeconds <= 0 || totalSeconds > 43_200) return false;
            minutes = totalSeconds / 60d;
            return true;
        }
    }
}
