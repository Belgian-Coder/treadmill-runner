@page "/workouts/import"
@implements IDisposable
@inject HttpClient Http
@inject ActiveProfileState ActiveProfile
@inject NavigationManager Navigation

<PageTitle>Import workout · TreadmillRunner</PageTitle>

<div class="planning-page planning-page--narrow">
    <header class="planning-hero">
        <div><p class="eyebrow">Review first</p><h1>Import workouts</h1><p>Import one workout or a complete set generated by the read-only treadmill-workout AI skill.</p></div>
        <a class="secondary-action" href="/workouts">Back to library</a>
    </header>

    <section class="planning-panel import-dropzone" aria-labelledby="import-title">
        <h2 id="import-title">Choose source</h2>
        <div class="segmented-choice" role="group" aria-label="Import type">
            <button type="button" aria-pressed="@(importMode == "single")" @onclick='() => SetImportMode("single")'>One workout</button>
            <button type="button" aria-pressed="@(importMode == "set")" @onclick='() => SetImportMode("set")'>Generated set</button>
        </div>
        @if (importMode == "single")
        {
            <div class="form-grid">
                <label class="field">Format<select @bind="format"><option value="NativeJson">TreadmillRunner JSON</option><option value="QDomyosXml">QDomyos XML</option><option value="GarminFit">Garmin FIT Workout</option></select></label>
                <label class="file-field">Workout file<InputFile OnChange="PreviewAsync" accept=".json,.xml,.fit" /></label>
            </div>
            <p class="field-help">Maximum 10 MB. Files stay in memory for 15 minutes and are not persisted as uploads.</p>
        }
        else
        {
            <label class="file-field">Generated treadmill-workout v4 bundle<InputFile OnChange="PreviewSetAsync" accept=".zip,application/zip" /></label>
            <p class="field-help">Maximum 64 MB. The manifest, every hash, the Omega profile, and exactly-one-variant rules are verified locally before preview.</p>
        }
    </section>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="notice" role="status">@message</p>
    }

    @if (preview is not null)
    {
        <section class="planning-panel preview-card" aria-labelledby="preview-title">
            <div class="panel-heading"><div><p class="eyebrow">Preview</p><h2 id="preview-title">@preview.Title</h2></div><span>@preview.Format</span></div>
            <dl class="compact-stats">
                <div><dt>Expanded steps</dt><dd>@preview.ExpandedStepCount</dd></div>
                <div><dt>Duration</dt><dd>@(preview.DurationMinutes is null ? "Mixed goals" : $"{preview.DurationMinutes:0.#} min")</dd></div>
                <div><dt>Expires</dt><dd>@preview.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</dd></div>
            </dl>
            @if (preview.Warnings.Count > 0)
            {
                <div class="warning-list" aria-label="Import warnings">
                    @foreach (ImportWarningView warning in preview.Warnings)
                    {
                        <p><strong>@warning.Code</strong> @warning.Message</p>
                    }
                </div>
            }
            @if (preview.Format == "QDomyosXml")
            {
                <label class="field">Source speed and distance units
                    <select @bind="qDomyosUnits" required>
                        <option value="">Choose units before confirmation</option>
                        <option value="KilometersPerHour">Kilometers / km/h</option>
                        <option value="MilesPerHour">Miles / mph</option>
                    </select>
                </label>
            }
            <button class="primary-action" type="button" @onclick="(MouseEventArgs _) => ConfirmAsync()" disabled="@(confirming || (preview.Format == "QDomyosXml" && string.IsNullOrEmpty(qDomyosUnits)))">@(confirming ? "Confirming…" : "Confirm and save workout")</button>
        </section>
    }
    else if (setPreview is not null)
    {
        <section class="planning-panel preview-card" aria-labelledby="set-preview-title">
            <div class="panel-heading"><div><p class="eyebrow">Generated set</p><h2 id="set-preview-title">@setPreview.PlanName</h2></div><span>v@(setPreview.ToolVersion)</span></div>
            <dl class="compact-stats">
                <div><dt>Plan workouts</dt><dd>@setPreview.SlotCount</dd></div>
                <div><dt>Available variants</dt><dd>@setPreview.VariantCount</dd></div>
                <div><dt>Category</dt><dd>@setPreview.Category</dd></div>
                <div><dt>Expires</dt><dd>@setPreview.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</dd></div>
            </dl>
            @if (setPreview.Warnings.Count > 0)
            {
                <div class="warning-list" aria-label="Workout-set warnings">
                    @foreach (string warning in setPreview.Warnings) { <p>@warning</p> }
                </div>
            }
            <label class="field">Variant selection
                <select @bind="setStrategy">
                    @foreach (WorkoutSetStrategyView strategy in setPreview.Strategies)
                    {
                        <option value="@strategy.Name">@StrategyLabel(strategy)</option>
                    }
                </select>
            </label>
            <label class="field">Create plan for
                <select value="@(activeProfileId?.ToString("D") ?? string.Empty)" @onchange="SelectDestinationProfile">
                    <option value="">Shared library only</option>
                    @foreach (ProfileView profile in profiles)
                    {
                        <option value="@profile.Id.ToString("D")">@profile.DisplayName</option>
                    }
                </select>
            </label>
            <p class="field-help">@(DestinationProfileName is { } runner ? $"The imported plan will be ready for {runner}." : "Workouts and the plan will be created without starting it for a runner.")</p>
            <details class="advanced-settings">
                <summary>Review workout slots</summary>
                <div class="set-slot-list">
                    @foreach (WorkoutSetSlotView slot in setPreview.Slots.Take(12))
                    {
                        <div><strong>@slot.CanonicalSlot</strong><span>@string.Join(" · ", slot.Variants.Select(static variant => variant.Variant))</span></div>
                    }
                    @if (setPreview.Slots.Count > 12) { <p class="field-help">Plus @(setPreview.Slots.Count - 12) more verified slots.</p> }
                </div>
            </details>
            <button class="primary-action" type="button" @onclick="ConfirmSetAsync" disabled="@confirming">@(confirming ? "Importing…" : $"Import {setPreview.SlotCount} workouts and create plan")</button>
        </section>
    }
</div>

@code {
    private const long MaximumFileBytes = 10 * 1024 * 1024;
    private const long MaximumSetBytes = 64 * 1024 * 1024;
    private string importMode = "single";
    private string format = "NativeJson";
    private string? message;
    private ImportPreviewView? preview;
    private WorkoutSetImportPreviewView? setPreview;
    private Guid? activeProfileId;
    private bool confirming;
    private bool initialized;
    private string? qDomyosUnits;
    private Guid pendingConfirmOperationId = Guid.NewGuid();
    private string setStrategy = "Default";
    private IReadOnlyList<ProfileView> profiles = Array.Empty<ProfileView>();
    private string? DestinationProfileName => profiles.FirstOrDefault(profile => profile.Id == activeProfileId)?.DisplayName;
    private int profileGeneration;

    protected override void OnInitialized() => ActiveProfile.Changed += ActiveProfileChanged;

    private void SetImportMode(string mode)
    {
        importMode = mode;
        preview = null;
        setPreview = null;
        message = null;
        pendingConfirmOperationId = Guid.NewGuid();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || initialized)
        {
            return;
        }

        initialized = true;
        int generation = profileGeneration;
        Guid? profileId = await ActiveProfile.GetAsync();
        IReadOnlyList<ProfileView> loadedProfiles = await Http.GetFromJsonAsync<ProfileView[]>("api/planning/profiles") ?? Array.Empty<ProfileView>();
        if (generation != profileGeneration) return;
        activeProfileId = profileId;
        profiles = loadedProfiles;
        StateHasChanged();
    }

    private void ActiveProfileChanged(Guid? profileId)
    {
        profileGeneration++;
        activeProfileId = profileId;
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectDestinationProfile(ChangeEventArgs args)
    {
        activeProfileId = Guid.TryParse(args.Value?.ToString(), out Guid profileId) ? profileId : null;
    }

    private async Task PreviewAsync(InputFileChangeEventArgs args)
    {
        message = "Reading and validating preview…";
        preview = null;
        setPreview = null;
        try
        {
            IBrowserFile file = args.File;
            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(file.OpenReadStream(MaximumFileBytes));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(streamContent, "file", file.Name);
            content.Add(new StringContent(format), "format");
            using HttpResponseMessage response = await Http.PostAsync("api/planning/workouts/import/preview", content);
            if (!response.IsSuccessStatusCode)
            {
                message = "The file could not be previewed. Check its format and limits.";
                return;
            }

            preview = await response.Content.ReadFromJsonAsync<ImportPreviewView>();
            qDomyosUnits = null;
            pendingConfirmOperationId = Guid.NewGuid();
            message = preview is null ? "No preview was returned." : "Preview ready. Review warnings before confirming.";
        }
        catch (IOException)
        {
            message = "The file exceeds the 10 MB upload limit.";
        }
    }

    private async Task PreviewSetAsync(InputFileChangeEventArgs args)
    {
        message = "Verifying bundle manifest and workouts…";
        preview = null;
        setPreview = null;
        try
        {
            IBrowserFile file = args.File;
            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(file.OpenReadStream(MaximumSetBytes));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
            content.Add(streamContent, "file", file.Name);
            using HttpResponseMessage response = await Http.PostAsync("api/planning/workout-sets/import/preview", content);
            if (!response.IsSuccessStatusCode)
            {
                message = "The generated set could not be verified. Check that it is an unmodified treadmill-workout v4 Omega ZIP.";
                return;
            }
            setPreview = await response.Content.ReadFromJsonAsync<WorkoutSetImportPreviewView>();
            setStrategy = "Default";
            pendingConfirmOperationId = Guid.NewGuid();
            message = setPreview is null ? "No preview was returned." : "Set verified. Choose one variant policy and confirm.";
        }
        catch (IOException)
        {
            message = "The generated set exceeds the 64 MB upload limit.";
        }
    }

    private async Task ConfirmAsync()
    {
        if (preview is null)
        {
            return;
        }

        confirming = true;
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            "api/planning/workouts/import/confirm",
            new ImportConfirmRequest(
                pendingConfirmOperationId,
                preview.PreviewId,
                preview.SourceSha256,
                activeProfileId,
                qDomyosUnits));
        if (response.IsSuccessStatusCode)
        {
            pendingConfirmOperationId = Guid.NewGuid();
            message = "Import confirmed from the original preview bytes.";
            await Task.Delay(350);
            Navigation.NavigateTo("/workouts");
        }
        else
        {
            message = "The preview expired or could not be confirmed. Preview the source again.";
        }

        confirming = false;
    }

    private async Task ConfirmSetAsync()
    {
        if (setPreview is null) return;
        confirming = true;
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            "api/planning/workout-sets/import/confirm",
            new WorkoutSetImportConfirmRequest(
                pendingConfirmOperationId,
                setPreview.PreviewId,
                setPreview.SourceSha256,
                activeProfileId,
                setStrategy));
        if (response.IsSuccessStatusCode)
        {
            pendingConfirmOperationId = Guid.NewGuid();
            message = "Workout set imported and training plan created.";
            await Task.Delay(350);
            Navigation.NavigateTo("/workouts");
        }
        else message = "The set preview expired or the atomic import could not be completed. No partial plan was saved.";
        confirming = false;
    }

    private static string StrategyLabel(WorkoutSetStrategyView strategy) => strategy.Name switch
    {
        "Default" => "Default choices (recommended)",
        "PreferHeartRate" => $"Prefer HR alternatives · {strategy.Substitutions} changes",
        "PreferFixed" => $"Prefer fixed-speed fallbacks · {strategy.Substitutions} changes",
        "PreferOmegaRecovery" => $"Prefer Omega recovery incline · {strategy.Substitutions} changes",
        _ => strategy.Name,
    };

    public void Dispose() => ActiveProfile.Changed -= ActiveProfileChanged;
}
