@page "/workouts"
@inject HttpClient Http
@inject ActiveProfileState ActiveProfile
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Workouts · TreadmillRunner</PageTitle>

<div class="planning-page planning-page--programs">
    <header class="planning-hero planning-hero--compact">
        <div>
            <p class="eyebrow">Library</p>
            <h1>Workouts</h1>
            <p>Build individual workouts or combine exact revisions into an ordered training plan.</p>
        </div>
        @if (libraryMode == "workouts")
        {
            <div class="hero-actions">
                <a class="secondary-action" href="/workouts/import">Import</a>
                <a class="primary-action" href="/workouts/new">New workout</a>
            </div>
        }
        else if (libraryMode == "programs")
        {
            <button class="primary-action" type="button" @onclick="NewProgram">New training plan</button>
        }
    </header>

    <nav class="library-segments" aria-label="Workout library view">
        <button type="button" aria-pressed="@(libraryMode == "workouts" ? "true" : "false")" @onclick='() => SetLibraryMode("workouts")'>Workouts</button>
        <button type="button" aria-pressed="@(libraryMode == "programs" ? "true" : "false")" @onclick='() => SetLibraryMode("programs")'>Training plans</button>
        <button type="button" aria-pressed="@(libraryMode == "premade" ? "true" : "false")" @onclick='() => SetLibraryMode("premade")'>Premade plans</button>
    </nav>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="notice" role="status">@message</p>
    }

    @if (libraryMode == "workouts")
    {
        <section class="planning-panel" aria-labelledby="workout-list-title" aria-label="Workout library">
            <div class="panel-heading"><div><h2 id="workout-list-title">Workout library</h2><span class="field-help">Current immutable revisions.</span></div><span>@FilteredWorkouts.Count result(s)</span></div>
            <div class="library-toolbar">
                <label class="field field--search">Search workouts
                    <input type="search" @bind="searchText" @bind:event="oninput" placeholder="Title or description" />
                </label>
                <label class="field">Duration
                    <select @bind="durationFilter">
                        <option value="all">Any duration</option>
                        <option value="short">Up to 30 min</option>
                        <option value="medium">30–60 min</option>
                        <option value="long">Over 60 min</option>
                        <option value="distance">Distance-based</option>
                    </select>
                </label>
                <label class="field">Structure
                    <select aria-label="Workout structure filter" @bind="structureFilter">
                        <option value="all">Any structure</option>
                        <option value="steady">Steady</option>
                        <option value="intervals">Intervals</option>
                        <option value="progression">Progression</option>
                        <option value="heart-rate">Heart-rate adaptive</option>
                        <option value="multi-stage">Multi-stage</option>
                    </select>
                </label>
                <label class="field">Sort
                    <select @bind="sortOrder">
                        <option value="updated">Recently updated</option>
                        <option value="title">Title</option>
                        <option value="duration">Duration</option>
                    </select>
                </label>
                <button class="secondary-action" type="button" @onclick="ClearFilters" disabled="@(!HasFilters)">Clear</button>
            </div>
            @if (loading)
            {
                <p class="empty-state">Loading workouts…</p>
            }
            else if (FilteredWorkouts.Count == 0)
            {
                <EmptyState><p>@(workouts.Count == 0 ? "Your library is empty." : "No workouts match these filters.")</p><a class="primary-action" href="/workouts/new">Build a workout</a></EmptyState>
            }
            else
            {
                <div class="workout-grid">
                    @foreach (WorkoutSummaryView workout in FilteredWorkouts)
                    {
                        <SummaryRow CssClass="workout-card">
                            <div><p class="eyebrow">Revision @workout.CurrentRevisionNumber</p><h3><button class="workout-card__details-link" type="button" @onclick="() => OpenWorkoutDetailsAsync(workout)">@workout.Name</button></h3></div>
                            <p class="workout-description">@(string.IsNullOrWhiteSpace(workout.Description) ? "No description yet." : workout.Description)</p>
                            <div class="workout-card__labels" aria-label="Workout type">
                                <span>@workout.StructureLabel</span>
                                @if (workout.UsesHeartRate) { <span>Heart rate</span> }
                            </div>
                            <dl class="compact-stats workout-card__stats">
                                <div><dt>Segments</dt><dd>@workout.ExpandedStepCount</dd></div>
                                <div><dt>Total</dt><dd>@workout.GoalLabel</dd></div>
                                <div><dt>Speed</dt><dd>@workout.SpeedLabel</dd></div>
                                <div><dt>Incline</dt><dd>@workout.InclineLabel</dd></div>
                            </dl>
                            <div class="card-actions">
                                <button class="secondary-action" type="button" @onclick="() => OpenWorkoutDetailsAsync(workout)">View details</button>
                                <details class="card-overflow">
                                    <summary aria-label="More actions for @workout.Name">More</summary>
                                    <div>
                                        <a class="secondary-action" href="@RevisionHref(workout)">New revision</a>
                                        <button class="text-action danger-action" type="button" @onclick="() => RequestArchive(workout)">Archive</button>
                                    </div>
                                </details>
                            </div>
                            @if (pendingArchive is { Kind: ArchiveKind.Workout } pending && pending.Id == workout.Id)
                            {
                                <section class="program-start-confirm" role="alertdialog" aria-labelledby="archive-workout-confirm-title">
                                    <strong id="archive-workout-confirm-title">Archive @workout.Name?</strong>
                                    <p>It will be hidden from the workout library. Existing session history is kept.</p>
                                    <div class="card-actions">
                                        <button class="secondary-action compact-action" type="button" @onclick="CancelArchive">Cancel</button>
                                        <button class="danger-action compact-action" type="button" @onclick="ConfirmArchiveAsync">Archive workout</button>
                                    </div>
                                </section>
                            }
                        </SummaryRow>
                    }
                </div>
            }
        </section>
    }
    else if (libraryMode == "programs")
    {
        <section class="program-workspace @(showProgramEditor ? "program-workspace--editing" : "program-workspace--browse")" aria-label="Training plans">
            <div class="program-browser">
                <div class="program-toolbar">
                    <label class="field field--search">Search training plans
                        <input type="search" @bind="programSearch" @bind:event="oninput" placeholder="Name or description" />
                    </label>
                    <div class="category-chips" role="group" aria-label="Training plan distance">
                        @foreach (string category in ProgramCategories)
                        {
                            <button type="button" aria-pressed="@(programCategory == category ? "true" : "false")" @onclick="() => programCategory = category">@category</button>
                        }
                    </div>
                    <button class="secondary-action" type="button" @onclick="ClearProgramFilters" disabled="@(!HasProgramFilters)">Clear filters</button>
                </div>

                @if (loading)
                {
                    <p class="empty-state">Loading training plans…</p>
                }
                else if (FilteredPrograms.Count == 0)
                {
                    <EmptyState><p>No training plans match this view.</p><button class="primary-action" type="button" @onclick="NewProgram">Create a plan</button></EmptyState>
                }
                else
                {
                    <div class="program-card-list">
                        @foreach (WorkoutProgramView program in FilteredPrograms)
                        {
                            <article class="program-card @(editingProgramId == program.Id ? "program-card--selected" : null)">
                                <button class="program-card__select" type="button" @onclick="() => OpenProgram(program)" aria-label="@(program.TemplateId is null ? "Edit" : "View") @program.Name" aria-describedby="@ProgramDescriptionId(program)">
                                    <span class="program-card__topline"><span class="category-pill">@program.Category</span><small>@(program.OwnerProfileId is null ? "Household" : $"For {ActiveProfileName}") · rev @program.RevisionNumber</small></span>
                                    <strong>@program.Name</strong>
                                    <span>@(string.IsNullOrWhiteSpace(program.Description) ? "No description" : program.Description)</span>
                                    <span class="program-next"><small>Next</small><strong>@NextWorkoutLabel(program)</strong></span>
                                    <span class="program-progress-copy">@ProgramProgress(program)</span>
                                    @if (program.Run?.ScheduledStartDate is { } scheduledStart)
                                    {
                                        <span class="program-schedule-copy">Calendar starts @scheduledStart.ToString("d MMM yyyy") · @FormatWeekdays(program.Run.ScheduledWeekdayMask)</span>
                                    }
                                    <span class="program-progress" aria-hidden="true"><i style="width: @ProgramProgressPercent(program)%"></i></span>
                                </button>
                                <span id="@ProgramDescriptionId(program)" class="visually-hidden">@ProgramAccessibleDescription(program)</span>
                                <div class="card-actions">
                                    @if (activeProfileId is not null)
                                    {
                                        <button class="secondary-action compact-action" type="button" @onclick="() => RequestProgramStart(program, program.Run is not null)">@(program.Run is null ? "Start plan" : "Restart")</button>
                                    }
                                    <details class="card-overflow">
                                        <summary aria-label="More actions for @program.Name">More</summary>
                                        <div>
                                            @if (program.Run?.ScheduledStartDate is not null)
                                            {
                                                <a class="secondary-action" href="/calendar">Calendar &amp; training days</a>
                                            }
                                            <button class="text-action danger-action" type="button" @onclick="() => RequestArchive(program)">Archive</button>
                                        </div>
                                    </details>
                                </div>
                                <details class="template-program-groups">
                                    <summary>View @program.Items.Count sessions</summary>
                                    @if (program.Items.Any(static item => item.Phase is not null || item.WeekNumber is not null))
                                    {
                                        <div class="template-program-phase-grid">
                                            @foreach (var phase in program.Items.GroupBy(item => item.Phase ?? "Plan").OrderBy(group => group.Min(item => item.Position)))
                                            {
                                                <section>
                                                    <h4>@phase.Key</h4>
                                                    @foreach (var week in phase.GroupBy(item => item.WeekNumber ?? 1).OrderBy(group => group.Key))
                                                    {
                                                        <details>
                                                            <summary>Week @week.Key · @week.Count() session(s)</summary>
                                                            <ol>
                                                                @foreach (WorkoutProgramItemView item in week.OrderBy(item => item.SessionNumber).ThenBy(item => item.Position))
                                                                {
                                                                    <li>
                                                                        <button class="program-session-detail" type="button" @onclick="() => OpenProgramWorkoutDetailsAsync(program, item)"><span>Session @(item.SessionNumber ?? item.Position)</span><strong>@item.WorkoutName</strong><small>@DurationLabel(item.DurationMinutes)</small></button>
                                                                        @foreach (WorkoutProgramAlternativeView alternative in item.Alternatives ?? [])
                                                                        {
                                                                            <button class="program-session-detail program-session-detail--alternative" type="button" @onclick="() => OpenProgramWorkoutDetailsAsync(program, item, alternative)"><span>Alternative</span><strong>@alternative.WorkoutName</strong><small>@DurationLabel(alternative.DurationMinutes)</small></button>
                                                                        }
                                                                    </li>
                                                                }
                                                            </ol>
                                                        </details>
                                                    }
                                                </section>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <ol class="program-session-summary-list">
                                            @foreach (WorkoutProgramItemView item in program.Items.OrderBy(static item => item.Position))
                                            {
                                                <li><button class="program-session-detail" type="button" @onclick="() => OpenProgramWorkoutDetailsAsync(program, item)"><span>Session @item.Position</span><strong>@item.WorkoutName</strong><small>@DurationLabel(item.DurationMinutes)</small></button></li>
                                            }
                                        </ol>
                                    }
                                </details>
                                @if (pendingArchive is { Kind: ArchiveKind.Program } archive && archive.Id == program.Id)
                                {
                                    <section class="program-start-confirm" role="alertdialog" aria-labelledby="archive-program-confirm-title">
                                        <strong id="archive-program-confirm-title">Archive @program.Name?</strong>
                                        <p>The training plan will be hidden. Completed workouts remain in history.</p>
                                        <div class="card-actions">
                                            <button class="secondary-action compact-action" type="button" @onclick="CancelArchive">Cancel</button>
                                            <button class="danger-action compact-action" type="button" @onclick="ConfirmArchiveAsync">Archive plan</button>
                                        </div>
                                    </section>
                                }
                                @if (pendingProgramStart is { } pending && pending.Program.Id == program.Id)
                                {
                                    <section class="program-start-confirm" role="alertdialog" aria-labelledby="program-start-confirm-title">
                                        <strong id="program-start-confirm-title">@(pending.Restart ? $"Restart {program.Name} for {ActiveProfileName}?" : $"Start {program.Name} for {ActiveProfileName}?")</strong>
                                        <p>@ProgramStartWarning(pending)</p>
                                        <div class="program-schedule-fields">
                                            <label class="field">First training date
                                                <input type="date" @bind="programScheduleStartDate" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                                            </label>
                                            <fieldset class="program-training-days">
                                                <legend>Choose exactly @RequiredTrainingDays training day(s)</legend>
                                                <div>
                                                    @foreach ((string label, int flag) in ScheduleWeekdays)
                                                    {
                                                        <button type="button" aria-pressed="@((programScheduleWeekdayMask & flag) != 0)"
                                                                class="@((programScheduleWeekdayMask & flag) != 0 ? "is-selected" : null)"
                                                                @onclick="() => ToggleProgramWeekday(flag)">@label</button>
                                                    }
                                                </div>
                                            </fieldset>
                                            <p class="field-help">Sessions stay in exact order and appear only on @ActiveProfileName’s calendar.</p>
                                        </div>
                                        <div class="card-actions">
                                            <button class="secondary-action compact-action" type="button" @onclick="CancelProgramStart">@(pending.Restart ? "Cancel" : "Keep for later")</button>
                                            <button class="primary-action compact-action" type="button" disabled="@(!CanConfirmProgramSchedule)" @onclick="ConfirmProgramStartAsync">@ProgramStartConfirmLabel(pending)</button>
                                        </div>
                                    </section>
                                }
                            </article>
                        }
                    </div>
                }
            </div>

            @if (showProgramEditor)
            {
                <section class="planning-panel program-editor" aria-labelledby="program-editor-title" @oninput="QueueProgramDraftSave" @onchange="QueueProgramDraftSave">
                    <div class="panel-heading">
                        <div><p class="eyebrow">Ordered plan</p><h2 id="program-editor-title">@(editingProgramId is null ? "New training plan" : "Edit training plan")</h2></div>
                        <button class="text-action" type="button" @onclick="RequestCloseProgramEditor" aria-label="Close training plan editor">Close</button>
                    </div>
                    @if (pendingProgramDraft is not null)
                    {
                        <section class="notice draft-recovery" role="status"><strong>Unfinished training plan found.</strong><button type="button" @onclick="ContinueProgramDraftAsync">Continue draft</button><button type="button" @onclick="DiscardProgramDraftAsync">Discard draft</button></section>
                    }
                    @if (confirmDiscardProgram)
                    {
                        <section class="program-start-confirm" role="alertdialog" aria-labelledby="discard-program-confirm-title">
                            <strong id="discard-program-confirm-title">Discard unsaved changes?</strong>
                            <p>Your edits to this training plan have not been saved.</p>
                            <div class="card-actions">
                                <button class="secondary-action compact-action" type="button" @onclick="KeepEditingProgram">Keep editing</button>
                                <button class="danger-action compact-action" type="button" @onclick="CloseProgramEditor">Discard changes</button>
                            </div>
                        </section>
                    }
                    <div class="form-grid">
                        <label class="field">Plan name
                            <input maxlength="120" @bind="programDraft.Name" @bind:event="oninput" placeholder="Couch to 5K" />
                        </label>
                        <label class="field">Category
                            <select @bind="programDraft.Category">
                                <option value="5K">5K</option>
                                <option value="10K">10K</option>
                                <option value="Base">Base</option>
                                <option value="Custom">Custom</option>
                            </select>
                        </label>
                        <label class="field field--wide">Description
                            <textarea rows="2" maxlength="1000" @bind="programDraft.Description" @bind:event="oninput" placeholder="What this plan builds toward"></textarea>
                        </label>
                    </div>

                    <div class="program-add-workout">
                        <label class="field">Add workout
                            <select @bind="workoutToAdd">
                                <option value="">Choose a workout</option>
                                @foreach (WorkoutSummaryView workout in ProgramEligibleWorkouts)
                                {
                                    <option value="@workout.CurrentRevisionId">@workout.Name · rev @workout.CurrentRevisionNumber</option>
                                }
                            </select>
                        </label>
                        <button class="secondary-action" type="button" @onclick="AddSelectedWorkout" disabled="@(workoutToAdd is null)">Add</button>
                    </div>

                    <dl class="program-draft-summary" aria-label="Training plan summary">
                        <div><dt>Sessions</dt><dd>@programDraft.Items.Count</dd></div>
                        <div><dt>Planned time</dt><dd>@ProgramDurationLabel</dd></div>
                        <div><dt>Goal</dt><dd>@programDraft.Category</dd></div>
                    </dl>

                    <ol class="program-item-list" aria-label="Ordered workouts">
                        @foreach ((ProgramDraftItem item, int index) in programDraft.Items.Select((item, index) => (item, index)))
                        {
                            <li class="program-item">
                                <span class="program-item__number">@(index + 1)</span>
                                <span class="program-item__copy"><strong>@item.WorkoutName</strong><small>Exact revision @item.WorkoutRevisionNumber · @DurationLabel(item.DurationMinutes)</small></span>
                                <span class="program-item__actions">
                                    <button type="button" @onclick="() => MoveProgramItem(index, -1)" disabled="@(index == 0)" aria-label="Move @item.WorkoutName up">↑</button>
                                    <button type="button" @onclick="() => MoveProgramItem(index, 1)" disabled="@(index == programDraft.Items.Count - 1)" aria-label="Move @item.WorkoutName down">↓</button>
                                    <button type="button" @onclick="() => DuplicateProgramItem(index)" aria-label="Duplicate @item.WorkoutName">⧉</button>
                                    <button class="danger-action" type="button" @onclick="() => RemoveProgramItem(index)" aria-label="Remove @item.WorkoutName">×</button>
                                </span>
                            </li>
                        }
                    </ol>
                    @if (programDraft.Items.Count == 0)
                    {
                        <p class="empty-state">Add at least one workout. The saved order becomes the progression order.</p>
                    }
                    <div class="sticky-actions program-editor__save">
                        <span>@programDraft.Items.Count workout(s) · exact revisions</span>
                        <button class="primary-action" type="button" @onclick="SaveProgramAsync" disabled="@(!CanSaveProgram)">@(editingProgramId is null ? "Create plan" : "Save new revision")</button>
                    </div>
                </section>
            }
        </section>
    }
    else
    {
        <section class="premade-plan-workspace" aria-label="Premade training-plan catalog">
            <div class="premade-plan-browser planning-panel">
                <div class="panel-heading"><div><p class="eyebrow">Ready-made training</p><h2>Premade plans</h2></div><span>@FilteredPremadePlans.Count plan(s)</span></div>
                <p class="field-help">Preview against the selected runner and treadmill limits. Nothing starts automatically.</p>
                @if (activeProfileId is null)
                {
                    <p class="notice">Select a runner on Run before adding a premade plan.</p>
                }
                <div class="premade-plan-filters">
                    <label class="field field--search">Search
                        <input type="search" @bind="premadeSearch" @bind:event="oninput" placeholder="Plan name or goal" />
                    </label>
                    <label class="field">Goal
                        <select @bind="premadeGoal">
                            <option value="All">All goals</option><option value="5K">5K</option><option value="10K">10K</option><option value="General fitness">General fitness</option><option value="Walking">Walking</option><option value="Maintenance">Maintenance</option>
                        </select>
                    </label>
                    <label class="field">Experience
                        <select @bind="premadeExperience"><option value="All">Any level</option><option value="Beginner">Beginner</option><option value="Intermediate">Intermediate</option><option value="Experienced">Experienced</option><option value="All levels">All levels</option></select>
                    </label>
                    <label class="field">Heart rate
                        <select @bind="premadeHeartRate"><option value="All">Optional or required</option><option value="Required">HR required</option><option value="No">No HR required</option></select>
                    </label>
                    <label class="field">Session duration
                        <select @bind="premadeDuration"><option value="All">Any duration</option><option value="30">Up to 30 min</option><option value="45">Up to 45 min</option><option value="60">Up to 60 min</option><option value="61">Over 60 min</option></select>
                    </label>
                    <label class="field">Sessions per week
                        <select @bind="premadeFrequency"><option value="All">Any frequency</option><option value="3">3 per week</option><option value="4">4 per week</option></select>
                    </label>
                    <button class="secondary-action" type="button" @onclick="ClearPremadeFilters" disabled="@(!HasPremadeFilters)">Clear filters</button>
                </div>
                @if (loading)
                {
                    <p class="empty-state">Loading premade plans…</p>
                }
                else
                {
                    <div class="premade-plan-grid">
                        @foreach (PremadePlanCatalogView plan in FilteredPremadePlans)
                        {
                            <button class="premade-plan-card @(selectedPremadeId == plan.Id ? "premade-plan-card--selected" : null)" type="button" @onclick="() => SelectPremadeAsync(plan)">
                                <span class="program-card__topline"><span class="category-pill">@plan.Goal</span><small>@plan.Experience</small></span>
                                <strong>@plan.Name</strong><span>@plan.Description</span>
                                <span class="premade-plan-card__stats">@plan.Weeks weeks · @plan.SessionCount sessions · @plan.SessionsPerWeek/week</span>
                                <span class="premade-plan-card__footer">@(plan.RequiresHeartRate ? "Heart rate required" : "Heart rate optional") <b>@(plan.AlreadyAdded ? "Already added" : "Preview")</b></span>
                            </button>
                        }
                    </div>
                }
            </div>
            <aside class="premade-plan-preview planning-panel" aria-live="polite">
                @if (premadePreview is null)
                {
                    <div class="empty-state"><p>Select a plan to check it for the active runner.</p></div>
                }
                else
                {
                    <p class="eyebrow">For @premadePreview.ProfileName</p><h2>@premadePreview.Template.Name</h2>
                    <p>@premadePreview.CompatibilityMessage</p>
                    <dl class="compact-stats compact-stats--four">
                        <div><dt>Weeks</dt><dd>@premadePreview.Template.Weeks</dd></div><div><dt>Sessions</dt><dd>@premadePreview.Template.SessionCount</dd></div>
                        <div><dt>Max speed</dt><dd>@premadePreview.NormalizedMaximumSpeedKph.ToString("0.0") km/h</dd></div><div><dt>Max incline</dt><dd>@premadePreview.NormalizedMaximumInclinePercent.ToString("0.0")%</dd></div>
                    </dl>
                    <div class="premade-plan-phases">
                        @foreach (PremadePlanPhaseView phase in premadePreview.Phases)
                        {
                            <div><strong>@phase.Name</strong><span>Weeks @phase.FirstWeek–@phase.LastWeek · @phase.SessionCount sessions</span></div>
                        }
                    </div>
                    <p class="field-help">@premadePreview.UniqueWorkoutCount unique workouts are reused across @premadePreview.Template.SessionCount scheduled positions. @premadePreview.NormalizedTargetCount target(s) are normalized conservatively.</p>
                    <div class="card-actions premade-plan-actions">
                        <button class="primary-action" type="button" disabled="@(!premadePreview.Compatible || premadeBusy || premadePreview.Template.AlreadyAdded)" @onclick="() => AddPremadeAsync(false)">@(premadePreview.Template.AlreadyAdded ? $"Already added for {premadePreview.ProfileName}" : $"Add for {premadePreview.ProfileName}")</button>
                        @if (premadePreview.Template.AlreadyAdded)
                        {
                            <button class="secondary-action" type="button" disabled="@premadeBusy" @onclick="() => AddPremadeAsync(true)">Add fresh copy</button>
                        }
                    </div>
                }
            </aside>
        </section>
    }
</div>

@if (selectedWorkoutDetails is not null || selectedPlanWorkoutName is not null)
{
    <DetailSheet BackdropId="workout-details-backdrop" BackdropClass="workout-details-backdrop" CssClass="workout-details-dialog" LabelledBy="workout-details-title" OnDismiss="CloseWorkoutDetailsAsync">
            <header class="workout-details-header">
                <div>
                    <p class="eyebrow">@DetailEyebrow</p>
                    <h2 id="workout-details-title">@DetailName</h2>
                </div>
                <button class="icon-action" type="button" aria-label="Close workout details" autofocus @onclick="CloseWorkoutDetailsAsync">×</button>
            </header>
            <p class="workout-description">@DetailDescription</p>
            @if (selectedWorkoutDetails is not null)
            {
              <dl class="workout-details-overview" aria-label="Workout overview">
                <div><dt>Structure</dt><dd>@selectedWorkoutDetails.StructureLabel</dd></div>
                <div><dt>Goal</dt><dd>@selectedWorkoutDetails.GoalLabel</dd></div>
                <div><dt>Expanded segments</dt><dd>@selectedWorkoutDetails.ExpandedStepCount</dd></div>
                <div><dt>Speed control</dt><dd>@selectedWorkoutDetails.SpeedLabel</dd></div>
                <div><dt>Incline</dt><dd>@selectedWorkoutDetails.InclineLabel</dd></div>
                <div><dt>Heart rate</dt><dd>@(selectedWorkoutDetails.UsesHeartRate ? "Used for speed control" : "Not required")</dd></div>
              </dl>
            }
            else
            {
              <dl class="workout-details-overview" aria-label="Plan workout overview"><div><dt>Source</dt><dd>Training plan</dd></div><div><dt>Revision</dt><dd>@selectedDetailRevisionNumber</dd></div><div><dt>Action</dt><dd>Viewing only</dd></div></dl>
            }
            <section class="workout-details-structure" aria-labelledby="workout-structure-title">
                <div class="panel-heading"><div><h3 id="workout-structure-title">Workout structure</h3><span class="field-help">Repeats stay grouped so the pattern remains easy to scan.</span></div></div>
                @if (workoutDetailsLoading)
                {
                    <p class="empty-state" role="status">Loading workout structure…</p>
                }
                else if (!string.IsNullOrWhiteSpace(workoutDetailsError))
                {
                    <div class="empty-state" role="alert"><p>@workoutDetailsError</p><button class="secondary-action" type="button" @onclick="RetryWorkoutDetailsAsync">Try again</button></div>
                }
                else if (selectedWorkoutRevision is not null)
                {
                    <WorkoutStructureSummary Blocks="selectedWorkoutRevision.Blocks" />
                    <WorkoutPlanDetails Blocks="selectedWorkoutRevision.Blocks" IdPrefix="workout-library-detail" />
                }
            </section>
            <div class="card-actions workout-details-actions">
                <button class="secondary-action" type="button" @onclick="CloseWorkoutDetailsAsync">Close</button>
                @if (selectedWorkoutDetails is not null)
                {
                    <a class="primary-action" href="@RevisionHref(selectedWorkoutDetails)">Create new revision</a>
                }
            </div>
    </DetailSheet>
}

@code {
