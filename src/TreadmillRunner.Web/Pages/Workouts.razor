    private async Task SaveProgramAsync()
    {
        if (!CanSaveProgram) return;
        var request = new WorkoutProgramSaveRequest(
            Guid.NewGuid(), programDraft.Name.Trim(), string.IsNullOrWhiteSpace(programDraft.Description) ? null : programDraft.Description.Trim(), programDraft.Category,
            programDraft.Items.Select(static item => new WorkoutProgramItemInput(item.WorkoutRevisionId)).ToArray());
        string url = editingProgramId is { } programId ? $"api/planning/programs/{programId}/revisions" : "api/planning/programs";
        using HttpResponseMessage response = await Http.PostAsJsonAsync(url, request);
        message = response.IsSuccessStatusCode ? $"{programDraft.Name} saved." : "The training plan could not be saved.";
        if (!response.IsSuccessStatusCode) return;
        await DiscardProgramDraftAsync();
        showProgramEditor = false;
        editingProgramId = null;
        await ReloadAsync();
    }

    private async Task StartProgramAsync(WorkoutProgramView program, bool restart)
    {
        if (activeProfileId is not { } profileId) return;
        string action = restart ? "restart" : "start";
        WorkoutProgramView? active = programs.FirstOrDefault(static candidate => candidate.Run is { Status: "Active" });
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/planning/programs/{program.Id}/{action}",
            new WorkoutProgramStartRequest(Guid.NewGuid(), profileId, program.RevisionId, active?.Run?.Id, active?.Run?.Version,
                programScheduleStartDate, programScheduleWeekdayMask, "Europe/Brussels"));
        message = response.IsSuccessStatusCode
            ? $"{program.Name} is active for {ActiveProfileName}. Its ordered sessions are on the calendar."
            : "The training plan could not be started.";
        if (response.IsSuccessStatusCode) await ReloadAsync();
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict) { message = "The active plan changed in another browser. Review the latest progress and try again."; await ReloadAsync(); }
    }

    private void RequestProgramStart(WorkoutProgramView program, bool restart)
    {
        WorkoutProgramView? active = programs.FirstOrDefault(static candidate => candidate.Run is { Status: "Active" });
        pendingProgramStart = new PendingProgramStart(program, restart, active);
        programScheduleWeekdayMask = DefaultWeekdayMask(RequiredTrainingDays);
        programScheduleStartDate = NextSelectedDate(DateOnly.FromDateTime(DateTime.Today), programScheduleWeekdayMask);
    }

    private void CancelProgramStart() => pendingProgramStart = null;

    private async Task SelectProfileAsync(Guid profileId)
    {
        if (activeProfileId == profileId) return;
        activeProfileId = profileId;
        selectedPremadeId = null;
        premadePreview = null;
        pendingProgramStart = null;
        await ActiveProfile.SetAsync(profileId);
        await ReloadAsync();
        message = $"Showing training for {ActiveProfileName}.";
    }

    private void ToggleProgramWeekday(int flag)
    {
        programScheduleWeekdayMask = (programScheduleWeekdayMask & flag) != 0
            ? programScheduleWeekdayMask & ~flag
            : programScheduleWeekdayMask | flag;
    }

    private static int CountSelectedWeekdays(int mask) => Enumerable.Range(0, 7).Count(bit => ((mask >> bit) & 1) == 1);
    private static DateOnly NextSelectedDate(DateOnly start, int mask)
    {
        while ((mask & WeekdayFlag(start.DayOfWeek)) == 0) start = start.AddDays(1);
        return start;
    }
    private static int WeekdayFlag(DayOfWeek day) => day == DayOfWeek.Sunday ? 64 : 1 << ((int)day - 1);
    private static int DefaultWeekdayMask(int count) => count switch
    {
        1 => 1,
        2 => 34,
        3 => 37,
        4 => 43,
        5 => 47,
        6 => 63,
        _ => 127,
    };
    private static string FormatWeekdays(int mask) => string.Join(", ", ScheduleWeekdays.Where(day => (mask & day.Flag) != 0).Select(static day => day.Label));

    private async Task ConfirmProgramStartAsync()
    {
        if (pendingProgramStart is not { } pending) return;
        pendingProgramStart = null;
        await StartProgramAsync(pending.Program, pending.Restart);
    }

    private static string ProgramStartWarning(PendingProgramStart pending)
    {
        if (pending.Active is { } active && active.Id != pending.Program.Id)
        {
            return $"{active.Name} ({ProgramProgress(active)}) will be abandoned. {pending.Program.Name} will begin at workout 1.";
        }
        if (pending.Restart)
        {
            return $"Current progress ({ProgramProgress(pending.Program)}) will be reset and the latest plan revision will begin at workout 1.";
        }
        return "The plan will begin at workout 1 for the selected runner.";
    }

    private static string ProgramStartConfirmLabel(PendingProgramStart pending) =>
        pending.Active is { } active && active.Id != pending.Program.Id
            ? "Abandon and start"
            : pending.Restart ? "Reset and restart" : "Start plan";

    private async Task OpenWorkoutDetailsAsync(WorkoutSummaryView workout)
    {
        selectedWorkoutDetails = workout;
        selectedPlanWorkoutName = null;
        selectedPlanWorkoutContext = null;
        selectedDetailRevisionId = workout.CurrentRevisionId;
        selectedDetailRevisionNumber = workout.CurrentRevisionNumber;
        selectedWorkoutRevision = null;
        workoutDetailsError = null;
        workoutDetailsLoading = true;
        openWorkoutDetailsPending = true;
        await InvokeAsync(StateHasChanged);
        await LoadWorkoutDetailsAsync();
    }

    private async Task OpenProgramWorkoutDetailsAsync(
        string workoutName,
        Guid workoutRevisionId,
        int workoutRevisionNumber,
        string context)
    {
        selectedWorkoutDetails = null;
        selectedPlanWorkoutName = workoutName;
        selectedPlanWorkoutContext = context;
        selectedDetailRevisionId = workoutRevisionId;
        selectedDetailRevisionNumber = workoutRevisionNumber;
        selectedWorkoutRevision = null;
        workoutDetailsError = null;
        workoutDetailsLoading = true;
        openWorkoutDetailsPending = true;
        await InvokeAsync(StateHasChanged);
        await LoadWorkoutDetailsAsync();
    }

    private Task OpenProgramWorkoutDetailsAsync(WorkoutProgramView program, WorkoutProgramItemView item) =>
        OpenProgramWorkoutDetailsAsync(
            item.WorkoutName,
            item.WorkoutRevisionId,
            item.WorkoutRevisionNumber,
            $"{program.Name} · Week {item.WeekNumber ?? 1} · Session {item.SessionNumber ?? item.Position}");

    private Task OpenProgramWorkoutDetailsAsync(
        WorkoutProgramView program,
        WorkoutProgramItemView item,
        WorkoutProgramAlternativeView alternative) =>
        OpenProgramWorkoutDetailsAsync(
            alternative.WorkoutName,
            alternative.WorkoutRevisionId,
            alternative.WorkoutRevisionNumber,
            $"{program.Name} · Week {item.WeekNumber ?? 1} · Session {item.SessionNumber ?? item.Position} · {VariantLabel(alternative.Variant)}");

    private async Task LoadWorkoutDetailsAsync()
    {
        if (selectedDetailRevisionId is not { } revisionId) return;
        workoutDetailsLoading = true;
        workoutDetailsError = null;
        try
        {
            if (selectedWorkoutDetails is { } workout)
            {
                List<WorkoutRevisionView> revisions = await Http.GetFromJsonAsync<List<WorkoutRevisionView>>($"api/planning/workouts/{workout.Id:D}/revisions") ?? [];
                selectedWorkoutRevision = revisions.FirstOrDefault(revision => revision.RevisionId == revisionId);
            }
            else
            {
                selectedWorkoutRevision = await Http.GetFromJsonAsync<WorkoutRevisionView>($"api/planning/workouts/revisions/{revisionId:D}");
            }
            if (selectedWorkoutRevision is null)
            {
                workoutDetailsError = "The current workout revision is no longer available. Reload the library and try again.";
            }
        }
        catch (HttpRequestException)
        {
            workoutDetailsError = "The workout structure could not be loaded right now.";
        }
        finally
        {
            workoutDetailsLoading = false;
        }
    }

    private Task RetryWorkoutDetailsAsync() => LoadWorkoutDetailsAsync();

    private async Task CloseWorkoutDetailsAsync()
    {
        await JS.InvokeVoidAsync("treadmillRunnerView.closeModal");
        workoutDetailsModalReference = null;
        selectedWorkoutDetails = null;
        selectedPlanWorkoutName = null;
        selectedPlanWorkoutContext = null;
        selectedDetailRevisionId = null;
        selectedDetailRevisionNumber = 0;
        selectedWorkoutRevision = null;
        workoutDetailsError = null;
        workoutDetailsLoading = false;
    }

    [JSInvokable]
    public async Task<bool> CloseScheduleManagerFromJs()
    {
        workoutDetailsModalReference = null;
        selectedWorkoutDetails = null;
        selectedPlanWorkoutName = null;
        selectedPlanWorkoutContext = null;
        selectedDetailRevisionId = null;
        selectedDetailRevisionNumber = 0;
        selectedWorkoutRevision = null;
        workoutDetailsError = null;
        workoutDetailsLoading = false;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task ArchiveWorkoutAsync(WorkoutSummaryView workout)
    {
        if (!pendingArchiveOperations.TryGetValue(workout.Id, out Guid operationId)) { operationId = Guid.NewGuid(); pendingArchiveOperations.Add(workout.Id, operationId); }
        using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/planning/workouts/{workout.Id}/archive", new { operationId });
        message = response.IsSuccessStatusCode ? $"{workout.Name} archived." : "The workout could not be archived.";
        if (response.IsSuccessStatusCode) { pendingArchiveOperations.Remove(workout.Id); await ReloadAsync(); }
    }

    private async Task ArchiveProgramAsync(WorkoutProgramView program)
    {
        using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/planning/programs/{program.Id}/archive", new { operationId = Guid.NewGuid() });
        message = response.IsSuccessStatusCode ? $"{program.Name} archived." : "The training plan could not be archived.";
        if (response.IsSuccessStatusCode) { if (editingProgramId == program.Id) CloseProgramEditor(); await ReloadAsync(); }
    }

    private void RequestArchive(WorkoutSummaryView workout) => pendingArchive = new PendingArchive(ArchiveKind.Workout, workout.Id, workout.Name);
    private void RequestArchive(WorkoutProgramView program) => pendingArchive = new PendingArchive(ArchiveKind.Program, program.Id, program.Name);
    private void CancelArchive() => pendingArchive = null;

    private async Task ConfirmArchiveAsync()
    {
        if (pendingArchive is not { } pending) return;
        pendingArchive = null;
        if (pending.Kind == ArchiveKind.Workout)
        {
            WorkoutSummaryView? workout = workouts.FirstOrDefault(candidate => candidate.Id == pending.Id);
            if (workout is not null) await ArchiveWorkoutAsync(workout);
            return;
        }
        WorkoutProgramView? program = programs.FirstOrDefault(candidate => candidate.Id == pending.Id);
        if (program is not null) await ArchiveProgramAsync(program);
    }

    private static string DraftSignature(ProgramDraft draft) => System.Text.Json.JsonSerializer.Serialize(draft);

    private async Task LoadProgramDraftAsync()
    {
        programDraftKey = $"{activeProfileId?.ToString("N") ?? "household"}.program.{editingProgramId?.ToString("N") ?? "new"}";
        pendingProgramDraft = await JS.InvokeAsync<string?>("treadmillRunnerDrafts.load", programDraftKey);
    }

    private void QueueProgramDraftSave()
    {
        programDraftDebounce?.Cancel();
        programDraftDebounce = new CancellationTokenSource();
        _ = SaveProgramDraftAfterDelayAsync(programDraftDebounce.Token);
    }

    private async Task SaveProgramDraftAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(450, cancellationToken);
            if (programDraftKey is not null &&
                !await JS.InvokeAsync<bool>("treadmillRunnerDrafts.save", programDraftKey, DraftSignature(programDraft)))
                message = "Browser draft recovery is unavailable because this training plan is too large or local storage is unavailable.";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private Task ContinueProgramDraftAsync()
    {
        try
        {
            ProgramDraft? restored = System.Text.Json.JsonSerializer.Deserialize<ProgramDraft>(pendingProgramDraft!);
            if (restored is not null) { programDraft = restored; pendingProgramDraft = null; message = "Browser-local training-plan draft restored."; }
        }
        catch (System.Text.Json.JsonException) { return DiscardProgramDraftAsync(); }
        return Task.CompletedTask;
    }

    private async Task DiscardProgramDraftAsync()
    {
        if (programDraftKey is not null) await JS.InvokeVoidAsync("treadmillRunnerDrafts.remove", programDraftKey);
        pendingProgramDraft = null;
    }

    private static string ProgramProgress(WorkoutProgramView program) => program.Run is null
        ? $"{program.Items.Count} workouts"
        : program.IsComplete
            ? program.SkippedItemCount > 0 ? $"Complete · {program.SkippedItemCount} skipped" : "Complete"
            : $"{program.CompletedItemCount} complete{(program.SkippedItemCount > 0 ? $" · {program.SkippedItemCount} skipped" : string.Empty)} · {program.Items.Count - program.CompletedItemCount - program.SkippedItemCount} remaining";
    private static string NextWorkoutLabel(WorkoutProgramView program)
    {
        if (program.IsComplete)
        {
            return "Plan complete";
        }

        WorkoutProgramItemView? next = program.NextItemId is { } nextId
            ? program.Items.FirstOrDefault(item => item.Id == nextId)
            : program.Items.OrderBy(static item => item.Position).FirstOrDefault();
        return next?.WorkoutName ?? "No session yet";
    }
    private static string ProgramDescriptionId(WorkoutProgramView program) => $"program-description-{program.Id:N}";
    private static string ProgramAccessibleDescription(WorkoutProgramView program) =>
        $"{program.Category} plan. Next: {NextWorkoutLabel(program)}. {ProgramProgress(program)}.";
    private static double ProgramProgressPercent(WorkoutProgramView program) => program.Items.Count == 0 ? 0 : Math.Clamp((program.CompletedItemCount + program.SkippedItemCount) * 100d / program.Items.Count, 0, 100);
    private static string DurationLabel(double? minutes) => minutes is null ? "Distance" : $"{minutes:0} min";
    private static string VariantLabel(string variant) => variant switch
    {
        "hr-alternative" => "Heart-rate option",
        "fixed-fallback" => "Fixed-speed option",
        _ => variant.Replace('-', ' '),
    };
    private static string RevisionHref(WorkoutSummaryView workout) => $"/workouts/new?workoutId={workout.Id:D}&name={Uri.EscapeDataString(workout.Name)}";

    private sealed class ProgramDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = "5K";
        public List<ProgramDraftItem> Items { get; set; } = [];
    }

    private sealed record ProgramDraftItem(Guid WorkoutRevisionId, string WorkoutName, int WorkoutRevisionNumber, double? DurationMinutes);
    private sealed record PendingProgramStart(WorkoutProgramView Program, bool Restart, WorkoutProgramView? Active);
    private sealed record PendingArchive(ArchiveKind Kind, Guid Id, string Name);
    private enum ArchiveKind { Workout, Program }

    public async ValueTask DisposeAsync()
    {
        programDraftDebounce?.Cancel();
        programDraftDebounce?.Dispose();
        if (selectedWorkoutDetails is not null || selectedPlanWorkoutName is not null)
        {
            try { await JS.InvokeVoidAsync("treadmillRunnerView.closeModal"); }
            catch (JSDisconnectedException) { }
        }
        workoutDetailsModalReference = null;
    }
}
