    private void MoveProgramItem(int index, int delta)
    {
        int destination = index + delta;
        if (index < 0 || index >= programDraft.Items.Count || destination < 0 || destination >= programDraft.Items.Count) return;
        ProgramDraftItem item = programDraft.Items[index];
        programDraft.Items.RemoveAt(index);
        programDraft.Items.Insert(destination, item);
        QueueProgramDraftSave();
    }

    private void RemoveProgramItem(int index)
    {
        if (index >= 0 && index < programDraft.Items.Count) { programDraft.Items.RemoveAt(index); QueueProgramDraftSave(); }
    }

    private void DuplicateProgramItem(int index)
    {
        if (index >= 0 && index < programDraft.Items.Count)
