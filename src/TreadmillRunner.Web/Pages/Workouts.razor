    private IReadOnlyList<WorkoutProgramView> FilteredPrograms => programs
        .Where(program => programCategory == "All" || string.Equals(program.Category, programCategory, StringComparison.CurrentCultureIgnoreCase))
        .Where(program => string.IsNullOrWhiteSpace(programSearch) || program.Name.Contains(programSearch, StringComparison.CurrentCultureIgnoreCase) || (program.Description?.Contains(programSearch, StringComparison.CurrentCultureIgnoreCase) ?? false))
        .OrderBy(static program => program.Category, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(static program => program.Name, StringComparer.CurrentCultureIgnoreCase)
