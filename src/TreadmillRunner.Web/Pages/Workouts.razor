            string programUrl = activeProfileId is { } profileId ? $"api/planning/programs?profileId={profileId}" : "api/planning/programs";
            programs = await Http.GetFromJsonAsync<List<WorkoutProgramView>>(programUrl) ?? [];
            string catalogUrl = activeProfileId is { } selectedProfileId ? $"api/planning/premade-plans?profileId={selectedProfileId}" : "api/planning/premade-plans";
