    private IReadOnlyList<PremadePlanCatalogView> FilteredPremadePlans => premadePlans
        .Where(plan => string.IsNullOrWhiteSpace(premadeSearch) || plan.Name.Contains(premadeSearch, StringComparison.CurrentCultureIgnoreCase) || plan.Description.Contains(premadeSearch, StringComparison.CurrentCultureIgnoreCase) || plan.Tags.Any(tag => tag.Contains(premadeSearch, StringComparison.CurrentCultureIgnoreCase)))
        .Where(plan => premadeGoal == "All" || string.Equals(plan.Goal, premadeGoal, StringComparison.CurrentCultureIgnoreCase) || plan.Tags.Contains(premadeGoal, StringComparer.CurrentCultureIgnoreCase))
        .Where(plan => premadeExperience == "All" || string.Equals(plan.Experience, premadeExperience, StringComparison.CurrentCultureIgnoreCase))
        .Where(plan => premadeHeartRate == "All" || (premadeHeartRate == "Required" ? plan.RequiresHeartRate : !plan.RequiresHeartRate))
        .Where(plan => premadeDuration switch { "30" => plan.MaximumDurationMinutes <= 30, "45" => plan.MaximumDurationMinutes <= 45, "60" => plan.MaximumDurationMinutes <= 60, "61" => plan.MaximumDurationMinutes > 60, _ => true })
        .Where(plan => premadeFrequency == "All" || plan.SessionsPerWeek.ToString(System.Globalization.CultureInfo.InvariantCulture) == premadeFrequency)
        .OrderBy(static plan => plan.Goal, StringComparer.CurrentCultureIgnoreCase)
        .ThenBy(static plan => plan.Weeks)
        .ThenBy(static plan => plan.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    private bool HasFilters => !string.IsNullOrWhiteSpace(searchText) || durationFilter != "all" || structureFilter != "all" || sortOrder != "updated";
    private bool HasProgramFilters => !string.IsNullOrWhiteSpace(programSearch) || programCategory != "All";
    private bool HasPremadeFilters => !string.IsNullOrWhiteSpace(premadeSearch) || premadeGoal != "All" ||
        premadeExperience != "All" || premadeHeartRate != "All" || premadeDuration != "All" || premadeFrequency != "All";
    private bool CanSaveProgram => !string.IsNullOrWhiteSpace(programDraft.Name) && !string.IsNullOrWhiteSpace(programDraft.Category) && programDraft.Items.Count > 0;
    private string ProgramDurationLabel
    {
        get
