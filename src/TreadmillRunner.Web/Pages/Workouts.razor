    private IReadOnlyList<WorkoutSummaryView> FilteredWorkouts
    {
        get
        {
            IEnumerable<WorkoutSummaryView> result = ProgramEligibleWorkouts.Where(MatchesSearch).Where(MatchesDuration).Where(MatchesStructure);
            result = sortOrder switch
            {
                "title" => result.OrderBy(static workout => workout.Name, StringComparer.CurrentCultureIgnoreCase),
                "duration" => result.OrderBy(static workout => workout.DurationMinutes ?? double.MaxValue).ThenBy(static workout => workout.Name, StringComparer.CurrentCultureIgnoreCase),
                _ => result.OrderByDescending(static workout => workout.UpdatedAtUtc),
