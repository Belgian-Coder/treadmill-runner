    private bool MatchesSearch(WorkoutSummaryView workout) => string.IsNullOrWhiteSpace(searchText) ||
        workout.Name.Contains(searchText, StringComparison.CurrentCultureIgnoreCase) ||
        (workout.Description?.Contains(searchText, StringComparison.CurrentCultureIgnoreCase) ?? false) ||
        workout.StructureLabel.Contains(searchText, StringComparison.CurrentCultureIgnoreCase) ||
        workout.GoalLabel.Contains(searchText, StringComparison.CurrentCultureIgnoreCase) ||
        workout.SpeedLabel.Contains(searchText, StringComparison.CurrentCultureIgnoreCase) ||
        workout.InclineLabel.Contains(searchText, StringComparison.CurrentCultureIgnoreCase);
    private bool MatchesDuration(WorkoutSummaryView workout) => durationFilter switch { "short" => workout.DurationMinutes is <= 30, "medium" => workout.DurationMinutes is > 30 and <= 60, "long" => workout.DurationMinutes is > 60, "distance" => workout.DurationMinutes is null, _ => true };
    private bool MatchesStructure(WorkoutSummaryView workout) => structureFilter switch
    {
        "heart-rate" => workout.UsesHeartRate,
        "intervals" => workout.StructureLabel.Contains("interval", StringComparison.OrdinalIgnoreCase),
        "progression" => string.Equals(workout.StructureLabel, "Progression", StringComparison.OrdinalIgnoreCase),
        "steady" => string.Equals(workout.StructureLabel, "Steady", StringComparison.OrdinalIgnoreCase),
        "multi-stage" => string.Equals(workout.StructureLabel, "Multi-stage", StringComparison.OrdinalIgnoreCase),
        _ => true,
    };
    private void ClearFilters() { searchText = string.Empty; durationFilter = "all"; structureFilter = "all"; sortOrder = "updated"; }
