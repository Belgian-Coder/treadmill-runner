            double[] durations = programDraft.Items.Where(static item => item.DurationMinutes is not null).Select(static item => item.DurationMinutes!.Value).ToArray();
            return durations.Length == programDraft.Items.Count ? $"{durations.Sum():0} min" : "Mixed goals";
