@page "/devices"

@inject HttpClient Http

<PageTitle>Devices · TreadmillRunner</PageTitle>

<section class="page-stack" aria-labelledby="devices-title">
    <header class="page-heading">
        <div><p class="eyebrow">Local Bluetooth</p><h1 id="devices-title">Devices</h1></div>
        <p>Add the household treadmill, Polar straps, and Garmin watch broadcasts once. Enabled heart-rate sensors reconnect automatically; each runner keeps an independent preferred device and fallback order.</p>
    </header>

    <section class="safety-banner" aria-label="Device safety notice">
        <span class="safety-icon" aria-hidden="true">!</span>
        <p><strong>The physical console remains authoritative.</strong> This screen can discover, read, and subscribe only. A hardware-verified Start control appears only on the Run screen.</p>
    </section>

    <section class="device-grid" aria-label="Enrolled device status">
        @{ DeviceEnrollmentView? treadmill = enrollments.FirstOrDefault(item => item.Role == "Treadmill"); }
        <article class="panel-card device-card">
            <p class="eyebrow">Treadmill</p>
            <h2>@(treadmill?.DisplayName ?? "Not enrolled")</h2>
            @if (treadmill is null)
            {
                <p>No local treadmill enrollment.</p>
            }
            else
            {
                <dl class="device-facts">
                    <div><dt>Connection</dt><dd>@(status?.Treadmill.State.ToString() ?? "Unavailable")</dd></div>
                    <div><dt>Firmware</dt><dd>@(treadmill.FirmwareRevision ?? "Not reported")</dd></div>
                </dl>
                <details class="advanced-settings"><summary>Connection details</summary>
                    <dl class="device-facts">
                        <div><dt>Protocol</dt><dd>@treadmill.ProtocolId</dd></div>
                        <div><dt>Mode</dt><dd>@treadmill.TelemetryMode</dd></div>
                        <div><dt>Identity</dt><dd>@RedactDeviceId(treadmill.DeviceId)</dd></div>
                    </dl>
                </details>
                <button class="touch-action" type="button" @onclick="() => ForgetAsync(treadmill)">Forget treadmill</button>
            }
        </article>

        @foreach (DeviceEnrollmentView enrollment in enrollments.Where(item => item.Role == "HeartRate"))
        {
            HeartRateSourceSnapshot? source = status?.HeartRateSources?.FirstOrDefault(item => item.EnrollmentId == enrollment.Id);
            <article class="panel-card device-card">
                <p class="eyebrow">Heart-rate sensor</p>
                <h2>@enrollment.DisplayName</h2>
                <div class="sensor-badges" aria-label="Heart-rate sensor type">
                    <span class="sensor-badge">@KindLabel(enrollment.HeartRateDeviceKind)</span>
                    <span class="sensor-badge">@(enrollment.HeartRateDeviceFamily ?? "Bluetooth")</span>
                    @if (IsPolar(enrollment) || enrollment.Assignments.Any(item => item.IsPreferred))
                    {
                        <span class="sensor-badge sensor-badge--preferred">Preferred</span>
                    }
                </div>
                <dl class="device-facts">
                    <div><dt>Connection</dt><dd>@(source?.State.ToString() ?? "Waiting")</dd></div>
                    <div><dt>Current pulse</dt><dd>@(source?.BeatsPerMinute is ushort bpm ? $"{bpm} bpm" : "No reading")</dd></div>
                    <div><dt>Battery</dt><dd>@FormatBattery(source)</dd></div>
                </dl>
                <details class="advanced-settings"><summary>Manage sensor</summary>
                <dl class="device-facts">
                    <div><dt>Freshness</dt><dd>@FormatFreshness(source?.ObservedAt)</dd></div>
                    <div><dt>Auto-connect</dt><dd>@(IsPolar(enrollment) ? "Always on" : enrollment.Assignments.Any(item => item.AutoConnect) ? "On" : "Off")</dd></div>
                </dl>
                <fieldset class="sensor-assignment-editor">
                    <legend>Use for runner</legend>
                    <div class="runner-button-row">
                        @foreach (ProfileSummary profile in profiles)
                        {
                            bool assigned = enrollment.Assignments.Any(item => item.UserProfileId == profile.Id);
                            <button type="button" class="sensor-runner-choice @(assigned ? "sensor-runner-choice--selected" : null)"
                                    aria-pressed="@assigned" @onclick="() => ToggleRunnerAsync(enrollment, profile.Id)">@profile.DisplayName</button>
                        }
                    </div>
                </fieldset>
                <div class="device-actions">
                    @if (!IsPolar(enrollment))
                    {
                        <button class="touch-action" type="button" @onclick="() => ToggleAutoConnectAsync(enrollment)">
                            @(enrollment.Assignments.Any(item => item.AutoConnect) ? "Disable auto-connect" : "Enable auto-connect")
                        </button>
                        <button class="touch-action" type="button" @onclick="() => MakePreferredAsync(enrollment)">Make preferred</button>
                    }
                    <button class="touch-action" type="button" @onclick="() => ChangePriorityAsync(enrollment, -1)" aria-label="Raise fallback priority">Priority ↑</button>
                    <button class="touch-action" type="button" @onclick="() => ChangePriorityAsync(enrollment, 1)" aria-label="Lower fallback priority">Priority ↓</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(source?.Fault))
                {
                    <p class="device-fault" role="alert">@source.Fault</p>
                }
                <button class="touch-action" type="button" @onclick="() => ForgetAsync(enrollment)">Forget sensor</button>
                </details>
            </article>
        }
        @if (!enrollments.Any(item => item.Role == "HeartRate"))
        {
            <article class="panel-card device-card"><p class="eyebrow">Heart-rate sensors</p><h2>None added</h2><p>Scan below while a Polar strap or Garmin HR Broadcast is advertising.</p></article>
        }
    </section>

    @if (maintenance is not null)
    {
        <section class="panel-card maintenance-panel" aria-labelledby="maintenance-title">
            <div class="panel-heading">
                <div><p class="eyebrow">Treadmill care</p><h2 id="maintenance-title">Maintenance</h2></div>
                <span class="status-chip">@MaintenanceStateLabel(maintenance.State)</span>
            </div>
            @if (maintenance.State == TreadmillMaintenanceState.SetupRequired)
            {
                <p>Record the last belt/deck service to start reminders. No due warning is shown until a baseline exists.</p>
            }
            else
            {
                <dl class="device-facts">
                    <div><dt>App-tracked hardware distance</dt><dd>@maintenance.AppTrackedHardwareDistanceKilometers.ToString("0.0") km</dd></div>
                    <div><dt>Next date</dt><dd>@(maintenance.NextDueAtUtc?.ToLocalTime().ToString("d") ?? "Not set")</dd></div>
                    <div><dt>Remaining</dt><dd>@(maintenance.RemainingKilometers is { } remaining ? $"{remaining:0.0} km" : "Not set")</dd></div>
                    <div><dt>Last recorded</dt><dd>@(maintenance.LastEvent?.PerformedAtUtc.ToLocalTime().ToString("d") ?? "Not set")</dd></div>
                </dl>
            }
            <p class="field-hint">@maintenance.UsageNotice</p>
            <p class="field-error"><strong>Check the exact Omega Z manual before lubricating.</strong> Waxed surfaces must not be lubricated. The 3-month/241-km default applies only to Horizon silicone-surface guidance.</p>
            <details class="advanced-settings">
                <summary>Reminder settings and service history</summary>
                <div class="integration-form-grid">
                    <label class="field">Months<input type="number" min="1" max="24" @bind="maintenanceMonths" /></label>
                    <label class="field">Distance (km)<input type="number" min="1" max="5000" step="1" @bind="maintenanceDistance" /></label>
                </div>
                <button class="secondary-action" type="button" disabled="@maintenanceBusy" @onclick="SaveMaintenancePolicyAsync">Save reminder</button>
                <div class="integration-form-grid maintenance-record-form">
                    <label class="field">Service date<input type="date" @bind="maintenanceDate" @bind:format="yyyy-MM-dd" /></label>
                    <label class="field">Note (optional)<input maxlength="500" @bind="maintenanceNote" placeholder="Inspection, lubrication, or service" /></label>
                </div>
                <button class="primary-action" type="button" disabled="@maintenanceBusy" @onclick="RecordMaintenanceAsync">@(maintenanceBusy ? "Recording…" : "Record maintenance")</button>
                @if (maintenance.Events.Count > 0)
                {
                    <ol class="event-list">
                        @foreach (TreadmillMaintenanceEvent item in maintenance.Events)
                        {
                            <li><strong>@item.PerformedAtUtc.ToLocalTime().ToString("d")</strong> · baseline @item.AppDistanceBaselineKilometers.ToString("0.0") km@(string.IsNullOrWhiteSpace(item.Note) ? string.Empty : $" · {item.Note}")</li>
                        }
                    </ol>
                }
            </details>
            @if (!string.IsNullOrWhiteSpace(maintenanceMessage)) { <p class="action-status" role="status">@maintenanceMessage</p> }
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(maintenanceLoadError))
    {
        <section class="panel-card device-card" aria-labelledby="maintenance-unavailable-title">
            <p class="eyebrow">Treadmill care</p>
            <h2 id="maintenance-unavailable-title">Maintenance status unavailable</h2>
            <p class="field-error" role="status">@maintenanceLoadError</p>
            <button class="secondary-action" type="button" @onclick="LoadMaintenanceAsync">Try again</button>
        </section>
    }

    <details class="panel-card advanced-settings">
        <summary>Bluetooth reliability report</summary>
        <p class="field-hint">A local, sanitized record of connection outages and recoveries. Raw Windows Bluetooth identifiers and identity fingerprints are never included.</p>
        <div class="controls-card reliability-window-picker" aria-label="Reliability reporting period">
            @foreach (int days in new[] { 1, 7, 30, 90 })
            {
                <button class="secondary-action" type="button" aria-pressed="@(reliabilityDays == days)"
                        @onclick="() => LoadReliabilityAsync(days)">@days day@(days == 1 ? string.Empty : "s")</button>
            }
        </div>
        @if (reliabilityLoading)
        {
            <p role="status">Loading connection history…</p>
        }
        else if (reliability?.Devices.Count > 0)
        {
            <div class="device-list">
                @foreach (BleDeviceReliabilityView device in reliability.Devices)
                {
                    <article class="device-candidate">
                        <div>
                            <h3>@device.DisplayName</h3>
                            <p>@device.CurrentState · @device.IncidentCount outage@(device.IncidentCount == 1 ? string.Empty : "s") · @device.RecoveredIncidentCount recovered</p>
                            @if (device.CurrentOutageStartedAtUtc is { } outage)
                            {
                                <p class="device-fault" role="status">Disconnected since @FormatTimestamp(outage); @device.CurrentFailedAttemptCount reconnect attempt@(device.CurrentFailedAttemptCount == 1 ? string.Empty : "s").</p>
                            }
                            else if (device.LastRecoverySeconds is { } recovery)
                            {
                                <p>Last recovery: @FormatDuration(recovery) · longest: @FormatDuration(device.LongestRecoverySeconds)</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="empty-state">No Bluetooth outages were recorded in this period.</p>
        }
    </details>

    <section class="panel-card device-discovery" aria-labelledby="discovery-title">
        <div class="section-heading">
            <div><p class="eyebrow">Bounded passive scan</p><h2 id="discovery-title">Nearby supported devices</h2></div>
            <button class="primary-action" type="button" @onclick="ScanAsync" disabled="@isScanning">
                @(isScanning ? "Scanning…" : "Scan for 5 seconds")
            </button>
        </div>

        <fieldset class="sensor-assignment-editor">
            <legend>New heart-rate sensors are available to</legend>
            <div class="runner-button-row">
                @foreach (ProfileSummary profile in profiles)
                {
                    bool selected = newSensorProfiles.Contains(profile.Id);
                    <button type="button" class="sensor-runner-choice @(selected ? "sensor-runner-choice--selected" : null)"
                            aria-pressed="@selected" @onclick="() => ToggleNewSensorProfile(profile.Id)">@profile.DisplayName</button>
                }
                <button type="button" class="sensor-runner-choice" @onclick="SelectEveryone">Everyone</button>
            </div>
            <p class="field-hint">Polar can be shared by both runners. A private watch should be assigned only to its owner.</p>
        </fieldset>

        @if (candidates.Count == 0)
        {
            <p class="empty-state">@scanMessage</p>
        }
        else
        {
            <div class="device-list">
                @foreach (ScanCandidate candidate in candidates)
                {
                    <article class="device-candidate">
                        <div>
                            <h3>@DisplayName(candidate)</h3>
                            @if (candidate.SupportedRoles.Contains("HeartRate", StringComparer.OrdinalIgnoreCase))
                            {
                                <div class="sensor-badges">
                                    <span class="sensor-badge">@KindLabel(candidate.HeartRateDeviceKind)</span>
                                    @if (candidate.IsPreferredHeartRate)
                                    {
                                        <span class="sensor-badge sensor-badge--preferred">Polar preferred</span>
                                    }
                                </div>
                            }
                            <p>@RedactDeviceId(candidate.DeviceId) · signal @(candidate.SignalStrength?.ToString() ?? "unknown") dBm</p>
                            <p>@candidate.ServiceUuids.Count advertised service(s)</p>
                        </div>
                        <div class="device-actions">
                            @if (candidate.SupportedRoles.Contains("Treadmill", StringComparer.OrdinalIgnoreCase))
                            {
                                <label class="field">Telemetry path
                                    <select @bind="telemetryMode">
                                        <option value="Ftms">FTMS</option>
                                        <option value="Vendor">Omega vendor notification</option>
                                    </select>
                                </label>
                                <button class="touch-action" type="button" @onclick='() => EnrollAsync(candidate, "Treadmill")'>Enroll treadmill</button>
                            }
                            @if (candidate.SupportedRoles.Contains("HeartRate", StringComparer.OrdinalIgnoreCase))
                            {
                                <button class="touch-action" type="button" @onclick='() => EnrollAsync(candidate, "HeartRate")'>
                                    @(candidate.IsPreferredHeartRate ? "Enroll preferred Polar" : "Enroll heart-rate monitor")
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        <p class="action-status" role="status">@actionStatus</p>
    </section>

    <details class="panel-card advanced-settings">
        <summary id="watch-sync-title">Watch and health-app setup</summary>
        <p><strong>Garmin Connect:</strong> start a native Treadmill activity on the watch and enable HR Broadcast. TreadmillRunner reads that live pulse while the watch records Garmin's full training metrics. Use the session FIT download only as a manual fallback to avoid duplicate activities.</p>
        <p><strong>Apple Health:</strong> the Windows gateway cannot write HealthKit directly. FIT export is available now; a future iPhone companion can save the indoor workout and time-series samples with your permission.</p>
        <p class="field-hint">Automatic connection cannot remotely switch Garmin broadcast on. Once the watch starts broadcasting the standard Bluetooth Heart Rate service, the gateway reconnects without another scan or setup.</p>
    </details>
</section>

@code {
    private IReadOnlyList<DeviceEnrollmentView> enrollments = Array.Empty<DeviceEnrollmentView>();
    private IReadOnlyList<ProfileSummary> profiles = Array.Empty<ProfileSummary>();
    private IReadOnlyList<ScanCandidate> candidates = Array.Empty<ScanCandidate>();
    private readonly HashSet<Guid> newSensorProfiles = [];
    private DeviceTelemetrySnapshot? status;
    private BleReliabilityReportView? reliability;
    private int reliabilityDays = 7;
    private bool reliabilityLoading;
    private string telemetryMode = "Ftms";
    private string scanMessage = "Run a scan while the Omega Z and Polar H10 are powered and advertising.";
    private string actionStatus = "Enrollment changes are available only while no workout is active.";
    private bool isScanning;
    private TreadmillMaintenanceSnapshot? maintenance;
    private int maintenanceMonths = 3;
    private double maintenanceDistance = 241;
    private DateTime maintenanceDate = DateTime.Today;
    private string maintenanceNote = string.Empty;
    private string maintenanceMessage = string.Empty;
    private string maintenanceLoadError = string.Empty;
    private bool maintenanceBusy;
    private Guid maintenanceEventOperationId;

    protected override async Task OnInitializedAsync() => await Task.WhenAll(RefreshAsync(), LoadReliabilityAsync(7), LoadMaintenanceAsync());

    private async Task LoadMaintenanceAsync()
    {
        maintenanceLoadError = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync("api/devices/treadmill/maintenance");
            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                maintenance = null;
                return;
            }
            response.EnsureSuccessStatusCode();
            maintenance = await response.Content.ReadFromJsonAsync<TreadmillMaintenanceSnapshot>();
            if (maintenance is not null)
            {
                maintenanceMonths = maintenance.Policy.IntervalMonths;
                maintenanceDistance = maintenance.Policy.DistanceIntervalKilometers;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            maintenance = null;
            maintenanceLoadError = "The gateway could not load maintenance data. No reminder settings were changed.";
        }
    }

    private async Task SaveMaintenancePolicyAsync()
    {
        if (maintenance is null) return;
        using HttpResponseMessage response = await Http.PutAsJsonAsync("api/devices/treadmill/maintenance/policy", new
        {
            operationId = Guid.NewGuid(),
            intervalMonths = maintenanceMonths,
            distanceIntervalKilometers = maintenanceDistance,
            expectedVersion = maintenance.Policy.Version,
        });
        maintenanceMessage = response.IsSuccessStatusCode
            ? "Maintenance reminder updated."
            : await ReadFailureAsync(response, "The maintenance reminder could not be updated.");
        if (response.IsSuccessStatusCode) await LoadMaintenanceAsync();
    }

    private async Task RecordMaintenanceAsync()
    {
        if (maintenance is null || maintenanceBusy)
        {
            if (maintenance is null) maintenanceMessage = "Choose a valid service date.";
            return;
        }
        maintenanceBusy = true;
        maintenanceEventOperationId = maintenanceEventOperationId == Guid.Empty ? Guid.NewGuid() : maintenanceEventOperationId;
        try
        {
            DateTime local = DateTime.SpecifyKind(maintenanceDate.Date.AddHours(12), DateTimeKind.Local);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/devices/treadmill/maintenance/events", new
            {
                operationId = maintenanceEventOperationId,
                performedAtUtc = new DateTimeOffset(local).ToUniversalTime(),
                note = maintenanceNote,
                expectedPolicyVersion = maintenance.Policy.Version,
            });
            maintenanceMessage = response.IsSuccessStatusCode
                ? "Maintenance recorded and the reminder baseline was reset."
                : await ReadFailureAsync(response, "Maintenance could not be recorded.");
            maintenanceEventOperationId = Guid.Empty;
            if (response.IsSuccessStatusCode)
            {
                maintenanceNote = string.Empty;
                await LoadMaintenanceAsync();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            maintenanceMessage = "The result is unknown because the gateway became unavailable. Retry uses the same operation and cannot create a duplicate event.";
        }
        finally { maintenanceBusy = false; }
    }

    private static string MaintenanceStateLabel(TreadmillMaintenanceState state) => state switch
    {
        TreadmillMaintenanceState.SetupRequired => "Set up",
        TreadmillMaintenanceState.Current => "Current",
        TreadmillMaintenanceState.DueByDate => "Due by date",
        TreadmillMaintenanceState.DueByDistance => "Due by distance",
        TreadmillMaintenanceState.DueByDateAndDistance => "Due",
        _ => state.ToString(),
    };

    private async Task LoadReliabilityAsync(int days)
    {
        reliabilityDays = days;
        reliabilityLoading = true;
        try
        {
            reliability = await Http.GetFromJsonAsync<BleReliabilityReportView>($"api/devices/reliability?days={days}");
        }
        catch (HttpRequestException)
        {
            reliability = null;
        }
        finally
        {
            reliabilityLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        enrollments = await Http.GetFromJsonAsync<DeviceEnrollmentView[]>("api/devices/enrollments")
            ?? Array.Empty<DeviceEnrollmentView>();
        profiles = await Http.GetFromJsonAsync<ProfileSummary[]>("api/planning/profiles")
            ?? Array.Empty<ProfileSummary>();
        if (newSensorProfiles.Count == 0)
        {
            foreach (ProfileSummary profile in profiles) newSensorProfiles.Add(profile.Id);
        }
        status = await Http.GetFromJsonAsync<DeviceTelemetrySnapshot>("api/devices/status");
    }

    private async Task ScanAsync()
    {
        isScanning = true;
        actionStatus = "Listening for supported advertisements…";
        try
        {
            candidates = await Http.GetFromJsonAsync<ScanCandidate[]>("api/devices/scan?durationSeconds=5")
                ?? Array.Empty<ScanCandidate>();
            scanMessage = candidates.Count == 0
                ? "No supported treadmill or heart-rate advertisements were observed. Check power and Bluetooth advertising, then try again."
                : string.Empty;
            actionStatus = $"Scan complete: {candidates.Count} supported device(s) found.";
        }
        catch (HttpRequestException)
        {
            actionStatus = "The bounded scan failed. The gateway log contains the local diagnostic detail.";
        }
        finally
        {
            isScanning = false;
        }
    }

    private async Task EnrollAsync(ScanCandidate candidate, string role)
    {
        using HttpResponseMessage response = await Http.PostAsJsonAsync("api/devices/enrollments", new
        {
            operationId = Guid.NewGuid(),
            role,
            candidate.DeviceId,
            displayName = DisplayName(candidate),
            advertisedName = candidate.Name,
            candidate.ServiceUuids,
            modelNumber = (string?)null,
            firmwareRevision = (string?)null,
            telemetryMode = role == "Treadmill" ? telemetryMode : null,
            ownerProfileIds = role == "HeartRate" ? newSensorProfiles.ToArray() : Array.Empty<Guid>(),
            autoConnect = true,
            isPreferred = candidate.IsPreferredHeartRate,
        });
        actionStatus = response.IsSuccessStatusCode
            ? $"{DisplayName(candidate)} enrolled for {RoleLabel(role)}. The gateway is establishing read-only telemetry."
            : await ReadFailureAsync(response, "The device could not be enrolled.");
        if (response.IsSuccessStatusCode) await RefreshAsync();
    }

    private async Task ForgetAsync(DeviceEnrollmentView enrollment)
    {
        using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/devices/enrollments/{enrollment.Id}")
        {
            Content = JsonContent.Create(new { operationId = Guid.NewGuid(), expectedVersion = enrollment.Version }),
        };
        using HttpResponseMessage response = await Http.SendAsync(request);
        actionStatus = response.IsSuccessStatusCode
            ? $"{enrollment.DisplayName} was forgotten."
            : await ReadFailureAsync(response, "The enrollment could not be removed.");
        if (response.IsSuccessStatusCode) await RefreshAsync();
    }

    private void ToggleNewSensorProfile(Guid profileId)
    {
        if (!newSensorProfiles.Add(profileId)) newSensorProfiles.Remove(profileId);
    }

    private void SelectEveryone()
    {
        newSensorProfiles.Clear();
        foreach (ProfileSummary profile in profiles) newSensorProfiles.Add(profile.Id);
    }

    private async Task ToggleRunnerAsync(DeviceEnrollmentView enrollment, Guid profileId)
    {
        Guid[] profileIds = enrollment.Assignments.Any(item => item.UserProfileId == profileId)
            ? enrollment.Assignments.Where(item => item.UserProfileId != profileId).Select(item => item.UserProfileId).ToArray()
            : enrollment.Assignments.Select(item => item.UserProfileId).Append(profileId).Distinct().ToArray();
        await ConfigureAsync(enrollment, profileIds, enrollment.Assignments.Any(item => item.AutoConnect), enrollment.Assignments.Any(item => item.IsPreferred), CurrentPriority(enrollment));
    }

    private Task ToggleAutoConnectAsync(DeviceEnrollmentView enrollment) => ConfigureAsync(
        enrollment,
        enrollment.Assignments.Select(item => item.UserProfileId).ToArray(),
        !enrollment.Assignments.Any(item => item.AutoConnect),
        enrollment.Assignments.Any(item => item.IsPreferred),
        CurrentPriority(enrollment));

    private Task MakePreferredAsync(DeviceEnrollmentView enrollment) => ConfigureAsync(
        enrollment,
        enrollment.Assignments.Select(item => item.UserProfileId).ToArray(),
        true,
        true,
        CurrentPriority(enrollment));

    private Task ChangePriorityAsync(DeviceEnrollmentView enrollment, int change) => ConfigureAsync(
        enrollment,
        enrollment.Assignments.Select(item => item.UserProfileId).ToArray(),
        enrollment.Assignments.Any(item => item.AutoConnect),
        enrollment.Assignments.Any(item => item.IsPreferred),
        Math.Clamp(CurrentPriority(enrollment) + change, 0, 99));

    private async Task ConfigureAsync(
        DeviceEnrollmentView enrollment,
        Guid[] ownerProfileIds,
        bool autoConnect,
        bool preferred,
        int priority)
    {
        using HttpResponseMessage response = await Http.PutAsJsonAsync(
            $"api/devices/enrollments/{enrollment.Id}/assignments",
            new { operationId = Guid.NewGuid(), ownerProfileIds, autoConnect, isPreferred = preferred, priority });
        actionStatus = response.IsSuccessStatusCode
            ? $"Automatic connection settings for {enrollment.DisplayName} were saved."
            : await ReadFailureAsync(response, "The sensor settings could not be saved.");
        if (response.IsSuccessStatusCode) await RefreshAsync();
    }

    private static int CurrentPriority(DeviceEnrollmentView enrollment) =>
        enrollment.Assignments.Count == 0 ? HeartRateDeviceClassifier.Priority(enrollment.DisplayName) : enrollment.Assignments.Min(item => item.Priority);

    private static bool IsPolar(DeviceEnrollmentView enrollment) =>
        string.Equals(enrollment.HeartRateDeviceFamily, "Polar", StringComparison.OrdinalIgnoreCase);

    private static async Task<string> ReadFailureAsync(HttpResponseMessage response, string fallback)
    {
        string detail = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(detail) ? fallback : $"{fallback} {detail}";
    }

    private static string DisplayName(ScanCandidate candidate) =>
        string.IsNullOrWhiteSpace(candidate.Name)
            ? candidate.IsPreferredHeartRate ? "Polar heart-rate sensor" : "Unnamed Bluetooth device"
            : candidate.Name;

    private static string KindLabel(string? kind) =>
        Enum.TryParse(kind, ignoreCase: true, out HeartRateDeviceKind parsed) ? KindLabel(parsed) : "HR sensor";

    private static string KindLabel(HeartRateDeviceKind kind) => kind switch
    {
        HeartRateDeviceKind.ChestStrap => "Chest strap",
        HeartRateDeviceKind.Watch => "Watch",
        _ => "HR sensor",
    };

    private static string RoleLabel(string role) =>
        string.Equals(role, "HeartRate", StringComparison.OrdinalIgnoreCase) ? "heart-rate telemetry" : "treadmill telemetry";

    private static string RedactDeviceId(string deviceId) =>
        deviceId.Length <= 4 ? "device …" : $"device …{deviceId[^4..]}";

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("g") ?? "Not yet verified";

    private static string FormatBattery(HeartRateSourceSnapshot? source) => source?.BatteryPercent is byte battery
        ? $"{battery}% · {FormatTimestamp(source.BatteryObservedAt)}"
        : "Not reported";

    private static string FormatDuration(double? seconds) => seconds is null
        ? "—"
        : seconds < 60 ? $"{seconds:0.#} s" : $"{TimeSpan.FromSeconds(seconds.Value):m\\:ss}";

    private string FormatFreshness(DateTimeOffset? value) => value is null || status is null
        ? "No sample"
        : $"{Math.Max(0, (status.CapturedAt - value.Value).TotalSeconds):0.0} s";

    private sealed record ScanCandidate(
        string DeviceId,
        string? Name,
        short? SignalStrength,
        IReadOnlyList<Guid> ServiceUuids,
        IReadOnlyList<string> SupportedRoles,
        string? HeartRateDeviceKind,
        bool IsPreferredHeartRate);

    private sealed record DeviceEnrollmentView(
        Guid Id,
        string Role,
        string DeviceId,
        string ProtocolId,
        string IdentityFingerprint,
        string DisplayName,
        string? ModelNumber,
        string? FirmwareRevision,
        string? TelemetryMode,
        TreadmillCapabilities? Capabilities,
        string Evidence,
        DateTimeOffset? LastVerifiedAtUtc,
        int Version,
        string? HeartRateDeviceKind,
        string? HeartRateDeviceFamily,
        IReadOnlyList<HeartRateAssignmentView> Assignments);

    private sealed record HeartRateAssignmentView(
        Guid Id,
        Guid UserProfileId,
        int Priority,
        bool AutoConnect,
        bool IsPreferred,
        int Version);

    private sealed record BleReliabilityReportView(
        DateTimeOffset CapturedAtUtc,
        DateTimeOffset WindowStartedAtUtc,
        int WindowDays,
        IReadOnlyList<BleDeviceReliabilityView> Devices);

    private sealed record BleDeviceReliabilityView(
        Guid EnrollmentId,
        string DisplayName,
        string Role,
        string CurrentState,
        long ConnectionGeneration,
        DateTimeOffset? LastTelemetryAtUtc,
        int IncidentCount,
        int RecoveredIncidentCount,
        DateTimeOffset? CurrentOutageStartedAtUtc,
        int CurrentFailedAttemptCount,
        double? LastRecoverySeconds,
        double? LongestRecoverySeconds,
        string? LastFailureKind,
        string? LastSanitizedFault,
        byte? BatteryPercent,
        DateTimeOffset? BatteryObservedAtUtc);

    private sealed class ProfileSummary
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = string.Empty;
    }
