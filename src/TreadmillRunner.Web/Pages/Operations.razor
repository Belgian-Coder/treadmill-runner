@page "/operations"
@implements IAsyncDisposable
@using System.Net.Http.Headers
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject TreadmillRunner.Web.ClientRuntimeState Runtime

<PageTitle>Operations · TreadmillRunner</PageTitle>

<section class="page-stack" aria-labelledby="operations-title">
    <header class="page-heading">
        <div><p class="eyebrow">Recovery and release</p><h1 id="operations-title">Operations</h1></div>
        <p>Backup, restore, diagnostics, and signed updates are available only while no workout is active.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(message)) { <p class="notice" role="status">@message</p> }

    @if (operationsSummaryLoading)
    {
        <section class="panel-card operations-summary-card" aria-labelledby="operations-summary-title" aria-busy="true">
            <div class="panel-heading"><div><p class="eyebrow">One local view</p><h2 id="operations-summary-title">Operations summary</h2></div><span>Loading</span></div>
            <p class="muted" role="status">Loading local health components…</p>
        </section>
    }
    else if (operationsSummary is { } summary)
    {
        <section class="panel-card operations-summary-card" aria-labelledby="operations-summary-title">
            <div class="panel-heading"><div><p class="eyebrow">One local view</p><h2 id="operations-summary-title">Operations summary</h2></div><span>@summary.State</span></div>
            <dl class="zone-list">
                @foreach (HealthComponentModel component in summary.Components)
                {
                    <div><dt>@component.Id · @component.State</dt><dd>@component.Detail</dd></div>
                }
            </dl>
        </section>
    }
    else
    {
        <section class="panel-card operations-summary-card" aria-labelledby="operations-summary-title">
            <div class="panel-heading"><div><p class="eyebrow">One local view</p><h2 id="operations-summary-title">Operations summary</h2></div><span>Unavailable</span></div>
            <p class="notice" role="status">The combined summary is temporarily unavailable. The detailed local checks below can still be reviewed.</p>
            <button class="secondary-action" type="button" @onclick="LoadOperationsSummaryAsync">Try again</button>
        </section>
    }

    <section class="panel-card app-access-card" aria-labelledby="app-access-title">
        <div class="panel-heading">
            <div><p class="eyebrow">Private Wi-Fi</p><h2 id="app-access-title">Open on another device</h2></div>
            <span>Local only</span>
        </div>
        @if (accessLoading)
        {
            <div class="app-access-layout app-access-layout--loading" aria-busy="true">
                <div class="app-access-qr app-access-qr--placeholder" aria-hidden="true"></div>
                <p class="muted-copy" role="status">Finding the server address…</p>
            </div>
        }
        else if (access?.Available == true && access.Candidates.Count > 0 && SelectedAccessCandidate is { } candidate)
        {
            <div class="app-access-layout">
                <img class="app-access-qr" src="@AccessQrUrl" alt="QR code for @candidate.Url" width="220" height="220" fetchpriority="high" @key="candidate.Id" />
                <div class="app-access-copy">
                    <p>@access.Message</p>
                    @if (access.Candidates.Count > 1)
                    {
                        <label class="field">Address
                            <select aria-label="Shared app address" @bind="selectedAccessCandidateId">
                                @foreach (AppAccessCandidateModel option in access.Candidates)
                                {
                                    <option value="@option.Id">@option.Label</option>
                                }
                            </select>
                        </label>
                    }
                    <code class="app-access-url">@candidate.Url</code>
                    <button class="secondary-action" type="button" @onclick="CopyAccessUrlAsync">Copy address</button>
                    <details class="advanced-settings"><summary>Install on iPhone Home Screen</summary><p>Open this address in Safari, tap Share, then <strong>Add to Home Screen</strong>. The installed app still requires this NUC and household Wi-Fi; it does not cache workouts or controls for offline use.</p></details>
                    @if (!candidate.IsSecure)
                    {
                        <p class="field-help">This private address uses HTTP. Screen stay-awake on iPhone can require HTTPS; configure <code>Gateway:PublicUrl</code> with a trusted local HTTPS address to make that address selectable here.</p>
                    }
                    <span class="action-status" role="status">@accessMessage</span>
                </div>
            </div>
        }
        else
        {
            <p class="notice" role="status">@(access?.Message ?? "The private-LAN address is unavailable.")</p>
        }
        <section class="pwa-install-panel" aria-labelledby="pwa-install-title">
            <div>
                <p class="eyebrow">Trusted HTTPS app</p>
                <h3 id="pwa-install-title">Installed experience</h3>
            </div>
            @if (pwaStatus is null)
            {
                <p class="muted-copy" role="status">Checking browser installation support…</p>
            }
            else if (pwaStatus.Standalone)
            {
                <p><span class="sensor-badge">Installed</span> TreadmillRunner is running in its standalone app window.</p>
            }
            else if (!pwaStatus.SecureContext)
            {
                <p class="notice">Open the trusted HTTPS address before installing. The private HTTP address cannot provide this installed/offline-safety experience.</p>
            }
            else if (pwaStatus.InstallPromptAvailable)
            {
                <button class="secondary-action" type="button" @onclick="InstallPwaAsync">Install app</button>
            }
            else
            {
                <p>On iPhone or iPad, open this HTTPS address in Safari, tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>. In Chrome or Edge, use the browser menu’s install command when available.</p>
            }
            @if (pwaStatus is not null)
            {
                <p class="field-hint">@pwaStatus.ServiceWorkerMessage</p>
            }
            <p class="field-hint">An app previously installed from HTTP is a separate browser app. Remove or ignore that old icon and install again from this HTTPS address.</p>
            @if (!string.IsNullOrWhiteSpace(pwaMessage))
            {
                <span class="action-status" role="status" aria-live="polite">@pwaMessage</span>
            }
        </section>
    </section>

    <section class="panel-card" aria-labelledby="database-health-title">
        <div class="panel-heading">
            <div><p class="eyebrow">Local data</p><h2 id="database-health-title">Database health</h2></div>
            <span class="sensor-badge">@(databaseLoading ? "Loading" : databaseStatus?.State ?? "Unavailable")</span>
        </div>
        <p role="status">@(databaseLoading ? "Loading the latest integrity result…" : databaseStatus?.Message ?? "Database health is temporarily unavailable. Use Check now to retry while the app is idle.")</p>
        @if (databaseStatus is { } database)
        {
            <dl class="zone-list" aria-label="Database integrity status">
                <div><dt>Last full check</dt><dd>@FormatTimestamp(database.LastFullCheckAtUtc)</dd></div>
                <div><dt>Last safe maintenance</dt><dd>@FormatTimestamp(database.LastMaintenanceAtUtc)</dd></div>
                <div><dt>Verified backup</dt><dd>@FormatTimestamp(database.LastBackupAtUtc)</dd></div>
                <div><dt>Next automatic check</dt><dd>@FormatTimestamp(database.NextCheckAtUtc)</dd></div>
            </dl>
            @if (database.RecoveryRequired)
            {
                <p class="notice" role="alert">Recovery is required. Download diagnostics and restore a reviewed backup; the app never deletes rows or replaces the database automatically.</p>
            }
            @if (database.Issues.Count > 0)
            {
                <details class="advanced-settings"><summary>Check details</summary>
                    <ul>@foreach (string issue in database.Issues) { <li>@issue</li> }</ul>
                </details>
            }
            <details class="advanced-settings"><summary>Automatic maintenance actions</summary>
                <p class="field-hint">Passive WAL checkpoint, SQLite optimization, stale integrity-temp cleanup, full validation, and verified backup rotation. Destructive recovery is never automatic.</p>
            </details>
        }
        <button class="secondary-action" type="button" @onclick="CheckDatabaseAsync" disabled="@(databaseBusy || databaseLoading)">
            @(databaseBusy ? "Checking…" : "Check now")
        </button>
        <p class="field-hint">Runs only while idle. Safe maintenance is limited to integrity checks, a passive WAL checkpoint, optimization, stale temporary-file cleanup, and a verified last-known-good backup.</p>
    </section>

    <section class="panel-card backup-policy-card" aria-labelledby="local-backup-title" aria-busy="@(backupLoading || backupBusy)">
        <div class="panel-heading"><div><p class="eyebrow">Rotating recovery copies</p><h2 id="local-backup-title">Local backup policy</h2></div><span>Local / UNC only</span></div>
        <div class="form-grid">
            <label class="field field--wide">Destination folder<input @bind="backupDestination" placeholder="D:\Backups\TreadmillRunner or \\server\share" disabled="@backupLoading" /></label>
            <label class="field">Backup interval (hours)<input type="number" min="1" max="168" @bind="backupIntervalHours" disabled="@backupLoading" /></label>
            <label class="field">Copies to retain<input type="number" min="2" max="60" @bind="backupRetentionCount" disabled="@backupLoading" /></label>
            <label class="check-field"><input type="checkbox" @bind="backupEnabled" disabled="@backupLoading" /> <span>Scheduled backups enabled</span></label>
        </div>
        <div class="controls-card backup-policy-actions">
            <button class="secondary-action" type="button" @onclick="SaveBackupPolicyAsync" disabled="@(backupBusy || backupLoading)">@(backupBusy ? "Working…" : "Save policy")</button>
            <button class="secondary-action" type="button" @onclick="VerifyBackupNowAsync" disabled="@(backupBusy || backupLoading || backupPolicyId is null || !backupEnabled)">Verify now</button>
        </div>
        @if (backupLoading)
        {
            <p class="muted" role="status">Loading the saved local backup policy…</p>
        }
        else if (backupPolicyId is null)
        {
            <p class="field-hint">Enter an absolute local or UNC destination and save the policy before verification is available.</p>
        }
        else if (!backupEnabled)
        {
            <p class="field-hint">Enable and save scheduled backups before creating a verified recovery copy.</p>
        }
        <p class="field-hint">Each copy is opened separately and receives a full SQLite integrity check before rotation. Production data is never replaced by a verification drill.</p>
        @if (backupVerifications.FirstOrDefault() is { } verification)
        {
            <dl class="zone-list">
                <div><dt>Last result</dt><dd>@verification.Status</dd></div>
                <div><dt>Completed</dt><dd>@FormatTimestamp(verification.CompletedAtUtc)</dd></div>
                <div><dt>Size</dt><dd>@(verification.BackupBytes / 1024d / 1024d).ToString("0.00") MiB</dd></div>
                <div><dt>Detail</dt><dd>@verification.Detail</dd></div>
            </dl>
        }
    </section>

    <details class="panel-card advanced-settings">
        <summary>Backup and diagnostics</summary>
        <div class="controls-card backup-export-actions">
            <a class="secondary-action" href="/api/operations/backup" download>Download full backup</a>
            @if (pwaStatus?.ShareSupported == true)
            {
                <button class="secondary-action" type="button" disabled="@shareBusy" @onclick="ShareFullBackupAsync">Share full backup</button>
            }
            @if (!string.IsNullOrWhiteSpace(databaseStatus?.LastBackupFileName))
            {
                <a class="secondary-action" href="/api/operations/database/verified-backup" download>Download verified recovery backup</a>
                @if (pwaStatus?.ShareSupported == true)
                {
                    <button class="secondary-action" type="button" disabled="@shareBusy" @onclick="ShareVerifiedBackupAsync">Share verified backup</button>
                }
            }
            <a class="secondary-action" href="/api/operations/diagnostics" download>Download diagnostics</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(shareMessage))
        {
            <p class="action-status" role="status" aria-live="polite">@shareMessage</p>
        }
    </details>

    <details class="panel-card advanced-settings">
        <summary>Restore from backup</summary>
        <p>Select a TreadmillRunner backup (.trb; legacy .db is also accepted). Nothing is replaced until its preview is shown and you confirm.</p>
        <label class="file-field">Backup file
            <InputFile OnChange="PreviewRestoreAsync" accept=".trb,.db,application/vnd.treadmillrunner.backup,application/vnd.sqlite3" disabled="@restoreBusy" />
        </label>
        @if (restoreBusy) { <p class="muted" role="status">@(restorePreview is null ? "Checking the selected backup…" : "Restoring and validating the local database…")</p> }
        @if (restorePreview is { } preview)
        {
            <dl class="zone-list">
                <div><dt>SHA-256</dt><dd>@preview.GetProperty("sha256").GetString()</dd></div>
                <div><dt>Profiles</dt><dd>@preview.GetProperty("profileCount").GetInt32()</dd></div>
                <div><dt>Workouts</dt><dd>@preview.GetProperty("workoutCount").GetInt32()</dd></div>
                <div><dt>Sessions</dt><dd>@preview.GetProperty("sessionCount").GetInt32()</dd></div>
            </dl>
            <p class="field-hint">Confirming replaces the local database with this reviewed backup. A pre-restore copy is retained for rollback if validation fails.</p>
            <button class="danger-action touch-action" type="button" @onclick="ConfirmRestoreAsync" disabled="@restoreBusy">@(restoreBusy ? "Restoring…" : "Restore this backup")</button>
        }
    </details>

    <section class="panel-card" id="signed-updates" tabindex="-1">
        <h2>Signed updates</h2>
        <p role="status" aria-live="polite">@updateStatus.Message</p>
        <dl class="zone-list" aria-label="Update status">
            <div><dt>State</dt><dd>@updateStatus.State</dd></div>
            <div><dt>Current</dt><dd>@updateStatus.CurrentVersion</dd></div>
            <div><dt>Available</dt><dd>@(updateStatus.AvailableVersion ?? "—")</dd></div>
            <div><dt>Staged</dt><dd>@(updateStatus.StagedVersion ?? "—")</dd></div>
            <div><dt>Source</dt><dd>@(updateStatus.FeedSource ?? "—")</dd></div>
            <div><dt>Last checked</dt><dd>@FormatTimestamp(updateStatus.LastCheckedAtUtc)</dd></div>
        </dl>
        @if (!string.IsNullOrWhiteSpace(updateStatus.ReleaseNotes))
        {
            <p><strong>Release notes:</strong> @updateStatus.ReleaseNotes</p>
        }
        <div class="controls-card">
            <button class="secondary-action" type="button" @onclick="CheckUpdateAsync" disabled="@updateBusy">Check now</button>
            @if (updateStatus.State == "Available")
            {
                <button class="secondary-action" type="button" @onclick="StageUpdateAsync" disabled="@updateBusy">Verify and stage</button>
            }
            @if (updateStatus.State == "Staged" && !activationConfirming)
            {
                <button class="danger-action touch-action" type="button" @onclick="BeginActivationConfirmation" disabled="@updateBusy">Activate staged update</button>
            }
        </div>
        <details class="advanced-settings update-file-fallback">
            <summary>Install from a signed file</summary>
            <p>Use this when GitHub or the local feed is unavailable. The bundle must be newer and signed by the already trusted TreadmillRunner key; uploading never activates it automatically.</p>
            <label class="file-field">Signed update bundle (.zip)
                <InputFile OnChange="ImportUpdateAsync" accept=".zip,application/vnd.treadmillrunner.update+zip" disabled="@updateBusy" />
            </label>
        </details>
        @if (activationConfirming && updateStatus.State == "Staged" && activationVersion == updateStatus.StagedVersion)
        {
            <section class="inline-confirmation" aria-label="Confirm software update activation">
                <p><strong>Install @updateStatus.StagedVersion now?</strong> The gateway will back up its database, briefly disconnect, and automatically restore the previous release if readiness fails.</p>
                <div class="controls-card">
                    <button class="secondary-action" type="button" @onclick="() => activationConfirming = false" disabled="@updateBusy">Cancel</button>
                    <button class="danger-action touch-action" type="button" @onclick="ActivateUpdateAsync" disabled="@updateBusy">@(updateBusy ? "Activating…" : "Confirm activation")</button>
                </div>
            </section>
        }
        <p class="muted-copy">Activation is accepted only while idle. The service creates a database backup and rolls back automatically if the new release does not become ready.</p>
    </section>
</section>

@code {
    private const long MaximumRestoreBytes = 256L * 1024 * 1024;
    private AppAccessModel? access;
    private bool accessLoading = true;
    private string? selectedAccessCandidateId;
    private string? accessMessage;
    private JsonElement? restorePreview;
    private string? message;
    private UpdateStatusModel updateStatus = UpdateStatusModel.Empty;
    private bool updateBusy;
    private bool activationConfirming;
    private string? activationVersion;
    private CancellationTokenSource? activationRecoveryCancellation;
    private bool disposed;
    private DatabaseIntegrityStatusModel? databaseStatus;
    private bool databaseLoading = true;
    private bool databaseBusy;
    private OperationsSummaryModel? operationsSummary;
    private bool operationsSummaryLoading = true;
    private Guid? backupPolicyId;
    private int backupPolicyVersion;
    private string backupDestination = string.Empty;
    private int backupIntervalHours = 24;
    private int backupRetentionCount = 7;
    private bool backupEnabled;
    private bool backupBusy;
    private bool backupLoading = true;
    private IReadOnlyList<BackupVerificationModel> backupVerifications = [];
    private bool restoreBusy;
    private DotNetObjectReference<Operations>? pwaReference;
    private PwaStatusModel? pwaStatus;
    private string? pwaMessage;
    private bool shareBusy;
    private string? shareMessage;

    private AppAccessCandidateModel? SelectedAccessCandidate => access?.Candidates
        .FirstOrDefault(candidate => candidate.Id == selectedAccessCandidateId) ?? access?.Candidates.FirstOrDefault();
    private string AccessQrUrl => SelectedAccessCandidate is { } candidate
        ? $"/api/operations/access/qr/{Uri.EscapeDataString(candidate.Id)}"
        : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUpdateStatusAsync(), LoadAccessAsync(), LoadDatabaseStatusAsync(), LoadBackupPolicyAsync(), LoadOperationsSummaryAsync());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        pwaReference = DotNetObjectReference.Create(this);
        try
        {
            pwaStatus = await JS.InvokeAsync<PwaStatusModel>("treadmillRunnerPwa.initialize", pwaReference);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            pwaMessage = "Browser installation and sharing features are temporarily unavailable.";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task PwaStatusChanged(PwaStatusModel status)
    {
        pwaStatus = status;
        return InvokeAsync(StateHasChanged);
    }

    private async Task InstallPwaAsync()
    {
        try
        {
            PwaActionResult result = await JS.InvokeAsync<PwaActionResult>("treadmillRunnerPwa.promptInstall");
            pwaMessage = result.Message;
            pwaStatus = await JS.InvokeAsync<PwaStatusModel>("treadmillRunnerPwa.getStatus");
        }
        catch (JSException)
        {
            pwaMessage = "The browser could not open its installation prompt.";
        }
    }

    private async Task ShareFileAsync(string path, string fallbackFileName, string title)
    {
        shareBusy = true;
        shareMessage = null;
        try
        {
            PwaActionResult result = await JS.InvokeAsync<PwaActionResult>(
                "treadmillRunnerPwa.shareOrDownload", path, fallbackFileName, title);
            shareMessage = result.State == "Canceled" ? null : result.Message;
        }
        catch (JSException)
        {
            shareMessage = "The browser could not share this file. Use Download instead.";
        }
        finally
        {
            shareBusy = false;
        }
    }

    private Task ShareFullBackupAsync() => ShareFileAsync(
        "/api/operations/backup",
        "treadmillrunner-backup.trb",
        "TreadmillRunner full backup");

    private Task ShareVerifiedBackupAsync() => ShareFileAsync(
        "/api/operations/database/verified-backup",
        "treadmillrunner-verified-backup.trb",
        "TreadmillRunner verified recovery backup");

    private async Task LoadOperationsSummaryAsync()
    {
        operationsSummaryLoading = true;
        try { operationsSummary = await Http.GetFromJsonAsync<OperationsSummaryModel>("api/local-first/operations-summary"); }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException) { operationsSummary = null; }
        finally { operationsSummaryLoading = false; }
    }

    private async Task LoadBackupPolicyAsync()
    {
        backupLoading = true;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync("api/local-first/backup-policy");
            if (!response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                message = "Local backup status is temporarily unavailable.";
                return;
            }
            if (response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                BackupPolicyModel? saved = await response.Content.ReadFromJsonAsync<BackupPolicyModel>();
                if (saved is not null)
                {
                    backupPolicyId = saved.Id;
                    backupPolicyVersion = saved.Version;
                    backupDestination = saved.Policy.DestinationPath;
                    backupIntervalHours = saved.Policy.IntervalHours;
                    backupRetentionCount = saved.Policy.RetentionCount;
                    backupEnabled = saved.Policy.Enabled;
                }
            }
            backupVerifications = await Http.GetFromJsonAsync<BackupVerificationModel[]>("api/local-first/backup-verifications?take=10") ?? [];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException) { message = "Local backup status is temporarily unavailable."; }
        finally { backupLoading = false; }
    }

    private async Task SaveBackupPolicyAsync()
    {
        backupBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync("api/local-first/backup-policy", new
            {
                Id = backupPolicyId,
                DestinationPath = backupDestination,
                IntervalHours = backupIntervalHours,
                RetentionCount = backupRetentionCount,
                Enabled = backupEnabled,
                ExpectedVersion = backupPolicyId is null ? (int?)null : backupPolicyVersion,
            });
            if (response.IsSuccessStatusCode)
            {
                BackupPolicyModel? saved = await response.Content.ReadFromJsonAsync<BackupPolicyModel>();
                if (saved is not null) { backupPolicyId = saved.Id; backupPolicyVersion = saved.Version; }
                message = backupEnabled ? "Local backup policy saved and scheduled backups enabled." : "Local backup policy saved with scheduled backups disabled.";
                await LoadOperationsSummaryAsync();
            }
            else message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "The backup policy changed elsewhere. Reload Operations and try again."
                : "The backup policy was rejected. Use an absolute local or UNC folder, 1–168 hours, and 2–60 copies.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            message = "The backup policy could not reach the local gateway. No changes were saved.";
        }
        finally { backupBusy = false; }
    }

    private async Task VerifyBackupNowAsync()
    {
        backupBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/local-first/backup-verifications", new { });
            message = response.IsSuccessStatusCode ? "A verified local recovery copy was created." : "Backup verification is waiting for an idle session or writable destination.";
            await LoadBackupPolicyAsync();
            await LoadOperationsSummaryAsync();
        }
        catch (HttpRequestException) { message = "Backup verification could not reach the local gateway."; }
        finally { backupBusy = false; }
    }

    private async Task LoadDatabaseStatusAsync()
    {
        databaseLoading = true;
        try
        {
            databaseStatus = await Http.GetFromJsonAsync<DatabaseIntegrityStatusModel>("api/operations/database/status");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            databaseStatus = null;
        }
        finally { databaseLoading = false; }
    }

    private async Task CheckDatabaseAsync()
    {
        if (databaseBusy) return;
        databaseBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/operations/database/check", new { });
            databaseStatus = await response.Content.ReadFromJsonAsync<DatabaseIntegrityStatusModel>() ?? databaseStatus;
            message = response.IsSuccessStatusCode
                ? "Database validation and safe maintenance completed."
                : "Database checking is waiting until the application is idle.";
        }
        catch (HttpRequestException)
        {
            message = "Database health could not be checked.";
        }
        finally
        {
            databaseBusy = false;
        }
    }

    private async Task LoadAccessAsync()
    {
        accessLoading = true;
        try
        {
            access = await Http.GetFromJsonAsync<AppAccessModel>("api/operations/access");
            selectedAccessCandidateId = access?.PreferredCandidateId ?? access?.Candidates.FirstOrDefault()?.Id;
        }
        catch (HttpRequestException)
        {
            access = new AppAccessModel(false, null, [], "The private-LAN address could not be loaded.");
        }
        finally
        {
            accessLoading = false;
        }
    }

    private async Task CopyAccessUrlAsync()
    {
        if (SelectedAccessCandidate is not { } candidate) return;
        try
        {
            bool copied = await JS.InvokeAsync<bool>("treadmillRunnerView.copyText", candidate.Url);
            accessMessage = copied ? "Address copied." : "Copy was blocked. Select and copy the address shown above.";
        }
        catch (JSException)
        {
            accessMessage = "Copy was blocked. Select and copy the address shown above.";
        }
    }

    private async Task PreviewRestoreAsync(InputFileChangeEventArgs args)
    {
        restorePreview = null;
        restoreBusy = true;
        try
        {
            await using Stream input = args.File.OpenReadStream(MaximumRestoreBytes);
            using var content = new StreamContent(input);
            content.Headers.ContentType = new MediaTypeHeaderValue("application/vnd.sqlite3");
            content.Headers.ContentLength = args.File.Size;
            using HttpResponseMessage response = await Http.PostAsync("api/operations/restore/preview", content);
            if (response.IsSuccessStatusCode)
            {
                restorePreview = await response.Content.ReadFromJsonAsync<JsonElement>();
                message = "Restore preview is ready. Review the identity and counts before replacing local data.";
            }
            else message = "The selected backup could not be previewed. No local data was changed.";
        }
        catch (Exception exception) when (exception is IOException or HttpRequestException or TaskCanceledException or JsonException or ArgumentException)
        {
            message = args.File.Size > MaximumRestoreBytes
                ? "The selected backup is larger than the 256 MiB restore limit. No local data was changed."
                : "The selected backup could not be read or the local gateway is unavailable. No local data was changed.";
        }
        finally { restoreBusy = false; }
    }

    private async Task ConfirmRestoreAsync()
    {
        if (restorePreview is not { } preview) return;
        restoreBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/operations/restore/confirm", new
            {
                token = preview.GetProperty("token").GetGuid(),
                confirmation = "RESTORE",
            });
            message = response.IsSuccessStatusCode
                ? "Restore completed and the live database passed integrity validation."
                : "Restore failed; the pre-restore database was retained or rolled back.";
            if (response.IsSuccessStatusCode) restorePreview = null;
            await Task.WhenAll(LoadDatabaseStatusAsync(), LoadOperationsSummaryAsync());
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException or InvalidOperationException)
        {
            message = "Restore confirmation was interrupted. The gateway retains or rolls back to the pre-restore database; check database health before trying again.";
        }
        finally { restoreBusy = false; }
    }

    private async Task CheckUpdateAsync()
    {
        await RunUpdateActionAsync(() => Http.PostAsJsonAsync("api/updates/check", new { }),
            "The update feed is unavailable or its configuration could not be validated.");
    }

    private async Task StageUpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(updateStatus.AvailableVersion)) return;
        await RunUpdateActionAsync(() => Http.PostAsJsonAsync("api/updates/stage", new { expectedVersion = updateStatus.AvailableVersion }),
            "The update could not be verified and staged.");
    }

    private async Task ImportUpdateAsync(InputFileChangeEventArgs args)
    {
        if (updateBusy) return;
        updateBusy = true;
        try
        {
            await using Stream input = args.File.OpenReadStream(UpdateManagerMaximumBundleBytes);
            using var content = new StreamContent(input);
            content.Headers.ContentType = new MediaTypeHeaderValue("application/vnd.treadmillrunner.update+zip");
            content.Headers.ContentLength = args.File.Size;
            using HttpResponseMessage response = await Http.PostAsync("api/updates/upload", content);
            if (response.IsSuccessStatusCode) await LoadUpdateStatusAsync();
            else updateStatus = updateStatus with { Message = "The file was not a valid newer signed TreadmillRunner update." };
        }
        catch (Exception exception) when (exception is IOException or HttpRequestException or ArgumentException)
        {
            updateStatus = updateStatus with { Message = "The signed update file could not be uploaded." };
        }
        finally
        {
            updateBusy = false;
        }
    }

    private async Task ActivateUpdateAsync()
    {
        UpdateActionDisposition disposition = await RunUpdateActionAsync(() => Http.PostAsJsonAsync(
            "api/updates/activate", new { confirmation = "ACTIVATE", expectedVersion = activationVersion }),
            "Activation was not accepted.");
        activationConfirming = false;
        if (disposition is UpdateActionDisposition.Accepted or UpdateActionDisposition.Unknown)
        {
            if (updateStatus.State == "Unavailable" || disposition == UpdateActionDisposition.Unknown)
            {
                updateStatus = updateStatus with
                {
                    State = "Activating",
                    Message = disposition == UpdateActionDisposition.Unknown
                        ? "The activation response was interrupted. Checking only for promotion or rollback; the activation command will not be sent again."
                        : "The signed update is activating. The service will reconnect after promotion or rollback."
                };
            }
            StartActivationRecovery();
        }
    }

    private async Task LoadUpdateStatusAsync(
        CancellationToken cancellationToken = default,
        bool preserveActivatingOnFailure = false)
    {
        try
        {
            updateStatus = await Http.GetFromJsonAsync<UpdateStatusModel>("api/updates/status", cancellationToken)
                ?? UpdateStatusModel.Empty;
            if (updateStatus.State != "Staged" || activationVersion != updateStatus.StagedVersion)
            {
                activationConfirming = false;
                activationVersion = null;
            }
        }
        catch (HttpRequestException)
        {
            if (!preserveActivatingOnFailure)
                updateStatus = UpdateStatusModel.Empty with { State = "Unavailable", Message = "Update status is unavailable." };
        }
        catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)
        {
            if (!preserveActivatingOnFailure)
                updateStatus = UpdateStatusModel.Empty with { State = "Unavailable", Message = "Update status is unavailable." };
        }
    }

    private void StartActivationRecovery()
    {
        activationRecoveryCancellation?.Cancel();
        activationRecoveryCancellation?.Dispose();
        activationRecoveryCancellation = new CancellationTokenSource();
        _ = MonitorActivationRecoveryAsync(activationRecoveryCancellation);
    }

    private async Task MonitorActivationRecoveryAsync(CancellationTokenSource recovery)
    {
        using CancellationTokenSource deadlineCancellation = CancellationTokenSource.CreateLinkedTokenSource(recovery.Token);
        deadlineCancellation.CancelAfter(TimeSpan.FromMinutes(3));
        CancellationToken cancellationToken = deadlineCancellation.Token;
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                await Runtime.CheckAsync(Http, cancellationToken);
                if (Runtime.UpdateRequired)
                {
                    updateStatus = updateStatus with { Message = "The update is installed. Reloading the application…" };
                    await InvokeAsync(StateHasChanged);
                    bool reloadStarted = await JS.InvokeAsync<bool>(
                        "treadmillRunnerRuntime.reload",
                        cancellationToken,
                        Runtime.ServerFingerprint ?? Runtime.ExpectedFingerprint);
                    if (!reloadStarted)
                    {
                        updateStatus = updateStatus with
                        {
                            Message = "The update is installed. Select Reload in the update banner to finish refreshing this browser."
                        };
                        await InvokeAsync(StateHasChanged);
                    }
                    return;
                }

                if (!Runtime.IsConnected) continue;
                await LoadUpdateStatusAsync(cancellationToken, preserveActivatingOnFailure: true);
                await InvokeAsync(StateHasChanged);
                if (updateStatus.State is not "Activating" and not "Unavailable") return;
            }

            if (deadlineCancellation.IsCancellationRequested &&
                !recovery.IsCancellationRequested &&
                !disposed &&
                ReferenceEquals(activationRecoveryCancellation, recovery))
            {
                updateStatus = updateStatus with
                {
                    Message = "The update is taking longer than expected. It may still be promoting or rolling back; use Check now after the gateway reconnects."
                };
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (recovery.IsCancellationRequested)
        {
            // The operator navigated away or a newer activation recovery superseded this monitor.
        }
        catch (OperationCanceledException) when (deadlineCancellation.IsCancellationRequested)
        {
            if (!disposed && ReferenceEquals(activationRecoveryCancellation, recovery))
            {
                updateStatus = updateStatus with
                {
                    Message = "The update is taking longer than expected. It may still be promoting or rolling back; use Check now after the gateway reconnects."
                };
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigation started or the browser disconnected while the promoted build was loading.
        }
        catch (JSException)
        {
            updateStatus = updateStatus with
            {
                Message = "The update is installed, but this browser could not reload automatically. Select Reload in the update banner."
            };
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BeginActivationConfirmation()
    {
        activationVersion = updateStatus.StagedVersion;
        activationConfirming = !string.IsNullOrWhiteSpace(activationVersion);
    }

    private async Task<UpdateActionDisposition> RunUpdateActionAsync(
        Func<Task<HttpResponseMessage>> action,
        string failureMessage)
    {
        if (updateBusy) return UpdateActionDisposition.Rejected;
        updateBusy = true;
        try
        {
            using HttpResponseMessage response = await action();
            if (response.IsSuccessStatusCode)
            {
                await LoadUpdateStatusAsync();
                return UpdateActionDisposition.Accepted;
            }
            else
            {
                updateStatus = updateStatus with { Message = failureMessage };
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            updateStatus = updateStatus with { State = "Unavailable", Message = failureMessage };
            return UpdateActionDisposition.Unknown;
        }
        finally
        {
            updateBusy = false;
        }
        return UpdateActionDisposition.Rejected;
    }

    private enum UpdateActionDisposition
    {
        Accepted,
        Rejected,
        Unknown
    }

    private static string FormatTimestamp(DateTimeOffset? value) => value is null
        ? "Never"
        : value.Value.ToLocalTime().ToString("g");

    private sealed record UpdateStatusModel(
        string State,
        string CurrentVersion,
        string? AvailableVersion,
        string? StagedVersion,
        string? ReleaseNotes,
        DateTimeOffset? LastCheckedAtUtc,
        string Message,
        string? FeedSource = null)
    {
        public static UpdateStatusModel Empty { get; } = new(
            "NotChecked", "Unknown", null, null, null, null, "No update check has completed yet.", null);
    }

    private sealed record AppAccessCandidateModel(string Id, string Label, string Url, bool IsSecure);

    private sealed record AppAccessModel(
        bool Available,
        string? PreferredCandidateId,
        IReadOnlyList<AppAccessCandidateModel> Candidates,
        string Message);

    private sealed record DatabaseIntegrityStatusModel(
        string State,
        string Message,
        DateTimeOffset UpdatedAtUtc,
        DateTimeOffset? LastQuickCheckAtUtc,
        DateTimeOffset? LastFullCheckAtUtc,
        DateTimeOffset? LastHealthyAtUtc,
        DateTimeOffset? LastMaintenanceAtUtc,
        DateTimeOffset? LastBackupAtUtc,
        string? LastBackupFileName,
        string? LastBackupSha256,
        DateTimeOffset? NextCheckAtUtc,
        bool RecoveryRequired,
        IReadOnlyList<string> Issues);

    private sealed record BackupPolicyValue(string DestinationPath, int IntervalHours, int RetentionCount, bool Enabled);
    private sealed record BackupPolicyModel(Guid Id, BackupPolicyValue Policy, int Version, DateTimeOffset UpdatedAtUtc);
    private sealed record BackupVerificationModel(Guid Id, Guid PolicyId, string BackupPath, string Status, string Detail, long BackupBytes, DateTimeOffset StartedAtUtc, DateTimeOffset CompletedAtUtc);
    private sealed record HealthComponentModel(string Id, string State, string Detail);
    private sealed record OperationsSummaryModel(string State, IReadOnlyList<HealthComponentModel> Components);
    public sealed record PwaStatusModel(
        bool SecureContext,
        bool Standalone,
        bool InstallPromptAvailable,
        bool ServiceWorkerSupported,
        bool ServiceWorkerRegistered,
        bool ShareSupported,
        string ServiceWorkerMessage);
    private sealed record PwaActionResult(string State, string Message);

    private const long UpdateManagerMaximumBundleBytes = (1024L * 1024 * 1024) + (2L * 1024 * 1024);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        activationRecoveryCancellation?.Cancel();
        activationRecoveryCancellation?.Dispose();
        if (pwaReference is not null)
        {
            try { await JS.InvokeVoidAsync("treadmillRunnerPwa.dispose"); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            pwaReference.Dispose();
        }
    }
}
