    private int RequiredTrainingDays => pendingCalendarProgram is { } program
        ? Math.Max(1, program.Items.Where(static item => item.WeekNumber is not null)
            .GroupBy(static item => item.WeekNumber).Select(static group => group.Count()).DefaultIfEmpty(3).Max())
