    private async Task PreviewDefaultDaysChangeAsync()
    {
        if (managedProgramSession is null || activeProfileId is null || !CanPreviewDefaultDays) return;
        programActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/program-runs/{managedProgramSession.RunId}/default-days/preview",
                new
                {
                    operationId = (Guid?)null,
                    profileId = activeProfileId.Value,
                    weekdayMask = programWeekdayMask,
                    effectiveDate = programEffectiveDate,
                    expectedRunVersion = (int?)null,
                    expectedRevision = (string?)null,
                });
            if (!response.IsSuccessStatusCode)
            {
                message = "The training-day preview could not be loaded.";
                return;
            }
            defaultDaysPreview = await response.Content.ReadFromJsonAsync<WorkoutProgramDefaultDaysPreviewView>();
            focusModalStagePending = true;
        }
        finally { programActionBusy = false; }
    }

    private async Task ApplyDefaultDaysChangeAsync()
    {
        if (managedProgramSession is null || activeProfileId is null || defaultDaysPreview is not { CanApply: true } preview) return;
        programActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/program-runs/{managedProgramSession.RunId}/default-days/apply",
                new
                {
                    operationId = Guid.NewGuid(),
                    profileId = activeProfileId.Value,
                    weekdayMask = preview.NewWeekdayMask,
                    effectiveDate = preview.EffectiveDate,
                    expectedRunVersion = preview.RunVersion,
                    expectedRevision = preview.Revision,
                });
            if (!response.IsSuccessStatusCode)
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The plan changed after the preview. Review the new training days again."
                    : "The future plan could not be rescheduled.";
                defaultDaysPreview = null;
                await ReloadCalendarAsync();
                return;
            }
            WorkoutProgramDefaultDaysPreviewView? saved = await response.Content.ReadFromJsonAsync<WorkoutProgramDefaultDaysPreviewView>();
            message = saved?.Message ?? "Future workouts rescheduled.";
            await DismissProgramManagerAsync();
            await ReloadCalendarAsync();
        }
        finally { programActionBusy = false; }
    }

    private void ClearDefaultDaysPreview()
    {
        defaultDaysPreview = null;
        focusModalStagePending = true;
    }

    private static string FormatWeekdayMask(int mask) => string.Join(", ",
        Weekdays.Where(day => (mask & day.Flag) != 0).Select(static day => day.Label));

