@page "/calendar"
@implements IAsyncDisposable
@inject HttpClient Http
@inject ActiveProfileState ActiveProfile
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Calendar · TreadmillRunner</PageTitle>

<div class="planning-page calendar-page">
    <header class="planning-hero">
        <div><p class="eyebrow">Training rhythm</p><h1>Calendar</h1><p>Review scheduled training, then move one session or shift everything that follows.</p></div>
        <div class="form-actions">
            @if (ActiveScheduledProgram is not null)
            {
                <button class="secondary-action danger-action" type="button" disabled="@clearUpcomingBusy" @onclick="RequestClearUpcomingAsync">Remove upcoming sessions</button>
            }
        </div>
    </header>

    @if (!string.IsNullOrEmpty(message))
    {
        <p class="notice" role="status">@message</p>
    }

    @if (clearUpcomingPreview is not null)
    {
        <section class="planning-panel destructive-confirmation" role="alertdialog" aria-labelledby="clear-upcoming-title" aria-describedby="clear-upcoming-description">
            <div><p class="eyebrow">Selected runner</p><h2 id="clear-upcoming-title">Remove all upcoming plan sessions?</h2></div>
            <p id="clear-upcoming-description">@clearUpcomingPreview.Message Completed workouts and the runner profile stay intact.</p>
            <div class="form-actions">
                <button class="secondary-action" type="button" disabled="@clearUpcomingBusy" @onclick="CancelClearUpcoming">Keep sessions</button>
                <button class="primary-action danger-action" type="button" disabled="@clearUpcomingBusy" @onclick="ConfirmClearUpcomingAsync">@(clearUpcomingBusy ? "Removing…" : $"Remove {clearUpcomingPreview.UpcomingSessionCount} sessions")</button>
            </div>
        </section>
    }

    @if (activeProfileId is null)
    {
        @if (!string.IsNullOrWhiteSpace(calendarLoadError))
        {
            <section class="planning-panel empty-state" role="alert"><h2>Calendar unavailable</h2><p>@calendarLoadError</p><button class="secondary-action" type="button" @onclick="ReloadInitialCalendarAsync">Retry calendar</button></section>
        }
        else
        {
            <section class="planning-panel empty-state"><h2>Choose a runner first</h2><p>Use the runner control in the navigation bar. Your choice is remembered across the app.</p><a class="primary-action" href="/profiles">Manage profiles</a></section>
        }
    }
    else
    {
        @if (ScheduleGroups.Count > 0)
        {
            <section class="schedule-overview" aria-labelledby="schedule-overview-title">
                <div class="panel-heading"><div><p class="eyebrow">Your schedules</p><h2 id="schedule-overview-title">Workout groups</h2></div><span>@ScheduleGroups.Count active</span></div>
                <div class="schedule-group-grid">
                    @foreach (ScheduleGroupSummary group in ScheduleGroups)
                    {
                        <article class="schedule-group-card">
                            <div><h3>@group.Name</h3><p>@SchedulePattern(group)</p></div>
                            <dl class="compact-stats">
                                <div><dt>Starts</dt><dd>@group.StartDate.ToString("d MMM")</dd></div>
                                <div><dt>Workout choices</dt><dd>@group.WorkoutCount</dd></div>
                            </dl>
                            <button class="secondary-action compact-action" type="button" @onclick="() => OpenGroupManager(group)">Manage group</button>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="planning-panel calendar-agenda-panel" aria-labelledby="range-title">
            <div class="panel-heading calendar-heading">
                <div><p class="eyebrow">Effective plan</p><h2 id="range-title">@visibleMonth.ToString("MMMM yyyy")</h2></div>
                <div class="calendar-toolbar">
                    <div class="calendar-view-switcher" role="group" aria-label="Calendar view">
                        <button type="button" aria-pressed="@(calendarView == CalendarViewMode.Agenda ? "true" : "false")" @onclick="() => SelectCalendarView(CalendarViewMode.Agenda)"><AppIcon Name="list" /><span>Agenda</span></button>
                        <button type="button" aria-pressed="@(calendarView == CalendarViewMode.Month ? "true" : "false")" @onclick="() => SelectCalendarView(CalendarViewMode.Month)"><AppIcon Name="calendar" /><span>Month</span></button>
                    </div>
                    <div class="calendar-navigation" role="group" aria-label="Calendar period">
                        <button class="secondary-action" type="button" aria-label="Previous month" disabled="@(!CanNavigatePreviousMonth || loading)" @onclick="() => ChangeMonthAsync(-1)"><AppIcon Name="chevron-left" /></button>
                        <button class="secondary-action" type="button" disabled="@loading" @onclick="GoToTodayAsync">Today</button>
                        <button class="secondary-action" type="button" aria-label="Next month" disabled="@(!CanNavigateNextMonth || loading)" @onclick="() => ChangeMonthAsync(1)"><AppIcon Name="chevron-right" /></button>
                    </div>
                </div>
            </div>
            @if (calendarView == CalendarViewMode.Month && !loading && string.IsNullOrWhiteSpace(calendarLoadError))
            {
                <div class="calendar-marker-key" aria-label="Month calendar key">
                    <span><i class="calendar-date-marker--program"></i>Plan</span>
                    <span><i></i>Scheduled workout</span>
                    <span><i class="calendar-date-marker--completed"></i>Completed</span>
                    <small>The number shows scheduled sessions.</small>
                </div>
            }
            @if (loading)
            {
                <p class="empty-state">Resolving calendar…</p>
            }
            else if (!string.IsNullOrWhiteSpace(calendarLoadError))
            {
                <div class="empty-state" role="alert"><p>@calendarLoadError</p><button class="secondary-action" type="button" @onclick="ReloadCalendarAsync">Retry calendar</button></div>
            }
            else
            {
                @if (calendarView == CalendarViewMode.Agenda)
                {
                    <div id="calendar-agenda-view" class="calendar-agenda" aria-label="Training agenda for @visibleMonth.ToString("MMMM yyyy")">
                        @foreach ((CalendarAgendaWeek agendaWeek, int weekIndex) in CalendarAgendaWeeks.Select((week, index) => (week, index)))
                        {
                            <details class="calendar-agenda-week" open="@ShouldOpenAgendaWeek(agendaWeek, weekIndex)">
                                <summary><span>@FormatAgendaWeek(agendaWeek)</span><strong>@agendaWeek.WorkoutCount scheduled</strong></summary>
                                <div class="calendar-agenda-week__days">
                                    @foreach (CalendarAgendaDay agendaDay in agendaWeek.Days)
                                    {
                                        <article class="calendar-agenda-day @(agendaDay.Date == DateOnly.FromDateTime(DateTime.Today) ? "calendar-agenda-day--today" : null)">
                                            <time datetime="@agendaDay.Date.ToString("yyyy-MM-dd")"><strong>@agendaDay.Date.ToString("ddd")</strong><span>@agendaDay.Date.ToString("d MMM")</span></time>
                                            <div class="calendar-agenda-day__workouts">
                                                @foreach (CalendarOptionView option in agendaDay.Day.Options)
                                                {
                                                    <div class="calendar-option-shell @(option.Source == "Program" ? "calendar-option-shell--program" : null)">
                                                        <button class="calendar-option @(option.IsSelected ? "calendar-option--selected" : null) @(option.IsCompleted ? "calendar-option--completed" : null)" type="button" @onclick="() => OpenCalendarDetailsAsync(agendaDay.Day, option)" aria-haspopup="dialog" aria-label="@CalendarOptionAriaLabel(agendaDay.Date, option)">
                                                            <span>@option.WorkoutName</span><small>@(option.IsRepeat ? "Extra attempt · " : string.Empty)@CalendarOptionContext(option)</small>
                                                            @if (option.IsCompleted)
                                                            {
                                                                <strong class="calendar-completion-status"><span aria-hidden="true">✓</span>Completed</strong>
                                                            }
                                                        </button>
                                                        @if (!option.IsRepeat)
                                                        {
                                                            <button class="calendar-option-manage" type="button"
                                                                    @onclick="() => OpenOptionManager(agendaDay.Date, option)"
                                                                    aria-haspopup="dialog"
                                                                    aria-label="Manage @option.WorkoutName on @agendaDay.Date.ToString("d MMMM")" title="Manage session"><AppIcon Name="more" /><span class="calendar-option-manage__label">Manage</span></button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                }
                else
                {
                    <div id="calendar-month-view" class="calendar-month-view">
                        <p class="calendar-scroll-hint"><AppIcon Name="horizontal-scroll" />Swipe sideways to see the full week.</p>
                        <div class="calendar-month-scroll" tabindex="0" role="region" aria-label="Month grid for @visibleMonth.ToString("MMMM yyyy"). Scroll horizontally if needed to see all seven days.">
                            <table class="calendar-month">
                                <caption class="visually-hidden">Training calendar for @visibleMonth.ToString("MMMM yyyy")</caption>
                                <thead>
                                    <tr>
                                        @foreach (string weekday in CalendarWeekdays)
                                        {
                                            <th scope="col"><abbr title="@CalendarWeekdayName(weekday)">@weekday</abbr></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DateOnly[] week in CalendarWeeks)
                                    {
                                        <tr>
                                            @foreach (DateOnly date in week)
                                            {
                                                CalendarDayView? day = DayFor(date);
                                                <td class="calendar-cell @CalendarCellClass(date)">
                                                    <button class="calendar-date-button" type="button"
                                                            aria-pressed="@(selectedMonthDate == date ? "true" : "false")"
                                                            aria-current="@(date == DateOnly.FromDateTime(DateTime.Today) ? "date" : null)"
                                                            aria-label="@CalendarDateLabel(date, day)"
                                                            @onclick="() => SelectMonthDateAsync(date)">
                                                        <time datetime="@date.ToString("yyyy-MM-dd")"><span>@date.Day</span></time>
                                                        @if (day?.Options.Count is > 0)
                                                        {
                                                            <span class="calendar-date-markers" aria-hidden="true">
                                                                <small class="calendar-date-count">@day.Options.Count</small>
                                                                @if (day.Options.Any(static option => option.IsCompleted))
                                                                {
                                                                    <i class="calendar-date-marker--completed"></i>
                                                                }
                                                                @foreach (CalendarOptionView option in day.Options
                                                                    .GroupBy(static option => option.Source == "Program")
                                                                    .Select(static group => group.First())
                                                                    .Take(2))
                                                                {
                                                                    <i class="@(option.Source == "Program" ? "calendar-date-marker--program" : null)"></i>
                                                                }
                                                            </span>
                                                        }
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <section class="calendar-selected-day" aria-labelledby="calendar-selected-day-title">
                            <div class="panel-heading">
                                <div><p class="eyebrow">Selected date</p><h3 id="calendar-selected-day-title">@selectedMonthDate.ToString("dddd d MMMM")</h3></div>
                                <span>@(SelectedMonthDay?.Options.Count ?? 0) scheduled</span>
                            </div>
                            @if (SelectedMonthDay is { } selectedDay && selectedDay.Options.Count > 0)
                            {
                                <div class="calendar-selected-day__workouts">
                                    @foreach (CalendarOptionView option in selectedDay.Options)
                                    {
                                        <div class="calendar-option-shell @(option.Source == "Program" ? "calendar-option-shell--program" : null)">
                                            <button class="calendar-option @(option.IsSelected ? "calendar-option--selected" : null) @(option.IsCompleted ? "calendar-option--completed" : null)" type="button" @onclick="() => OpenCalendarDetailsAsync(selectedDay, option)" aria-haspopup="dialog" aria-label="@CalendarOptionAriaLabel(selectedMonthDate, option)">
                                                <span>@option.WorkoutName</span><small>@(option.IsRepeat ? "Extra attempt · " : string.Empty)@CalendarOptionContext(option)</small>
                                                @if (option.IsCompleted)
                                                {
                                                    <strong class="calendar-completion-status"><span aria-hidden="true">✓</span>Completed</strong>
                                                }
                                            </button>
                                            @if (!option.IsRepeat)
                                            {
                                                <button class="calendar-option-manage" type="button" @onclick="() => OpenOptionManager(selectedMonthDate, option)" aria-haspopup="dialog" aria-label="Manage @option.WorkoutName on @selectedMonthDate.ToString("d MMMM")" title="Manage session"><AppIcon Name="more" /><span class="calendar-option-manage__label">Manage</span></button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="empty-state">
                                    @if (HasVisibleMonthWorkouts)
                                    {
                                        <span>No workout planned for this date.</span>
                                    }
                                    else
                                    {
                                        <span>No workouts are planned this month. <a href="/workouts">Open Training plans</a> to schedule one.</span>
                                    }
                                </p>
                            }
                        </section>
                    </div>
                }
                @if (calendarView == CalendarViewMode.Agenda && !HasVisibleMonthWorkouts)
                {
                    <p class="empty-state">No workouts are planned this month. <a href="/workouts">Open Training plans</a> to schedule one.</p>
                }
            }
        </section>
    }
</div>

@if (managedSession is not null)
{
    <div id="schedule-dialog-backdrop" class="schedule-dialog-backdrop" @onclick="CloseManagerAsync">
        <section class="schedule-dialog" role="dialog" aria-modal="true" aria-labelledby="schedule-dialog-title" @onclick:stopPropagation="true">
            <div class="panel-heading">
                <div><p class="eyebrow">@managedSession.ScheduleName</p><h2 id="schedule-dialog-title">@(managedSession.IsWholeGroup ? "Manage workout group" : managedSession.WorkoutName)</h2></div>
                <button class="secondary-action icon-action" type="button" @onclick="CloseManagerAsync" aria-label="Close schedule manager" title="Close" autofocus><AppIcon Name="close" /></button>
            </div>
            @if (!managedSession.IsWholeGroup)
            {
                <p class="schedule-dialog__summary">Scheduled for <strong>@managedSession.SourceDate.ToString("dddd d MMMM")</strong>.</p>
                @if (managerStep == ManagerSteps.Actions)
                {
                    <div id="schedule-dialog-stage" class="schedule-choice-grid" aria-label="Session actions" aria-live="polite" tabindex="-1">
                        <button class="schedule-choice" type="button" aria-label="Move session" aria-describedby="move-session-description" @onclick="() => SetManagerStepAsync(ManagerSteps.MoveDate)">
                            <strong>Move session</strong><span id="move-session-description">Choose another date, then decide whether later sessions move too.</span>
                        </button>
                        <button class="schedule-choice schedule-choice--danger" type="button" aria-label="Delete from schedule" aria-describedby="delete-schedule-description" @onclick="() => SetManagerStepAsync(ManagerSteps.DeleteScope)">
                            <strong>Delete from schedule</strong><span id="delete-schedule-description">Remove this date or the complete workout group.</span>
                        </button>
                    </div>
                }
                else if (managerStep == ManagerSteps.MoveDate)
                {
                    <div id="schedule-dialog-stage" class="schedule-dialog-stage" aria-live="polite" tabindex="-1">
                        <div><p class="eyebrow">Step 1 of 2</p><h3>Choose the new date</h3></div>
                        <label class="field">Move to<input type="date" @bind="moveTargetDate" min="@managedSession.SourceDate.AddDays(-365).ToString("yyyy-MM-dd")" max="@managedSession.SourceDate.AddDays(365).ToString("yyyy-MM-dd")" /></label>
                        @if (moveTargetDate == managedSession.SourceDate)
                        {
                            <p class="field-help">Choose a date other than @managedSession.SourceDate.ToString("d MMMM").</p>
                        }
                        <div class="schedule-dialog-actions schedule-dialog-actions--confirm">
                            <button class="secondary-action" type="button" @onclick="ReturnToManagerActions">Back</button>
                            <button class="primary-action" type="button" @onclick="ContinueToMoveScope" disabled="@(moveTargetDate == managedSession.SourceDate)">Continue</button>
                        </div>
                    </div>
                }
                else if (managerStep == ManagerSteps.MoveScope)
                {
                    <div id="schedule-dialog-stage" class="schedule-dialog-stage" aria-live="polite" tabindex="-1">
                        <div><p class="eyebrow">Step 2 of 2</p><h3>Should later sessions move too?</h3></div>
                        <p class="schedule-dialog__summary">Move from <strong>@managedSession.SourceDate.ToString("d MMM")</strong> to <strong>@moveTargetDate.ToString("d MMM")</strong> (@MoveOffsetLabel).</p>
                        <div class="schedule-choice-grid">
                            <button class="schedule-choice" type="button" aria-label="Only this session" aria-describedby="move-one-description" @onclick="() => MoveManagedSessionAsync(false)" disabled="@scheduleActionBusy">
                                <strong>Only this session</strong><span id="move-one-description">Every other date in @managedSession.ScheduleName stays unchanged.</span>
                            </button>
                            <button class="schedule-choice" type="button" aria-label="This and all later sessions" aria-describedby="move-following-description" @onclick="() => SetManagerStepAsync(ManagerSteps.ConfirmFollowingMove)" disabled="@scheduleActionBusy">
                                <strong>This and all later sessions</strong><span id="move-following-description">Shift this session and every session after it by the same amount.</span>
                            </button>
                        </div>
                        <button class="text-action" type="button" @onclick="() => SetManagerStepAsync(ManagerSteps.MoveDate)" disabled="@scheduleActionBusy">Change date</button>
                    </div>
                }
                else if (managerStep == ManagerSteps.ConfirmFollowingMove)
                {
                    <div id="schedule-dialog-stage" class="schedule-inline-confirm" aria-live="polite" tabindex="-1">
                        <div><p class="eyebrow">Final confirmation</p><h3>Move this and every later session?</h3></div>
                        <p>The group will shift @MoveOffsetLabel, beginning on <strong>@moveTargetDate.ToString("d MMM")</strong>.</p>
                        <button class="secondary-action" type="button" @onclick="() => SetManagerStepAsync(ManagerSteps.MoveScope)" disabled="@scheduleActionBusy">Back</button>
                        <button class="primary-action" type="button" @onclick="() => MoveManagedSessionAsync(true)" disabled="@scheduleActionBusy">Yes, move later sessions</button>
                    </div>
                }
                else if (managerStep == ManagerSteps.DeleteScope)
                {
                    <div id="schedule-dialog-stage" class="schedule-dialog-stage" aria-live="polite" tabindex="-1">
                        <div><p class="eyebrow">Delete scope</p><h3>What should be removed?</h3></div>
                        <div class="schedule-choice-grid">
                            <button class="schedule-choice schedule-choice--danger" type="button" aria-label="Only this session" aria-describedby="delete-one-description" @onclick="() => SetManagerStepAsync(ManagerSteps.ConfirmSessionDelete)">
                                <strong>Only this session</strong><span id="delete-one-description">Remove @managedSession.SourceDate.ToString("d MMMM") and keep the rest of the group.</span>
                            </button>
                            <button class="schedule-choice schedule-choice--danger" type="button" aria-label="Complete workout group" aria-describedby="delete-group-description" @onclick="() => SetManagerStepAsync(ManagerSteps.ConfirmGroupDelete)">
                                <strong>Complete workout group</strong><span id="delete-group-description">Remove every current and future session in @managedSession.ScheduleName.</span>
                            </button>
                        </div>
                        <button class="text-action" type="button" @onclick="ReturnToManagerActions">Cancel</button>
                    </div>
                }
                else if (managerStep == ManagerSteps.ConfirmSessionDelete)
                {
                    <div id="schedule-dialog-stage" class="schedule-inline-confirm" aria-live="polite" tabindex="-1">
                        <p><strong>Delete only this session?</strong> @managedSession.SourceDate.ToString("dddd d MMMM") will be removed. Completed runs stay in history.</p>
                        <button class="secondary-action" type="button" @onclick="() => SetManagerStepAsync(ManagerSteps.DeleteScope)" disabled="@scheduleActionBusy">Back</button>
                        <button class="primary-action danger-action" type="button" @onclick="DeleteManagedSessionAsync" disabled="@scheduleActionBusy">Yes, delete session</button>
                    </div>
                }
            }
            @if (managedSession.IsWholeGroup && managerStep != ManagerSteps.ConfirmGroupDelete)
            {
                <div id="schedule-dialog-stage" class="schedule-group-danger" aria-live="polite" tabindex="-1">
                    <p>Remove this schedule and all current and future sessions. Completed runs stay in history.</p>
                    <button class="text-action danger-action" type="button" @onclick="() => SetManagerStepAsync(ManagerSteps.ConfirmGroupDelete)">Delete complete workout group</button>
                </div>
            }
            @if (managerStep == ManagerSteps.ConfirmGroupDelete)
            {
                <div id="schedule-dialog-stage" class="schedule-inline-confirm" aria-live="polite" tabindex="-1">
                    <p><strong>Delete the complete workout group?</strong> All current and future sessions in @managedSession.ScheduleName will be removed. Completed runs stay in history.</p>
                    <button class="secondary-action" type="button" @onclick="ReturnFromGroupConfirmation" disabled="@scheduleActionBusy">Back</button>
                    <button class="primary-action danger-action" type="button" @onclick="DeleteManagedGroupAsync" disabled="@scheduleActionBusy">Yes, delete group</button>
                </div>
            }
        </section>
    </div>
}

@if (managedProgramSession is not null)
{
    <div id="program-schedule-dialog-backdrop" class="schedule-dialog-backdrop" @onclick="CloseProgramManagerAsync">
        <section class="schedule-dialog" role="dialog" aria-modal="true" aria-labelledby="program-schedule-dialog-title" @onclick:stopPropagation="true">
            <div class="panel-heading">
                <div><p class="eyebrow">@managedProgramSession.PlanName · step @managedProgramSession.Position of @managedProgramSession.Total</p><h2 id="program-schedule-dialog-title">@managedProgramSession.WorkoutName</h2></div>
                <button class="secondary-action icon-action" type="button" @onclick="CloseProgramManagerAsync" aria-label="Close plan session manager" title="Close" autofocus><AppIcon Name="close" /></button>
            </div>
            <p class="schedule-dialog__summary">Currently planned for <strong>@managedProgramSession.CurrentDate.ToString("dddd d MMMM")</strong>.</p>
            @if (!string.IsNullOrWhiteSpace(programActionError))
            {
                <p class="field-error" role="alert">@programActionError</p>
            }
            @if (changingProgramDays)
            {
                <div id="program-schedule-dialog-stage" class="schedule-dialog-stage default-days-stage" aria-live="polite" tabindex="-1">
                    <div><p class="eyebrow">Weekly rhythm</p><h3>Change training days</h3></div>
                    @if (defaultDaysPreview is null)
                    {
                        <p class="schedule-dialog__summary">Choose exactly <strong>@RequiredProgramTrainingDays</strong> days. Completed runs, skips, repeats, and sessions you moved individually stay where they are.</p>
                        <div class="weekday-picker default-days-picker" role="group" aria-label="New default training days">
                            @foreach ((string label, int flag) in Weekdays)
                            {
                                <button type="button" aria-pressed="@(((programWeekdayMask & flag) != 0).ToString().ToLowerInvariant())" @onclick="() => ToggleProgramWeekday(flag)">@label</button>
                            }
                        </div>
                        <label class="field">Apply from
                            <input type="date" @bind="programEffectiveDate" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                        </label>
                        <p class="field-help">Current days: @FormatWeekdayMask(managedProgramSession.WeekdayMask). The preview shows every generated future session and blocks changes that would put two sessions on one date.</p>
                        <div class="schedule-dialog-actions">
                            <button class="secondary-action" type="button" @onclick="CancelDefaultDaysChange" disabled="@programActionBusy">Back</button>
                            <button class="primary-action" type="button" @onclick="PreviewDefaultDaysChangeAsync" disabled="@(!CanPreviewDefaultDays || programActionBusy)">@(programActionBusy ? "Checking…" : "Preview new schedule")</button>
                        </div>
                    }
                    else
                    {
                        <p class="schedule-dialog__summary">@defaultDaysPreview.Message</p>
                        <dl class="schedule-impact-summary">
                            <div><dt>New days</dt><dd>@FormatWeekdayMask(defaultDaysPreview.NewWeekdayMask)</dd></div>
                            <div><dt>Sessions moving</dt><dd>@defaultDaysPreview.Impacts.Count</dd></div>
                            <div><dt>Preserved</dt><dd>@defaultDaysPreview.PreservedExceptionCount</dd></div>
                        </dl>
                        <ol class="default-days-impact-list" aria-label="Future workout date changes">
                            @foreach (WorkoutProgramDefaultDaysImpactView impact in defaultDaysPreview.Impacts)
                            {
                                <li><span>Session @impact.Position</span><strong>@impact.CurrentDate.ToString("d MMM") → @impact.NewDate.ToString("d MMM")</strong></li>
                            }
                        </ol>
                        @if (defaultDaysPreview.CollisionDates.Count > 0)
                        {
                            <p class="notice" role="alert"><strong>Date unavailable.</strong> @string.Join(", ", defaultDaysPreview.CollisionDates.Select(date => date.ToString("d MMM"))) already contain another session. Choose different training days or move that session first.</p>
                        }
                        <div class="schedule-dialog-actions schedule-dialog-actions--confirm">
                            <button class="secondary-action" type="button" @onclick="ClearDefaultDaysPreview" disabled="@programActionBusy">Back</button>
                            <button class="primary-action" type="button" @onclick="ApplyDefaultDaysChangeAsync" disabled="@(!defaultDaysPreview.CanApply || programActionBusy)">@(programActionBusy ? "Rescheduling…" : "Confirm all future changes")</button>
                        </div>
                        @if (!defaultDaysPreview.CanApply)
                        {
                            <p class="field-error" role="alert">No change can be made: @defaultDaysPreview.Message</p>
                        }
                    }
                </div>
            }
            else if (programPreview is null)
            {
                <div id="program-schedule-dialog-stage" class="schedule-dialog-stage" aria-live="polite" tabindex="-1">
                    @if (programMoveAction is not null)
                    {
                        <div><p class="eyebrow">@ProgramActionTitle(programMoveAction)</p><h3>Choose the new date</h3></div>
                        <label class="field">Move to date
                            <input type="date" @bind="programTargetDate" min="@managedProgramSession.CurrentDate.AddDays(-365).ToString("yyyy-MM-dd")" max="@managedProgramSession.CurrentDate.AddDays(365).ToString("yyyy-MM-dd")" />
                        </label>
                        @if (programTargetDate == managedProgramSession.CurrentDate)
                        {
                            <p class="field-help">Choose a date other than @managedProgramSession.CurrentDate.ToString("d MMMM"). Gaps in the plan are allowed.</p>
                        }
                        else
                        {
                            <p class="field-help">The session will move to exactly @programTargetDate.ToString("d MMMM"); it will not be snapped to a training day.</p>
                        }
                        <div class="schedule-dialog-actions schedule-dialog-actions--confirm">
                            <button class="secondary-action" type="button" @onclick="CancelProgramMove" disabled="@programActionBusy">Back</button>
                            <button class="primary-action" type="button" @onclick="PreviewPendingProgramMoveAsync" disabled="@(programTargetDate == managedProgramSession.CurrentDate || programActionBusy)">@(programActionBusy ? "Checking…" : "Preview move")</button>
                        </div>
                    }
                    else
                    {
                        <button class="secondary-action change-training-days" type="button" @onclick="StartDefaultDaysChange">Change training days</button>
                        <button class="secondary-action danger-action" type="button" @onclick="RequestClearUpcomingFromProgramManagerAsync" disabled="@clearUpcomingBusy">Remove all upcoming sessions from this plan</button>
                        @if (managedProgramSession.IsCompleted)
                        {
                            <label class="field">New or repeat date
                                <input type="date" @bind="programTargetDate" min="@managedProgramSession.CurrentDate.AddDays(-365).ToString("yyyy-MM-dd")" max="@managedProgramSession.CurrentDate.AddDays(365).ToString("yyyy-MM-dd")" />
                            </label>
                        }
                        <div class="schedule-choice-grid">
                            @if (managedProgramSession.IsCompleted)
                            {
                                <p class="field-hint schedule-choice-grid__hint">This plan step is completed. Correct its calendar date or add another attempt without changing completed history.</p>
                                <button class="schedule-choice" type="button" @onclick='() => StartProgramMove("MoveOne")' disabled="@programActionBusy"><strong>Move only this session</strong><span>Correct the completed step to an exact date. Its completed run stays unchanged.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => StartProgramMove("MoveFollowing")' disabled="@programActionBusy"><strong>Move this and all following</strong><span>Use the actual completion date, then shift every later incomplete session by the same number of days.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => PreviewProgramChangeAsync("Repeat")' disabled="@programActionBusy"><strong>Repeat · keep later dates</strong><span>Add an extra attempt without rewinding completed progress.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => PreviewProgramChangeAsync("RepeatAndShift")' disabled="@programActionBusy"><strong>Repeat · shift the rest</strong><span>Insert an extra attempt and move the remaining incomplete plan forward.</span></button>
                            }
                            else
                            {
                                <p class="field-hint schedule-choice-grid__hint">This plan step is still incomplete. Reschedule or skip it; a failed attempt never counts as completed.</p>
                                <button class="schedule-choice" type="button" @onclick='() => StartProgramMove("MoveOne")' disabled="@programActionBusy"><strong>Move only this session</strong><span>Choose an exact date. Later plan dates remain unchanged and gaps are allowed.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => StartProgramMove("MoveFollowing")' disabled="@programActionBusy"><strong>Move this and all following</strong><span>Choose an exact date, then shift the remaining plan by the same number of days.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => PreviewProgramChangeAsync("Skip")' disabled="@programActionBusy"><strong>Skip this session</strong><span>Advance to the next plan step without creating a completed run.</span></button>
                                <button class="schedule-choice" type="button" @onclick='() => PreviewProgramChangeAsync("Restore")' disabled="@programActionBusy"><strong>Restore original date</strong><span>Remove the saved move or skip for this plan step.</span></button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div id="program-schedule-dialog-stage" class="schedule-dialog-stage" aria-live="polite" tabindex="-1">
                    <div><p class="eyebrow">Impact preview</p><h3>@ProgramActionTitle(programPreview.Action)</h3></div>
                    <p class="schedule-dialog__summary">@programPreview.Message</p>
                    @if (programPreview.Impacts.Count > 0)
                    {
                        <dl class="schedule-impact-summary">
                            <div><dt>Affected</dt><dd>@programPreview.Impacts.Count session(s)</dd></div>
                            <div><dt>First change</dt><dd>@ImpactDate(programPreview.Impacts[0])</dd></div>
                            @if (programPreview.Impacts.Count > 1)
                            {
                                <div><dt>Last change</dt><dd>@ImpactDate(programPreview.Impacts[^1])</dd></div>
                            }
                        </dl>
                    }
                    @if (programPreview.CollisionDates.Count > 0)
                    {
                        <p class="notice" role="alert"><strong>@(programPreview.CanApply ? "Double-session warning." : "Date unavailable.")</strong> @string.Join(", ", programPreview.CollisionDates.Select(date => date.ToString("d MMM"))) already contain another plan session.@(programPreview.CanApply ? " Nothing will be overwritten." : " Choose an empty date instead.")</p>
                    }
                    <div class="schedule-dialog-actions schedule-dialog-actions--confirm">
                        <button class="secondary-action" type="button" @onclick="ClearProgramPreview" disabled="@programActionBusy">Back</button>
                        <button class="primary-action" type="button" @onclick="ApplyProgramChangeAsync" disabled="@(!programPreview.CanApply || programActionBusy)">@(programActionBusy ? "Saving…" : "Confirm change")</button>
                    </div>
                    @if (!programPreview.CanApply)
                    {
                        <p class="field-error" role="alert">No change can be made: @programPreview.Message</p>
                    }
                </div>
            }
        </section>
    </div>
}

@if (selectedCalendarDetail is not null)
{
    <DetailSheet BackdropId="calendar-details-backdrop" BackdropClass="workout-details-backdrop" CssClass="workout-details-dialog calendar-details-dialog" LabelledBy="calendar-details-title" OnDismiss="CloseCalendarDetailsAsync">
        <header class="workout-details-header">
            <div>
                <p class="eyebrow">@selectedCalendarDetail.Option.ScheduleName · @selectedCalendarDetail.Date.ToString("dddd d MMMM")</p>
                <h2 id="calendar-details-title">@selectedCalendarDetail.Option.WorkoutName</h2>
            </div>
            <button class="icon-action" type="button" aria-label="Close calendar workout details" autofocus @onclick="CloseCalendarDetailsAsync"><AppIcon Name="close" /></button>
        </header>
        <dl class="workout-details-overview" aria-label="Scheduled workout overview">
            <div><dt>Date</dt><dd>@selectedCalendarDetail.Date.ToString("d MMM yyyy")</dd></div>
            <div><dt>Source</dt><dd>@(selectedCalendarDetail.Option.Source == "Program" ? "Training plan" : "Calendar schedule")</dd></div>
            <div><dt>Revision</dt><dd>@selectedCalendarDetail.Option.RevisionNumber</dd></div>
            <div><dt>Schedule</dt><dd>@selectedCalendarDetail.Option.ScheduleName</dd></div>
            <div><dt>Day choice</dt><dd>@(selectedCalendarDetail.Option.IsSelected ? "Selected" : "Alternative")</dd></div>
            <div><dt>Recorded data</dt><dd>@(selectedCalendarDetail.Option.IsCompleted ? "Completed plan step" : "Not run yet")</dd></div>
        </dl>
        @if (calendarDetailsLoading)
        {
            <p class="empty-state" role="status">Loading the immutable workout revision…</p>
        }
        else if (!string.IsNullOrWhiteSpace(calendarDetailsError))
        {
            <div class="empty-state" role="alert"><p>@calendarDetailsError</p><button class="secondary-action" type="button" @onclick="RetryCalendarDetailsAsync">Try again</button></div>
        }
        else if (selectedCalendarRevision is not null)
        {
            <WorkoutPlanDetails Blocks="selectedCalendarRevision.Blocks" IdPrefix="calendar-workout-detail" />
        }
        <div class="card-actions workout-details-actions">
            <button class="secondary-action" type="button" @onclick="CloseCalendarDetailsAsync">Close</button>
            @if (selectedCalendarDetail.Option.Source != "Program" && !selectedCalendarDetail.Option.IsSelected)
            {
                <button class="primary-action" type="button" disabled="@calendarSelectionBusy" @onclick="SelectCalendarDetailAsync">@(calendarSelectionBusy ? "Saving…" : "Choose for this day")</button>
            }
        </div>
    </DetailSheet>
}

@code {
    private static readonly (string Label, int Flag)[] Weekdays =
    [
        ("Mon", 1), ("Tue", 2), ("Wed", 4), ("Thu", 8), ("Fri", 16), ("Sat", 32), ("Sun", 64),
    ];
    private static readonly string[] CalendarWeekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private readonly CalendarSeriesForm series = new();
    private DateOnly visibleMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly selectedMonthDate = DateOnly.FromDateTime(DateTime.Today);
    private CalendarViewMode calendarView = CalendarViewMode.Agenda;
    private Guid? activeProfileId;
    private List<ProfileView> profiles = [];
    private List<WorkoutSummaryView> workouts = [];
    private List<WorkoutProgramSummaryView> programs = [];
    private List<CalendarSeriesView> calendarSeries = [];
    private CalendarRangeView? calendar;
    private bool initialized;
    private bool loading = true;
    private string? calendarLoadError;
    private int calendarLoadGeneration;
    private CancellationTokenSource? calendarLoadCancellation;
    private int profileApplyGeneration;
    private bool showSeriesForm;
    private string scheduleSource = "workout";
    private string scheduleSearch = string.Empty;
    private WorkoutProgramSummaryView? pendingCalendarProgram;
    private DateOnly programScheduleStartDate = DateOnly.FromDateTime(DateTime.Today);
    private int programScheduleWeekdayMask = 37;
    private bool clearUpcomingBusy;
    private WorkoutProgramClearUpcomingView? clearUpcomingPreview;
    private Guid? clearUpcomingProfileId;
    private int clearUpcomingGeneration;
    private CancellationTokenSource? clearUpcomingCancellation;
    private string? message;
    private Guid pendingSeriesOperationId = Guid.NewGuid();
    private readonly Dictionary<DateOnly, Guid> pendingSelectionOperations = [];
    private ManagedSchedule? managedSession;
    private ManagedProgramSession? managedProgramSession;
    private CalendarDetailSelection? selectedCalendarDetail;
    private WorkoutRevisionView? selectedCalendarRevision;
    private bool calendarDetailsLoading;
    private bool calendarSelectionBusy;
    private string? calendarDetailsError;
    private int calendarDetailsGeneration;
    private CancellationTokenSource? calendarDetailsCancellation;
    private WorkoutProgramScheduleChangePreviewView? programPreview;
    private string? programMoveAction;
    private string? programActionError;
    private WorkoutProgramDefaultDaysPreviewView? defaultDaysPreview;
    private bool changingProgramDays;
    private int programWeekdayMask;
    private DateOnly programEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly programTargetDate;
    private bool programActionBusy;
    private DateOnly moveTargetDate;
    private bool scheduleActionBusy;
    private string managerStep = ManagerSteps.Actions;
    private bool openModalPending;
    private bool focusModalStagePending;
    private DotNetObjectReference<Calendar>? modalReference;
    private string? calendarDraftKey;
    private string? pendingCalendarDraft;
    private CancellationTokenSource? calendarDraftDebounce;
    private int initialLoadGeneration;
    private int calendarSelectionGeneration;
    private int RequiredProgramTrainingDays => managedProgramSession is null
        ? 0
        : Weekdays.Count(day => (managedProgramSession.WeekdayMask & day.Flag) != 0);
    private bool CanPreviewDefaultDays => managedProgramSession is not null &&
        programWeekdayMask != managedProgramSession.WeekdayMask &&
        Weekdays.Count(day => (programWeekdayMask & day.Flag) != 0) == RequiredProgramTrainingDays &&
        programEffectiveDate >= DateOnly.FromDateTime(DateTime.Today);
    private bool CanNavigatePreviousMonth => visibleMonth > DateOnly.MinValue;
    private bool CanNavigateNextMonth => visibleMonth.Year < DateOnly.MaxValue.Year || visibleMonth.Month < DateOnly.MaxValue.Month;
    private WorkoutProgramSummaryView? ActiveScheduledProgram => programs.FirstOrDefault(static program =>
        program.Run is { Status: "Active", ScheduledStartDate: not null });
    private WorkoutProgramSummaryView? ActiveProgram => programs.FirstOrDefault(static program => program.Run is { Status: "Active" });
    private string ActiveProfileName => profiles.FirstOrDefault(profile => profile.Id == activeProfileId)?.DisplayName ?? "selected runner";
    private IReadOnlyList<WorkoutSummaryView> FilteredScheduleWorkouts => workouts
        .Where(workout => string.IsNullOrWhiteSpace(scheduleSearch) ||
            workout.Name.Contains(scheduleSearch, StringComparison.CurrentCultureIgnoreCase) ||
            (workout.Description?.Contains(scheduleSearch, StringComparison.CurrentCultureIgnoreCase) ?? false))
        .OrderBy(static workout => workout.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
    private IReadOnlyList<WorkoutProgramSummaryView> FilteredSchedulePrograms => programs
        .Where(program => !program.IsArchived && (string.IsNullOrWhiteSpace(scheduleSearch) ||
            program.Name.Contains(scheduleSearch, StringComparison.CurrentCultureIgnoreCase) ||
            (program.Description?.Contains(scheduleSearch, StringComparison.CurrentCultureIgnoreCase) ?? false) ||
            program.Category.Contains(scheduleSearch, StringComparison.CurrentCultureIgnoreCase)))
        .OrderByDescending(static program => program.Run is { Status: "Active" })
        .ThenBy(static program => program.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
    private int RequiredTrainingDays => pendingCalendarProgram is { } program
        ? program.RequiredTrainingDays
        : 3;
    private bool CanConfirmProgramSchedule => pendingCalendarProgram is not null &&
        CountSelectedWeekdays(programScheduleWeekdayMask) == RequiredTrainingDays &&
        (programScheduleWeekdayMask & WeekdayFlag(programScheduleStartDate.DayOfWeek)) != 0;

    private IReadOnlyList<ScheduleGroupSummary> ScheduleGroups => calendarSeries
        .GroupBy(static item => item.ScheduleGroupId)
        .Select(group => new ScheduleGroupSummary(
            group.Key,
            group.OrderBy(static item => item.StartDate).First().Name,
            group.Min(static item => item.StartDate),
            group.Any(static item => item.EndDate is null) ? null : group.Max(static item => item.EndDate),
            group.SelectMany(static item => item.Alternatives).Select(static item => item.WorkoutRevisionId).Distinct().Count(),
            group.OrderByDescending(static item => item.StartDate).First()))
        .OrderBy(static group => group.StartDate)
        .ToArray();

    protected override void OnInitialized() => ActiveProfile.Changed += ActiveProfileChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            await ReloadInitialCalendarAsync();
        }

        if (openModalPending && (managedSession is not null || managedProgramSession is not null || selectedCalendarDetail is not null))
        {
            openModalPending = false;
            modalReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "treadmillRunnerView.openModal",
                selectedCalendarDetail is not null
                    ? "calendar-details-backdrop"
                    : managedProgramSession is null ? "schedule-dialog-backdrop" : "program-schedule-dialog-backdrop",
                modalReference);
        }
        else if (focusModalStagePending && (managedSession is not null || managedProgramSession is not null))
        {
            focusModalStagePending = false;
            await JS.InvokeVoidAsync(
                "treadmillRunnerView.focusModalStage",
                managedProgramSession is null ? "schedule-dialog-stage" : "program-schedule-dialog-stage");
        }
    }

    private async Task ReloadInitialCalendarAsync()
    {
        int generation = ++initialLoadGeneration;
        int profileGeneration = profileApplyGeneration;
        loading = true;
        calendarLoadError = null;
        try
        {
            List<ProfileView> loadedProfiles = await Http.GetFromJsonAsync<List<ProfileView>>("api/planning/profiles") ?? [];
            if (generation != initialLoadGeneration || profileGeneration != profileApplyGeneration) return;
            profiles = loadedProfiles;
            Guid? loadedProfileId = await ActiveProfile.GetAsync();
            if (generation != initialLoadGeneration || profileGeneration != profileApplyGeneration) return;
            activeProfileId = loadedProfileId;
            if (activeProfileId is { } storedProfileId && profiles.All(profile => profile.Id != storedProfileId))
            {
                activeProfileId = null;
                await ActiveProfile.ClearAsync();
            }
            if (activeProfileId is null && profiles.Count == 1)
            {
                activeProfileId = profiles[0].Id;
                await ActiveProfile.SetAsync(profiles[0].Id);
            }
            if (generation != initialLoadGeneration || profileGeneration != profileApplyGeneration) return;
            calendarDraftKey = $"{activeProfileId?.ToString("N") ?? "household"}.calendar.new";
            pendingCalendarDraft = await JS.InvokeAsync<string?>("treadmillRunnerDrafts.load", calendarDraftKey);
            if (generation != initialLoadGeneration || profileGeneration != profileApplyGeneration) return;
            if (activeProfileId is not null)
            {
                workouts = await Http.GetFromJsonAsync<List<WorkoutSummaryView>>("api/planning/workouts") ?? [];
                if (generation != initialLoadGeneration || profileGeneration != profileApplyGeneration) return;
                await ReloadCalendarAsync();
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or JSException)
        {
            if (generation == initialLoadGeneration && profileGeneration == profileApplyGeneration)
                calendarLoadError = "The calendar could not be loaded from the local gateway. Check the connection and retry.";
        }
        finally
        {
            if (generation == initialLoadGeneration && profileGeneration == profileApplyGeneration)
            {
                loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ToggleSeriesForm()
    {
        showSeriesForm = !showSeriesForm;
        if (!showSeriesForm) { scheduleSearch = string.Empty; pendingCalendarProgram = null; }
    }

    private void SelectScheduleSource(string source)
    {
        scheduleSource = source;
        scheduleSearch = string.Empty;
        pendingCalendarProgram = null;
    }

    private void SelectWorkoutForSchedule(WorkoutSummaryView workout)
    {
        series.PrimaryRevisionId = workout.CurrentRevisionId;
        if (series.Name == "Weekly rhythm" || string.IsNullOrWhiteSpace(series.Name)) series.Name = workout.Name;
    }

    private void SelectProgramForSchedule(WorkoutProgramSummaryView program)
    {
        pendingCalendarProgram = program;
        programScheduleWeekdayMask = DefaultWeekdayMask(RequiredTrainingDays);
        programScheduleStartDate = NextSelectedDate(DateOnly.FromDateTime(DateTime.Today), programScheduleWeekdayMask);
    }

    private void TogglePlanWeekday(int flag) => programScheduleWeekdayMask = (programScheduleWeekdayMask & flag) != 0
        ? programScheduleWeekdayMask & ~flag
        : programScheduleWeekdayMask | flag;

    private async Task ConfirmProgramScheduleAsync()
    {
        if (activeProfileId is not { } profileId || pendingCalendarProgram is not { } program || !CanConfirmProgramSchedule) return;
        try
        {
            WorkoutProgramSummaryView? active = ActiveProgram;
            string action = active?.Id == program.Id ? "restart" : "start";
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/programs/{program.Id:D}/{action}",
                new WorkoutProgramStartRequest(
                    Guid.NewGuid(), profileId, program.RevisionId, active?.Run?.Id, active?.Run?.Version,
                    programScheduleStartDate, programScheduleWeekdayMask, "Europe/Brussels"));
            if (response.IsSuccessStatusCode)
            {
                message = $"{program.Name} is scheduled for {ActiveProfileName}.";
                pendingCalendarProgram = null;
                showSeriesForm = false;
                await ReloadCalendarAsync();
            }
            else
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The active plan changed. Reloaded the latest plans; review and try again."
                    : "The training plan could not be scheduled.";
                await ReloadCalendarAsync();
            }
        }
        finally { }
    }

    private void ToggleWeekday(int flag, ChangeEventArgs args)
    {
        bool selected = args.Value is bool value && value;
        if (selected)
        {
            series.WeekdayFlags.Add(flag);
        }
        else
        {
            series.WeekdayFlags.Remove(flag);
        }
        QueueCalendarDraftSave();
    }

    private async Task SaveSeriesAsync(EditContext _)
    {
        if (activeProfileId is null || series.PrimaryRevisionId is null)
        {
            message = "Choose an active profile and primary workout.";
            return;
        }

        var alternatives = new List<CalendarAlternativeInput> { new(series.PrimaryRevisionId.Value, 0) };
        if (series.AlternativeRevisionId is { } alternative && alternative != series.PrimaryRevisionId)
        {
            alternatives.Add(new CalendarAlternativeInput(alternative, 1));
        }

        List<CalendarExceptionInput> exceptions = [];
        if (series.ExceptionDate is { } exceptionDate)
        {
            IReadOnlyList<CalendarAlternativeInput> exceptionAlternatives = series.ExceptionKind == "Skip"
                ? []
                : alternatives.Skip(1).DefaultIfEmpty(alternatives[0]).Take(1).ToArray();
            exceptions.Add(new CalendarExceptionInput(exceptionDate, series.ExceptionKind, exceptionAlternatives));
        }

        var request = new CalendarSeriesSaveRequest(
            pendingSeriesOperationId,
            activeProfileId.Value,
            series.Name,
            "Europe/Brussels",
            series.StartDate,
            series.EndDate,
            series.IntervalWeeks,
            series.WeekdayFlags.Aggregate(0, static (current, flag) => current | flag),
            alternatives,
            exceptions);
        using HttpResponseMessage response = await Http.PostAsJsonAsync("api/planning/calendar/series", request);
        message = response.IsSuccessStatusCode ? "Schedule saved." : "The schedule could not be saved.";
        if (response.IsSuccessStatusCode)
        {
            await DiscardCalendarDraftAsync();
            pendingSeriesOperationId = Guid.NewGuid();
            showSeriesForm = false;
            await ReloadCalendarAsync();
        }

    }

    private void QueueCalendarDraftSave()
    {
        calendarDraftDebounce?.Cancel();
        calendarDraftDebounce = new CancellationTokenSource();
        _ = SaveCalendarDraftAfterDelayAsync(calendarDraftDebounce.Token);
    }

    private async Task SaveCalendarDraftAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(450, cancellationToken);
            if (calendarDraftKey is null) return;
            var draft = new CalendarDraft(series.Name, series.StartDate, series.EndDate, series.IntervalWeeks, series.WeekdayFlags.ToArray(), series.PrimaryRevisionId, series.AlternativeRevisionId, series.ExceptionDate, series.ExceptionKind);
            bool saved = await JS.InvokeAsync<bool>("treadmillRunnerDrafts.save", calendarDraftKey, System.Text.Json.JsonSerializer.Serialize(draft));
            if (!saved) message = "Browser draft recovery is unavailable because this schedule is too large or local storage is unavailable.";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private Task ContinueCalendarDraftAsync()
    {
        try
        {
            CalendarDraft? draft = System.Text.Json.JsonSerializer.Deserialize<CalendarDraft>(pendingCalendarDraft!);
            if (draft is not null)
            {
                series.Name = draft.Name; series.StartDate = draft.StartDate; series.EndDate = draft.EndDate;
                series.IntervalWeeks = draft.IntervalWeeks; series.PrimaryRevisionId = draft.PrimaryRevisionId;
                series.AlternativeRevisionId = draft.AlternativeRevisionId; series.ExceptionDate = draft.ExceptionDate;
                series.ExceptionKind = draft.ExceptionKind; series.WeekdayFlags.Clear();
                foreach (int flag in draft.WeekdayFlags) series.WeekdayFlags.Add(flag);
                pendingCalendarDraft = null; message = "Browser-local schedule draft restored.";
            }
        }
        catch (System.Text.Json.JsonException) { return DiscardCalendarDraftAsync(); }
        return Task.CompletedTask;
    }

    private async Task DiscardCalendarDraftAsync()
    {
        if (calendarDraftKey is not null) await JS.InvokeVoidAsync("treadmillRunnerDrafts.remove", calendarDraftKey);
        pendingCalendarDraft = null;
    }

    private async Task<bool> SelectDayAsync(CalendarDayView day, CalendarOptionView option)
    {
        if (activeProfileId is null)
        {
            return false;
        }

        if (option.Source == "Program")
        {
            message = $"{option.WorkoutName} is workout {option.ProgramPosition} of {option.ProgramTotal}. Opening Run.";
            Navigation.NavigateTo("/");
            return true;
        }

        if (!pendingSelectionOperations.TryGetValue(day.Date, out Guid operationId))
        {
            operationId = Guid.NewGuid();
            pendingSelectionOperations.Add(day.Date, operationId);
        }

        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/planning/calendar/{activeProfileId}/days/{day.Date:yyyy-MM-dd}/selection",
            new CalendarSelectionRequest(operationId, option.SeriesId, option.WorkoutRevisionId));
        message = response.IsSuccessStatusCode ? $"{option.WorkoutName} selected for {day.Date:d MMM}." : "The day choice could not be saved.";
        if (response.IsSuccessStatusCode)
        {
            pendingSelectionOperations.Remove(day.Date);
            await ReloadCalendarAsync();
        }
        return response.IsSuccessStatusCode;
    }

    private async Task OpenCalendarDetailsAsync(CalendarDayView day, CalendarOptionView option)
    {
        ++calendarSelectionGeneration;
        selectedCalendarDetail = new CalendarDetailSelection(day.Date, day, option);
        selectedCalendarRevision = null;
        calendarDetailsError = null;
        calendarDetailsLoading = true;
        openModalPending = true;
        await InvokeAsync(StateHasChanged);
        await LoadCalendarDetailsAsync();
    }

    private async Task LoadCalendarDetailsAsync()
    {
        if (selectedCalendarDetail is not { } detail) return;
        calendarDetailsCancellation?.Cancel();
        calendarDetailsCancellation?.Dispose();
        calendarDetailsCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = calendarDetailsCancellation.Token;
        int generation = ++calendarDetailsGeneration;
        Guid revisionId = detail.Option.WorkoutRevisionId;
        calendarDetailsLoading = true;
        calendarDetailsError = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync(
                $"api/planning/workouts/revisions/{revisionId:D}", cancellationToken);
            WorkoutRevisionView? revision = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<WorkoutRevisionView>(cancellationToken: cancellationToken)
                : null;
            if (generation != calendarDetailsGeneration || selectedCalendarDetail?.Option.WorkoutRevisionId != revisionId) return;
            selectedCalendarRevision = revision;
            if (revision is null) calendarDetailsError = "This immutable workout revision is no longer available.";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (generation == calendarDetailsGeneration)
                calendarDetailsError = "The workout details could not be loaded from the local gateway.";
        }
        finally
        {
            if (generation == calendarDetailsGeneration) calendarDetailsLoading = false;
        }
    }

    private Task RetryCalendarDetailsAsync() => LoadCalendarDetailsAsync();

    private async Task SelectCalendarDetailAsync()
    {
        if (selectedCalendarDetail is not { } detail) return;
        int selectionGeneration = ++calendarSelectionGeneration;
        calendarSelectionBusy = true;
        try
        {
            if (await SelectDayAsync(detail.Day, detail.Option) &&
                selectionGeneration == calendarSelectionGeneration &&
                IsCurrentCalendarDetail(detail))
            {
                await CloseCalendarDetailsAsync();
            }
        }
        finally { calendarSelectionBusy = false; }
    }

    private async Task CloseCalendarDetailsAsync()
    {
        calendarSelectionGeneration++;
        calendarDetailsCancellation?.Cancel();
        calendarDetailsCancellation?.Dispose();
        calendarDetailsCancellation = null;
        calendarDetailsGeneration++;
        await JS.InvokeVoidAsync("treadmillRunnerView.closeModal");
        modalReference = null;
        selectedCalendarDetail = null;
        selectedCalendarRevision = null;
        calendarDetailsError = null;
        calendarDetailsLoading = false;
    }

    private bool IsCurrentCalendarDetail(CalendarDetailSelection detail) =>
        selectedCalendarDetail is { } current &&
        current.Date == detail.Date &&
        current.Option.SeriesId == detail.Option.SeriesId &&
