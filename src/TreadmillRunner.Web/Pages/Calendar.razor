    private static int CountSelectedWeekdays(int mask) => Enumerable.Range(0, 7).Count(bit => ((mask >> bit) & 1) == 1);
    private static DateOnly NextSelectedDate(DateOnly start, int mask)
    {
        while ((mask & WeekdayFlag(start.DayOfWeek)) == 0) start = start.AddDays(1);
        return start;
    }
    private static int WeekdayFlag(DayOfWeek day) => day == DayOfWeek.Sunday ? 64 : 1 << ((int)day - 1);
    private static int DefaultWeekdayMask(int count) => count switch
    {
        1 => 1,
        2 => 34,
        3 => 37,
        4 => 43,
        5 => 47,
        6 => 63,
        _ => 127,
    };

