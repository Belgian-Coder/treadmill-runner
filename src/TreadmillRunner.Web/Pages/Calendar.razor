    private async Task ConfirmClearUpcomingAsync()
    {
        if (activeProfileId is not { } profileId || clearUpcomingProfileId != profileId || clearUpcomingPreview is not { CanApply: true } preview) return;
        int generation = clearUpcomingGeneration;
        clearUpcomingBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/programs/runs/{preview.RunId:D}/clear-upcoming",
                new WorkoutProgramClearUpcomingRequest(
                    Guid.NewGuid(), profileId, preview.RunVersion, DateOnly.FromDateTime(DateTime.Today)));
            if (generation != clearUpcomingGeneration || activeProfileId != profileId) return;
            if (!response.IsSuccessStatusCode)
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The training plan changed. Reloaded the latest schedule; review it and try again."
                    : "Upcoming plan sessions could not be removed.";
                clearUpcomingPreview = null;
                clearUpcomingProfileId = null;
                await ReloadCalendarAsync();
                return;
            }
            clearUpcomingPreview = null;
            clearUpcomingProfileId = null;
            await ReloadCalendarAsync();
            message = "All upcoming training-plan sessions were removed. Completed workouts and the runner profile were preserved.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (generation == clearUpcomingGeneration)
            {
                clearUpcomingPreview = null;
                clearUpcomingProfileId = null;
                message = "Upcoming plan sessions could not be removed. The calendar was reloaded; review it and try again.";
                await ReloadCalendarAsync();
            }
        }
        finally
        {
            if (generation == clearUpcomingGeneration)
                clearUpcomingBusy = false;
        }
    }

