    private async Task MoveManagedSessionAsync(bool moveFollowing)
    {
        if (managedSession is null || managedSession.IsWholeGroup)
        {
            return;
        }

        if (moveTargetDate == managedSession.SourceDate)
        {
            message = "Choose a different date.";
            return;
        }

        scheduleActionBusy = true;
        try
        {
            var request = new CalendarOccurrenceMoveRequest(
                Guid.NewGuid(),
                moveTargetDate,
                moveFollowing,
                managedSession.ExpectedVersion,
                moveFollowing
                    ? calendarSeries
                        .Where(segment => segment.ScheduleGroupId == managedSession.ScheduleGroupId)
                        .Select(segment => new CalendarSegmentVersion(segment.Id, segment.Version))
                        .ToArray()
                    : null);
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/series/{managedSession.SeriesId}/occurrences/{managedSession.SourceDate:yyyy-MM-dd}/move",
                request);
            if (!response.IsSuccessStatusCode)
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The schedule changed elsewhere. It has been reloaded; open the session again to move it."
                    : "That session could not be moved.";
                await DismissManagerAfterActionAsync();
                await ReloadCalendarAsync();
                return;
            }

            message = moveFollowing
                ? $"Moved this session and all later sessions to begin on {moveTargetDate:d MMM}."
                : $"Moved this session to {moveTargetDate:d MMM}.";
            await DismissManagerAfterActionAsync();
            await ReloadCalendarAsync();
        }
        finally
        {
            scheduleActionBusy = false;
        }
    }

    private async Task DeleteManagedSessionAsync()
    {
        if (managedSession is null || managedSession.IsWholeGroup)
        {
            return;
        }

        scheduleActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/series/{managedSession.SeriesId}/occurrences/{managedSession.SourceDate:yyyy-MM-dd}/delete",
                new CalendarOccurrenceDeleteRequest(Guid.NewGuid(), managedSession.ExpectedVersion));
            message = response.IsSuccessStatusCode
                ? "Session removed from the schedule."
                : response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The schedule changed elsewhere. It has been reloaded; open the session again to delete it."
                    : "That session could not be removed.";
            if (response.IsSuccessStatusCode)
            {
                await DismissManagerAfterActionAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await DismissManagerAfterActionAsync();
            }
            await ReloadCalendarAsync();
        }
        finally
        {
            scheduleActionBusy = false;
        }
    }

    private async Task DeleteManagedGroupAsync()
    {
        if (managedSession is null)
        {
            return;
        }

        scheduleActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/series/{managedSession.SeriesId}/delete-group",
                new CalendarGroupDeleteRequest(
                    Guid.NewGuid(),
                    calendarSeries
                        .Where(segment => segment.ScheduleGroupId == managedSession.ScheduleGroupId)
                        .Select(segment => new CalendarSegmentVersion(segment.Id, segment.Version))
                        .ToArray()));
            message = response.IsSuccessStatusCode
                ? $"{managedSession.ScheduleName} and all of its scheduled sessions were deleted."
                : response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The workout group changed elsewhere. It has been reloaded; open it again to delete it."
                    : "The workout group could not be deleted.";
            if (response.IsSuccessStatusCode)
            {
                await DismissManagerAfterActionAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                await DismissManagerAfterActionAsync();
