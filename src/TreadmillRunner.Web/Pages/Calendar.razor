    public async ValueTask DisposeAsync()
    {
        ActiveProfile.Changed -= ActiveProfileChanged;
        calendarLoadCancellation?.Cancel();
        calendarLoadCancellation?.Dispose();
        clearUpcomingCancellation?.Cancel();
        clearUpcomingCancellation?.Dispose();
        calendarDetailsCancellation?.Cancel();
        calendarDetailsCancellation?.Dispose();
        calendarDraftDebounce?.Cancel();
        calendarDraftDebounce?.Dispose();
        if (managedSession is not null || managedProgramSession is not null || selectedCalendarDetail is not null)
        {
            try { await JS.InvokeVoidAsync("treadmillRunnerView.closeModal"); }
            catch (JSDisconnectedException) { }
        }
        modalReference = null;
    }
