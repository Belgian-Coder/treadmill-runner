    private DateOnly CalendarGridStart
    {
        get
        {
            int daysFromMonday = ((int)visibleMonth.DayOfWeek + 6) % 7;
            return visibleMonth.AddDays(-daysFromMonday);
        }
    }

    private DateOnly CalendarGridEnd
    {
        get
        {
            DateOnly last = CanNavigateNextMonth ? visibleMonth.AddMonths(1).AddDays(-1) : DateOnly.MaxValue;
            int daysToSunday = (7 - (int)last.DayOfWeek) % 7;
            return last.DayNumber > DateOnly.MaxValue.DayNumber - daysToSunday
                ? DateOnly.MaxValue
                : last.AddDays(daysToSunday);
        }
    }

    private IReadOnlyList<DateOnly> CalendarDates
    {
        get
        {
            var dates = new List<DateOnly>();
            DateOnly end = CalendarGridEnd;
            for (DateOnly date = CalendarGridStart; ; date = date.AddDays(1))
            {
                dates.Add(date);
                if (date == end) break;
            }
            return dates;
        }
    }

    private IReadOnlyList<DateOnly[]> CalendarWeeks => CalendarDates.Chunk(7).ToArray();

    private CalendarDayView? DayFor(DateOnly date) => calendar?.Days.FirstOrDefault(day => day.Date == date);
    private CalendarDayView? SelectedMonthDay => DayFor(selectedMonthDate);
    private bool HasVisibleMonthWorkouts => calendar?.Days.Any(day =>
        day.Date.Month == visibleMonth.Month &&
        day.Date.Year == visibleMonth.Year &&
        day.Options.Count > 0) == true;

    private IReadOnlyList<CalendarAgendaWeek> CalendarAgendaWeeks
    {
        get
        {
            var days = new List<CalendarAgendaDay>();
            foreach (DateOnly date in CalendarDates.Where(date => date.Month == visibleMonth.Month && date.Year == visibleMonth.Year))
            {
                if (DayFor(date) is { } day)
                {
                    days.Add(new CalendarAgendaDay(date, day));
                }
            }

            return days
                .GroupBy(static item => item.Date.AddDays(-(((int)item.Date.DayOfWeek + 6) % 7)))
                .Select(group => new CalendarAgendaWeek(
                    group.Key,
                    group.Key.AddDays(6),
                    group.ToArray(),
                    group.Sum(static item => item.Day.Options.Count)))
                .ToArray();
        }
    }

    private bool ShouldOpenAgendaWeek(CalendarAgendaWeek week, int index)
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        bool showingCurrentMonth = today.Month == visibleMonth.Month && today.Year == visibleMonth.Year;
        IReadOnlyList<CalendarAgendaWeek> weeks = CalendarAgendaWeeks;
        int preferredIndex = showingCurrentMonth
            ? FindPreferredCurrentMonthWeek(weeks, today)
            : FindFirstScheduledWeek(weeks);
        return index == preferredIndex;
    }

    private static int FindPreferredCurrentMonthWeek(IReadOnlyList<CalendarAgendaWeek> weeks, DateOnly today)
    {
        int currentWeekIndex = -1;
        for (int index = 0; index < weeks.Count; index++)
        {
            CalendarAgendaWeek candidate = weeks[index];
            if (today >= candidate.Start && today <= candidate.End)
            {
                currentWeekIndex = index;
                if (candidate.WorkoutCount > 0) return index;
                break;
            }
        }

        for (int index = Math.Max(0, currentWeekIndex + 1); index < weeks.Count; index++)
        {
            if (weeks[index].WorkoutCount > 0) return index;
        }

        return currentWeekIndex >= 0 ? currentWeekIndex : FindFirstScheduledWeek(weeks);
    }

    private static int FindFirstScheduledWeek(IReadOnlyList<CalendarAgendaWeek> weeks)
    {
        for (int index = 0; index < weeks.Count; index++)
        {
            if (weeks[index].WorkoutCount > 0) return index;
        }

        return 0;
    }

    private static string FormatAgendaWeek(CalendarAgendaWeek week) => week.Start.Month == week.End.Month
        ? $"{week.Start:d MMM}–{week.End.Day}"
        : $"{week.Start:d MMM}–{week.End:d MMM}";

    private string CalendarCellClass(DateOnly date)
    {
        var classes = new List<string>(3);
        if (date.Month != visibleMonth.Month) classes.Add("calendar-cell--outside");
        if (date == DateOnly.FromDateTime(DateTime.Today)) classes.Add("calendar-cell--today");
        if (date == selectedMonthDate) classes.Add("calendar-cell--selected");
        return string.Join(' ', classes);
    }

    private static string CalendarWeekdayName(string weekday) => weekday switch
    {
        "Mon" => "Monday",
        "Tue" => "Tuesday",
        "Wed" => "Wednesday",
        "Thu" => "Thursday",
        "Fri" => "Friday",
        "Sat" => "Saturday",
        "Sun" => "Sunday",
        _ => weekday,
    };

    private string CalendarDateLabel(DateOnly date, CalendarDayView? day)
    {
        int count = day?.Options.Count ?? 0;
        int completedCount = day?.Options.Count(static option => option.IsCompleted) ?? 0;
        string monthContext = date.Month == visibleMonth.Month && date.Year == visibleMonth.Year
            ? string.Empty
            : ", outside the selected month";
        string schedule = count switch
        {
            0 => "No workouts scheduled",
            1 => "1 workout scheduled",
            _ => $"{count} workouts scheduled",
        };
        string completion = completedCount switch
        {
            0 => string.Empty,
            1 => " 1 completed plan step.",
            _ => $" {completedCount} completed plan steps.",
        };
        return $"{date:dddd d MMMM}{monthContext}. {schedule}.{completion}";
    }

    private void SelectCalendarView(CalendarViewMode view) => calendarView = view;

    private async Task SelectMonthDateAsync(DateOnly date)
    {
        if (date.Month != visibleMonth.Month || date.Year != visibleMonth.Year)
        {
            visibleMonth = new DateOnly(date.Year, date.Month, 1);
            await ReloadCalendarAsync();
        }
        selectedMonthDate = date;
    }

    private async Task ChangeMonthAsync(int months)
    {
        if ((months < 0 && !CanNavigatePreviousMonth) || (months > 0 && !CanNavigateNextMonth)) return;
        visibleMonth = visibleMonth.AddMonths(months);
        await ReloadCalendarAsync();
        selectedMonthDate = PreferredMonthDate();
    }

    private async Task GoToTodayAsync()
    {
        visibleMonth = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
        await ReloadCalendarAsync();
        selectedMonthDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private DateOnly PreferredMonthDate()
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        if (today.Month == visibleMonth.Month && today.Year == visibleMonth.Year) return today;
        if (calendar is null) return visibleMonth;
        return calendar.Days
            .Where(day => day.Date.Month == visibleMonth.Month && day.Date.Year == visibleMonth.Year)
            .OrderBy(static day => day.Date)
            .Select(static day => day.Date)
            .FirstOrDefault(visibleMonth);
    }

