    private static async Task<string> ReadScheduleActionErrorAsync(
        HttpResponseMessage response,
        string fallback)
    {
        try
        {
            string payload = await response.Content.ReadAsStringAsync();
            using System.Text.Json.JsonDocument problem = System.Text.Json.JsonDocument.Parse(payload);
            System.Text.Json.JsonElement root = problem.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object &&
                root.TryGetProperty("errors", out System.Text.Json.JsonElement errors) &&
                errors.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (System.Text.Json.JsonProperty error in errors.EnumerateObject())
                {
                    if (error.Value.ValueKind == System.Text.Json.JsonValueKind.Array &&
                        error.Value.GetArrayLength() > 0 &&
                        error.Value[0].ValueKind == System.Text.Json.JsonValueKind.String &&
                        error.Value[0].GetString() is { Length: > 0 } validationMessage)
                    {
                        return validationMessage;
                    }
                }
            }

            foreach (string propertyName in new[] { "detail", "message", "title" })
            {
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object &&
                    root.TryGetProperty(propertyName, out System.Text.Json.JsonElement value) &&
                    value.ValueKind == System.Text.Json.JsonValueKind.String &&
                    value.GetString() is { Length: > 0 } problemMessage)
                {
                    return problemMessage;
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // The local gateway may return an empty/non-JSON error response.
        }

        return fallback;
    }

