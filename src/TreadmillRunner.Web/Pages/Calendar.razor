        programActionBusy = true;
        try
        {
            DateOnly? target = action is "MoveOne" or "MoveFollowing" or "Repeat" or "RepeatAndShift"
                ? programTargetDate
                : null;
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/program-runs/{managedProgramSession.RunId}/schedule/preview",
                new WorkoutProgramScheduleChangeRequest(
                    null, activeProfileId.Value, managedProgramSession.ProgramItemId, action, target));
            if (!response.IsSuccessStatusCode)
            {
                message = "The schedule preview could not be loaded.";
                return;
            }
            programPreview = await response.Content.ReadFromJsonAsync<WorkoutProgramScheduleChangePreviewView>();
            focusModalStagePending = true;
        }
        finally { programActionBusy = false; }
    }

    private async Task ApplyProgramChangeAsync()
    {
        if (managedProgramSession is null || activeProfileId is null || programPreview is not { CanApply: true }) return;
        programActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/planning/calendar/program-runs/{managedProgramSession.RunId}/schedule/apply",
                new WorkoutProgramScheduleChangeRequest(
                    Guid.NewGuid(), activeProfileId.Value, managedProgramSession.ProgramItemId,
                    programPreview.Action,
                    programPreview.Action is "MoveOne" or "MoveFollowing" or "Repeat" or "RepeatAndShift" ? programTargetDate : null,
                    programPreview.RunVersion));
            if (!response.IsSuccessStatusCode)
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "The plan changed after the preview. The calendar was reloaded; open the session and review it again."
                    : "The plan schedule could not be changed.";
                await DismissProgramManagerAsync();
                await ReloadCalendarAsync();
                return;
            }
            WorkoutProgramScheduleChangePreviewView? saved = await response.Content.ReadFromJsonAsync<WorkoutProgramScheduleChangePreviewView>();
            message = saved?.Message ?? "Plan schedule updated.";
            await DismissProgramManagerAsync();
            await ReloadCalendarAsync();
        }
        finally { programActionBusy = false; }
    }

