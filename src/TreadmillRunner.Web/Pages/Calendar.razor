        DateOnly rangeEnd = CalendarGridEnd;
        Task<List<CalendarSeriesView>?> seriesTask = Http.GetFromJsonAsync<List<CalendarSeriesView>>(
            $"api/planning/calendar/series?profileId={activeProfileId}");
        Task<CalendarRangeView?> rangeTask = Http.GetFromJsonAsync<CalendarRangeView>(
            $"api/planning/calendar/{activeProfileId}?from={rangeStart:yyyy-MM-dd}&to={rangeEnd:yyyy-MM-dd}");
        Task<List<WorkoutProgramView>?> programsTask = Http.GetFromJsonAsync<List<WorkoutProgramView>>(
            $"api/planning/programs?profileId={activeProfileId}");
        await Task.WhenAll(seriesTask, rangeTask, programsTask);
        calendarSeries = await seriesTask ?? [];
        calendar = await rangeTask;
        programs = await programsTask ?? [];
    }

