    private async Task ReloadCalendarAsync()
    {
        if (activeProfileId is not { } profileId)
        {
            calendarSeries = [];
            calendar = null;
            programs = [];
            calendarLoadError = null;
            loading = false;
            return;
        }
        DateOnly rangeStart = CalendarGridStart;
        DateOnly rangeEnd = CalendarGridEnd;
        calendarLoadCancellation?.Cancel();
        calendarLoadCancellation?.Dispose();
        calendarLoadCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = calendarLoadCancellation.Token;
        int generation = ++calendarLoadGeneration;
        loading = true;
        calendarLoadError = null;
        try
        {
            Task<List<CalendarSeriesView>?> seriesTask = Http.GetFromJsonAsync<List<CalendarSeriesView>>(
                $"api/planning/calendar/series?profileId={profileId}", cancellationToken);
            Task<CalendarRangeView?> rangeTask = Http.GetFromJsonAsync<CalendarRangeView>(
                $"api/planning/calendar/{profileId}?from={rangeStart:yyyy-MM-dd}&to={rangeEnd:yyyy-MM-dd}", cancellationToken);
            Task<List<WorkoutProgramSummaryView>?> programsTask = Http.GetFromJsonAsync<List<WorkoutProgramSummaryView>>(
                $"api/planning/programs?profileId={profileId}", cancellationToken);
            await Task.WhenAll(seriesTask, rangeTask, programsTask);
            if (generation != calendarLoadGeneration || activeProfileId != profileId ||
                CalendarGridStart != rangeStart || CalendarGridEnd != rangeEnd) return;
            CalendarRangeView? loadedCalendar = await rangeTask;
            if (loadedCalendar is null) throw new HttpRequestException("The calendar range response was empty.");
            calendarSeries = await seriesTask ?? [];
            calendar = loadedCalendar;
            programs = await programsTask ?? [];
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (generation == calendarLoadGeneration)
                calendarLoadError = "The calendar could not be loaded from the local gateway. Check the connection and retry.";
        }
        finally
        {
            if (generation == calendarLoadGeneration)
            {
                loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

