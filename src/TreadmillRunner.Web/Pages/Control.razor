    private static bool IsHeartRateWithinTarget(ActiveSessionSnapshot? value)
    {
        if (value?.Live.HeartRateBpm is not { } heartRate || value.HeartRateTarget is not { } target) return true;
        return (target.MinimumBpm is null || heartRate >= target.MinimumBpm) &&
            (target.MaximumBpm is null || heartRate <= target.MaximumBpm);
    }

    private static bool HasHeartRateTarget(ActiveSessionSnapshot? value) =>
        value?.Live.HeartRateBpm is not null && value.HeartRateTarget is not null;

