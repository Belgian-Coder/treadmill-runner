@page "/control"

@using System.Globalization
@using System.Text
@using System.Text.Json

@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ClientRuntimeState Runtime

<PageTitle>@DashboardTitle · TreadmillRunner</PageTitle>

<section id="control-dashboard" class="control-page" aria-labelledby="control-title">
    <header class="dashboard-header control-page__header">
        <div><p class="eyebrow">Run</p><h1 id="control-title">@DashboardTitle</h1></div>
        <div class="control-header-actions">
            <span class="connection-state" role="status">@connectionStatus</span>
            <HeartRateStatus Compact="true" />
            <span class="wake-lock-indicator @WakeLockIndicatorClass" role="status" aria-live="polite" aria-label="@WakeLockAccessibleLabel" title="@WakeLockAccessibleLabel">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="4" y="4" width="16" height="12" rx="2" />
                    <path d="M9 20h6M12 16v4" />
                    @if (wakeLockStatus?.Active != true)
                    {
                        <path class="wake-lock-indicator__slash" d="M3 3l18 18" />
                    }
                </svg>
                <span class="visually-hidden">@WakeLockAccessibleLabel</span>
            </span>
            <button class="secondary-action fullscreen-action" type="button" @onclick="ToggleFullscreenAsync" aria-label="Toggle full-screen dashboard" title="Full screen"><span aria-hidden="true">⛶</span></button>
        </div>
    </header>

    @if (HasUnknownOutcome)
    {
        <section class="safety-banner" role="alert" aria-label="Unknown command safety notice">
            <span class="safety-icon" aria-hidden="true">!</span>
            <p><strong>Use physical Stop now.</strong> A command outcome is uncertain; the dashboard will not retry it.</p>
        </section>
    }

    @if (session is null)
    {
        <section class="panel-card control-empty">
            <p class="eyebrow">No active session</p>
            <h2>Prepare a run before using direct controls</h2>
            <p>The dashboard controls the one authoritative session. Choose a runner and workout, enable controls, and prepare it from Run.</p>
            <a class="primary-action" href="/">Open Run</a>
        </section>
    }
    else
    {
        @if (session.Warnings.Any(IsVisibleControlWarning))
        {
            <section class="session-notices" aria-label="Control notices">
                @foreach (string warning in session.Warnings.Where(IsVisibleControlWarning))
                {
                    <p>@warning</p>
                }
            </section>
        }

        @if (session.RecoveryState is not SessionRecoveryState.None)
        {
            <section class="recovery-status recovery-status--@session.ConnectionPhase.ToString().ToLowerInvariant()" role="status" aria-live="polite" aria-busy="@isManualCommandPending">
                <div><strong>@RecoveryHeading</strong><span>@RecoveryDetail</span></div>
                @if (session.CanResumePlannedControls)
                {
                    <p>The belt is already moving. This does not Start or resume the treadmill; it allows automatic speed and incline changes to match the current workout position.</p>
                    <button class="primary-action touch-action" type="button" @onclick="ResumePlannedControlsAsync" disabled="@(!CanResumePlannedControls)">@(isManualCommandPending ? "Resuming…" : "Resume automatic speed & incline")</button>
                }
            </section>
        }

        @if (session.LastCommandResult is { Disposition: TreadmillCommandDisposition.Unknown } unknownResult)
        {
            <section class="command-result command-unknown" role="alert">
                <strong>@unknownResult.Kind: outcome unknown</strong>
                <span>@unknownResult.Reason</span>
                @if (CommandValuesLabel(unknownResult) is { } unknownValues)
                {
                    <span>@unknownValues</span>
                }
            </section>
        }

        <section class="control-console-grid @(!liveStateConnected ? "control-console-grid--stale" : null)" aria-label="Live treadmill controls" aria-busy="@(isManualCommandPending || isStopPending)">
            <aside class="control-rail control-rail--speed" aria-labelledby="speed-control-title">
                <span class="eyebrow">Target speed</span>
                <h2 id="speed-control-title">@session.RequestedSpeedKph.ToString("0.0", CultureInfo.InvariantCulture)<small> km/h</small></h2>
                <div class="rail-stepper" role="group" aria-label="Fine speed controls">
                    <button class="touch-action" type="button" aria-label="Speed -@SpeedIncrement.ToString("0.0", CultureInfo.InvariantCulture) km/h" @onclick="() => SetSpeedTargetAsync(session.RequestedSpeedKph - SpeedIncrement)" disabled="@(!CanAdjustSpeed)">−</button>
                    <button class="touch-action" type="button" aria-label="Speed +@SpeedIncrement.ToString("0.0", CultureInfo.InvariantCulture) km/h" @onclick="() => SetSpeedTargetAsync(session.RequestedSpeedKph + SpeedIncrement)" disabled="@(!CanAdjustSpeed)">+</button>
                </div>
                <div class="rail-presets" role="group" aria-label="Speed presets">
                    @foreach (double target in SpeedTargets)
                    {
                        <button class="touch-action quick-target" type="button" aria-label="Set speed to @target.ToString("0.0", CultureInfo.InvariantCulture) km/h" aria-pressed="@AriaPressed(Approximately(session.RequestedSpeedKph, target))" @onclick="() => SetSpeedTargetAsync(target)" disabled="@(!CanAdjustSpeed)">@target.ToString("0.0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
            </aside>

            <section class="control-center" aria-label="Live control center">
                <section class="control-primary-metrics" aria-label="Live workout metrics">
                    <article aria-label="Measured speed"><span>Measured speed</span><strong>@session.Live.SpeedKph.ToString("0.0", CultureInfo.InvariantCulture)<small> km/h</small></strong></article>
                    <article aria-label="Measured incline"><span>Measured incline</span><strong>@session.Live.InclinePercent.ToString("0.0", CultureInfo.InvariantCulture)<small>%</small></strong></article>
                    <article aria-label="Heart rate"><span>Heart rate</span><strong>@(session.Live.HeartRateBpm?.ToString(CultureInfo.InvariantCulture) ?? "—")<small> bpm</small></strong></article>
                    <article aria-label="Elapsed time"><span>Time</span><strong>@FormatElapsed(session.Live.Elapsed)</strong></article>
                </section>

                <section class="control-live-chart @(isChartFocused ? "control-live-chart--focused" : null)" aria-labelledby="control-chart-title">
                    <div class="control-chart-heading">
                        <div><span class="eyebrow">This run</span><h2 id="control-chart-title">Live progress</h2></div>
                        <div class="control-chart-actions">
                            <span title="@session.WorkoutTitle">@session.WorkoutTitle</span>
                            <button class="secondary-action chart-focus-action" type="button" @onclick="ToggleChartFocus" aria-label="@(isChartFocused ? "Collapse live graph" : "Expand live graph")" title="@(isChartFocused ? "Collapse graph" : "Expand graph")"><span aria-hidden="true">@(isChartFocused ? "↙" : "↗")</span></button>
                        </div>
                    </div>
                    <div class="chart-plot-grid chart-plot-grid--dual">
                        <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@SpeedAxisMaximum, 1fr)">
                            <strong class="chart-axis-unit">km/h</strong>
                            @foreach (int tick in SpeedAxisTicks)
                            {
                                <span>@tick</span>
                            }
                        </div>
                        <svg class="live-chart control-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Live speed in kilometers per hour and incline percentage over elapsed time">
                            @foreach (int tick in SpeedAxisTicks)
                            {
                                double y = ChartY(tick, ChartBand.Speed);
                                <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                            }
                            <line class="chart-axis" x1="10" y1="210" x2="710" y2="210" />
                            <path class="chart-plan" data-series="planned-speed" d="@BuildPlanPath(static point => point.SpeedKph, ChartBand.Speed)" />
                            <path class="chart-requested" data-series="requested-speed" d="@BuildChartPath(static point => point.RequestedSpeedKph, ChartBand.Speed)" />
                            <path class="chart-current" data-series="measured-speed" d="@BuildChartPath(static point => point.MeasuredSpeedKph, ChartBand.Speed)" />
                            <path class="chart-plan chart-plan--incline" data-series="planned-incline" d="@BuildPlanPath(static point => point.InclinePercent, ChartBand.Incline)" />
                            <path class="chart-requested chart-requested--incline" data-series="requested-incline" d="@BuildChartPath(static point => point.RequestedInclinePercent, ChartBand.Incline)" />
                            <path class="chart-current chart-current--incline" data-series="measured-incline" d="@BuildChartPath(static point => point.MeasuredInclinePercent, ChartBand.Incline)" />
                            <line class="chart-cursor" x1="@CurrentChartX" x2="@CurrentChartX" y1="10" y2="210" data-elapsed-seconds="@CurrentChartElapsedSeconds" data-duration-seconds="@ChartDurationSeconds" />
                            @if (LatestMeasuredPoint is { } latest)
                            {
                                <circle class="chart-marker" cx="@ChartX(latest.Elapsed)" cy="@ChartY(latest.MeasuredSpeedKph, ChartBand.Speed)" r="5" />
                            }
                        </svg>
                        <div class="chart-y-scale chart-y-scale--ticks chart-y-scale--secondary" aria-label="Incline axis in percent" style="grid-template-rows: repeat(@InclineAxisMaximum, 1fr)">
                            <strong class="chart-axis-unit">%</strong>
                            @foreach (int tick in InclineAxisTicks)
                            {
                                <span>@tick</span>
                            }
                        </div>
                        <div></div>
                        <div class="chart-time-scale" aria-label="Elapsed time axis" data-midpoint="@FormatAxisTime(TimeSpan.FromTicks(ChartDuration.Ticks / 2))">
                            @foreach (ChartTimeTick tick in ChartTimeTicks)
                            {
                                <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatAxisTime(tick.Elapsed)</span>
                            }
                        </div>
                        <div></div>
                    </div>
                    <div class="control-chart-legend" aria-label="Chart legend">
                        <strong>Speed</strong><span><i class="legend-line legend-line--plan"></i>Plan</span><span><i class="legend-line legend-line--requested"></i>Target</span><span><i class="legend-line legend-line--measured"></i>Measured</span>
                        <strong>Incline</strong><span><i class="legend-line legend-line--plan legend-line--incline-plan"></i>Plan</span><span><i class="legend-line legend-line--requested legend-line--incline-target"></i>Target</span><span><i class="legend-line legend-line--measured legend-line--incline-measured"></i>Measured</span>
                    </div>
                </section>

                @if (lease is null)
                {
                    <button class="primary-action touch-action control-takeover" type="button" @onclick="TakeControlAsync" disabled="@(isTakingControl || !ClientReady)">@(isTakingControl ? "Enabling…" : "Enable controls")</button>
                }

                <section class="control-action-dock" aria-label="Treadmill motion controls">
                    <p class="control-command-status" role="status">@actionStatus</p>
                    @if (session.Live.SessionState == SessionState.ArmedWaitingForPhysicalStart)
                    {
                        <button class="touch-action primary-action hold-start-action" type="button" disabled="@(!CanStart)" @onpointerdown="BeginStartPointerHoldAsync" @onpointerup="CancelStartHold" @onpointerleave="CancelStartHold" @onpointercancel="CancelStartHold" @onkeydown="StartKeyDownAsync" @onkeyup="CancelStartHold" @onblur="CancelStartHold">
                            @(startHoldSecondsRemaining is { } seconds ? $"Keep holding · {seconds}" : $"Hold to start · {session.MinimumStartSpeedKph:0.0} km/h")
                        </button>
                    }
                    else if (session.Live.SessionState == SessionState.PausedWaitingForPhysicalResume)
                    {
                        <button class="touch-action primary-action" type="button" @onclick="ResumeAsync" disabled="@(!CanResume)">Resume</button>
                    }
                    else
                    {
                        <button class="touch-action" type="button" @onclick="PauseAsync" disabled="@(!CanPause)">Pause</button>
                    }
                    <button class="touch-action danger-action stop-action" type="button" @onclick="StopAsync" disabled="@(!CanStop)">Stop</button>
                </section>
                @if (session.HeartRateTarget is not null)
                {
                    <details class="automation-panel control-automation">
                        <summary><span>Heart-rate speed control</span><strong>@AutomationLabel</strong></summary>
                        <div class="automation-modes" role="group" aria-label="Heart-rate speed control">
                            <button class="touch-action" type="button" aria-label="HR shadow" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Shadow)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Shadow)" disabled="@(!CanSetAutomation)">Monitor only</button>
                            <button class="touch-action" type="button" aria-label="HR decreases" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.DecreaseOnly)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.DecreaseOnly)" disabled="@(!CanSetSpeedAutomation)">Slow down only</button>
                            <button class="touch-action" type="button" aria-label="HR two-way" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Full)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Full)" disabled="@(!CanSetSpeedAutomation)">Full control</button>
                            <button class="touch-action" type="button" aria-label="HR off" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Disabled)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Disabled)" disabled="@(!CanSetAutomation)">Off</button>
                        </div>
                        <p>HR automation: @session.HeartRateAutomationMode · @session.HeartRateAutomationReason</p>
                    </details>
                }
                <p class="control-disabled-reason">@ControlAvailabilityMessage</p>
            </section>

            <aside class="control-rail control-rail--incline" aria-labelledby="incline-control-title">
                <span class="eyebrow">Target incline</span>
                <h2 id="incline-control-title">@session.RequestedInclinePercent.ToString("0.0", CultureInfo.InvariantCulture)<small>%</small></h2>
                <div class="rail-stepper" role="group" aria-label="Fine incline controls">
                    <button class="touch-action" type="button" aria-label="Incline -@InclineIncrement.ToString("0.0", CultureInfo.InvariantCulture)%" @onclick="() => SetInclineTargetAsync(session.RequestedInclinePercent - InclineIncrement)" disabled="@(!CanAdjustIncline)">−</button>
                    <button class="touch-action" type="button" aria-label="Incline +@InclineIncrement.ToString("0.0", CultureInfo.InvariantCulture)%" @onclick="() => SetInclineTargetAsync(session.RequestedInclinePercent + InclineIncrement)" disabled="@(!CanAdjustIncline)">+</button>
                </div>
                <div class="rail-presets" role="group" aria-label="Incline presets">
                    @foreach (double target in InclineTargets)
                    {
                        <button class="touch-action quick-target" type="button" aria-label="Set incline to @target.ToString("0.0", CultureInfo.InvariantCulture)%" aria-pressed="@AriaPressed(Approximately(session.RequestedInclinePercent, target))" @onclick="() => SetInclineTargetAsync(target)" disabled="@(!CanAdjustIncline)">@target.ToString("0.0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
            </aside>
        </section>

        <details class="control-details" aria-label="Technical session details">
            <summary>Connection and command details</summary>
            <p class="control-safety-copy"><strong>Physical Stop and the safety key remain authoritative.</strong> Bluetooth disconnect is never a stop mechanism.</p>
            <section class="control-status-strip" aria-label="Current treadmill status">
                <div><span>Session</span><strong>@SessionStateLabel</strong></div>
                <div><span>Treadmill</span><strong>@session.Live.TreadmillConnectionState</strong></div>
                <div><span>Telemetry</span><strong>@session.Live.TelemetryAge.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s old</strong></div>
                <div><span>Controller</span><strong>@controlStatus</strong></div>
            </section>
            @if (session.LastCommandResult is { Disposition: not TreadmillCommandDisposition.Unknown } commandResult)
            {
                <section class="command-result command-@commandResult.Disposition.ToString().ToLowerInvariant()" role="status">
                    <strong>@commandResult.Kind: @commandResult.Disposition</strong><span>@commandResult.Reason</span>
                    @if (CommandValuesLabel(commandResult) is { } values) { <span>@values</span> }
                    <span>Completed in @((commandResult.CompletedAt - commandResult.IssuedAt).TotalSeconds.ToString("0.00", CultureInfo.InvariantCulture)) s · generation @commandResult.ConnectionGeneration</span>
                </section>
            }
        </details>
    }
</section>

@code {
    private const string HolderStorageKey = "treadmillrunner.controller-holder";
    private static readonly double[] PopularSpeeds = [5.0, 7.0, 7.5, 8.0, 8.5, 9.0, 9.5, 10.0];
    private static readonly double[] PopularInclines = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0];
    private BoundedLiveSeries<ControlChartPoint> chartPoints = new(43_200);
    private HubConnection? hubConnection;
    private CancellationTokenSource? heartbeatCancellation;
    private CancellationTokenSource? connectionCancellation;
    private CancellationTokenSource? startHoldCancellation;
    private Task? heartbeatTask;
    private Task? connectionTask;
    private bool isForcingHubRestart;
    private DotNetObjectReference<Control>? wakeLockReference;
    private ActiveSessionSnapshot? session;
    private ControlLease? lease;
    private string holderId = string.Empty;
    private string connectionStatus = "Connecting";
    private bool liveStateConnected;
    private bool wantsControl = true;
    private string controlStatus = "Observer";
    private string actionStatus = "Waiting for an active session.";
    private bool isTakingControl;
    private bool isManualCommandPending;
    private bool isStopPending;
    private bool isChartFocused;
    private bool stopRequestedDuringCommand;
    private bool hasRendered;
    private WakeLockStatusView? wakeLockStatus;
    private int? startHoldSecondsRemaining;
    private double speedChartMaximum = 10;
    private double inclineChartMaximum = 10;
    private long renderedChartVersion = -1;
    private IReadOnlyList<ControlChartPoint> renderedChartPoints = [];

    private bool HasUnknownOutcome => session?.LastCommandResult?.Disposition == TreadmillCommandDisposition.Unknown;
    private bool HasController => lease is not null;
    private bool ClientReady => Runtime.IsConnected && !Runtime.UpdateRequired && liveStateConnected;
    private bool CanStart => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session is
    {
        CanStartRemotely: true,
        Live.SessionState: SessionState.ArmedWaitingForPhysicalStart,
    };
    private bool CanResume => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session is
    {
        CanStartRemotely: true,
        Live.SessionState: SessionState.PausedWaitingForPhysicalResume,
    };
    private bool CanPause => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session is
    {
        CanPauseRemotely: true,
        Live.SessionState: SessionState.Running,
    };
    private bool CanStop => ClientReady && !isStopPending && HasController && session is not null &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanStopRemotely) && session.Live.SessionState is
        SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume;
    private bool CanAdjustSpeed => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetSpeedRemotely);
    private bool CanAdjustIncline => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetInclineRemotely);
    private bool CanSetAutomation => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController &&
        session?.Live.SessionState == SessionState.Running;
    private bool CanSetSpeedAutomation => CanSetAutomation && session is not null &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetSpeedRemotely);
    private string DashboardTitle => session?.Live.SessionState switch
    {
        SessionState.ArmedWaitingForPhysicalStart => "Ready at the treadmill",
        SessionState.PausedWaitingForPhysicalResume => "Run paused",
        SessionState.Running => "Live run",
        _ => "Run",
    };
    private string AutomationLabel => session?.HeartRateAutomationMode switch
    {
        HeartRateAutomationMode.Disabled => "Off",
        HeartRateAutomationMode.Shadow => "Monitor only",
        HeartRateAutomationMode.DecreaseOnly => "Slow down only",
        HeartRateAutomationMode.Full => "Full control",
        HeartRateAutomationMode.SuspendedManualOverride => "Paused after manual change",
        HeartRateAutomationMode.SuspendedSafety => "Paused for safety",
        _ => "Unavailable",
    };
    private double SpeedIncrement => (double)(session?.SpeedRange?.Increment ?? 0.1m);
    private double InclineIncrement => (double)(session?.InclineRange?.Increment ?? 0.5m);
    private IEnumerable<double> SpeedTargets => PopularSpeeds.Where(target => IsWithinRange(target, session?.SpeedRange));
    private IEnumerable<double> InclineTargets => PopularInclines.Where(target => IsWithinRange(target, session?.InclineRange));
    private string SessionStateLabel => session?.Live.SessionState switch
    {
        SessionState.ArmedWaitingForPhysicalStart => "Ready",
        SessionState.PausedWaitingForPhysicalResume => "Paused",
        SessionState.Running => "Running",
        SessionState.Stopped => "Stopped",
        SessionState.Completed => "Complete",
        _ => session?.Live.SessionState.ToString() ?? "None",
    };
    private string ControlAvailabilityMessage => HasUnknownOutcome
        ? "Adjustments are locked after an unknown outcome. Use physical Stop; the dashboard will not retry."
        : lease is null
            ? "Take control to enable commands. Live measurements remain visible to observers."
            : session?.Live.SessionState != SessionState.Running
                ? "Speed and incline changes are available while the session is running."
                : "Targets are bounded by the active profile and verified treadmill ranges.";
    private string WakeLockIndicatorClass => wakeLockStatus?.Active == true
      ? "wake-lock-indicator--active"
      : wakeLockStatus?.State == "PausedInBackground"
        ? "wake-lock-indicator--paused"
        : "wake-lock-indicator--unavailable";
    private string WakeLockAccessibleLabel => wakeLockStatus is null
      ? "Checking screen stay-awake"
      : wakeLockStatus.Active
        ? "Screen stay-awake active"
        : $"Screen stay-awake unavailable. {wakeLockStatus.Reason}";

    protected override async Task OnInitializedAsync()
    {
        holderId = await JS.InvokeAsync<string?>("localStorage.getItem", HolderStorageKey) ?? string.Empty;
        if (string.IsNullOrWhiteSpace(holderId))
        {
            holderId = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("localStorage.setItem", HolderStorageKey, holderId);
        }

        wantsControl = true;
        connectionStatus = "Connecting to live updates";
        try
        {
            await RefreshSessionAsync();
            if (session is null || IsTerminal(session.Live.SessionState))
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            await HydrateChartAsync(session.SessionId);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            lease = null;
            connectionStatus = "Gateway unavailable · retrying";
            liveStateConnected = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        hasRendered = true;
        wakeLockReference = DotNetObjectReference.Create(this);
        await UpdateWakeLockAsync();
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/live"))
            .WithAutomaticReconnect(new IndefiniteHubRetryPolicy())
            .Build();
        hubConnection.On<ActiveSessionSnapshot>("sessionSnapshot", async snapshot =>
        {
            session = snapshot;
            AppendChartPoint(snapshot);
            await UpdateWakeLockAsync();
            if (IsTerminal(snapshot.Live.SessionState))
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }
            await InvokeAsync(StateHasChanged);
        });
        hubConnection.Reconnecting += _ => SetConnectionAsync("Reconnecting", false);
        hubConnection.Reconnected += _ => RecoverAfterGatewayReconnectAsync();
        hubConnection.Closed += _ => RestartHubAfterCloseAsync();
        connectionCancellation = new CancellationTokenSource();
        connectionTask = StartHubUntilConnectedAsync(connectionCancellation.Token);
        _ = connectionTask;
    }

    private Task TakeControlAsync() => TakeControlAsync(restoring: false);

    private async Task TakeControlAsync(bool restoring)
    {
        if (isTakingControl) return;
        isTakingControl = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/lease/acquire", new { holderId });
            if (response.IsSuccessStatusCode)
            {
                lease = await response.Content.ReadFromJsonAsync<ControlLease>();
                controlStatus = restoring ? "Controller restored" : "Controller";
                actionStatus = restoring ? "Controller access restored." : "Direct controls are ready.";
                StartHeartbeat();
                wantsControl = true;
            }
            else
            {
                lease = null;
                controlStatus = "Observer";
                actionStatus = "Another browser currently controls manual actions.";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            lease = null;
            actionStatus = "Manual controls are unavailable because the gateway connection was interrupted.";
            await SetConnectionAsync("Gateway unavailable · retrying", false);
        }
        finally
        {
            isTakingControl = false;
        }
    }

    private async Task StartHubUntilConnectedAsync(CancellationToken cancellationToken)
    {
        int attempt = 0;
        while (!cancellationToken.IsCancellationRequested && hubConnection is { State: HubConnectionState.Disconnected })
        {
            try
            {
                await hubConnection.StartAsync(cancellationToken);
                await RecoverAfterGatewayReconnectAsync();
                return;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { return; }
            catch (Exception exception) when (exception is not OperationCanceledException)
            {
                await SetConnectionAsync("Gateway unavailable · retrying", false);
                TimeSpan delay = TimeSpan.FromSeconds(Math.Min(10, Math.Max(1, 1 << Math.Min(attempt++, 3))));
                await Task.Delay(delay, cancellationToken);
            }
        }
    }

    private async Task RecoverAfterGatewayReconnectAsync()
    {
        if (hubConnection?.State != HubConnectionState.Connected)
        {
            await SetConnectionAsync("Gateway unavailable · retrying", false);
            return;
        }
        await Runtime.CheckAsync(Http);
        heartbeatCancellation?.Cancel();
        lease = null;
        isManualCommandPending = false;
        isStopPending = false;
        await RefreshSessionAsync();
        if (session is null || IsTerminal(session.Live.SessionState))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        if (hubConnection.State != HubConnectionState.Connected)
        {
            await SetConnectionAsync("Gateway unavailable · retrying", false);
            return;
        }
        if (wantsControl && !Runtime.UpdateRequired) await TakeControlAsync(restoring: true);
        await SetConnectionAsync("Gateway ready", true);
    }

    private async Task RestartHubAfterCloseAsync()
    {
        await SetConnectionAsync("Gateway unavailable · retrying", false);
        if (isForcingHubRestart) return;
        if (connectionCancellation?.IsCancellationRequested != false) return;
        if (connectionTask is { IsCompleted: false }) return;
        connectionTask = StartHubUntilConnectedAsync(connectionCancellation.Token);
        _ = connectionTask;
    }

    private string RecoveryHeading => session?.RecoveryState switch
    {
        SessionRecoveryState.TelemetryGap => "Treadmill reconnecting",
        SessionRecoveryState.Reconciling => "Checking treadmill state",
        SessionRecoveryState.Recovered => "Treadmill reconnected",
        SessionRecoveryState.RestartTracking => "Restoring previous session tracking",
        _ => "Planned controls paused",
    };

    private string RecoveryDetail => session?.RecoveryState == SessionRecoveryState.Recovered
        ? $"Fresh treadmill state was confirmed{(session.LastReconciledAtUtc is { } reconciled ? $" at {reconciled.ToLocalTime():HH:mm:ss}" : string.Empty)}."
        : session?.CommandsSuspendedReason ?? "The gateway is checking fresh treadmill state.";

    private static bool IsTerminal(SessionState state) => state is
        SessionState.Stopped or SessionState.Completed or SessionState.Interrupted or SessionState.Faulted;

    private bool CanResumePlannedControls => ClientReady && liveStateConnected && lease is not null &&
        session?.CanResumePlannedControls == true && !isManualCommandPending && !isStopPending;

    private async Task ResumePlannedControlsAsync()
    {
        if (!CanResumePlannedControls || session is null || lease is null) return;
        isManualCommandPending = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/resume-planned-controls", new
            {
                operationId = Guid.NewGuid(),
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
                connectionGeneration = session.Live.TreadmillConnectionGeneration,
            });
            if (response.IsSuccessStatusCode)
            {
                session = await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
                actionStatus = "Planned controls resumed from fresh treadmill state.";
            }
            else
            {
                string detail = "The gateway did not confirm that recovery is safe.";
                try
                {
                    using JsonDocument problem = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
                    if (problem.RootElement.TryGetProperty("error", out JsonElement error) && error.GetString() is { Length: > 0 } message)
                        detail = message;
                }
                catch (JsonException) { }
                await RefreshSessionAsync();
                actionStatus = $"Planned controls remain paused. {detail}";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            lease = null;
            actionStatus = "Planned controls remain paused because the gateway connection was interrupted.";
            await SetConnectionAsync("Gateway unavailable · retrying", false);
        }
        finally
        {
            isManualCommandPending = false;
        }
    }

    private async Task SetSpeedTargetAsync(double target)
    {
        if (!CanAdjustSpeed || session is null || lease is null) return;
        target = NormalizeTarget(target, session.SpeedRange);
        double adjustment = target - session.RequestedSpeedKph;
        if (Math.Abs(adjustment) < 0.0001) return;
        isManualCommandPending = true;
        actionStatus = $"Setting speed to {target:0.0} km/h…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/speed-override", new
            {
                operationId = Guid.NewGuid(),
                adjustmentKph = adjustment,
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
            });
            await ApplyManualControlResponseAsync(response, "speed");
        }
        finally
        {
            await CompleteManualCommandAsync();
        }
    }

    private async Task SetInclineTargetAsync(double target)
    {
        if (!CanAdjustIncline || session is null || lease is null) return;
        target = NormalizeTarget(target, session.InclineRange);
        if (Approximately(target, session.RequestedInclinePercent)) return;
        isManualCommandPending = true;
        actionStatus = $"Setting incline to {target:0.0}%…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/incline-override", new
            {
                operationId = Guid.NewGuid(),
                targetPercent = target,
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
            });
            await ApplyManualControlResponseAsync(response, "incline");
        }
        finally
        {
            await CompleteManualCommandAsync();
        }
    }

    private async Task ApplyManualControlResponseAsync(HttpResponseMessage response, string control)
    {
        if (!response.IsSuccessStatusCode)
        {
            actionStatus = $"The {control} request was rejected before confirmation. Refreshing live state.";
            await RefreshSessionAsync();
            return;
        }

        using JsonDocument payload = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
        session = payload.RootElement.GetProperty("snapshot").Deserialize<ActiveSessionSnapshot>(
            new JsonSerializerOptions(JsonSerializerDefaults.Web));
        if (session is not null) AppendChartPoint(session);
        actionStatus = session?.LastCommandResult?.Reason ?? $"The {control} target was updated.";
    }

    private async Task SetAutomationAsync(HeartRateAutomationMode mode)
    {
        if (!CanSetAutomation || session is null || lease is null) return;
        isManualCommandPending = true;
        actionStatus = "Updating heart-rate control…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/heart-rate-automation", new
            {
                operationId = Guid.NewGuid(),
                mode,
