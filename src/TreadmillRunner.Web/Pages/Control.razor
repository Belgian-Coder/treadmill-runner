    private string RecoveryDetail => session?.RecoveryState == SessionRecoveryState.Recovered
        ? $"Fresh treadmill state was confirmed{(session.LastReconciledAtUtc is { } reconciled ? $" at {reconciled.ToLocalTime():HH:mm:ss}" : string.Empty)}."
        : session?.CommandsSuspendedReason ?? "The gateway is checking fresh treadmill state.";

    private static bool IsTerminal(SessionState state) => state is
        SessionState.Stopped or SessionState.Completed or SessionState.Interrupted or SessionState.Faulted;

    private bool CanResumePlannedControls => ClientReady && liveStateConnected && lease is not null &&
        session?.CanResumePlannedControls == true && !isManualCommandPending && !isStopPending;

    private async Task ResumePlannedControlsAsync()
    {
        if (!CanResumePlannedControls || session is null || lease is null) return;
        isManualCommandPending = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/resume-planned-controls", new
            {
                operationId = Guid.NewGuid(),
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
                connectionGeneration = session.Live.TreadmillConnectionGeneration,
            });
            if (response.IsSuccessStatusCode)
            {
                session = await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
                actionStatus = "Planned controls resumed from fresh treadmill state.";
            }
            else
            {
                string detail = "The gateway did not confirm that recovery is safe.";
                try
                {
                    using JsonDocument problem = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
                    if (problem.RootElement.TryGetProperty("error", out JsonElement error) && error.GetString() is { Length: > 0 } message)
                        detail = message;
                }
                catch (JsonException) { }
                await RefreshSessionAsync();
                actionStatus = $"Planned controls remain paused. {detail}";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            actionStatus = "Planned controls remain paused because the gateway connection was interrupted.";
            await Gateway.RefreshAuthoritativeStateAsync();
        }
        finally
        {
            isManualCommandPending = false;
        }
    }

    private async Task SetSpeedTargetAsync(double target)
    {
        if (!CanAdjustSpeed || session is null || lease is null) return;
        target = NormalizeTarget(target, session.SpeedRange);
        double adjustment = target - session.RequestedSpeedKph;
        if (Math.Abs(adjustment) < 0.0001) return;
        isManualCommandPending = true;
        actionStatus = $"Setting speed to {target:0.0} km/h…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/speed-override", new
            {
                operationId = Guid.NewGuid(),
                adjustmentKph = adjustment,
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
            });
            await ApplyManualControlResponseAsync(response, "speed");
        }
        finally
        {
            await CompleteManualCommandAsync();
        }
    }

    private async Task SetInclineTargetAsync(double target)
    {
        if (!CanAdjustIncline || session is null || lease is null) return;
        target = NormalizeTarget(target, session.InclineRange);
        if (Approximately(target, session.RequestedInclinePercent)) return;
        isManualCommandPending = true;
        actionStatus = $"Setting incline to {target:0.0}%…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/live/sessions/incline-override", new
            {
                operationId = Guid.NewGuid(),
                targetPercent = target,
                holderId,
                leaseId = lease.Id,
                expectedSessionVersion = session.Version,
            });
            await ApplyManualControlResponseAsync(response, "incline");
        }
        finally
        {
            await CompleteManualCommandAsync();
        }
    }

    private async Task ApplyManualControlResponseAsync(HttpResponseMessage response, string control)
    {
        if (!response.IsSuccessStatusCode)
        {
            actionStatus = $"The {control} request was rejected before confirmation. Refreshing live state.";
            await RefreshSessionAsync();
            return;
        }

        using JsonDocument payload = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
        session = payload.RootElement.GetProperty("snapshot").Deserialize<ActiveSessionSnapshot>(
            new JsonSerializerOptions(JsonSerializerDefaults.Web));
        if (session is not null) AppendChartPoint(session);
        actionStatus = session?.LastCommandResult?.Reason ?? $"The {control} target was updated.";
    }

