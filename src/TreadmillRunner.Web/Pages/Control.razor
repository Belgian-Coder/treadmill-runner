    private void AppendChartPoint(ActiveSessionSnapshot snapshot)
    {
        var point = new ControlChartPoint(
            snapshot.Live.Elapsed,
            snapshot.PlannedSpeedKph,
            snapshot.RequestedSpeedKph,
            snapshot.Live.SpeedKph,
            snapshot.PlannedInclinePercent,
            snapshot.RequestedInclinePercent,
            snapshot.Live.InclinePercent);
        UpdateChartMaximums(snapshot, point);
        chartPoints.AppendOrReplace(
            point,
            static (previous, current) => (long)previous.Elapsed.TotalSeconds == (long)current.Elapsed.TotalSeconds);
    }

    private async Task HydrateChartAsync(Guid sessionId)
    {
        chartPoints = new BoundedLiveSeries<ControlChartPoint>(43_200);
        renderedChartVersion = -1;
        renderedChartPoints = [];
        speedChartMaximum = 10;
        inclineChartMaximum = 10;
        StoredWorkoutSessionView? stored = await Http.GetFromJsonAsync<StoredWorkoutSessionView>($"api/history/{sessionId}");
        if (stored is not null)
        {
            foreach (SessionSample sample in stored.Samples)
            {
                var point = new ControlChartPoint(
                    sample.Elapsed,
                    sample.PlannedSpeedKph,
                    sample.RequestedSpeedKph,
                    sample.MeasuredSpeedKph,
                    sample.PlannedInclinePercent,
                    sample.RequestedInclinePercent,
                    sample.MeasuredInclinePercent);
                UpdateChartMaximums(session, point);
                chartPoints.AppendOrReplace(
                    point,
                    static (previous, current) => (long)previous.Elapsed.TotalSeconds == (long)current.Elapsed.TotalSeconds);
            }
        }
        if (session is not null) AppendChartPoint(session);
    }

    private string BuildChartPath(Func<ControlChartPoint, double?> selector, ChartBand band)
    {
        IReadOnlyList<ControlChartPoint> points = RenderChartPoints();
        if (points.Count == 0) return string.Empty;
        var path = new StringBuilder();
        bool started = false;
        foreach (ControlChartPoint point in points)
        {
            if (selector(point) is not { } value)
            {
                started = false;
                continue;
            }
            double y = ChartY(value, band);
            path.Append(started ? " L" : "M");
            path.Append(ChartX(point.Elapsed).ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
            started = true;
        }
        return path.ToString();
    }

    private IReadOnlyList<ControlChartPoint> RenderChartPoints()
    {
        if (renderedChartVersion == chartPoints.Version) return renderedChartPoints;

        IReadOnlyList<ControlChartPoint> points = chartPoints.Snapshot();
        const int maximumRenderedPoints = 720;
        if (points.Count <= maximumRenderedPoints)
        {
            renderedChartVersion = chartPoints.Version;
            renderedChartPoints = points;
            return renderedChartPoints;
        }
        const int bucketCount = maximumRenderedPoints / 14;
        int bucketSize = (int)Math.Ceiling(points.Count / (double)bucketCount);
        var selected = new List<ControlChartPoint>(maximumRenderedPoints);
        for (int start = 0; start < points.Count; start += bucketSize)
        {
            ControlChartPoint[] bucket = points.Skip(start).Take(Math.Min(bucketSize, points.Count - start)).ToArray();
            var extrema = new List<ControlChartPoint>
            {
                bucket[0], bucket[^1],
                bucket.MinBy(static point => point.MeasuredSpeedKph)!, bucket.MaxBy(static point => point.MeasuredSpeedKph)!,
                bucket.MinBy(static point => point.MeasuredInclinePercent)!, bucket.MaxBy(static point => point.MeasuredInclinePercent)!,
                bucket.MinBy(static point => point.RequestedSpeedKph)!, bucket.MaxBy(static point => point.RequestedSpeedKph)!,
                bucket.MinBy(static point => point.RequestedInclinePercent)!, bucket.MaxBy(static point => point.RequestedInclinePercent)!,
            };
            ControlChartPoint[] plannedSpeed = bucket.Where(static point => point.PlannedSpeedKph is not null).ToArray();
            if (plannedSpeed.Length > 0)
            {
                extrema.Add(plannedSpeed.MinBy(static point => point.PlannedSpeedKph)!);
                extrema.Add(plannedSpeed.MaxBy(static point => point.PlannedSpeedKph)!);
            }
            ControlChartPoint[] plannedIncline = bucket.Where(static point => point.PlannedInclinePercent is not null).ToArray();
            if (plannedIncline.Length > 0)
            {
                extrema.Add(plannedIncline.MinBy(static point => point.PlannedInclinePercent)!);
                extrema.Add(plannedIncline.MaxBy(static point => point.PlannedInclinePercent)!);
            }
            foreach (int transition in Enumerable.Range(1, bucket.Length - 1).Where(index =>
                bucket[index - 1].PlannedSpeedKph.HasValue != bucket[index].PlannedSpeedKph.HasValue ||
                bucket[index - 1].PlannedInclinePercent.HasValue != bucket[index].PlannedInclinePercent.HasValue))
            {
                extrema.Add(bucket[transition - 1]);
                extrema.Add(bucket[transition]);
            }
            selected.AddRange(extrema.Distinct().OrderBy(static point => point.Elapsed));
        }
        renderedChartVersion = chartPoints.Version;
        renderedChartPoints = selected;
        return renderedChartPoints;
    }

    private string BuildPlanPath(Func<WorkoutPlanPoint, double?> selector, ChartBand band)
    {
        IReadOnlyList<WorkoutPlanPoint> points = session?.WorkoutPlan ?? [];
        if (points.Count == 0) return string.Empty;
        var path = new StringBuilder();
        bool started = false;
        foreach (WorkoutPlanPoint point in points)
        {
            if (selector(point) is not { } value) { started = false; continue; }
            double y = ChartY(value, band);
            path.Append(started ? " L" : "M");
            path.Append(ChartX(point.Elapsed).ToString("0.##", CultureInfo.InvariantCulture));
            path.Append(' ');
            path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
            started = true;
        }
        return path.ToString();
    }

    private void UpdateChartMaximums(ActiveSessionSnapshot? snapshot, ControlChartPoint point)
    {
        IReadOnlyList<WorkoutPlanPoint> plan = snapshot?.WorkoutPlan ?? [];
        double planSpeed = plan.Count == 0 ? 0 : plan.Max(static item => item.SpeedKph ?? 0);
        double planIncline = plan.Count == 0 ? 0 : plan.Max(static item => item.InclinePercent ?? 0);
        speedChartMaximum = Math.Ceiling(Math.Max(speedChartMaximum, Math.Max(planSpeed, Math.Max(point.MeasuredSpeedKph, point.RequestedSpeedKph))));
        inclineChartMaximum = Math.Ceiling(Math.Max(inclineChartMaximum, Math.Max(planIncline, Math.Max(point.MeasuredInclinePercent, point.RequestedInclinePercent))));
    }

    private double ChartMaximum(ChartBand band) => band == ChartBand.Speed ? speedChartMaximum : inclineChartMaximum;

    private int SpeedAxisMaximum => (int)ChartMaximum(ChartBand.Speed);
    private int InclineAxisMaximum => (int)ChartMaximum(ChartBand.Incline);

    private double ChartY(double value, ChartBand band) =>
        210 - (Math.Clamp(value / ChartMaximum(band), 0, 1) * 200);

    private double ChartX(TimeSpan elapsed)
        => LiveChartTimeline.PositionX(elapsed, ChartDuration);

    private TimeSpan ChartDuration => LiveChartTimeline.ResolveDuration(
        session,
        chartPoints.Snapshot().LastOrDefault()?.Elapsed ?? TimeSpan.Zero);

    private double CurrentChartX => ChartX(session?.Live.Elapsed ?? TimeSpan.Zero);
    private string CurrentChartElapsedSeconds => (session?.Live.Elapsed.TotalSeconds ?? 0).ToString("0.###", CultureInfo.InvariantCulture);
    private string ChartDurationSeconds => ChartDuration.TotalSeconds.ToString("0.###", CultureInfo.InvariantCulture);
    private ControlChartPoint? LatestMeasuredPoint => chartPoints.Snapshot().LastOrDefault();
    private IReadOnlyList<ChartInspectionPoint> ChartInspectionPoints
    {
        get
        {
            var points = new SortedDictionary<long, (TimeSpan Elapsed, double?[] Values)>();
            foreach (ControlChartPoint point in RenderChartPoints())
            {
                points[point.Elapsed.Ticks] = (point.Elapsed,
                [
                    point.PlannedSpeedKph,
                    point.RequestedSpeedKph,
                    point.MeasuredSpeedKph,
                    point.PlannedInclinePercent,
                    point.RequestedInclinePercent,
                    point.MeasuredInclinePercent,
                ]);
            }

            foreach (WorkoutPlanPoint point in session?.WorkoutPlan ?? [])
            {
                if (!points.TryGetValue(point.Elapsed.Ticks, out var inspection))
                {
                    inspection = (point.Elapsed, new double?[6]);
                    points[point.Elapsed.Ticks] = inspection;
                }
                inspection.Values[0] = point.SpeedKph;
                inspection.Values[3] = point.InclinePercent;
            }

            return points.Values
                .Select(item => new ChartInspectionPoint(item.Elapsed, ChartX(item.Elapsed), item.Values))
                .ToArray();
        }
    }

    private static string FormatElapsed(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
        : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);

    private static bool IsWithinRange(double target, TreadmillOperatingRange? range) => range is null ||
        ((decimal)target >= range.Minimum && (decimal)target <= range.Maximum);

    private static double NormalizeTarget(double target, TreadmillOperatingRange? range)
    {
        if (range is null) return Math.Max(0, target);
        decimal clamped = range.Clamp((decimal)target);
        decimal steps = decimal.Floor((clamped - range.Minimum) / range.Increment);
        return (double)(range.Minimum + (steps * range.Increment));
    }

    private static bool Approximately(double left, double right) => Math.Abs(left - right) < 0.001;
    private static bool IsVisibleControlWarning(string warning) =>
        !string.Equals(warning, "Physical movement detected", StringComparison.OrdinalIgnoreCase);
    private static string AriaPressed(bool value) => value ? "true" : "false";

    private static string? CommandValuesLabel(TreadmillCommandResult result)
    {
        string? unit = result.Kind switch
        {
            TreadmillCommandKind.Start or TreadmillCommandKind.SetSpeed => "km/h",
            TreadmillCommandKind.SetIncline => "%",
            _ => null,
        };
        if (unit is null) return null;
        var values = new List<string>(3);
        if (result.RequestedValue is { } requested) values.Add($"Requested {requested.ToString("0.0", CultureInfo.InvariantCulture)} {unit}");
        if (result.AcceptedValue is { } accepted) values.Add($"accepted {accepted.ToString("0.0", CultureInfo.InvariantCulture)} {unit}");
        if (result.MeasuredValue is { } measured) values.Add($"measured {measured.ToString("0.0", CultureInfo.InvariantCulture)} {unit}");
        return values.Count == 0 ? null : string.Join(" · ", values);
    }

    public async ValueTask DisposeAsync()
    {
        if (hasRendered)
        {
            try { await JS.InvokeVoidAsync("treadmillRunnerView.disposeRunWakeLock"); }
            catch (JSDisconnectedException) { }
            try { await JS.InvokeVoidAsync("treadmillRunnerView.disposeFullscreenTracking"); }
            catch (JSDisconnectedException) { }
        }
        wakeLockReference?.Dispose();
        wakeLockReference = null;
        Gateway.ConnectionChanged -= GatewayConnectionChanged;
        Gateway.SessionChanged -= GatewaySessionChanged;
        Gateway.LeaseChanged -= GatewayLeaseChanged;
        if (hasRendered)
        {
            try { await JS.InvokeAsync<string>("treadmillRunnerView.clearImmersiveView", "control-dashboard"); }
            catch (JSDisconnectedException) { }
        }
    }

    private enum ChartBand { Speed, Incline }
    private sealed record ControlChartPoint(
        TimeSpan Elapsed,
        double? PlannedSpeedKph,
        double RequestedSpeedKph,
        double MeasuredSpeedKph,
        double? PlannedInclinePercent,
        double RequestedInclinePercent,
        double MeasuredInclinePercent);

    public sealed record WakeLockStatusView(
        string State,
        bool Supported,
        bool Active,
        bool SecureContext,
        string Reason);

}
