    private Task BeginStartPointerHoldAsync(PointerEventArgs _) => BeginStartHoldAsync();

    private Task StartKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CancelStartHold();
            return Task.CompletedTask;
        }

        return args.Key is "Enter" or " " ? BeginStartHoldAsync() : Task.CompletedTask;
    }

    private async Task BeginStartHoldAsync()
    {
        if (!CanStart || startHoldCancellation is not null) return;
        startHoldCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = startHoldCancellation.Token;
        try
        {
            for (var remaining = 3; remaining > 0; remaining--)
            {
                startHoldSecondsRemaining = remaining;
                actionStatus = $"Keep holding — Start in {remaining}.";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            }

            startHoldSecondsRemaining = null;
            if (!CanStart)
            {
                actionStatus = "Remote Start canceled because the session state changed.";
                return;
            }
            await SendCommandAsync(TreadmillCommandKind.Start);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            actionStatus = "Remote Start canceled before sending.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            lease = null;
            controlStatus = "Observer";
            actionStatus = "Gateway connection was interrupted. Manual controls are disabled while reconnecting.";
            await SetConnectionAsync("Gateway unavailable · retrying", false);
        }
        finally
        {
            startHoldSecondsRemaining = null;
            startHoldCancellation?.Dispose();
            startHoldCancellation = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelStartHold() => startHoldCancellation?.Cancel();
    private Task StopAsync()
    {
        CancelStartHold();
        if (isManualCommandPending)
        {
            stopRequestedDuringCommand = true;
            actionStatus = "Stop requested — finishing the in-flight command, then sending one current-state Stop.";
            return InvokeAsync(StateHasChanged);
        }
        return SendCommandAsync(TreadmillCommandKind.Stop);
    }
    private Task PauseAsync() => SendCommandAsync(TreadmillCommandKind.Pause);
    private Task ResumeAsync() => SendCommandAsync(TreadmillCommandKind.Start);
    private void ToggleChartFocus() => isChartFocused = !isChartFocused;

    private async Task SendCommandAsync(TreadmillCommandKind kind)
    {
        bool isStop = kind == TreadmillCommandKind.Stop;
        if (isStop ? isStopPending : isManualCommandPending || isStopPending) return;
        ActiveSessionSnapshot? currentSession = session;
        ControlLease? currentLease = lease;
        if (currentSession is null || currentLease is null) return;
        if (!isStop && HasUnknownOutcome) return;
        if (isStop) isStopPending = true;
        else isManualCommandPending = true;
        string operation = kind switch
        {
            TreadmillCommandKind.Start => "start",
            TreadmillCommandKind.Pause => "pause",
            _ => "stop",
        };
        actionStatus = $"Sending single-use {operation} command…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/live/sessions/{operation}", new
            {
                operationId = Guid.NewGuid(),
                holderId,
                leaseId = currentLease.Id,
                expectedSessionVersion = currentSession.Version,
            });
            if (!response.IsSuccessStatusCode)
            {
                actionStatus = $"{kind} was rejected before confirmation. Live state was refreshed.";
                await RefreshSessionAsync();
                return;
            }

            TreadmillCommandResult? result = await response.Content.ReadFromJsonAsync<TreadmillCommandResult>();
            actionStatus = result?.Disposition switch
            {
                TreadmillCommandDisposition.Confirmed => result.Reason,
                TreadmillCommandDisposition.Unknown => $"Unknown outcome: {result.Reason} Use physical Stop now.",
                _ => result?.Reason ?? $"{kind} was rejected.",
            };
            await RefreshSessionAsync();
            if (session is null || session.Live.SessionState is SessionState.Stopped or SessionState.Completed)
            {
                Navigation.NavigateTo("/", replace: true);
            }
        }
        finally
        {
            if (isStop) isStopPending = false;
            else
            {
                await CompleteManualCommandAsync();
            }
        }
    }

    private async Task CompleteManualCommandAsync()
    {
        isManualCommandPending = false;
        if (!stopRequestedDuringCommand) return;
        stopRequestedDuringCommand = false;
        await RefreshSessionAsync();
        await SendCommandAsync(TreadmillCommandKind.Stop);
    }

    private async Task RefreshSessionAsync()
    {
        using HttpResponseMessage response = await Http.GetAsync("api/live/session");
        session = response.StatusCode == System.Net.HttpStatusCode.NoContent
            ? null
            : await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
        if (session is not null) AppendChartPoint(session);
    }

