    private Task ResetWorkoutProgressAsync() => ApplySessionDecisionAsync("reset-progress", "Workout reset to the first step. Press Start when you are ready.", navigateHome: false);
    private Task DiscardSessionAsync() => ApplySessionDecisionAsync("discard", "Session discarded.", navigateHome: true);
    private Task EndSessionAsync() => ApplySessionDecisionAsync("end", "Session ended and saved.", navigateHome: true);

    private async Task ApplySessionDecisionAsync(string action, string successMessage, bool navigateHome)
    {
        if (sessionActionBusy || session is null || lease is null) return;
        sessionActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/live/sessions/{action}", new
            {
                operationId = Guid.NewGuid(), holderId, leaseId = lease.Id, expectedSessionVersion = session.Version,
            });
            if (!response.IsSuccessStatusCode)
            {
                actionStatus = $"The session action was rejected. Live state was refreshed.";
                await RefreshSessionAsync();
                return;
            }
            session = await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
            Guid completedSessionId = session?.SessionId ?? Guid.Empty;
            await KeepSessionPausedAsync();
            actionStatus = successMessage;
            if (navigateHome)
            {
                Navigation.NavigateTo(
                    completedSessionId == Guid.Empty ? "/history" : $"/history/{completedSessionId:D}",
                    replace: true);
            }
        }
        finally { sessionActionBusy = false; }
    }

