@page "/control"

@using System.Globalization
@using System.Text
@using System.Text.Json
@using TreadmillRunner.Core.Household

@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ClientRuntimeState Runtime
@inject GatewayConnectionSupervisor Gateway
@inject ControlFocusState FocusState

<PageTitle>@DashboardTitle · TreadmillRunner</PageTitle>

<section id="control-dashboard" class="control-page control-page--@FocusClass control-page--@DisplayStyleClass" aria-labelledby="control-title">
    <header class="dashboard-header control-page__header">
        <div class="control-title-block">
            <p class="eyebrow">Run</p>
            <div class="control-title-line">
                <h1 id="control-title">@DashboardTitle</h1>
                @if (session is not null)
                {
                    <span class="control-runner-context" aria-label="Active runner: @session.UserProfileName" title="Active runner: @session.UserProfileName">
                        <AppIcon Name="runner" />
                        <span>@session.UserProfileName</span>
                    </span>
                }
            </div>
        </div>
        <div class="control-header-actions">
            <span class="connection-state" role="status">@connectionStatus</span>
            <HeartRateStatus Compact="true" />
            <div class="control-focus-switcher" role="group" aria-label="Dashboard focus">
                <button type="button" aria-pressed="@Pressed(ControlFocusMode.Balanced)" @onclick="() => SetFocus(ControlFocusMode.Balanced)">Balanced</button>
                <button type="button" aria-pressed="@Pressed(ControlFocusMode.Chart)" @onclick="() => SetFocus(ControlFocusMode.Chart)">Chart</button>
                <button type="button" aria-pressed="@Pressed(ControlFocusMode.Controls)" @onclick="() => SetFocus(ControlFocusMode.Controls)">Controls</button>
            </div>
            <span class="wake-lock-indicator @WakeLockIndicatorClass" role="status" aria-live="polite" aria-label="@WakeLockAccessibleLabel" title="@WakeLockAccessibleLabel">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="4" y="4" width="16" height="12" rx="2" />
                    <path d="M9 20h6M12 16v4" />
                    @if (wakeLockStatus?.Active != true)
                    {
                        <path class="wake-lock-indicator__slash" d="M3 3l18 18" />
                    }
                </svg>
                <span class="visually-hidden">@WakeLockAccessibleLabel</span>
            </span>
            <button class="secondary-action fullscreen-action" type="button" @onclick="ToggleFullscreenAsync" aria-label="Toggle full-screen dashboard" aria-pressed="@(isFullscreenMode ? "true" : "false")" title="@(isFullscreenMode ? "Exit full screen" : "Full screen")"><AppIcon Name="@(isFullscreenMode ? "shrink" : "expand")" /></button>
        </div>
    </header>

    @if (HasUnknownOutcome)
    {
        <section class="safety-banner" role="alert" aria-label="Unknown command safety notice">
            <span class="safety-icon"><AppIcon Name="alert" /></span>
            <p><strong>Use physical Stop now.</strong> A command outcome is uncertain; the dashboard will not retry it.</p>
        </section>
    }

    @if (session is null)
    {
        <section class="panel-card control-empty">
            <p class="eyebrow">No active session</p>
            <h2>Prepare a run before using direct controls</h2>
            <p>The dashboard controls the one authoritative session. Choose a runner and workout, enable controls, and prepare it from Run.</p>
            <a class="primary-action" href="/">Open Run</a>
        </section>
    }
    else
    {
        @if (session.Warnings.Any(IsVisibleControlWarning))
        {
            <section class="session-notices" aria-label="Control notices">
                @foreach (string warning in session.Warnings.Where(IsVisibleControlWarning))
                {
                    <p>@warning</p>
                }
            </section>
        }

        @if (session.RecoveryState is not SessionRecoveryState.None)
        {
            <section class="recovery-status recovery-status--@session.ConnectionPhase.ToString().ToLowerInvariant()" role="status" aria-live="polite" aria-busy="@isManualCommandPending">
                <div><strong>@RecoveryHeading</strong><span>@RecoveryDetail</span></div>
                @if (session.CanResumePlannedControls)
                {
                    <p>The belt is already moving. This does not Start or resume the treadmill; it allows automatic speed and incline changes to match the current workout position.</p>
                    <button class="primary-action touch-action" type="button" @onclick="ResumePlannedControlsAsync" disabled="@(!CanResumePlannedControls)">@(isManualCommandPending ? "Resuming…" : "Resume automatic speed & incline")</button>
                }
            </section>
        }

        @if (session.LastCommandResult is { Disposition: TreadmillCommandDisposition.Unknown } unknownResult)
        {
            <section class="command-result command-unknown" role="alert">
                <strong>@unknownResult.Kind: outcome unknown</strong>
                <span>@unknownResult.Reason</span>
                @if (CommandValuesLabel(unknownResult) is { } unknownValues)
                {
                    <span>@unknownValues</span>
                }
            </section>
        }

        <section class="control-console-grid control-console-grid--@FocusClass @(!liveStateConnected ? "control-console-grid--stale" : null)" aria-label="Live treadmill controls" aria-busy="@(isManualCommandPending || isStopPending)">
            <aside class="control-rail control-rail--speed" aria-labelledby="speed-control-title">
                <div class="control-rail__heading">
                    <span class="eyebrow">Target speed</span>
                    <h2 id="speed-control-title">@session.RequestedSpeedKph.ToString("0.0", CultureInfo.InvariantCulture)<small> km/h</small></h2>
                </div>
                <div class="rail-stepper" role="group" aria-label="Fine speed controls">
                    <button class="touch-action" type="button" aria-label="Speed -@SpeedIncrement.ToString("0.0", CultureInfo.InvariantCulture) km/h" @onclick="() => SetSpeedTargetAsync(session.RequestedSpeedKph - SpeedIncrement)" disabled="@(!CanAdjustSpeed)">−</button>
                    <button class="touch-action" type="button" aria-label="Speed +@SpeedIncrement.ToString("0.0", CultureInfo.InvariantCulture) km/h" @onclick="() => SetSpeedTargetAsync(session.RequestedSpeedKph + SpeedIncrement)" disabled="@(!CanAdjustSpeed)">+</button>
                </div>
                <div class="rail-presets" role="group" aria-label="Speed presets">
                    @foreach (double target in SpeedTargets)
                    {
                        <button class="touch-action quick-target" type="button" aria-label="Set speed to @target.ToString("0.0", CultureInfo.InvariantCulture) km/h" aria-pressed="@AriaPressed(Approximately(session.RequestedSpeedKph, target))" @onclick="() => SetSpeedTargetAsync(target)" disabled="@(!CanAdjustSpeed)">@target.ToString("0.0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
            </aside>

            <section class="control-center" aria-label="Live control center">
                <section class="control-mode-metrics" aria-label="Control mode summary">
                    <article><span>Measured speed</span><strong>@session.Live.SpeedKph.ToString("0.0", CultureInfo.InvariantCulture)<small> km/h</small></strong></article>
                    <article><span>Heart rate</span><strong>@(session.Live.HeartRateBpm?.ToString(CultureInfo.InvariantCulture) ?? "—")<small>@(session.Live.HeartRateBpm is null ? null : " bpm")</small></strong></article>
                    <article><span>Workout</span><strong>@FormatElapsed(session.WorkoutElapsed)</strong></article>
                </section>
                <section class="control-primary-metrics" aria-label="Live workout metrics">
                    @foreach (LiveMetric metric in primaryMetrics)
                    {
                        @switch (metric)
                        {
                            case LiveMetric.Speed:
                                <article aria-label="Measured speed"><span>Measured speed</span><strong>@session.Live.SpeedKph.ToString("0.0", CultureInfo.InvariantCulture)<small> km/h</small></strong></article>
                                break;
                            case LiveMetric.Incline:
                                <article aria-label="Measured incline"><span>Measured incline</span><strong>@session.Live.InclinePercent.ToString("0.0", CultureInfo.InvariantCulture)<small>%</small></strong></article>
                                break;
                            case LiveMetric.HeartRate:
                                <article aria-label="Heart rate">
                                    <span>Heart rate</span>
                                    @if (session.Live.HeartRateBpm is { } heartRate)
                                    {
                                        <strong>@heartRate.ToString(CultureInfo.InvariantCulture)<small> bpm</small></strong>
                                    }
                                    else
                                    {
                                        <strong>—</strong><small>Not available</small>
                                    }
                                </article>
                                break;
                            case LiveMetric.ElapsedTime:
                                <article aria-label="Workout progress time"><span>Workout</span><strong>@FormatElapsed(session.WorkoutElapsed)</strong></article>
                                break;
                            case LiveMetric.Distance:
                                <article aria-label="Distance"><span>Distance</span><strong>@session.Live.DistanceKilometers.ToString("0.00", CultureInfo.InvariantCulture)<small> km</small></strong></article>
                                break;
                            case LiveMetric.Calories:
                                <article aria-label="Calories unavailable"><span>Calories</span><strong>—</strong><small>Not recorded</small></article>
                                break;
                        }
                    }
                </section>

                <LiveProgressChart TitleId="control-chart-title"
                                   Eyebrow="This run"
                                   Heading="Progress"
                                   Title="@session.WorkoutTitle"
                                   CssClass="@(focusMode == ControlFocusMode.Chart ? "control-live-chart--focused" : null)"
                                   SpeedAxisMaximum="@SpeedAxisMaximum"
                                   InclineAxisMaximum="@InclineAxisMaximum"
                                   Duration="@ChartDuration"
                                   PlannedSpeedPath="@BuildPlanPath(static point => point.SpeedKph, ChartBand.Speed)"
                                   TargetSpeedPath="@BuildChartPath(static point => point.RequestedSpeedKph, ChartBand.Speed)"
                                   MeasuredSpeedPath="@BuildChartPath(static point => point.MeasuredSpeedKph, ChartBand.Speed)"
                                   PlannedInclinePath="@BuildPlanPath(static point => point.InclinePercent, ChartBand.Incline)"
                                   TargetInclinePath="@BuildChartPath(static point => point.RequestedInclinePercent, ChartBand.Incline)"
                                   MeasuredInclinePath="@BuildChartPath(static point => point.MeasuredInclinePercent, ChartBand.Incline)"
                                   CursorX="@CurrentChartX"
                                   ElapsedSeconds="@CurrentChartElapsedSeconds"
                                   DurationSeconds="@ChartDurationSeconds"
                                   MarkerX="@(LatestMeasuredPoint is { } latest ? ChartX(latest.Elapsed) : null)"
                                   MarkerY="@(LatestMeasuredPoint is { } marker ? ChartY(marker.MeasuredSpeedKph, ChartBand.Speed) : null)"
                                   InspectionSeries="@ChartInspectionSeries"
                                   InspectionPoints="@ChartInspectionPoints">
                    <HeaderActions>
                            <button class="secondary-action chart-focus-action" type="button" @onclick="ToggleChartFocus" aria-label="@(focusMode == ControlFocusMode.Chart ? "Collapse live graph" : "Expand live graph")" title="@(focusMode == ControlFocusMode.Chart ? "Back to dashboard" : "Expand graph")"><AppIcon Name="@(focusMode == ControlFocusMode.Chart ? "shrink" : "chart-expand")" /><span class="chart-focus-action__label">Back</span></button>
                    </HeaderActions>
                </LiveProgressChart>

                @if (lease is null)
                {
                    <button class="primary-action touch-action control-takeover" type="button" @onclick="TakeControlAsync" disabled="@(isTakingControl || !ClientReady)">@(isTakingControl ? "Enabling…" : "Enable controls")</button>
                }

                <section class="control-action-dock" aria-label="Treadmill motion controls">
                    <p class="control-command-status" role="status">@actionStatus</p>
                    @if (session.Live.SessionState == SessionState.Running)
                    {
                        <button class="touch-action media-control media-control--pause" type="button" @onclick="PauseAsync" disabled="@(!CanPause)"><span class="media-control__icon"><AppIcon Name="pause" /></span><span>Pause</span></button>
                    }
                    else
                    {
                        <button class="touch-action primary-action media-control media-control--play" type="button" disabled="@(!CanStart)" @onclick="StartAsync"><span class="media-control__icon"><AppIcon Name="play" /></span><span>@(session.Live.SessionState == SessionState.PausedWaitingForPhysicalResume ? "Resume" : "Start")</span></button>
                    }
                    <button class="touch-action danger-action stop-action media-control media-control--stop" type="button" @onclick="StopAsync" disabled="@(!CanStop)"><span class="media-control__icon"><AppIcon Name="stop" /></span><span>Stop</span></button>
                </section>
                @if (session.HeartRateTarget is not null)
                {
                    <details class="automation-panel control-automation">
                        <summary><span>Heart-rate speed control</span><strong>@AutomationLabel</strong></summary>
                        <div class="automation-modes" role="group" aria-label="Heart-rate speed control">
                            <button class="touch-action" type="button" aria-label="HR shadow" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Shadow)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Shadow)" disabled="@(!CanSetAutomation)">Monitor only</button>
                            <button class="touch-action" type="button" aria-label="HR decreases" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.DecreaseOnly)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.DecreaseOnly)" disabled="@(!CanSetSpeedAutomation)">Slow down only</button>
                            <button class="touch-action" type="button" aria-label="HR two-way" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Full)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Full)" disabled="@(!CanSetSpeedAutomation)">Full control</button>
                            <button class="touch-action" type="button" aria-label="HR off" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Disabled)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Disabled)" disabled="@(!CanSetAutomation)">Off</button>
                        </div>
                        <p>HR automation: @session.HeartRateAutomationMode · @session.HeartRateAutomationReason</p>
                    </details>
                }
                <p class="control-disabled-reason">@ControlAvailabilityMessage</p>
            </section>

            <aside class="control-rail control-rail--incline" aria-labelledby="incline-control-title">
                <div class="control-rail__heading">
                    <span class="eyebrow">Target incline</span>
                    <h2 id="incline-control-title">@session.RequestedInclinePercent.ToString("0.0", CultureInfo.InvariantCulture)<small>%</small></h2>
                </div>
                <div class="rail-stepper" role="group" aria-label="Fine incline controls">
                    <button class="touch-action" type="button" aria-label="Incline -@InclineIncrement.ToString("0.0", CultureInfo.InvariantCulture)%" @onclick="() => SetInclineTargetAsync(session.RequestedInclinePercent - InclineIncrement)" disabled="@(!CanAdjustIncline)">−</button>
                    <button class="touch-action" type="button" aria-label="Incline +@InclineIncrement.ToString("0.0", CultureInfo.InvariantCulture)%" @onclick="() => SetInclineTargetAsync(session.RequestedInclinePercent + InclineIncrement)" disabled="@(!CanAdjustIncline)">+</button>
                </div>
                <div class="rail-presets" role="group" aria-label="Incline presets">
                    @foreach (double target in InclineTargets)
                    {
                        <button class="touch-action quick-target" type="button" aria-label="Set incline to @target.ToString("0.0", CultureInfo.InvariantCulture)%" aria-pressed="@AriaPressed(Approximately(session.RequestedInclinePercent, target))" @onclick="() => SetInclineTargetAsync(target)" disabled="@(!CanAdjustIncline)">@target.ToString("0.0", CultureInfo.InvariantCulture)</button>
                    }
                </div>
            </aside>
        </section>

        <details class="control-details" aria-label="Technical session details">
            <summary>Connection and command details</summary>
            <p class="control-safety-copy"><strong>Physical Stop and the safety key remain authoritative.</strong> Bluetooth disconnect is never a stop mechanism.</p>
            <section class="control-status-strip" aria-label="Current treadmill status">
                <div><span>Session</span><strong>@SessionStateLabel</strong></div>
                <div><span>Treadmill</span><strong>@session.Live.TreadmillConnectionState</strong></div>
                <div><span>Telemetry</span><strong>@session.Live.TelemetryAge.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) s old</strong></div>
                <div><span>Controller</span><strong>@controlStatus</strong></div>
            </section>
            @if (session.LastCommandResult is { Disposition: not TreadmillCommandDisposition.Unknown } commandResult)
            {
                <section class="command-result command-@commandResult.Disposition.ToString().ToLowerInvariant()" role="status">
                    <strong>@commandResult.Kind: @commandResult.Disposition</strong><span>@commandResult.Reason</span>
                    @if (CommandValuesLabel(commandResult) is { } values) { <span>@values</span> }
                    <span>Completed in @((commandResult.CompletedAt - commandResult.IssuedAt).TotalSeconds.ToString("0.00", CultureInfo.InvariantCulture)) s · generation @commandResult.ConnectionGeneration</span>
                </section>
            }
        </details>
    }
</section>

@if (isStopDecisionOpen)
{
    <DetailSheet BackdropId="stop-decision-backdrop" BackdropClass="workout-details-backdrop" CssClass="workout-details-dialog stop-decision-dialog" LabelledBy="stop-decision-title" OnDismiss="KeepSessionPausedAsync">
        <header class="workout-details-header"><div><p class="eyebrow">Treadmill stopped</p><h2 id="stop-decision-title">What should happen to this session?</h2></div><button class="icon-action" type="button" aria-label="Keep session paused" autofocus @onclick="KeepSessionPausedAsync"><AppIcon Name="close" /></button></header>
        <p>The belt is stopped. Your recording and workout progress are still preserved.</p>
        <div class="stop-decision-actions">
            <button class="secondary-action" type="button" disabled="@sessionActionBusy" @onclick="KeepSessionPausedAsync"><strong>Keep paused</strong><span>Return to the run and resume later.</span></button>
            <button class="secondary-action" type="button" disabled="@sessionActionBusy" @onclick="ResetWorkoutProgressAsync"><strong>Start from beginning</strong><span>Go back to the first step and apply its speed and incline after Start.</span></button>
            <button class="danger-action" type="button" disabled="@sessionActionBusy" @onclick="DiscardSessionAsync"><strong>Discard session</strong><span>Delete this run and all local samples instead of adding it to History.</span></button>
            <button class="danger-action" type="button" disabled="@sessionActionBusy" @onclick="EndSessionAsync"><strong>End and save</strong><span>Finish this session and keep it in History.</span></button>
        </div>
    </DetailSheet>
}

@code {
    private static readonly double[] PopularSpeeds = [5.0, 7.0, 7.5, 8.0, 8.5, 9.0, 9.5, 10.0];
    private static readonly double[] PopularInclines = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0];
    private static readonly IReadOnlyList<ChartInspectionSeries> ChartInspectionSeries =
    [
        new("Speed", "Plan", "km/h", 1, "legend-line--plan"),
        new("Speed", "Target", "km/h", 1, "legend-line--requested"),
        new("Speed", "Measured", "km/h", 1, "legend-line--measured"),
        new("Incline", "Plan", "%", 1, "legend-line--incline-plan"),
        new("Incline", "Target", "%", 1, "legend-line--incline-target"),
        new("Incline", "Measured", "%", 1, "legend-line--incline-measured"),
    ];
    private BoundedLiveSeries<ControlChartPoint> chartPoints = new(43_200);
    private DotNetObjectReference<Control>? wakeLockReference;
    private ActiveSessionSnapshot? session;
    private ControlLease? lease => Gateway.Current.Lease;
    private string holderId => Gateway.HolderId;
    private string connectionStatus => Gateway.Current.ConnectionPhase switch
    {
        GatewayClientConnectionPhase.Connected => "Gateway ready",
        GatewayClientConnectionPhase.Starting => "Connecting",
        _ => "Gateway unavailable · retrying",
    };
    private bool liveStateConnected => Gateway.Current.IsConnected;
    private string controlStatus => lease is null ? "Observer" : "Controller";
    private string actionStatus = "Waiting for an active session.";
    private bool isTakingControl;
    private bool isManualCommandPending;
    private bool isStopPending;
    private ControlFocusMode focusMode = ControlFocusMode.Balanced;
    private LiveDisplayStyle displayStyle = LiveDisplayStyle.Balanced;
    private IReadOnlyList<LiveMetric> primaryMetrics = RunnerExperiencePreferences.Default.PrimaryMetrics;
    private RunCuePreferences cuePreferences = RunCuePreferences.Default;
    private Guid? experienceProfileId;
    private bool halfwayCuePlayed;
    private string FocusClass => focusMode.ToString().ToLowerInvariant();
    private string DisplayStyleClass => displayStyle.ToString().ToLowerInvariant();
    private bool stopRequestedDuringCommand;
    private bool openDecisionAfterQueuedStop;
    private bool isStopDecisionOpen;
    private bool openStopDecisionPending;
    private bool sessionActionBusy;
    private DotNetObjectReference<Control>? stopDecisionModalReference;
    private bool hasRendered;
    private bool isFullscreenMode;
    private WakeLockStatusView? wakeLockStatus;
    private double speedChartMaximum = 10;
    private double inclineChartMaximum = 10;
    private long renderedChartVersion = -1;
    private IReadOnlyList<ControlChartPoint> renderedChartPoints = [];

    private bool HasUnknownOutcome => session?.LastCommandResult?.Disposition == TreadmillCommandDisposition.Unknown;
    private bool HasController => lease is not null;
    private bool ClientReady => Runtime.IsConnected && !Runtime.UpdateRequired && liveStateConnected && Gateway.Current.ControlsBlockedReason is null;
    private bool CanStart => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session is
    {
        CanStartRemotely: true,
        Live.SessionState: SessionState.ArmedWaitingForPhysicalStart or SessionState.PausedWaitingForPhysicalResume,
    };
    private bool CanPause => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session is
    {
        CanPauseRemotely: true,
        Live.SessionState: SessionState.Running,
    };
    private bool CanStop => ClientReady && !isStopPending && HasController && session is not null &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanStopRemotely) && session.Live.SessionState is
        SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume;
    private bool CanAdjustSpeed => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetSpeedRemotely);
    private bool CanAdjustIncline => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetInclineRemotely);
    private bool CanSetAutomation => ClientReady && !HasUnknownOutcome && !isManualCommandPending && !isStopPending && HasController &&
        session?.Live.SessionState == SessionState.Running;
    private bool CanSetSpeedAutomation => CanSetAutomation && session is not null &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetSpeedRemotely);
    private string DashboardTitle => session?.Live.SessionState switch
    {
        SessionState.ArmedWaitingForPhysicalStart => "Ready at the treadmill",
        SessionState.PausedWaitingForPhysicalResume => "Run paused",
        SessionState.Running => "Live run",
        _ => "Run",
    };
    private string AutomationLabel => session?.HeartRateAutomationMode switch
    {
        HeartRateAutomationMode.Disabled => "Off",
        HeartRateAutomationMode.Shadow => "Monitor only",
        HeartRateAutomationMode.DecreaseOnly => "Slow down only",
        HeartRateAutomationMode.Full => "Full control",
        HeartRateAutomationMode.SuspendedManualOverride => "Paused after manual change",
        HeartRateAutomationMode.SuspendedSafety => "Paused for safety",
        _ => "Unavailable",
    };
    private double SpeedIncrement => (double)(session?.SpeedRange?.Increment ?? 0.1m);
    private double InclineIncrement => (double)(session?.InclineRange?.Increment ?? 0.5m);
    private IEnumerable<double> SpeedTargets => PopularSpeeds.Where(target => IsWithinRange(target, session?.SpeedRange));
    private IEnumerable<double> InclineTargets => PopularInclines.Where(target => IsWithinRange(target, session?.InclineRange));
    private string SessionStateLabel => session?.Live.SessionState switch
    {
        SessionState.ArmedWaitingForPhysicalStart => "Ready",
        SessionState.PausedWaitingForPhysicalResume => "Paused",
        SessionState.Running => "Running",
        SessionState.Stopped => "Stopped",
        SessionState.Completed => "Complete",
        _ => session?.Live.SessionState.ToString() ?? "None",
    };
    private string ControlAvailabilityMessage => HasUnknownOutcome
        ? "Adjustments are locked after an unknown outcome. Use physical Stop; the dashboard will not retry."
        : lease is null
            ? "Take control to enable commands. Live measurements remain visible to observers."
            : session?.Live.SessionState != SessionState.Running
                ? "Speed and incline changes are available while the session is running."
                : "Targets are bounded by the active profile and verified treadmill ranges.";
    private string WakeLockIndicatorClass => wakeLockStatus?.Active == true
      ? "wake-lock-indicator--active"
      : wakeLockStatus?.State == "PausedInBackground"
        ? "wake-lock-indicator--paused"
        : "wake-lock-indicator--unavailable";
    private string WakeLockAccessibleLabel => wakeLockStatus is null
      ? "Checking screen stay-awake"
      : wakeLockStatus.Active
        ? "Screen stay-awake active"
        : $"Screen stay-awake unavailable. {wakeLockStatus.Reason}";

    protected override async Task OnInitializedAsync()
    {
        Gateway.ConnectionChanged += GatewayConnectionChanged;
        Gateway.SessionChanged += GatewaySessionChanged;
        Gateway.LeaseChanged += GatewayLeaseChanged;
        try
        {
            await Gateway.EnsureStartedAsync();
            session = Gateway.Current.Session;
            if (session is not null && IsTerminal(session.Live.SessionState))
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            if (session is not null)
            {
                UpdateInitialActionStatus(session);
                focusMode = FocusState.ForSession(session.SessionId);
                await LoadExperienceAsync(session.UserProfileId);
                await HydrateChartAsync(session.SessionId);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            actionStatus = "Gateway unavailable; reconnecting automatically.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;
            wakeLockReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("treadmillRunnerView.initializeFullscreenTracking", "control-dashboard", wakeLockReference);
            await UpdateWakeLockAsync();
            if (Gateway.Current.WantsControl is false) await TakeControlAsync(restoring: true);
        }
        if (openStopDecisionPending && isStopDecisionOpen)
        {
            openStopDecisionPending = false;
            stopDecisionModalReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("treadmillRunnerView.openModal", "stop-decision-backdrop", stopDecisionModalReference);
        }
    }

    private Task TakeControlAsync() => TakeControlAsync(restoring: false);

    private async Task TakeControlAsync(bool restoring)
    {
        if (isTakingControl) return;
        isTakingControl = true;
        try
        {
            ControlLease? acquired = await Gateway.RequestControlAsync(restoring);
            if (acquired is not null)
            {
                actionStatus = restoring ? "Controller access restored." : "Direct controls are ready.";
            }
            else
            {
                actionStatus = Gateway.Current.ControlsBlockedReason ?? "Another browser currently controls manual actions.";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            actionStatus = "Manual controls are unavailable because the gateway connection was interrupted.";
        }
        finally
        {
            isTakingControl = false;
        }
    }

    private void GatewayConnectionChanged()
    {
        if (!Gateway.Current.IsConnected)
        {
            actionStatus = Gateway.Current.ControlsBlockedReason ?? "Live updates interrupted; the treadmill may still be moving.";
            if (cuePreferences.ConnectionProblems) _ = PlayCueAsync();
        }
        _ = InvokeAsync(() =>
        {
            if (Gateway.Current.IsConnected && Gateway.Current.Session is null)
                Navigation.NavigateTo("/", replace: true);
            else
                StateHasChanged();
        });
    }

    private void GatewayLeaseChanged()
    {
        if (Gateway.Current.Lease is null && Gateway.Current.WantsControl)
            actionStatus = Gateway.Current.ControlsBlockedReason ?? "Controller access is being restored.";
        else if (Gateway.Current.Lease is not null && Gateway.Current.WantsControl)
            actionStatus = "Controller access restored.";
        _ = InvokeAsync(StateHasChanged);
    }

    private void GatewaySessionChanged()
    {
        ActiveSessionSnapshot? previous = session;
        ActiveSessionSnapshot? incoming = Gateway.Current.Session;
        session = incoming;
        if (incoming is not null)
        {
            UpdateStateActionStatus(previous, incoming);
            focusMode = FocusState.ForSession(incoming.SessionId);
            AppendChartPoint(incoming);
            if (experienceProfileId != incoming.UserProfileId) _ = LoadExperienceAsync(incoming.UserProfileId);
            if (cuePreferences.StepChanges && previous?.CurrentStep?.Index is { } previousStep && incoming.CurrentStep?.Index != previousStep)
                _ = PlayCueAsync();
            if (cuePreferences.HeartRateDeparture && HasHeartRateTarget(previous) && IsHeartRateWithinTarget(previous) && !IsHeartRateWithinTarget(incoming))
                _ = PlayCueAsync();
            if (cuePreferences.Halfway && !halfwayCuePlayed && incoming.Remaining is { } remaining && incoming.Live.Elapsed >= remaining)
            {
                halfwayCuePlayed = true;
                _ = PlayCueAsync();
            }
            if (cuePreferences.Completion && previous is not null && !IsTerminal(previous.Live.SessionState) && IsTerminal(incoming.Live.SessionState))
                _ = PlayCueAsync();
        }
        _ = InvokeAsync(async () =>
        {
            await UpdateWakeLockAsync();
            if (incoming is null || IsTerminal(incoming.Live.SessionState))
                Navigation.NavigateTo("/", replace: true);
            else
                StateHasChanged();
        });
    }

    private void UpdateInitialActionStatus(ActiveSessionSnapshot incoming)
    {
        if (actionStatus != "Waiting for an active session.") return;

        actionStatus = StateActionStatus(incoming.Live.SessionState);
    }

    private void UpdateStateActionStatus(ActiveSessionSnapshot? previous, ActiveSessionSnapshot incoming)
    {
        if (previous?.Live.SessionState == incoming.Live.SessionState) return;
        actionStatus = StateActionStatus(incoming.Live.SessionState);
    }

    private static string StateActionStatus(SessionState state) => state switch
        {
            SessionState.ArmedWaitingForPhysicalStart => "Session ready. Press Start when you are prepared.",
            SessionState.Running => "Session running. Pause or Stop when needed.",
            SessionState.PausedWaitingForPhysicalResume => "Session paused. Press Resume when you are ready.",
            _ => "Live session connected.",
        };

