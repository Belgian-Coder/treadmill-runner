@page "/history"
@inject HttpClient Http
@inject ActiveProfileState ActiveProfile
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>History · TreadmillRunner</PageTitle>

<section class="page-stack" aria-labelledby="history-title">
    <header class="page-heading">
        <div><p class="eyebrow">Progress</p><h1 id="history-title">History</h1></div>
        <p>Completed, stopped, interrupted, and faulted sessions remain available locally.</p>
    </header>

    <div class="segmented-control history-mode" role="group" aria-label="History type">
        <button type="button" class="@(showTests ? "secondary-action" : "primary-action")" aria-pressed="@((!showTests).ToString().ToLowerInvariant())" @onclick="() => SetTestModeAsync(false)">Runs</button>
        <button type="button" class="@(showTests ? "primary-action" : "secondary-action")" aria-pressed="@(showTests.ToString().ToLowerInvariant())" @onclick="() => SetTestModeAsync(true)">Tests</button>
    </div>

    @if (loading)
    {
        <p class="empty-state" role="status">Loading this runner’s local history…</p>
    }
    else if (profileId is null)
    {
        <div class="empty-state">
            <p>Choose a runner before viewing personal history, trends, and goals.</p>
            <a class="primary-action" href="/profiles">Choose a runner</a>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="empty-state" role="alert">
            <p>@loadError</p>
            <button class="secondary-action" type="button" @onclick="LoadAsync">Try again</button>
        </div>
    }
    else if (sessions.Count == 0)
    {
        <p class="empty-state">@(showTests ? "No system-test activities are stored for this runner." : "No completed sessions for the selected runner yet.")</p>
    }
    else
    {
        @if (!showTests && insights is { } local)
        {
            <section class="weekly-summary-panel" aria-label="Personal local trends">
                <div class="weekly-summary-heading"><strong>Personal trends · completed runs</strong><span>Simulator and system-test sessions are excluded.</span></div>
                <div class="weekly-summary trend-summary">
                    <article><span>Last 7 days</span><strong>@local.WeeklyTrends.CompletedSessions runs · @local.WeeklyTrends.DistanceKilometers.ToString("0.00") km</strong></article>
                    <article><span>Last 30 days</span><strong>@local.MonthlyTrends.CompletedSessions runs · @local.MonthlyTrends.Duration.ToString(@"hh\:mm\:ss")</strong></article>
                    <article><span>All completed</span><strong>@local.Trends.DistanceKilometers.ToString("0.00") km</strong></article>
                    <article><span>Distance record</span><strong>@local.Trends.LongestDistanceKilometers.ToString("0.00") km</strong></article>
                </div>
                @if (local.Trends.IncompleteTelemetrySessions > 0)
                {
                    <p class="field-hint">@local.Trends.IncompleteTelemetrySessions completed run(s) contain incomplete telemetry; totals retain the recorded values without estimation.</p>
                }
            </section>
        }
        @if (!showTests && summaryUnavailable)
        {
            <p class="notice" role="status">Runs are available, but personal trend or weekly summaries could not be loaded from the local gateway.</p>
        }
        @if (!showTests && weekly is not null)
        {
            <section class="weekly-summary-panel" aria-label="This week's completed running">
                <div class="weekly-summary-heading"><strong>This week · all completed activity</strong><span>These totals are not changed by the history filters below.</span></div>
                <div class="weekly-summary">
                <article><span>Completed this week</span><strong>@weekly.CompletedSessionCount</strong></article>
                <article><span>Running time</span><strong>@weekly.Duration.ToString(@"hh\:mm\:ss")</strong></article>
                <article><span>Distance</span><strong>@weekly.DistanceKilometers.ToString("0.00") km</strong></article>
                </div>
            </section>
        }
        <section class="history-toolbar" aria-label="Filter running history">
            <label class="field field--search">Search history
                <input type="search" @bind="searchText" @bind:event="oninput" placeholder="Workout title" />
            </label>
            <label class="field">Status
                <select @bind="statusFilter">
                    <option value="all">All outcomes</option>
                    <option value="Completed">Completed</option>
                    <option value="Stopped">Stopped</option>
                    <option value="Interrupted">Interrupted</option>
                    <option value="Faulted">Faulted</option>
                </select>
            </label>
            <label class="field">Period
                <select @bind="periodFilter">
                    <option value="30">Last 30 days</option>
                    <option value="7">Last 7 days</option>
                    <option value="90">Last 90 days</option>
                    <option value="all">All time</option>
                </select>
            </label>
            <button class="secondary-action" type="button" @onclick="ClearFilters" disabled="@(!HasFilters)">Clear filters</button>
            <span class="history-result-count" role="status">@FilteredSessions.Count @(showTests ? (FilteredSessions.Count == 1 ? "test" : "tests") : (FilteredSessions.Count == 1 ? "run" : "runs"))</span>
        </section>
        <div class="history-list">
            @foreach (SessionSummary item in FilteredSessions)
            {
                <article class="history-card history-card--interactive" role="button" tabindex="0" aria-label="View details for @item.WorkoutTitle" @onclick="() => OpenSessionDetailsAsync(item)" @onkeydown="args => OpenSessionDetailsFromKeyAsync(args, item)">
                    <div><span class="status-chip">@(item.Origin == SessionOrigin.SystemTest ? "System test" : item.Status)</span><h2>@item.WorkoutTitle</h2><p>@item.StartedAt.ToLocalTime().ToString("d MMM yyyy · HH:mm")</p><span class="history-card__hint">View graph and all changes</span></div>
                    <dl>
                        <div><dt>Time</dt><dd>@item.Duration.ToString(@"hh\:mm\:ss")</dd></div>
                        <div><dt>Distance</dt><dd>@item.DistanceKilometers.ToString("0.00") km</dd></div>
                        <div><dt>Avg speed</dt><dd>@item.AverageSpeedKph.ToString("0.0") km/h</dd></div>
                        <div><dt>Heart rate</dt><dd>@HeartRateLabel(item)</dd></div>
                        <div><dt>Avg incline</dt><dd>@item.AverageInclinePercent.ToString("0.0")%</dd></div>
                    </dl>
                </article>
            }
        </div>
        @if (FilteredSessions.Count == 0)
        {
            <div class="empty-state"><p>No runs match these filters.</p><button class="secondary-action" type="button" @onclick="ClearFilters">Clear filters</button></div>
        }
    }
</section>

@if (selectedSummary is not null)
{
    <DetailSheet BackdropId="history-details-backdrop" BackdropClass="workout-details-backdrop" CssClass="workout-details-dialog session-details-dialog" LabelledBy="history-details-title" OnDismiss="CloseSessionDetailsAsync">
        <header class="workout-details-header">
            <div><p class="eyebrow">@selectedSummary.Status · @selectedSummary.UserProfileName</p><h2 id="history-details-title">@selectedSummary.WorkoutTitle</h2></div>
            <button class="icon-action" type="button" aria-label="Close session details" autofocus @onclick="CloseSessionDetailsAsync">×</button>
        </header>
        @if (sessionDetailsLoading)
        {
            <p class="empty-state" role="status">Loading the stored session, graph, and changes…</p>
        }
        else if (!string.IsNullOrWhiteSpace(sessionDetailsError))
        {
            <div class="empty-state" role="alert"><p>@sessionDetailsError</p><button class="secondary-action" type="button" @onclick="RetrySessionDetailsAsync">Try again</button></div>
        }
        else if (selectedSession is not null)
        {
            <SessionSnapshotDetails Session="selectedSession" IdPrefix="history-popup" />
        }
        <div class="card-actions workout-details-actions">
            <button class="secondary-action" type="button" @onclick="CloseSessionDetailsAsync">Close</button>
            <a class="primary-action" href="/history/@selectedSummary.SessionId">Open full session page</a>
        </div>
    </DetailSheet>
}

@code {
    private IReadOnlyList<SessionSummary> sessions = Array.Empty<SessionSummary>();
    private WeeklySessionTotals? weekly;
    private LocalInsightsView? insights;
    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string periodFilter = "30";
    private bool HasFilters => !string.IsNullOrWhiteSpace(searchText) || statusFilter != "all" || periodFilter != "30";
    private bool showTests;
    private Guid? profileId;
    private bool loading = true;
    private bool summaryUnavailable;
    private string? loadError;
    private SessionSummary? selectedSummary;
    private StoredWorkoutSessionView? selectedSession;
    private bool sessionDetailsLoading;
    private bool sessionDetailsOpenPending;
    private string? sessionDetailsError;
    private DotNetObjectReference<History>? sessionDetailsModalReference;

    private IReadOnlyList<SessionSummary> FilteredSessions
    {
        get
        {
            IEnumerable<SessionSummary> filtered = sessions;
            filtered = filtered.Where(session => showTests
                ? session.Origin == SessionOrigin.SystemTest
                : session.Origin != SessionOrigin.SystemTest);
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filtered = filtered.Where(session => session.WorkoutTitle.Contains(searchText, StringComparison.CurrentCultureIgnoreCase));
            }
            if (statusFilter != "all")
            {
                filtered = filtered.Where(session => string.Equals(session.Status.ToString(), statusFilter, StringComparison.Ordinal));
            }
            if (int.TryParse(periodFilter, out int days))
            {
                DateTimeOffset cutoff = DateTimeOffset.Now.AddDays(-days);
                filtered = filtered.Where(session => session.StartedAt.ToLocalTime() >= cutoff);
            }
            return filtered.OrderByDescending(static session => session.StartedAt).ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        profileId = await ActiveProfile.GetAsync();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!sessionDetailsOpenPending || selectedSummary is null) return;
        sessionDetailsOpenPending = false;
        sessionDetailsModalReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("treadmillRunnerView.openModal", "history-details-backdrop", sessionDetailsModalReference);
    }

    private async Task OpenSessionDetailsAsync(SessionSummary summary)
    {
        selectedSummary = summary;
        selectedSession = null;
        sessionDetailsError = null;
        sessionDetailsLoading = true;
        sessionDetailsOpenPending = true;
        await InvokeAsync(StateHasChanged);
        await LoadSessionDetailsAsync();
    }

    private Task OpenSessionDetailsFromKeyAsync(KeyboardEventArgs args, SessionSummary summary)
    {
        return args.Key is "Enter" or " " ? OpenSessionDetailsAsync(summary) : Task.CompletedTask;
    }

    private async Task LoadSessionDetailsAsync()
    {
        if (selectedSummary is not { } summary) return;
        sessionDetailsLoading = true;
        sessionDetailsError = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync($"api/history/{summary.SessionId:D}");
            selectedSession = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<StoredWorkoutSessionView>() : null;
            if (selectedSession is null) sessionDetailsError = response.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "This local session was not found. It may have been deleted."
                : "The stored session details could not be loaded.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            sessionDetailsError = "The session details could not be loaded from the local gateway. No stored data was changed.";
        }
        finally { sessionDetailsLoading = false; }
    }

    private Task RetrySessionDetailsAsync() => LoadSessionDetailsAsync();

    private async Task CloseSessionDetailsAsync()
    {
        await JS.InvokeVoidAsync("treadmillRunnerView.closeModal");
        sessionDetailsModalReference = null;
        selectedSummary = null;
        selectedSession = null;
        sessionDetailsError = null;
        sessionDetailsLoading = false;
    }

    [JSInvokable]
    public async Task<bool> CloseScheduleManagerFromJs()
    {
        sessionDetailsModalReference = null;
        selectedSummary = null;
        selectedSession = null;
        sessionDetailsError = null;
        sessionDetailsLoading = false;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task SetTestModeAsync(bool value)
    {
        if (showTests == value) return;
        showTests = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        summaryUnavailable = false;
        sessions = Array.Empty<SessionSummary>();
        weekly = null;
        insights = null;
        if (profileId is not { } selected)
        {
            loading = false;
            return;
        }
        try
        {
            sessions = await Http.GetFromJsonAsync<SessionSummary[]>($"api/history?profileId={selected}&take=5000&includeTests={showTests.ToString().ToLowerInvariant()}")
                ?? Array.Empty<SessionSummary>();
            if (!showTests)
            {
                try
                {
                    weekly = await Http.GetFromJsonAsync<WeeklySessionTotals>($"api/history/weekly?profileId={selected}");
                    insights = await Http.GetFromJsonAsync<LocalInsightsView>($"api/local-first/profiles/{selected}/insights");
                }
                catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
                {
                    summaryUnavailable = true;
                }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            loadError = "History could not be loaded from the local gateway. No stored data was changed.";
        }
        finally
        {
            loading = false;
        }
    }

    private static string HeartRateLabel(SessionSummary session)
    {
        if (session.AverageHeartRateBpm is null) return "—";
        return session.MaximumHeartRateBpm is { } maximum
            ? $"{session.AverageHeartRateBpm:0} / {maximum} bpm"
            : $"{session.AverageHeartRateBpm:0} bpm";
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = "all";
        periodFilter = "30";
    }

    private sealed record LocalInsightsView(LocalTrendView Trends, LocalTrendView WeeklyTrends, LocalTrendView MonthlyTrends, IReadOnlyList<LocalGoalView> Goals);
    private sealed record LocalTrendView(Guid ProfileId, int CompletedSessions, TimeSpan Duration, double DistanceKilometers, int IncompleteTelemetrySessions, double LongestDistanceKilometers, TimeSpan LongestDuration, int? HighestAverageHeartRateBpm);
    private sealed record LocalGoalView(Guid Id, Guid ProfileId, string Kind, string Period, double TargetValue, bool Enabled, int Version, DateTimeOffset UpdatedAtUtc);

    public async ValueTask DisposeAsync()
    {
        if (selectedSummary is not null)
        {
            try { await JS.InvokeVoidAsync("treadmillRunnerView.closeModal"); }
            catch (JSDisconnectedException) { }
        }
        sessionDetailsModalReference = null;
    }
}
