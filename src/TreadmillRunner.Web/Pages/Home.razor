    private void AppendLiveChartPoint(ActiveSessionSnapshot snapshot)
    {
        if (snapshot.Live.SessionState is not (SessionState.Running or SessionState.PausedWaitingForPhysicalResume)) return;
        var point = new LiveChartPoint(
            snapshot.Live.Elapsed,
            snapshot.PlannedSpeedKph,
            snapshot.RequestedSpeedKph,
            snapshot.Live.SpeedKph,
            snapshot.PlannedInclinePercent,
            snapshot.RequestedInclinePercent,
            snapshot.Live.InclinePercent);
        double planSpeedMaximum = snapshot.WorkoutPlan.Count == 0
            ? 0
            : snapshot.WorkoutPlan.Max(static item => item.SpeedKph ?? 0);
        double planInclineMaximum = snapshot.WorkoutPlan.Count == 0
            ? 0
            : snapshot.WorkoutPlan.Max(static item => item.InclinePercent ?? 0);
        double observedSpeed = Math.Max(point.PlannedSpeedKph ?? 0, Math.Max(point.RequestedSpeedKph, point.MeasuredSpeedKph));
        double observedIncline = Math.Max(point.PlannedInclinePercent ?? 0, Math.Max(point.RequestedInclinePercent, point.MeasuredInclinePercent));
        liveSpeedAxisMaximum = (int)Math.Ceiling(Math.Max(liveSpeedAxisMaximum, Math.Max(planSpeedMaximum, observedSpeed)));
        liveInclineAxisMaximum = (int)Math.Ceiling(Math.Max(liveInclineAxisMaximum, Math.Max(planInclineMaximum, observedIncline)));
        liveChartPoints.AppendOrReplace(point, static (previous, current) => (long)previous.Elapsed.TotalSeconds == (long)current.Elapsed.TotalSeconds);
    }

    private string BuildLiveMetricPath(Func<LiveChartPoint, double?> selector, int axisMaximum)
    {
        if (liveChartPoints.Count == 0) return string.Empty;
        IReadOnlyList<LiveChartPoint> points = RenderLiveChartPoints();
        var path = new StringBuilder();
        bool started = false;
        double previousY = 0;
        foreach (LiveChartPoint point in points)
        {
            if (selector(point) is not { } value)
            {
                started = false;
                continue;
            }
            double y = LiveChartY(value, axisMaximum);
            double x = ChartX(point.Elapsed);
            if (!started)
            {
                path.Append('M');
                path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
                path.Append(' ');
                path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
            }
            else
            {
                // Treat each sample as the value held until the next timestamp. This
                // keeps speed changes rectangular, matching the incline presentation,
                // instead of visually implying a gradual ramp between samples.
                path.Append(" L");
                path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
                path.Append(' ');
                path.Append(previousY.ToString("0.##", CultureInfo.InvariantCulture));
                if (Math.Abs(y - previousY) > 0.0001)
                {
                    path.Append(" L");
                    path.Append(x.ToString("0.##", CultureInfo.InvariantCulture));
                    path.Append(' ');
                    path.Append(y.ToString("0.##", CultureInfo.InvariantCulture));
                }
            }
            previousY = y;
            started = true;
        }

        return path.ToString();
    }

    private IReadOnlyList<LiveChartPoint> RenderLiveChartPoints()
    {
        if (renderedLiveChartVersion == liveChartPoints.Version) return renderedLiveChartPoints;

        IReadOnlyList<LiveChartPoint> points = liveChartPoints.Snapshot();
        const int maximumRenderedPoints = 720;
        if (points.Count <= maximumRenderedPoints)
        {
            renderedLiveChartVersion = liveChartPoints.Version;
            renderedLiveChartPoints = points;
            return renderedLiveChartPoints;
        }
        const int bucketCount = maximumRenderedPoints / 12;
        int bucketSize = (int)Math.Ceiling(points.Count / (double)bucketCount);
        var selected = new List<LiveChartPoint>(maximumRenderedPoints);
        for (int start = 0; start < points.Count; start += bucketSize)
        {
            LiveChartPoint[] bucket = points.Skip(start).Take(Math.Min(bucketSize, points.Count - start)).ToArray();
            var extrema = new List<LiveChartPoint>
            {
                bucket[0], bucket[^1],
                bucket.MinBy(static point => point.MeasuredSpeedKph)!, bucket.MaxBy(static point => point.MeasuredSpeedKph)!,
                bucket.MinBy(static point => point.RequestedSpeedKph)!, bucket.MaxBy(static point => point.RequestedSpeedKph)!,
                bucket.MinBy(static point => point.MeasuredInclinePercent)!, bucket.MaxBy(static point => point.MeasuredInclinePercent)!,
                bucket.MinBy(static point => point.RequestedInclinePercent)!, bucket.MaxBy(static point => point.RequestedInclinePercent)!,
            };
            LiveChartPoint[] planned = bucket.Where(static point => point.PlannedSpeedKph is not null).ToArray();
            if (planned.Length > 0)
            {
                extrema.Add(planned.MinBy(static point => point.PlannedSpeedKph)!);
                extrema.Add(planned.MaxBy(static point => point.PlannedSpeedKph)!);
            }
            LiveChartPoint[] plannedIncline = bucket.Where(static point => point.PlannedInclinePercent is not null).ToArray();
            if (plannedIncline.Length > 0)
            {
                extrema.Add(plannedIncline.MinBy(static point => point.PlannedInclinePercent)!);
                extrema.Add(plannedIncline.MaxBy(static point => point.PlannedInclinePercent)!);
            }
            int[] transitions = Enumerable.Range(1, bucket.Length - 1)
                .Where(index => bucket[index - 1].PlannedSpeedKph.HasValue != bucket[index].PlannedSpeedKph.HasValue)
                .ToArray();
            foreach (int transition in transitions.Length <= 2 ? transitions : new[] { transitions[0], transitions[^1] })
            {
                extrema.Add(bucket[transition - 1]);
                extrema.Add(bucket[transition]);
            }
            selected.AddRange(extrema.Distinct().OrderBy(static point => point.Elapsed));
        }
        renderedLiveChartVersion = liveChartPoints.Version;
        renderedLiveChartPoints = selected;
        return renderedLiveChartPoints;
    }

    private double ChartX(TimeSpan elapsed)
        => LiveChartTimeline.PositionX(elapsed, LiveChartDuration);

    private TimeSpan LiveChartDuration => LiveChartTimeline.ResolveDuration(
        session,
        LatestLiveChartPoint?.Elapsed ?? TimeSpan.Zero);
    private LiveChartPoint? LatestLiveChartPoint => liveChartPoints.Snapshot().LastOrDefault();
    private int LiveSpeedAxisMaximum => liveSpeedAxisMaximum;
    private int LiveInclineAxisMaximum => liveInclineAxisMaximum;
    private IEnumerable<int> LiveSpeedAxisTicks => Enumerable.Range(1, LiveSpeedAxisMaximum).Reverse();
    private IEnumerable<int> LiveInclineAxisTicks => Enumerable.Range(1, LiveInclineAxisMaximum).Reverse();
    private static double LiveChartY(double value, int axisMaximum) => 210 - (Math.Clamp(value / axisMaximum, 0, 1) * 200);
    private double LiveProgressX => ChartX(session?.Live.Elapsed ?? TimeSpan.Zero);
    private string LiveChartElapsedSeconds => (session?.Live.Elapsed.TotalSeconds ?? 0).ToString("0.###", CultureInfo.InvariantCulture);
    private string LiveChartDurationSeconds => LiveChartDuration.TotalSeconds.ToString("0.###", CultureInfo.InvariantCulture);
    private IReadOnlyList<LiveChartTimeTick> LiveChartTimeTicks
    {
        get
        {
            TimeSpan duration = LiveChartDuration;
            double minutes = duration.TotalMinutes;
            int intervalMinutes = LiveAxisIntervalMinutes(minutes);
            var ticks = new List<LiveChartTimeTick> { new(TimeSpan.Zero, 0) };
            for (double minute = intervalMinutes; minute < minutes; minute += intervalMinutes)
            {
                TimeSpan elapsed = TimeSpan.FromMinutes(minute);
                ticks.Add(new LiveChartTimeTick(elapsed, elapsed.TotalSeconds / Math.Max(1, duration.TotalSeconds) * 100));
            }
            if (ticks.Count > 1 && (duration - ticks[^1].Elapsed).TotalMinutes < intervalMinutes * .75) ticks.RemoveAt(ticks.Count - 1);
            if (duration > TimeSpan.Zero) ticks.Add(new LiveChartTimeTick(duration, 100));
            return ticks;
        }
    }
    private static string FormatChartAxisTime(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm", CultureInfo.InvariantCulture)
        : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    private static int LiveAxisIntervalMinutes(double durationMinutes)
    {
        double desired = durationMinutes / 5;
        return desired <= 1 ? 1 : desired <= 2 ? 2 : desired <= 5 ? 5 : desired <= 10 ? 10 : desired <= 15 ? 15 : 30;
    }

    private static string CheckClass(PreflightCheckStatus status) => status switch
    {
        PreflightCheckStatus.Ready => "check-ready",
        PreflightCheckStatus.NotRequired => "check-optional",
        _ => "check-waiting",
    };

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        startHoldCancellation?.Cancel();
        startHoldCancellation?.Dispose();
        preflightRefreshCancellation?.Cancel();
        preflightRefreshCancellation?.Dispose();
        preflightRefreshCancellation = null;
        profileSelectionCancellation?.Cancel();
        profileSelectionCancellation?.Dispose();
        Gateway.ConnectionChanged -= GatewayConnectionChanged;
        Gateway.SessionChanged -= GatewaySessionChanged;
        Gateway.LeaseChanged -= GatewayLeaseChanged;
        ActiveProfile.Changed -= ActiveProfileChanged;
        stopDecisionModalReference = null;
        await Task.CompletedTask;
    }

    private sealed record LiveChartPoint(
        TimeSpan Elapsed,
        double? PlannedSpeedKph,
        double RequestedSpeedKph,
        double MeasuredSpeedKph,
        double? PlannedInclinePercent,
        double RequestedInclinePercent,
        double MeasuredInclinePercent);

    private sealed record LiveChartTimeTick(TimeSpan Elapsed, double PositionPercent);

    private sealed record WorkoutChoice(
        Guid RevisionId,
        string Name,
        string? Description,
        string Context,
        string Stats,
        DateOnly SortDate,
        string SelectionSource = "Library",
        Guid? ProgramRunId = null,
        Guid? ProgramItemId = null);
}
