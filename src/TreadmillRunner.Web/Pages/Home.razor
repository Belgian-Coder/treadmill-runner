    private async Task StartProgramAsync(WorkoutProgramSummaryView program, bool restart)
    {
        if (selectedProfileId is not { } profileId) return;
        string action = restart ? "restart" : "start";
        WorkoutProgramSummaryView? active = programs.FirstOrDefault(static candidate => candidate.Run is { Status: "Active" });
        using HttpResponseMessage response = await Http.PostAsJsonAsync(
            $"api/planning/programs/{program.Id}/{action}",
            new WorkoutProgramStartRequest(Guid.NewGuid(), profileId, program.RevisionId, active?.Run?.Id, active?.Run?.Version,
                programScheduleStartDate, programScheduleWeekdayMask, "Europe/Brussels"));
        actionStatus = response.IsSuccessStatusCode ? $"{program.Name} started." : "The training plan could not be started.";
        if (!response.IsSuccessStatusCode)
        {
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                actionStatus = "The active plan changed in another browser. Review the latest progress and try again.";
                await ReloadCurrentProfilePlanningAsync();
            }
            return;
