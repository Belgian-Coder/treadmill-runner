    private void GatewaySessionChanged()
    {
        int? previousStepIndex = session?.CurrentStep?.Index;
        ActiveSessionSnapshot? incoming = Gateway.Current.Session;
        session = incoming;
        if (incoming is not null) AppendLiveChartPoint(incoming);
        _ = InvokeAsync(async () =>
        {
            if (incoming?.Live.SessionState is SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume)
            {
                Navigation.NavigateTo("/control", replace: true);
                return;
            }
            if (incoming is not null)
            {
                if (incoming.Live.SessionState == SessionState.Completed) actionStatus = "Run completed. Ready for the next run.";
                if (soundEnabled && cuePreferences.StepChanges && previousStepIndex is not null && incoming.CurrentStep?.Index != previousStepIndex)
                    await JS.InvokeVoidAsync("treadmillRunnerSound.playCue", cuePreferences.VolumePercent);
            }
            StateHasChanged();
        });
    }

