        .FirstOrDefault(static workout => string.Equals(workout.Kind, "ManualTemplate", StringComparison.Ordinal));
    private IReadOnlyList<WorkoutChoice> VisibleWorkoutChoices
    {
        get
        {
            IEnumerable<WorkoutChoice> choices = workoutSource switch
            {
                "scheduled" => ScheduledWorkoutChoices(),
                "programs" => ProgramWorkoutChoices(),
                _ => workouts.Where(static workout => !workout.IsArchived && !string.Equals(workout.Kind, "ManualTemplate", StringComparison.Ordinal)).Select(ChoiceFromSummary),
            };
            if (!string.IsNullOrWhiteSpace(workoutSearch))
            {
                choices = choices.Where(choice =>
                    choice.Name.Contains(workoutSearch, StringComparison.CurrentCultureIgnoreCase) ||
