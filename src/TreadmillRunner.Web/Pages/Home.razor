    private Task RequestStopAsync(bool openDecision)
    {
        CancelStartHold();
        if (isManualCommandPending)
        {
            stopRequestedDuringCommand = true;
            openDecisionAfterQueuedStop |= openDecision;
            actionStatus = "Stop requested — finishing the in-flight command, then sending one current-state Stop.";
            return InvokeAsync(StateHasChanged);
        }
        return SendCommandAsync(TreadmillCommandKind.Stop, openDecision);
    }

    private async Task RefreshAfterManualControlAsync(HttpResponseMessage response, string control)
    {
        if (!response.IsSuccessStatusCode)
        {
            actionStatus = $"The requested {control} could not be changed.";
            return;
        }

        using JsonDocument payload = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
        session = payload.RootElement.GetProperty("snapshot").Deserialize<ActiveSessionSnapshot>(
            new JsonSerializerOptions(JsonSerializerDefaults.Web));
        if (session is not null)
        {
            AppendLiveChartPoint(session);
            liveOverrideMarkers.Add(session.Live.Elapsed);
        }
        actionStatus = session?.LastCommandResult?.Reason ?? $"Requested {control} changed.";
    }

