    private async Task BeginStartHoldAsync()
    {
        if (!CanStart || startHoldCancellation is not null) return;
        startHoldCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = startHoldCancellation.Token;
        try
        {
            for (var remaining = 3; remaining > 0; remaining--)
            {
                startHoldSecondsRemaining = remaining;
                actionStatus = $"Keep holding — Start in {remaining}.";
                if (soundEnabled) await JS.InvokeVoidAsync("treadmillRunnerSound.playCue", cuePreferences.VolumePercent);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
            }

            startHoldSecondsRemaining = null;
            await SendCommandAsync(TreadmillCommandKind.Start);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            actionStatus = "Remote Start canceled before sending.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            actionStatus = "Gateway connection was interrupted. Manual controls are disabled while reconnecting.";
            await Gateway.RefreshAuthoritativeStateAsync();
        }
        finally
        {
            startHoldSecondsRemaining = null;
            startHoldCancellation?.Dispose();
            startHoldCancellation = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelStartHold()
    {
        startHoldCancellation?.Cancel();
    }

    private Task StopAsync() => RequestStopAsync(openDecision: true);
