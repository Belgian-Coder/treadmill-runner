    private async Task SendCommandAsync(TreadmillCommandKind kind, bool openDecision = false)
    {
        bool isStopCommand = kind == TreadmillCommandKind.Stop;
        if (isStopCommand ? isStopPending : isManualCommandPending || isStopPending) return;
        ActiveSessionSnapshot? currentSession = session;
        ControlLease? currentLease = lease;
        if (currentSession is null || currentLease is null) return;
        if (isStopCommand) isStopPending = true;
        else isManualCommandPending = true;
        string operation = kind switch
        {
            TreadmillCommandKind.Start => "start",
            _ => "stop",
        };
        actionStatus = $"Sending single-use {operation} command…";
        await InvokeAsync(StateHasChanged);
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/live/sessions/{operation}", new
            {
                operationId = Guid.NewGuid(),
                holderId,
                leaseId = currentLease.Id,
                expectedSessionVersion = currentSession.Version,
            });
            if (!response.IsSuccessStatusCode)
            {
                actionStatus = $"{kind} was rejected before a command could be confirmed.";
                return;
            }

            TreadmillCommandResult? result = await response.Content.ReadFromJsonAsync<TreadmillCommandResult>();
            actionStatus = result?.Disposition switch
            {
                TreadmillCommandDisposition.Confirmed => result.Reason,
                TreadmillCommandDisposition.Unknown => $"Unknown outcome: {result.Reason} Use physical Stop and inspect the treadmill.",
                _ => result?.Reason ?? $"{kind} was rejected.",
            };
            using HttpResponseMessage sessionResponse = await Http.GetAsync("api/live/session");
            if (sessionResponse.IsSuccessStatusCode)
            {
                session = await sessionResponse.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
            }
            if (isStopCommand && openDecision && result?.Disposition == TreadmillCommandDisposition.Confirmed &&
                session?.Live.SessionState == SessionState.PausedWaitingForPhysicalResume)
            {
                isStopDecisionOpen = true;
                openStopDecisionPending = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            if (isStopCommand) isStopPending = false;
            else await CompleteManualCommandAsync();
        }
    }

    private async Task CompleteManualCommandAsync()
    {
        isManualCommandPending = false;
        if (!stopRequestedDuringCommand) return;
        stopRequestedDuringCommand = false;
        bool openDecision = openDecisionAfterQueuedStop;
        openDecisionAfterQueuedStop = false;
        using HttpResponseMessage response = await Http.GetAsync("api/live/session");
        session = response.StatusCode == System.Net.HttpStatusCode.NoContent
            ? null
            : await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
        await SendCommandAsync(TreadmillCommandKind.Stop, openDecision);
    }

