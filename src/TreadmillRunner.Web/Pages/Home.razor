    private async Task ApplySessionDecisionAsync(string action, string successMessage, bool navigateHome)
    {
        if (sessionActionBusy || session is null || lease is null) return;
        sessionActionBusy = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/live/sessions/{action}", new { operationId = Guid.NewGuid(), holderId, leaseId = lease.Id, expectedSessionVersion = session.Version });
            if (!response.IsSuccessStatusCode) { actionStatus = "The session action was rejected."; return; }
            session = await response.Content.ReadFromJsonAsync<ActiveSessionSnapshot>();
