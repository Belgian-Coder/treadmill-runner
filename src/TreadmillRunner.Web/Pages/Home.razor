@page "/"
@using TreadmillRunner.Core.Workouts
@using TreadmillRunner.Core.Household

@using System.Globalization
@using System.Text
@using System.Text.Json

@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ActiveProfileState ActiveProfile
@inject ClientRuntimeState Runtime
@inject GatewayConnectionSupervisor Gateway

<PageTitle>TreadmillRunner</PageTitle>

<div class="runner-page">
    @if (session is not null && session.Live.SessionState is SessionState.Running or SessionState.PausedWaitingForPhysicalResume)
    {
        <header class="dashboard-header">
            <div><p class="eyebrow">Authoritative gateway</p><h1>Live run</h1></div>
            <span class="connection-state" role="status">@controlStatus · @session.Live.SessionState</span>
        </header>

        <section class="safety-banner" aria-label="Safety notice">
            <span class="safety-icon"><AppIcon Name="alert" /></span>
            <p><strong>Physical controls remain authoritative.</strong> Use the safety key or console Stop whenever browser control is unavailable or uncertain.</p>
        </section>

        @if (session.Warnings.Count > 0)
        {
            <section class="session-notices" aria-label="Session notices">
                @foreach (string warning in session.Warnings)
                {
                    <p role="status">@warning</p>
                }
            </section>
        }

        @if (session.LastCommandResult is { } commandResult)
        {
            <section class="command-result command-@commandResult.Disposition.ToString().ToLowerInvariant()" aria-live="assertive">
                <strong>@commandResult.Kind: @commandResult.Disposition</strong>
                <span>@commandResult.Reason</span>
                @if (CommandValuesLabel(commandResult) is { } commandValues)
                {
                    <span>@commandValues</span>
                }
                <span>Connection generation @commandResult.ConnectionGeneration</span>
            </section>
        }

        <section class="live-metric-grid">
            <article class="primary-metric live-metric live-metric--speed" aria-label="Measured speed"><p>Speed</p><strong>@session.Live.SpeedKph.ToString("0.0") <small>km/h</small></strong><span>Requested @session.RequestedSpeedKph.ToString("0.0") · planned @(session.PlannedSpeedKph?.ToString("0.0") ?? "open")</span></article>
            <article class="metric-card live-metric live-metric--heart" aria-label="Heart rate"><p>Heart rate</p><strong>@HeartRateValue <small>bpm</small></strong><span>@HeartRateTargetLabel</span></article>
            <article class="metric-card live-metric" aria-label="Measured incline"><p>Incline</p><strong>@session.Live.InclinePercent.ToString("0.0")<small>%</small></strong><span>Requested @session.RequestedInclinePercent.ToString("0.0") · planned @(session.PlannedInclinePercent?.ToString("0.0") ?? "open")</span></article>
            <article class="metric-card live-metric"><p>Workout</p><strong>@session.WorkoutElapsed.ToString(@"mm\:ss")</strong><span>@(session.Remaining?.ToString(@"mm\:ss") ?? "distance goal") remaining</span></article>
        </section>

        <section class="controls-card live-controls" aria-labelledby="run-controls-title" aria-busy="@(isManualCommandPending || isStopPending)">
            <div class="live-controls__heading">
                <div><p class="eyebrow">Direct control</p><h2 id="run-controls-title">Run controls</h2></div>
                <button class="sound-toggle" type="button" @onclick="ToggleSoundAsync" aria-pressed="@soundEnabled">Sound @(soundEnabled ? "on" : "off")</button>
            </div>
            <div class="adjustment-grid">
                <div class="adjustment-control" role="group" aria-label="Speed controls">
                    <button class="touch-action step-action" type="button" aria-label="Speed -0.1 km/h" @onclick="() => AdjustSpeedAsync(-0.1)" disabled="@(!CanAdjustSpeed)">−</button>
                    <div><span>Speed</span><strong>@session.RequestedSpeedKph.ToString("0.0") <small>km/h</small></strong><small>0.1 steps</small></div>
                    <button class="touch-action step-action primary-action" type="button" aria-label="Speed +0.1 km/h" @onclick="() => AdjustSpeedAsync(0.1)" disabled="@(!CanAdjustSpeed)">+</button>
                </div>
                <div class="adjustment-control" role="group" aria-label="Incline controls">
                    <button class="touch-action step-action" type="button" aria-label="Incline -0.5%" @onclick="() => AdjustInclineAsync(-0.5)" disabled="@(!CanAdjustIncline)">−</button>
                    <div><span>Incline</span><strong>@session.RequestedInclinePercent.ToString("0.0")<small>%</small></strong><small>0.5 steps</small></div>
                    <button class="touch-action step-action primary-action" type="button" aria-label="Incline +0.5%" @onclick="() => AdjustInclineAsync(0.5)" disabled="@(!CanAdjustIncline)">+</button>
                </div>
            </div>
            <div class="run-actions">
                @if (session.Live.SessionState == SessionState.PausedWaitingForPhysicalResume)
                {
                    <button class="touch-action primary-action hold-start-action media-control media-control--play" type="button" disabled="@(!CanStart)" @onpointerdown="BeginStartPointerHoldAsync" @onpointerup="CancelStartHold" @onpointerleave="CancelStartHold" @onpointercancel="CancelStartHold" @onkeydown="StartKeyDownAsync" @onkeyup="CancelStartHold" @onblur="CancelStartHold"><span class="media-control__icon"><AppIcon Name="play" /></span><span>@(startHoldSecondsRemaining is { } seconds ? $"Keep holding · {seconds}" : "Hold to resume")</span></button>
                }
                else
                {
                    <button class="touch-action pause-action media-control media-control--pause" type="button" @onclick="PauseAsync" disabled="@(!CanPause)"><span class="media-control__icon"><AppIcon Name="pause" /></span><span>Pause</span></button>
                }
                <button class="touch-action danger-action stop-action media-control media-control--stop" type="button" @onclick="StopAsync" disabled="@(!CanStop)"><span class="media-control__icon"><AppIcon Name="stop" /></span><span>Stop</span></button>
            </div>
            @if (session.HeartRateTarget is not null)
            {
                <details class="automation-panel">
                    <summary><span>Heart-rate speed control</span><strong>@AutomationLabel</strong></summary>
                    <div class="automation-modes" role="group" aria-label="Heart-rate speed control">
                        <button class="touch-action" type="button" aria-label="HR shadow" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Shadow)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Shadow)" disabled="@(!CanSetAutomation)">Monitor only</button>
                        <button class="touch-action" type="button" aria-label="HR decreases" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.DecreaseOnly)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.DecreaseOnly)" disabled="@(!CanSetSpeedAutomation)">Slow down only</button>
                        <button class="touch-action" type="button" aria-label="HR two-way" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Full)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Full)" disabled="@(!CanSetSpeedAutomation)">Full control</button>
                        <button class="touch-action" type="button" aria-label="HR off" aria-pressed="@(session.HeartRateAutomationMode == HeartRateAutomationMode.Disabled)" @onclick="() => SetAutomationAsync(HeartRateAutomationMode.Disabled)" disabled="@(!CanSetAutomation)">Off</button>
                    </div>
                    <p>HR automation: @session.HeartRateAutomationMode · @session.HeartRateAutomationReason</p>
                </details>
            }
            <span class="action-status" role="status">@actionStatus</span>
        </section>

        <section class="secondary-metrics" aria-label="Run totals">
            <div><span>Distance</span><strong>@session.Live.DistanceKilometers.ToString("0.00") km</strong></div>
            <div><span>Energy</span><strong>@Math.Round(session.Live.Elapsed.TotalMinutes * 9) kcal</strong></div>
            <div><span>Current step</span><strong>@CurrentStepLabel</strong></div>
            <div><span>Next</span><strong>@NextStepLabel</strong></div>
        </section>

        <details class="route-card workout-details" open="@(session.Live.SessionState != SessionState.Running)">
            <summary>
                <span><span class="eyebrow">Workout details</span><strong>@session.WorkoutTitle</strong></span>
                <span>Plan and live chart</span>
            </summary>
            <div class="chart-plot-grid chart-plot-grid--dual" aria-label="Live workout chart">
                <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@LiveSpeedAxisMaximum, 1fr)">
                    @foreach (int tick in LiveSpeedAxisTicks)
                    {
                        <span>@tick</span>
                    }
                </div>
                <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Planned, requested, and measured speed and incline">
                    @foreach (int tick in LiveSpeedAxisTicks)
                    {
                        double y = LiveChartY(tick, LiveSpeedAxisMaximum);
                        <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                    }
                    <path class="chart-plan" data-series="planned-speed" d="@BuildLiveMetricPath(static point => point.PlannedSpeedKph, LiveSpeedAxisMaximum)" />
                    <path class="chart-requested" data-series="requested-speed" d="@BuildLiveMetricPath(static point => point.RequestedSpeedKph, LiveSpeedAxisMaximum)" />
                    <path class="chart-current" data-series="measured-speed" d="@BuildLiveMetricPath(static point => point.MeasuredSpeedKph, LiveSpeedAxisMaximum)" />
                    <path class="chart-plan chart-plan--incline" data-series="planned-incline" d="@BuildLiveMetricPath(static point => point.PlannedInclinePercent, LiveInclineAxisMaximum)" />
                    <path class="chart-requested chart-requested--incline" data-series="requested-incline" d="@BuildLiveMetricPath(static point => point.RequestedInclinePercent, LiveInclineAxisMaximum)" />
                    <path class="chart-current chart-current--incline" data-series="measured-incline" d="@BuildLiveMetricPath(static point => point.MeasuredInclinePercent, LiveInclineAxisMaximum)" />
                    @foreach (TimeSpan marker in liveOverrideMarkers)
                    {
                        double markerX = ChartX(marker);
                        <line class="chart-event-marker" x1="@markerX" x2="@markerX" y1="10" y2="210" />
                    }
                    <line class="chart-cursor" x1="@LiveProgressX" x2="@LiveProgressX" y1="10" y2="210" data-elapsed-seconds="@LiveChartElapsedSeconds" data-duration-seconds="@LiveChartDurationSeconds" />
                    @if (LatestLiveChartPoint is { } latest)
                    {
                        <circle class="chart-marker" cx="@ChartX(latest.Elapsed)" cy="@LiveChartY(latest.MeasuredSpeedKph, LiveSpeedAxisMaximum)" r="5" />
                    }
                </svg>
                <div class="chart-y-scale chart-y-scale--ticks chart-y-scale--secondary" aria-label="Incline axis in percent" style="grid-template-rows: repeat(@LiveInclineAxisMaximum, 1fr)">
                    <strong class="chart-axis-unit">%</strong>
                    @foreach (int tick in LiveInclineAxisTicks)
                    {
                        <span>@tick</span>
                    }
                </div>
                <div></div>
                <div class="chart-time-scale" aria-label="Elapsed time axis" data-midpoint="@FormatChartAxisTime(TimeSpan.FromTicks(LiveChartDuration.Ticks / 2))">
                    @foreach (LiveChartTimeTick tick in LiveChartTimeTicks)
                    {
                        <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatChartAxisTime(tick.Elapsed)</span>
                    }
                </div>
                <div></div>
            </div>
            <div class="control-chart-legend" aria-label="Live chart legend">
                <span class="control-chart-legend__group" aria-label="Speed legend"><strong>Speed</strong><span><i class="legend-line legend-line--plan" aria-hidden="true"></i>Planned</span><span><i class="legend-line legend-line--requested" aria-hidden="true"></i>Requested</span><span><i class="legend-line legend-line--measured" aria-hidden="true"></i>Measured</span></span>
                <span class="control-chart-legend__group" aria-label="Incline legend"><strong>Incline</strong><span><i class="legend-line legend-line--plan legend-line--incline-plan" aria-hidden="true"></i>Planned</span><span><i class="legend-line legend-line--requested legend-line--incline-target" aria-hidden="true"></i>Requested</span><span><i class="legend-line legend-line--measured legend-line--incline-measured" aria-hidden="true"></i>Measured</span></span>
            </div>
        </details>
    }
    else if (session?.Live.SessionState == SessionState.ArmedWaitingForPhysicalStart)
    {
        <header class="dashboard-header">
            <div><p class="eyebrow">Run prepared</p><h1>Ready at the treadmill</h1></div>
            <span class="connection-state" role="status">@controlStatus · @session.Live.SessionState</span>
        </header>

        <section class="safety-banner" aria-label="Remote start safety notice">
            <span class="safety-icon"><AppIcon Name="alert" /></span>
            <p><strong>Confirm the belt is clear and wear the safety key.</strong> The physical Stop remains authoritative. Never rely on Bluetooth disconnect to stop the belt.</p>
        </section>

        <section class="controls-card start-card" aria-labelledby="start-title">
            <div>
                <p class="eyebrow">Single-use command</p>
                <h2 id="start-title">Start at @(session.MinimumStartSpeedKph?.ToString("0.0") ?? "—") km/h</h2>
                @if (session.CanStartRemotely)
                {
                    <p>Press and hold for three seconds. Releasing, moving away, or pressing Escape cancels before the command is sent.</p>
                }
                else
                {
                    <p>Remote Start is unavailable until this exact model and firmware pass the hardware gate. Start from the physical console.</p>
                }
            </div>
            <button class="touch-action primary-action hold-start-action media-control media-control--play"
                    type="button"
                    disabled="@(!CanStart)"
                    aria-describedby="start-hold-status"
                    @onpointerdown="BeginStartPointerHoldAsync"
                    @onpointerup="CancelStartHold"
                    @onpointerleave="CancelStartHold"
                    @onpointercancel="CancelStartHold"
                    @onkeydown="StartKeyDownAsync"
                    @onkeyup="CancelStartHold"
                    @onblur="CancelStartHold">
                <span class="media-control__icon"><AppIcon Name="play" /></span><span>@(startHoldSecondsRemaining is { } seconds ? $"Keep holding · {seconds}" : "Hold to start")</span>
            </button>
            <button class="touch-action danger-action media-control media-control--stop" type="button" @onclick="StopAsync" disabled="@(!CanStop)"><span class="media-control__icon"><AppIcon Name="stop" /></span><span>Stop</span></button>
            <span id="start-hold-status" class="action-status" role="status">@actionStatus</span>
        </section>

        @if (session.LastCommandResult is { } armedResult)
        {
            <section class="command-result command-@armedResult.Disposition.ToString().ToLowerInvariant()" aria-live="assertive">
                <strong>@armedResult.Kind: @armedResult.Disposition</strong>
                <span>@armedResult.Reason</span>
            </section>
        }
    }
    else
    {
        <header class="dashboard-header">
            <div><p class="eyebrow">Today</p><h1>Ready to run</h1></div>
            <span class="connection-state" role="status">@connectionStatus</span>
        </header>

        <section class="safety-banner" aria-label="Safety notice">
            <span class="safety-icon"><AppIcon Name="alert" /></span>
            <p><strong>Safety key and physical Stop required.</strong><span class="desktop-safety-detail"> Remote Start appears only for an exact model and firmware with hardware-verified capability; otherwise use the physical console.</span></p>
        </section>

        @if (maintenance?.IsDue == true)
        {
            <aside class="maintenance-advisory" role="status">
                <p><strong>Treadmill maintenance is due.</strong> This reminder is informational and does not block your run.</p>
                <a class="secondary-action compact-action" href="/devices">Review maintenance</a>
            </aside>
        }

        @if (quickStart?.Suggestion is { RequiresConfirmation: true, SuggestedProfileId: { } suggested } && suggested != selectedProfileId)
        {
            <aside class="maintenance-advisory" role="status" aria-labelledby="quick-start-title">
                <p id="quick-start-title"><strong>Is @QuickStartProfileName running?</strong> A fresh assigned heart-rate sensor matches this runner. Nothing changes until you confirm.</p>
                <button class="secondary-action compact-action" type="button" @onclick="() => ConfirmQuickStartAsync(suggested)">Use @QuickStartProfileName and review run</button>
            </aside>
        }

        <section class="preflight-grid">
            <article class="selection-card">
                <p class="eyebrow">Choose today’s run</p>
                @if (profileSelectionLoading && selectedProfileId is not null)
                {
                    <section class="next-run-card" aria-label="Loading runner plan" aria-busy="true">
                        <span class="next-run-card__icon"><AppIcon Name="calendar" /></span>
                        <span class="next-run-card__copy"><small>Runner selected</small><strong>Loading @SelectedProfileName’s plan</strong><span>Refreshing workouts and pre-run checks for this runner…</span></span>
                    </section>
                }
                else if (selectedProfileId is not null)
                {
                    <section class="next-run-card" aria-label="Recommended next run">
                        <span class="next-run-card__icon"><AppIcon Name="arrow-right" /></span>
                        <span class="next-run-card__copy">
                            <small>Next for @SelectedProfileName</small>
                            @if (CalendarNeedsChoice)
                            {
                                <strong>Choose today’s calendar workout</strong>
                                <span>More than one option is scheduled today.</span>
                            }
                            else if (RecommendedChoice is { } recommendation)
                            {
                                <strong>@recommendation.Name</strong>
                                <span>@recommendation.Context · @recommendation.Stats</span>
                            }
                            else
                            {
                                <strong>Manual run</strong>
                                <span>Control speed and incline as you go.</span>
                            }
                        </span>
                        @if (!CalendarNeedsChoice && RecommendedChoice is { } recommended)
                        {
                            <button class="primary-action compact-action" type="button" @onclick="() => SelectWorkoutAsync(recommended)">Choose</button>
                        }
                    </section>

                    @if (RecentReusableRuns.Count > 0)
                    {
                        <details class="quick-reuse" aria-label="Reuse a recent workout">
                            <summary>Run a recent workout again</summary>
                            <div class="quick-reuse__list">
                                @foreach (WorkoutReuseView recent in RecentReusableRuns.Take(3))
                                {
                                    <button class="quick-reuse__button" type="button"
                                        aria-pressed="@(selectedRevisionId == recent.WorkoutRevisionId ? "true" : "false")"
                                        @onclick="() => SelectRecentWorkoutAsync(recent)">
                                        <span><strong>@recent.Name</strong><small>@recent.LastCompletedAtUtc.ToLocalTime().ToString("d MMM")</small></span>
                                        <small>@recent.LastActualDuration.ToString(@"h\:mm\:ss") · completed @recent.CompletionCount×</small>
                                    </button>
                                }
                            </div>
                        </details>
                    }
                }
                else
                {
                    <section class="next-run-card" aria-label="Runner required">
                        <span class="next-run-card__icon"><AppIcon Name="runner" /></span>
                        <span class="next-run-card__copy"><small>Runner required</small><strong>Choose who is running</strong><span>Use the runner control in the navigation bar. The app remembers it.</span></span>
                    </section>
                }

                <details class="choose-another-run">
                    <summary><span><strong>Other workout</strong><small>Manual, calendar, plan, or library</small></span><AppIcon Name="chevron-down" /></summary>
                    <div class="choose-another-run__content">
                <section class="workout-picker" aria-label="Choose workout">
                    <div class="workout-picker__heading"><strong>Workout</strong><span>@VisibleWorkoutChoices.Count available</span></div>
                    <button class="workout-choice-card workout-choice-card--manual" type="button"
                            aria-pressed="@(ManualWorkout is { } manual && selectedRevisionId == manual.CurrentRevisionId ? "true" : "false")"
                            @onclick="SelectManualRunAsync">
                        <span><strong>Manual run</strong><small>No preset</small></span>
                        <span>Start with the treadmill minimum and control speed and incline yourself.</span>
                        <small>Up to 4 hours · no planned intervals</small>
                    </button>
                    <div class="workout-source-tabs" role="group" aria-label="Workout source">
                        <button type="button" aria-pressed="@(workoutSource == "scheduled" ? "true" : "false")" @onclick='() => workoutSource = "scheduled"'>Calendar</button>
                        <button type="button" aria-pressed="@(workoutSource == "programs" ? "true" : "false")" @onclick='() => workoutSource = "programs"'>Training plans</button>
                        <button type="button" aria-pressed="@(workoutSource == "library" ? "true" : "false")" @onclick='() => workoutSource = "library"'>All workouts</button>
                    </div>
                    <label class="field">Search workouts
                        <input type="search" @bind="workoutSearch" @bind:event="oninput" placeholder="Title or description" />
                    </label>
                    <div class="workout-choice-list">
                        @if (workoutSource == "programs")
                        {
                            @if (FilteredProgramChoices.Count == 0)
                            {
                                <p class="empty-state">No training plans match this view.</p>
                            }
                            @foreach (WorkoutProgramSummaryView program in FilteredProgramChoices)
                            {
                                <article class="run-program-card">
                                    <span><strong>@program.Name</strong><small>@program.Category · @program.CompletedItemCount/@program.ItemCount complete</small></span>
                                    @if (program.Run is not null && ProgramChoice(program) is { } nextChoice)
                                    {
                                        <button class="secondary-action compact-action" type="button" @onclick="() => SelectWorkoutAsync(nextChoice)">Next workout</button>
                                    }
                                    else
                                    {
                                        <button class="secondary-action compact-action" type="button" @onclick="() => RequestProgramStart(program, program.Run is not null)">@(program.Run is null ? "Start plan" : "Restart plan")</button>
                                    }
                                    @if (pendingProgramStart is { } pending && pending.Program.Id == program.Id)
                                    {
                                        <section class="program-start-confirm" role="alertdialog" aria-labelledby="run-program-start-confirm-title">
                                            <strong id="run-program-start-confirm-title">@(pending.Restart ? $"Restart {program.Name} for {SelectedProfileName}?" : $"Start {program.Name} for {SelectedProfileName}?")</strong>
                                            <p>@ProgramStartWarning(pending)</p>
                                            <div class="program-schedule-fields">
                                                <label class="field">First training date
                                                    <input type="date" @bind="programScheduleStartDate" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                                                </label>
                                                <fieldset class="program-training-days">
                                                    <legend>Choose exactly @RequiredTrainingDays training day(s)</legend>
                                                    <div>
                                                        @foreach ((string label, int flag) in ScheduleWeekdays)
                                                        {
                                                            <button type="button" aria-pressed="@((programScheduleWeekdayMask & flag) != 0)"
                                                                    class="@((programScheduleWeekdayMask & flag) != 0 ? "is-selected" : null)"
                                                                    @onclick="() => ToggleProgramWeekday(flag)">@label</button>
                                                        }
                                                    </div>
                                                </fieldset>
                                                <p class="field-help">The plan stays in order and appears only on @SelectedProfileName’s calendar.</p>
                                            </div>
                                            <div class="card-actions">
                                                <button class="secondary-action compact-action" type="button" @onclick="CancelProgramStart">Cancel</button>
                                                <button class="primary-action compact-action" type="button" disabled="@(!CanConfirmProgramSchedule)" @onclick="ConfirmProgramStartAsync">@ProgramStartConfirmLabel(pending)</button>
                                            </div>
                                        </section>
                                    }
                                </article>
                            }
                        }
                        else if (VisibleWorkoutChoices.Count == 0)
                        {
                            <p class="empty-state">@(workoutSource == "scheduled" ? "Nothing is scheduled in the next 31 days. Try All workouts." : "No workouts match this view.")</p>
                        }
                        else
                        {
                            @foreach (WorkoutChoice choice in VisibleWorkoutChoices.Take(40))
                            {
                                <button class="workout-choice-card" type="button"
                                        aria-pressed="@(selectedRevisionId == choice.RevisionId ? "true" : "false")"
                                        @onclick="() => SelectWorkoutAsync(choice)">
                                    <span><strong>@choice.Name</strong><small>@choice.Context</small></span>
                                    <span>@(string.IsNullOrWhiteSpace(choice.Description) ? "No description" : choice.Description)</span>
                                    <small>@choice.Stats</small>
                                </button>
                            }
                        }
                    </div>
                </section>
                    </div>
                    </details>
                <dl class="selection-summary" aria-busy="@profileSelectionLoading">
                    <div><dt>Selected runner</dt><dd aria-label="Selected runner">@SelectedProfileName</dd></div>
                    <div><dt>Selected workout</dt><dd aria-label="Selected workout">@(profileSelectionLoading ? "Loading…" : SelectedWorkoutName)</dd></div>
                    <div><dt>Expected</dt><dd>@(profileSelectionLoading ? "Loading…" : ExpectedDuration)</dd></div>
                    <div><dt>Intensity</dt><dd>@(profileSelectionLoading ? "Loading…" : preflight?.IntensityLabel ?? "Select a workout")</dd></div>
                </dl>
                <div class="preflight-actions">
                    <p>Only one screen can control the treadmill at a time.</p>
                    <button class="primary-action touch-action" type="button" @onclick="PrepareSelectedRunAsync" disabled="@(!CanTakeControl)">Prepare run</button>
                    <span role="status" class="action-status">@actionStatus</span>
                </div>
            </article>

            <details class="readiness-card" open aria-busy="@profileSelectionLoading">
                <summary><span>Pre-run checks</span><strong>@(preflight is null ? "Select a run" : preflight.IsReady ? "Ready" : "Needs attention")</strong></summary>
                @if (profileSelectionLoading)
                {
                    <p class="empty-state" role="status">Loading checks for @SelectedProfileName…</p>
                }
                else if (preflight is { } readiness)
                {
                    <div class="weekly-summary readiness-summary" aria-label="Readiness levels">
                        <article><span>Safe to record</span><strong>@(CanRecord(readiness) ? "Ready" : "Blocked")</strong></article>
                        <article><span>Manual control</span><strong>@(CanUseManualControl(readiness) ? "Ready" : "Unavailable")</strong></article>
                        <article><span>Planned automation</span><strong>@(CanUsePlannedAutomation(readiness) ? "Ready" : "Unavailable")</strong></article>
                    </div>
                    <p class="field-hint">These checks never start the treadmill or send a motion command. Physical controls remain authoritative.</p>
                }
                <ul class="readiness-list">
                    @foreach (PreflightCheck check in preflight?.Checks ?? Array.Empty<PreflightCheck>())
                    {
                        <li class="@CheckClass(check.Status)"><strong>@check.Label</strong><span>@check.Detail</span></li>
                    }
                </ul>
                @if (preflight?.TargetEvaluations.Any(static target => target.Disposition != WorkoutTargetDisposition.Accepted) == true)
                {
                    <details class="target-evaluations" open="@(preflight.TargetEvaluations.Any(static target => target.Disposition == WorkoutTargetDisposition.Rejected))">
                        <summary>Target adjustments</summary>
                        <ul class="readiness-list">
                            @foreach (WorkoutTargetEvaluation target in preflight.TargetEvaluations.Where(static target => target.Disposition != WorkoutTargetDisposition.Accepted))
                            {
                                <li class="@(target.Disposition == WorkoutTargetDisposition.Rejected ? "check-blocked" : "check-ready")">
                                    <strong>@target.Path</strong>
                                    <span>Requested @target.Requested.ToString("0.0") · @(target.Normalized is { } normalized ? $"normalized {normalized:0.0}" : "rejected") · @target.Reason</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (!profileSelectionLoading && preflight is null)
                {
                    <p class="empty-state">Select a runner and workout to check readiness.</p>
                }
            </details>
        </section>

    }
</div>

@if (isStopDecisionOpen)
{
    <DetailSheet BackdropId="home-stop-decision-backdrop" BackdropClass="workout-details-backdrop" CssClass="workout-details-dialog stop-decision-dialog" LabelledBy="home-stop-decision-title" OnDismiss="KeepSessionPausedAsync">
        <header class="workout-details-header"><div><p class="eyebrow">Treadmill stopped</p><h2 id="home-stop-decision-title">What should happen to this session?</h2></div><button class="icon-action" type="button" aria-label="Keep session paused" autofocus @onclick="KeepSessionPausedAsync"><AppIcon Name="close" /></button></header>
        <p>The belt is stopped. Your recording and workout progress are still preserved.</p>
        <div class="stop-decision-actions"><button class="secondary-action" type="button" disabled="@sessionActionBusy" @onclick="KeepSessionPausedAsync"><strong>Keep paused</strong><span>Return to the run and resume later.</span></button><button class="secondary-action" type="button" disabled="@sessionActionBusy" @onclick="ResetWorkoutProgressAsync"><strong>Reset progress</strong><span>Go back to the first step. Recording totals stay intact.</span></button><button class="danger-action" type="button" disabled="@sessionActionBusy" @onclick="EndSessionAsync"><strong>End and save</strong><span>Finish this session and keep it in History.</span></button></div>
    </DetailSheet>
}

@code {
