    private async Task RefreshPreflightAsync()
    {
        preflightRefreshCancellation?.Cancel();
        preflightRefreshCancellation?.Dispose();
        preflightRefreshCancellation = null;
        if (selectedProfileId is not { } profileId || selectedRevisionId is not { } revisionId)
        {
            preflight = null;
            actionStatus = "Select a runner and workout.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        int profileGeneration = profileSelectionGeneration;
        int workoutGeneration = workoutSelectionGeneration;
        var refresh = new CancellationTokenSource();
        preflightRefreshCancellation = refresh;
        try
        {
            var successfulPolls = 0;
            var transientFailures = 0;
            while (true)
            {
                PreflightSnapshot? loaded;
                try
                {
                    loaded = await Http.GetFromJsonAsync<PreflightSnapshot>(
                        $"api/live/preflight?profileId={profileId}&workoutRevisionId={revisionId}",
                        refresh.Token);
                }
                catch (OperationCanceledException) when (refresh.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
                {
                    if (!IsCurrentPreflightSelection(profileGeneration, profileId, workoutGeneration, revisionId)) return;
                    transientFailures++;
                    actionStatus = transientFailures < 4
                        ? "Reconnecting pre-run checks…"
                        : "Pre-run checks are unavailable. Retrying…";
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(
                        transientFailures < 4 ? TimeSpan.FromSeconds(1) : TimeSpan.FromSeconds(5),
                        refresh.Token);
                    continue;
                }
                if (!IsCurrentPreflightSelection(profileGeneration, profileId, workoutGeneration, revisionId)) return;
                if (loaded is not null && (loaded.UserProfileId != profileId || loaded.WorkoutRevisionId != revisionId))
                    throw new JsonException("The preflight response did not match the selected runner and workout.");
                transientFailures = 0;
                successfulPolls++;
                preflight = loaded;
                if (loaded?.IsReady == true)
                {
                    actionStatus = "Gateway ready — take control when you are prepared.";
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                actionStatus = successfulPolls < 12
                    ? "Connecting the devices needed for this run…"
                    : "Some pre-run checks are still waiting. Retrying in the background…";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(
                    successfulPolls < 12 ? TimeSpan.FromSeconds(1) : TimeSpan.FromSeconds(5),
                    refresh.Token);
            }
        }
        catch (OperationCanceledException) when (refresh.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            if (IsCurrentPreflightSelection(profileGeneration, profileId, workoutGeneration, revisionId))
            {
                preflight = null;
                actionStatus = "Pre-run checks are temporarily unavailable. Try selecting the workout again.";
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            if (ReferenceEquals(preflightRefreshCancellation, refresh))
                preflightRefreshCancellation = null;
            refresh.Dispose();
        }
    }

