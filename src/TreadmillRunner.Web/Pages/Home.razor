    private IReadOnlyList<WorkoutProgramSummaryView> FilteredProgramChoices => programs
        .Where(program => string.IsNullOrWhiteSpace(workoutSearch) ||
            program.Name.Contains(workoutSearch, StringComparison.CurrentCultureIgnoreCase) ||
            (program.Description?.Contains(workoutSearch, StringComparison.CurrentCultureIgnoreCase) ?? false))
        .OrderBy(static program => program.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
    private IReadOnlyList<WorkoutReuseView> RecentReusableRuns => reusableWorkouts;
    private IReadOnlyList<CalendarOptionView> TodayCalendarOptions => planningCalendar?.Days
        .FirstOrDefault(day => day.Date == DateOnly.FromDateTime(DateTime.Today))?.Options ?? [];
    private bool CalendarNeedsChoice => TodayCalendarOptions.Count > 1 && TodayCalendarOptions.All(static option => !option.IsSelected);
    private WorkoutChoice? RecommendedChoice
    {
        get
        {
            CalendarOptionView? calendar = TodayCalendarOptions.FirstOrDefault(static option => option.IsSelected) ??
                (TodayCalendarOptions.Count == 1 ? TodayCalendarOptions[0] : null);
            if (calendar is not null)
            {
                WorkoutSummaryView? summary = workouts.FirstOrDefault(workout => workout.CurrentRevisionId == calendar.WorkoutRevisionId);
                string context = calendar.Source == "Program"
                    ? $"{calendar.ScheduleName} · workout {calendar.ProgramPosition} of {calendar.ProgramTotal}"
                    : "Today’s calendar";
                return new WorkoutChoice(
                    calendar.WorkoutRevisionId,
                    calendar.WorkoutName,
                    summary?.Description,
                    context,
                    calendar.Source == "Program" ? ProgramCalendarStats(calendar) : SummaryStats(summary, calendar.RevisionNumber),
                    DateOnly.FromDateTime(DateTime.Today),
                    calendar.Source == "Program" && !calendar.IsRepeat ? "Program" : "Calendar",
                    calendar.IsRepeat ? null : calendar.ProgramRunId,
                    calendar.IsRepeat ? null : calendar.ProgramItemId);
            }
            if (CalendarNeedsChoice) return null;
            WorkoutProgramSummaryView? active = programs.FirstOrDefault(static program => program.Run is not null && !program.IsComplete && program.NextItemId is not null);
            if (active is not null) return ProgramChoice(active);
            if (RecentReusableRuns.FirstOrDefault() is { } recent) return ChoiceFromReuse(recent);
            return ManualWorkout is { } manual ? ChoiceFromSummary(manual) with { Context = "Manual fallback", SelectionSource = "Manual" } : null;
        }
    }
    private string ExpectedDuration => preflight?.ExpectedDuration?.ToString(@"hh\:mm\:ss") ?? "—";
    private bool ClientReady => Runtime.IsConnected && !Runtime.UpdateRequired && liveStateConnected && Gateway.Current.ControlsBlockedReason is null;
    private bool CanTakeControl => ClientReady && preflight?.IsReady == true;
    private static bool CanRecord(PreflightSnapshot value) => value.UserProfileId != Guid.Empty && value.WorkoutRevisionId != Guid.Empty;
    private static bool CanUseManualControl(PreflightSnapshot value) => value.IsReady && value.CanStopRemotely && (value.CanSetSpeedRemotely || value.CanSetInclineRemotely);
    private static bool CanUsePlannedAutomation(PreflightSnapshot value) => value.IsReady && value.CanSetSpeedRemotely && value.CanSetInclineRemotely && value.TargetEvaluations.All(static target => target.Disposition != WorkoutTargetDisposition.Rejected);
    private bool CanArm => ClientReady && lease is not null && preflight?.IsReady == true;
    private bool CanStart => ClientReady && lease is not null && session is
    {
        CanStartRemotely: true,
        Live.SessionState: SessionState.ArmedWaitingForPhysicalStart or SessionState.PausedWaitingForPhysicalResume,
    };
    private bool CanStop => ClientReady && !isStopPending && lease is not null && session?.CanStopRemotely == true && session.Live.SessionState is
        SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume;
    private bool CanAdjustSpeed => ClientReady && !isManualCommandPending && lease is not null && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetSpeedRemotely);
    private bool CanAdjustIncline => ClientReady && !isManualCommandPending && lease is not null && session?.Live.SessionState == SessionState.Running &&
        (session.HeartRateSource == HeartRateSource.Simulated || session.CanSetInclineRemotely);
    private bool CanPause => ClientReady && !isManualCommandPending && lease is not null && session?.CanStopRemotely == true &&
        session.Live.SessionState == SessionState.Running;
    private bool CanSetAutomation => ClientReady && !isManualCommandPending && lease is not null &&
        session?.Live.SessionState == SessionState.Running;
    private bool CanSetSpeedAutomation => CanSetAutomation && session?.CanSetSpeedRemotely == true;
    private string CurrentStepLabel => session?.CurrentStep is { } step ? $"{step.Index + 1} of {step.TotalStepCount}" : "Complete";
    private string NextStepLabel => session?.NextStep is { } step ? $"Step {step.Index + 1}" : "Finish";
    private string HeartRateTargetLabel => session?.HeartRateTarget is { } target
        ? $"Target {target.MinimumBpm?.ToString() ?? "—"}–{target.MaximumBpm?.ToString() ?? "—"} bpm"
        : "No HR target";
    private string HeartRateValue => session?.Live.HeartRateBpm?.ToString(CultureInfo.InvariantCulture) ?? "—";
    private string AutomationLabel => session?.HeartRateAutomationMode switch
    {
        HeartRateAutomationMode.Disabled => "Off",
        HeartRateAutomationMode.Shadow => "Monitor only",
        HeartRateAutomationMode.DecreaseOnly => "Slow down only",
        HeartRateAutomationMode.Full => "Full control",
        HeartRateAutomationMode.SuspendedManualOverride => "Paused after manual change",
        HeartRateAutomationMode.SuspendedSafety => "Paused for safety",
        _ => "Unavailable",
    };

    protected override async Task OnInitializedAsync()
    {
        soundEnabled = string.Equals(
            await JS.InvokeAsync<string?>("localStorage.getItem", SoundStorageKey),
            "true",
            StringComparison.OrdinalIgnoreCase);
        Gateway.ConnectionChanged += GatewayConnectionChanged;
        Gateway.SessionChanged += GatewaySessionChanged;
        Gateway.LeaseChanged += GatewayLeaseChanged;
        ActiveProfile.Changed += ActiveProfileChanged;
        try
        {
            await Gateway.EnsureStartedAsync();
            await ReloadRunSelectionDataAsync();
            session = Gateway.Current.Session;
            if (session is not null)
            {
                AppendLiveChartPoint(session);
                if (session.Live.SessionState is SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume)
                {
                    Navigation.NavigateTo("/control", replace: true);
                    return;
                }
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            actionStatus = "Gateway unavailable; reconnecting automatically.";
        }
    }

    private async Task ReloadRunSelectionDataAsync()
    {
        try
        {
            using HttpResponseMessage maintenanceResponse = await Http.GetAsync("api/devices/treadmill/maintenance");
            maintenance = maintenanceResponse.StatusCode == System.Net.HttpStatusCode.NoContent
                ? null
                : await maintenanceResponse.Content.ReadFromJsonAsync<TreadmillMaintenanceSnapshot>();
        }
        catch (JsonException) { maintenance = null; }
        profiles = await Http.GetFromJsonAsync<ProfileView[]>("api/planning/profiles") ?? Array.Empty<ProfileView>();
        workouts = await Http.GetFromJsonAsync<WorkoutSummaryView[]>("api/planning/workouts") ?? Array.Empty<WorkoutSummaryView>();
        quickStart = await Http.GetFromJsonAsync<QuickStartView>("api/local-first/quick-start");
        selectedProfileId = await ActiveProfile.GetAsync();
        await ApplyProfileSelectionAsync(selectedProfileId, announce: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Gateway.EnsureStartedAsync();
        if (openStopDecisionPending && isStopDecisionOpen)
        {
            openStopDecisionPending = false;
            stopDecisionModalReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("treadmillRunnerView.openModal", "home-stop-decision-backdrop", stopDecisionModalReference);
        }
    }

    private async Task SelectProfileAsync(Guid profileId)
    {
        if (session?.Live.SessionState is SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume)
            return;

        await ActiveProfile.SetAsync(profileId);
    }

    private void ActiveProfileChanged(Guid? profileId)
    {
        if (disposed) return;
        _ = InvokeAsync(() => ApplyProfileSelectionAsync(profileId, announce: true));
    }

    private bool IsCurrentProfileSelection(int generation, Guid? profileId) =>
        !disposed && generation == profileSelectionGeneration && selectedProfileId == profileId;

    private bool IsCurrentWorkoutSelection(int profileGeneration, Guid? profileId, int workoutGeneration, Guid revisionId) =>
        IsCurrentProfileSelection(profileGeneration, profileId) &&
        workoutSelectionGeneration == workoutGeneration &&
        selectedRevisionId == revisionId;

    private bool IsCurrentPreflightSelection(int profileGeneration, Guid profileId, int workoutGeneration, Guid revisionId) =>
        IsCurrentWorkoutSelection(profileGeneration, profileId, workoutGeneration, revisionId);

    private async Task ApplyProfileSelectionAsync(Guid? profileId, bool announce)
    {
        if (session?.Live.SessionState is SessionState.ArmedWaitingForPhysicalStart or SessionState.Running or SessionState.PausedWaitingForPhysicalResume)
            return;

        int generation = ++profileSelectionGeneration;
        int selectionGeneration = ++workoutSelectionGeneration;
        profileSelectionCancellation?.Cancel();
        profileSelectionCancellation?.Dispose();
        profileSelectionCancellation = new CancellationTokenSource();
        CancellationTokenSource selectionCancellation = profileSelectionCancellation;
        CancellationToken cancellationToken = selectionCancellation.Token;

        selectedProfileId = profileId;
        selectedRevisionId = null;
        selectedWorkoutLabel = null;
        selectedWorkoutSource = "Library";
        selectedProgramRunId = null;
        selectedProgramItemId = null;
        preflightRefreshCancellation?.Cancel();
        preflightRefreshCancellation?.Dispose();
        preflightRefreshCancellation = null;
        preflight = null;
        planningCalendar = null;
        calendarSeries = Array.Empty<CalendarSeriesView>();
        programs = Array.Empty<WorkoutProgramSummaryView>();
        reusableWorkouts = Array.Empty<WorkoutReuseView>();
        profileSelectionLoading = profileId is not null;
        actionStatus = profileId is { } selected
            ? $"Loading {profiles.FirstOrDefault(profile => profile.Id == selected)?.DisplayName ?? "runner"}…"
            : "Select a runner and workout.";
        await InvokeAsync(StateHasChanged);

        if (profileId is null)
        {
            profileSelectionLoading = false;
            profileSelectionCancellation?.Dispose();
            profileSelectionCancellation = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            Task<RunCuePreferences> cueTask = LoadCuePreferencesAsync(profileId.Value, cancellationToken);
            Task<ProfilePlanningData> planningTask = LoadProfilePlanningAsync(profileId.Value, cancellationToken);
            await Task.WhenAll(cueTask, planningTask);
            if (!IsCurrentProfileSelection(generation, profileId)) return;

            cuePreferences = await cueTask;
            CommitProfilePlanning(await planningTask);
            if (!IsCurrentProfileSelection(generation, profileId)) return;

            // Planning is ready at this point. Readiness polling may intentionally continue
            // for several seconds while nearby devices reconnect, but it must not keep the
            // runner switch presented as a plan load.
            profileSelectionLoading = false;

            if (workoutSelectionGeneration == selectionGeneration)
            {
                if (announce)
                    actionStatus = $"{SelectedProfileName} selected. Choose a workout.";
                await ApplyRecommendationAsync(generation, profileId.Value, selectionGeneration, cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            if (!IsCurrentProfileSelection(generation, profileId)) return;
            planningCalendar = null;
            calendarSeries = Array.Empty<CalendarSeriesView>();
            programs = Array.Empty<WorkoutProgramSummaryView>();
            reusableWorkouts = Array.Empty<WorkoutReuseView>();
            actionStatus = $"{SelectedProfileName}’s plan is temporarily unavailable. You can still choose a workout manually.";
        }
        finally
        {
            if (IsCurrentProfileSelection(generation, profileId))
            {
                profileSelectionLoading = false;
                if (ReferenceEquals(profileSelectionCancellation, selectionCancellation))
                {
                    selectionCancellation.Dispose();
                    profileSelectionCancellation = null;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ConfirmQuickStartAsync(Guid profileId)
    {
        string profileName = QuickStartProfileName;
        await SelectProfileAsync(profileId);
        actionStatus = $"{profileName} selected. Review the runner and workout before preparing the run.";
        quickStart = null;
    }

    private async Task SelectWorkoutAsync(WorkoutChoice choice)
    {
        int profileGeneration = profileSelectionGeneration;
        Guid? profileId = selectedProfileId;
        int workoutGeneration = ++workoutSelectionGeneration;
        selectedRevisionId = choice.RevisionId;
        selectedWorkoutLabel = choice.Name;
        selectedWorkoutSource = choice.SelectionSource;
        selectedProgramRunId = choice.ProgramRunId;
        selectedProgramItemId = choice.ProgramItemId;
        preflight = null;
        actionStatus = "Checking readiness in the background…";
        await InvokeAsync(StateHasChanged);
        if (!IsCurrentWorkoutSelection(profileGeneration, profileId, workoutGeneration, choice.RevisionId)) return;
        await RefreshPreflightAsync();
    }

    private async Task SelectRecentWorkoutAsync(WorkoutReuseView reusable)
    {
        await SelectWorkoutAsync(ChoiceFromReuse(reusable));
        actionStatus = $"{reusable.Name} selected again.";
    }

    private static WorkoutChoice ChoiceFromReuse(WorkoutReuseView reusable)
    {
        string stats = reusable.PlannedDurationMinutes is { } minutes
            ? $"{minutes:0.#} min · {reusable.ExpandedStepCount} steps"
            : $"Mixed goals · {reusable.ExpandedStepCount} steps";
        return new WorkoutChoice(
            reusable.WorkoutRevisionId,
            reusable.Name,
            reusable.Description,
            $"Last completed {reusable.LastCompletedAtUtc.ToLocalTime():d MMM}",
            stats,
            DateOnly.FromDateTime(reusable.LastCompletedAtUtc.LocalDateTime),
            "Library");
    }

    private async Task SelectManualRunAsync()
    {
        WorkoutSummaryView? manual = ManualWorkout;
        if (manual is null)
        {
            actionStatus = "Preparing manual run…";
            var step = new WorkoutBlockInput(
                "step", 1, [], "time", 240, "fixed", 0.8, 0.8,
                0, 0, 0, 0.8, 0.8, 40,
                "fixed", 0, 0, null, "Manual speed and incline control.");
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/planning/workouts",
                new WorkoutSaveRequest(
                    Guid.NewGuid(),
                    "Manual run",
                    "Open-ended treadmill session controlled from the live dashboard.",
                    [step],
                    "ManualTemplate"));
            if (!response.IsSuccessStatusCode)
            {
                actionStatus = "The manual run could not be prepared.";
                return;
            }

            workouts = await Http.GetFromJsonAsync<WorkoutSummaryView[]>("api/planning/workouts") ?? [];
            manual = ManualWorkout;
        }

        if (manual is null)
        {
            actionStatus = "The manual run is unavailable.";
            return;
        }

        await SelectWorkoutAsync(ChoiceFromSummary(manual) with { Context = "Manual run", SelectionSource = "Manual" });
    }

    private async Task<ProfilePlanningData> LoadProfilePlanningAsync(Guid profileId, CancellationToken cancellationToken)
    {
        DateOnly from = DateOnly.FromDateTime(DateTime.Today);
        DateOnly to = from.AddDays(30);
        Task<CalendarRangeView?> calendarTask = Http.GetFromJsonAsync<CalendarRangeView>(
            $"api/planning/calendar/{profileId}?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}", cancellationToken);
        Task<CalendarSeriesView[]?> seriesTask = Http.GetFromJsonAsync<CalendarSeriesView[]>(
            $"api/planning/calendar/series?profileId={profileId}", cancellationToken);
        Task<WorkoutProgramSummaryView[]?> programsTask = Http.GetFromJsonAsync<WorkoutProgramSummaryView[]>(
            $"api/planning/programs?profileId={profileId}", cancellationToken);
        Task<WorkoutReuseView[]?> reusableTask = Http.GetFromJsonAsync<WorkoutReuseView[]>(
            $"api/planning/workouts/reuse?profileId={profileId}&take=3", cancellationToken);
        await Task.WhenAll(calendarTask, seriesTask, programsTask, reusableTask);
        return new ProfilePlanningData(
            await calendarTask,
            await seriesTask ?? Array.Empty<CalendarSeriesView>(),
            await programsTask ?? Array.Empty<WorkoutProgramSummaryView>(),
            await reusableTask ?? Array.Empty<WorkoutReuseView>());
    }

    private void CommitProfilePlanning(ProfilePlanningData planning)
    {
        planningCalendar = planning.Calendar;
        calendarSeries = planning.Series;
        programs = planning.Programs;
        reusableWorkouts = planning.ReusableWorkouts;
    }

    private async Task ReloadCurrentProfilePlanningAsync()
    {
        if (selectedProfileId is not { } profileId) return;
        int generation = profileSelectionGeneration;
        CancellationToken cancellationToken = profileSelectionCancellation?.Token ?? CancellationToken.None;
        try
        {
            ProfilePlanningData planning = await LoadProfilePlanningAsync(profileId, cancellationToken);
            if (IsCurrentProfileSelection(generation, profileId))
                CommitProfilePlanning(planning);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or TaskCanceledException)
        {
            if (IsCurrentProfileSelection(generation, profileId))
                actionStatus = $"{SelectedProfileName}’s plan is temporarily unavailable.";
        }
    }

    private Task ApplyRecommendationForCurrentProfileAsync()
    {
        int selectionGeneration = workoutSelectionGeneration;
        return selectedProfileId is { } profileId
            ? ApplyRecommendationAsync(profileSelectionGeneration, profileId, selectionGeneration, profileSelectionCancellation?.Token ?? CancellationToken.None)
            : Task.CompletedTask;
    }

    private async Task ApplyRecommendationAsync(int generation, Guid profileId, int selectionGeneration, CancellationToken cancellationToken)
    {
        if (!IsCurrentProfileSelection(generation, profileId) ||
            workoutSelectionGeneration != selectionGeneration ||
            cancellationToken.IsCancellationRequested) return;
        if (CalendarNeedsChoice)
        {
            workoutSource = "scheduled";
            await RefreshPreflightAsync();
            return;
        }

        if (RecommendedChoice is { } recommendation)
        {
            if (!IsCurrentProfileSelection(generation, profileId) || workoutSelectionGeneration != selectionGeneration) return;
            workoutSource = recommendation.SelectionSource switch
            {
                "Calendar" => "scheduled",
                "Program" => "programs",
                _ => "library",
            };
            await SelectWorkoutAsync(recommendation);
            return;
        }

        await RefreshPreflightAsync();
    }

    private IEnumerable<WorkoutChoice> ScheduledWorkoutChoices() =>
        planningCalendar?.Days.SelectMany(day => day.Options.Select(option =>
        {
            WorkoutSummaryView? summary = workouts.FirstOrDefault(workout => workout.CurrentRevisionId == option.WorkoutRevisionId);
            return new WorkoutChoice(
                option.WorkoutRevisionId,
                option.WorkoutName,
                summary?.Description,
                option.Source == "Program"
                    ? $"{day.Date:ddd d MMM} · {option.ScheduleName}"
                    : day.Date.ToString("ddd d MMM"),
                option.Source == "Program" ? ProgramCalendarStats(option) : SummaryStats(summary, option.RevisionNumber),
                day.Date,
                option.Source == "Program" && !option.IsRepeat ? "Program" : "Calendar",
                option.IsRepeat ? null : option.ProgramRunId,
