@using System.Net
@using System.Net.Http.Json
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime JS

<section class="profile-integration garmin-activity-upload" aria-labelledby="garmin-activity-title">
    <div class="panel-heading">
        <div><p class="eyebrow">Completed activities</p><h3 id="garmin-activity-title">Garmin activity upload</h3></div>
        <span class="integration-badge integration-badge--unsupported">Experimental</span>
    </div>
    <p class="integration-note"><strong>Optional and disabled by default.</strong> This uses Garmin's private consumer interface, which Garmin may change without notice. Known failures can be retried; an unknown upload outcome is never retried automatically.</p>
    @if (loading)
    {
        <p role="status">Loading activity-upload status…</p>
    }
    else if (status is null)
    {
        <p class="field-error" role="status">Garmin account status is temporarily unavailable. Watch pairing and prior job history are loaded separately.</p>
        <button class="secondary-action" type="button" @onclick="LoadStatusAsync">Retry account status</button>
    }
    else if (!status.Connected && !status.CanConnect)
    {
        <div class="integration-account integration-account--warning" role="status">
            <strong>Adapter setup required</strong>
            <span>@status.AdapterMessage</span>
        </div>
        <button class="secondary-action" type="button" @onclick="LoadStatusAsync">Check again</button>
    }
    else if (!status.Connected)
    {
        <div class="integration-form-grid">
            <label class="field">Garmin email<input type="email" autocomplete="username" maxlength="254" @bind="email" /></label>
            <label class="field">Garmin password<input type="password" autocomplete="current-password" maxlength="512" @bind="password" /></label>
        </div>
        <label class="choice-row"><input type="checkbox" @bind="enableAfterConnect" /> Enable automatic upload after connecting</label>
        <p class="integration-note"><strong>Private-LAN HTTP setup is allowed but is not encrypted.</strong> Use this only on your trusted household network and never expose or port-forward TreadmillRunner. The password is sent once to the isolated login process and is never stored.</p>
        <button class="primary-action" type="button" @onclick="ConnectAsync" disabled="@(busy || string.IsNullOrWhiteSpace(email) || string.IsNullOrEmpty(password))">@(busy ? "Connecting…" : "Connect Garmin")</button>
    }
    else
    {
        <div class="integration-account">
            <strong>@status.AccountLabel</strong>
            <span>@(status.Enabled ? "Automatic upload enabled" : "Automatic upload disabled") · @status.Confirmed confirmed · @status.FoundInGarmin found manually · @status.Pending pending</span>
            @if (status.Unknown > 0) { <small class="field-error">@status.Unknown unknown outcome(s)—review before dismissing.</small> }
            @if (status.Failed > 0) { <small class="field-error">@status.Failed known failure(s) can be retried.</small> }
            @if (!string.IsNullOrWhiteSpace(status.LastError)) { <small class="field-error" role="status">@status.LastError</small> }
        </div>
        <div class="form-actions">
            <button class="primary-action" type="button" @onclick="ToggleEnabledAsync" disabled="@busy">@(status.Enabled ? "Disable automatic upload" : "Enable automatic upload")</button>
            @if (confirmDisconnect)
            {
                <button class="danger-action" type="button" @onclick="DisconnectAsync" disabled="@busy">Confirm disconnect</button>
                <button class="secondary-action" type="button" @onclick="() => confirmDisconnect = false">Keep connected</button>
            }
            else
            {
                <button class="secondary-action" type="button" @onclick="() => confirmDisconnect = true">Disconnect upload account</button>
            }
        </div>
        @if (jobs.Count > 0)
        {
            <details class="technical-details"><summary>Recent upload jobs</summary>
                <div class="compact-list">
                    @foreach (GarminActivityJobView job in jobs)
                    {
                        <article><div><strong>@(job.WorkoutTitle ?? "Completed treadmill run") · @job.Status</strong><small>@(job.StartedAtUtc?.ToLocalTime().ToString("g") ?? job.UpdatedAtUtc.ToLocalTime().ToString("g")) · @FormatDuration(job.DurationSeconds) · attempt @job.AttemptCount</small></div>
                            @if (!string.IsNullOrWhiteSpace(job.LastError)) { <p>@job.LastError</p> }
                            <div class="form-actions">
                                <a class="secondary-action" href="@($"history/{job.WorkoutSessionId}")">Open history</a>
                                @if (job.CanRetry) { <button class="secondary-action" type="button" @onclick="() => RetryAsync(job.Id)">Retry known failure</button> }
                                @if (job.Status == "Unknown" && confirmFoundJobId == job.Id)
                                {
                                    <span class="field-error" role="status">Confirm only after you visually found this activity in Garmin Connect.</span>
                                    <button class="touch-action primary-action" type="button" disabled="@busy" @onclick="() => AcknowledgeFoundAsync(job.Id)">Confirm found</button>
                                    <button class="touch-action secondary-action" type="button" disabled="@busy" @onclick="() => confirmFoundJobId = null">Cancel</button>
                                }
                                else if (job.Status == "Unknown")
                                {
                                    <button class="primary-action" type="button" @onclick="() => confirmFoundJobId = job.Id">Found in Garmin</button>
                                }
                                @if (job.Status is "Failed" or "Unknown") { <button class="secondary-action" type="button" @onclick="() => DismissAsync(job.Id)">Dismiss</button> }
                            </div>
                        </article>
                    }
                </div>
            </details>
        }
    }
    @if (!string.IsNullOrWhiteSpace(jobsLoadError)) { <p class="integration-note field-error" role="status">@jobsLoadError</p> }
    @if (challengeId is not null)
    {
        <div class="inline-confirmation" role="status">
            <label class="field">Garmin verification code<input inputmode="numeric" autocomplete="one-time-code" maxlength="16" @bind="mfaCode" /></label>
            <button class="primary-action" type="button" @onclick="CompleteMfaAsync" disabled="@(busy || mfaCode.Length < 4)">Verify</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(message)) { <p class="integration-note" role="status">@message</p> }
</section>

<section class="profile-integration garmin-watch-binding" aria-labelledby="garmin-watch-title">
    <div class="panel-heading"><div><p class="eyebrow">Watch companion</p><h3 id="garmin-watch-title">Connect IQ watch app</h3></div></div>
    <p class="integration-note">The watch app records a treadmill activity only after you press Select on the watch. Pairing lets it show this runner and the current TreadmillRunner session; it never starts the treadmill.</p>
    @if (watchLoading)
    {
        <p role="status">Loading watch pairing…</p>
    }
    else if (!string.IsNullOrWhiteSpace(watchLoadError))
    {
        <p class="field-error" role="status">@watchLoadError</p>
        <button class="secondary-action" type="button" @onclick="LoadWatchAsync">Try watch pairing again</button>
    }
    else if (watchBinding is null)
    {
        <label class="field">Watch label<input maxlength="100" @bind="watchLabel" /></label>
        <button class="primary-action" type="button" @onclick="PairWatchAsync" disabled="@(busy || string.IsNullOrWhiteSpace(watchLabel))">Create watch pairing</button>
    }
    else
    {
        <div class="integration-account"><strong>@watchBinding.DeviceLabel</strong><span>@(watchBinding.LastSeenAtUtc is null ? "Not contacted yet" : $"Last contacted {watchBinding.LastSeenAtUtc.Value.ToLocalTime():g}")</span></div>
        <button class="secondary-action" type="button" @onclick="RevokeWatchAsync" disabled="@busy">Revoke watch pairing</button>
    }
    @if (!string.IsNullOrWhiteSpace(oneTimeWatchToken))
    {
        <div class="one-time-secret" role="status"><strong>Copy this pairing token now</strong><code>@oneTimeWatchToken</code><button class="secondary-action" type="button" @onclick="CopyWatchTokenAsync">Copy token</button><small>It cannot be shown again. Paste it into the Connect IQ app setting “Watch pairing token”.</small></div>
    }
    @if (!string.IsNullOrWhiteSpace(watchMessage)) { <p class="integration-note" role="status">@watchMessage</p> }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProfileId { get; set; }
    private GarminActivityStatusView? status;
    private GarminWatchBindingView? watchBinding;
    private List<GarminActivityJobView> jobs = [];
    private bool loading = true, watchLoading = true, busy, enableAfterConnect, confirmDisconnect;
    private Guid? confirmFoundJobId;
    private string email = string.Empty, password = string.Empty, mfaCode = string.Empty, watchLabel = "Garmin watch", message = string.Empty, watchMessage = string.Empty, oneTimeWatchToken = string.Empty;
    private string jobsLoadError = string.Empty, watchLoadError = string.Empty;
    private Guid? challengeId;
    private Guid loadedProfileId;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProfileId == ProfileId) return;
        status = null; watchBinding = null; jobs = []; challengeId = null;
        email = string.Empty; password = string.Empty; mfaCode = string.Empty;
        message = string.Empty; watchMessage = string.Empty; oneTimeWatchToken = string.Empty;
        jobsLoadError = string.Empty; watchLoadError = string.Empty;
        loadedProfileId = ProfileId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; watchLoading = true;
        status = null; watchBinding = null; jobs = [];
        jobsLoadError = string.Empty; watchLoadError = string.Empty;
        await Task.WhenAll(LoadStatusAsync(), LoadJobsAsync(), LoadWatchAsync());
    }

    private async Task LoadStatusAsync()
    {
        loading = true;
        try
        {
            status = await Http.GetFromJsonAsync<GarminActivityStatusView>($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/status");
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or NotSupportedException) { status = null; }
        finally { loading = false; }
    }

    private async Task LoadJobsAsync()
    {
        jobsLoadError = string.Empty;
        try { jobs = await Http.GetFromJsonAsync<List<GarminActivityJobView>>($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/jobs") ?? []; }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or NotSupportedException)
        {
            jobs = [];
            jobsLoadError = "Recent Garmin upload jobs are temporarily unavailable. Account status and setup remain usable.";
        }
    }

    private async Task LoadWatchAsync()
    {
        watchLoading = true; watchLoadError = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync($"api/integrations/garmin/watch/profiles/{ProfileId}");
            if (response.StatusCode == HttpStatusCode.NoContent) watchBinding = null;
            else if (response.IsSuccessStatusCode) watchBinding = await response.Content.ReadFromJsonAsync<GarminWatchBindingView>();
            else throw new HttpRequestException("Watch pairing status request failed.", null, response.StatusCode);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or NotSupportedException)
        {
            watchBinding = null;
            watchLoadError = "Watch pairing status is temporarily unavailable. Garmin activity upload remains usable.";
        }
        finally { watchLoading = false; }
    }

    private async Task ConnectAsync()
    {
        busy = true; message = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/connect", new { email, password, enabled = enableAfterConnect });
            password = string.Empty;
            if (response.StatusCode == HttpStatusCode.UpgradeRequired)
            {
                GarminActivityErrorView? error = await ReadErrorAsync(response);
                message = error?.Error ?? "Use a private household-network address or HTTPS to connect Garmin.";
                return;
            }
            if (response.StatusCode == HttpStatusCode.ServiceUnavailable)
            {
                GarminActivityErrorView? error = await response.Content.ReadFromJsonAsync<GarminActivityErrorView>();
                message = error?.Error ?? "The Garmin activity adapter is unavailable. Repair the signed release and try again.";
                await LoadStatusAsync();
                return;
            }
            GarminActivityConnectResultView? result = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<GarminActivityConnectResultView>() : null;
            if (result is null)
            {
                GarminActivityErrorView? error = await ReadErrorAsync(response);
                message = error?.Error ?? "Garmin authentication could not be started.";
                return;
            }
            challengeId = result.ChallengeId; message = result.Message;
            if (result.State == "Connected") await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            message = "The gateway is unavailable; Garmin authentication was not completed.";
        }
        finally { password = string.Empty; busy = false; }
    }

    private static async Task<GarminActivityErrorView?> ReadErrorAsync(HttpResponseMessage response)
    {
        try { return await response.Content.ReadFromJsonAsync<GarminActivityErrorView>(); }
        catch (Exception exception) when (exception is JsonException or NotSupportedException) { return null; }
    }

    private async Task CompleteMfaAsync()
    {
        if (challengeId is not { } challenge) return;
        busy = true; message = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/mfa", new { challengeId = challenge, code = mfaCode });
            GarminActivityConnectResultView? result = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<GarminActivityConnectResultView>() : null;
            message = result?.Message ?? "Garmin verification failed; start the connection again.";
            challengeId = null;
            if (result?.State == "Connected") await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            message = "The gateway is unavailable; verification was not completed.";
        }
        finally { mfaCode = string.Empty; busy = false; }
    }

    private async Task ToggleEnabledAsync() { if (status?.Version is not { } version) return; if (await SendAsync(() => Http.PostAsJsonAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/enabled", new { enabled = !status.Enabled, expectedVersion = version }), "The upload setting could not be changed.")) await LoadAsync(); }
    private async Task DisconnectAsync() { if (status?.Version is not { } version) return; if (await SendAsync(() => Http.PostAsJsonAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/disconnect", new { expectedVersion = version }), "The upload account could not be disconnected.")) { confirmDisconnect = false; await LoadAsync(); } }
    private async Task RetryAsync(Guid jobId) { if (await SendAsync(() => Http.PostAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/jobs/{jobId}/retry", null), "This job is not retryable or changed; refresh and review it.")) await LoadAsync(); }
    private async Task DismissAsync(Guid jobId) { if (await SendAsync(() => Http.PostAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/jobs/{jobId}/dismiss", null), "This job could not be dismissed.")) await LoadAsync(); }
    private async Task AcknowledgeFoundAsync(Guid jobId)
    {
        if (confirmFoundJobId != jobId) return;
        Guid operationId = Guid.NewGuid();
        if (await SendAsync(
            () => Http.PostAsJsonAsync($"api/integrations/garmin/activity-upload/profiles/{ProfileId}/jobs/{jobId}/acknowledge-found", new { operationId }),
            "Only an upload with an unknown outcome can be marked as found in Garmin."))
        {
            confirmFoundJobId = null;
            await LoadAsync();
            message = "Marked as found in Garmin. This is your acknowledgment, not provider confirmation, and it will not be retried.";
        }
    }
    private async Task PairWatchAsync()
    {
        busy = true; watchMessage = string.Empty;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/integrations/garmin/watch/profiles/{ProfileId}", new { deviceLabel = watchLabel });
            if (response.IsSuccessStatusCode)
            {
                using JsonDocument json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                oneTimeWatchToken = json.RootElement.GetProperty("token").GetString() ?? string.Empty;
            }
            else if (response.StatusCode == HttpStatusCode.UpgradeRequired) { watchMessage = "For token safety, create the watch pairing on the NUC itself or configure HTTPS first."; }
            else { watchMessage = "The watch pairing could not be created."; }
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            watchMessage = "The gateway is unavailable; no watch pairing was created.";
        }
        finally { busy = false; }
    }
    private async Task RevokeWatchAsync() { if (watchBinding is null) return; if (await SendAsync(() => Http.PostAsJsonAsync($"api/integrations/garmin/watch/profiles/{ProfileId}/revoke", new { expectedVersion = watchBinding.Version }), "The watch pairing could not be revoked.")) { oneTimeWatchToken = string.Empty; await LoadAsync(); } }
    private async Task CopyWatchTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(oneTimeWatchToken)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", oneTimeWatchToken); watchMessage = "Watch pairing token copied."; }
        catch (JSException) { watchMessage = "Clipboard access was denied. Select and copy the one-time token manually."; }
    }

    private async Task<bool> SendAsync(Func<Task<HttpResponseMessage>> send, string failureMessage)
    {
        busy = true; message = string.Empty;
        try
        {
            using HttpResponseMessage response = await send();
            if (response.IsSuccessStatusCode) return true;
            message = failureMessage;
            return false;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or JsonException)
        {
            message = "The gateway is unavailable; no change was made.";
            return false;
        }
        finally { busy = false; }
    }

    private sealed record GarminActivityStatusView(Guid ProfileId, bool Connected, bool Enabled, string? AccountLabel, string State, int Pending, int Confirmed, int FoundInGarmin, int Failed, int Unknown, DateTimeOffset? LastSuccessAtUtc, string? LastError, int? Version, string AdapterState, string AdapterMessage, bool CanConnect);
    private static string FormatDuration(double? seconds) => seconds is null ? "duration unavailable" : TimeSpan.FromSeconds(seconds.Value).ToString(@"h\:mm\:ss");
    private sealed record GarminActivityJobView(Guid Id, Guid WorkoutSessionId, string Status, int AttemptCount, string? RemoteId, string? FailureKind, bool CanRetry, string? WorkoutTitle, DateTimeOffset? StartedAtUtc, double? DurationSeconds, string? LastError, DateTimeOffset UpdatedAtUtc, DateTimeOffset? AcknowledgedAtUtc);
    private sealed record GarminActivityConnectResultView(string State, Guid? ChallengeId, string? AccountLabel, string Message);
    private sealed record GarminActivityErrorView(string Error, string? AdapterState);
    private sealed record GarminWatchBindingView(Guid Id, Guid UserProfileId, string RunnerName, string DeviceLabel, DateTimeOffset CreatedAtUtc, DateTimeOffset? LastSeenAtUtc, int Version);
}
