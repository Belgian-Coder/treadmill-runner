@using System.Globalization

<section class="control-live-chart @CssClass" aria-labelledby="@TitleId" data-component="live-progress-chart">
    <div class="control-chart-heading">
        <div><span class="eyebrow">@Eyebrow</span><h2 id="@TitleId">@Heading</h2></div>
        <div class="control-chart-actions">
            <span title="@Title">@Title</span>
            @HeaderActions
        </div>
    </div>
    <div class="chart-plot-grid chart-plot-grid--dual">
        <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@SpeedAxisMaximum, 1fr)">
            <strong class="chart-axis-unit">km/h</strong>
            @foreach (int tick in SpeedAxisTicks)
            {
                <span>@tick</span>
            }
        </div>
        <svg class="live-chart control-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="@ChartAriaLabel">
            @foreach (int tick in SpeedAxisTicks)
            {
                double y = ChartY(tick, SpeedAxisMaximum);
                <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
            }
            <line class="chart-axis" x1="10" y1="210" x2="710" y2="210" />
            <path class="chart-plan" data-series="planned-speed" d="@PlannedSpeedPath" />
            <path class="chart-requested" data-series="requested-speed" d="@TargetSpeedPath" />
            <path class="chart-current" data-series="measured-speed" d="@MeasuredSpeedPath" />
            <path class="chart-plan chart-plan--incline" data-series="planned-incline" d="@PlannedInclinePath" />
            <path class="chart-requested chart-requested--incline" data-series="requested-incline" d="@TargetInclinePath" />
            <path class="chart-current chart-current--incline" data-series="measured-incline" d="@MeasuredInclinePath" />
            @if (CursorX is { } cursorX)
            {
                <line class="chart-cursor" x1="@cursorX" x2="@cursorX" y1="10" y2="210" data-elapsed-seconds="@ElapsedSeconds" data-duration-seconds="@DurationSeconds" />
            }
            @if (MarkerX is { } markerX && MarkerY is { } markerY)
            {
                <circle class="chart-marker" cx="@markerX" cy="@markerY" r="5" />
            }
        </svg>
        <div class="chart-y-scale chart-y-scale--ticks chart-y-scale--secondary" aria-label="Incline axis in percent" style="grid-template-rows: repeat(@InclineAxisMaximum, 1fr)">
            <strong class="chart-axis-unit">%</strong>
            @foreach (int tick in InclineAxisTicks)
            {
                <span>@tick</span>
            }
        </div>
        <div></div>
        <div class="chart-time-scale" aria-label="Elapsed time axis" data-midpoint="@FormatAxisTime(TimeSpan.FromTicks(SafeDuration.Ticks / 2))">
            @foreach (ChartTimeTick tick in ChartTimeTicks)
            {
                <span style="left: @tick.PositionPercent.ToString("0.##", CultureInfo.InvariantCulture)%">@FormatAxisTime(tick.Elapsed)</span>
            }
        </div>
        <div></div>
    </div>
    <div class="control-chart-legend" aria-label="Chart legend">
        <span class="control-chart-legend__group" aria-label="Speed legend"><strong>Speed</strong><span><i class="legend-line legend-line--plan"></i>Plan</span><span><i class="legend-line legend-line--requested"></i>Target</span><span><i class="legend-line legend-line--measured"></i>Measured</span></span>
        <span class="control-chart-legend__group" aria-label="Incline legend"><strong>Incline</strong><span><i class="legend-line legend-line--plan legend-line--incline-plan"></i>Plan</span><span><i class="legend-line legend-line--requested legend-line--incline-target"></i>Target</span><span><i class="legend-line legend-line--measured legend-line--incline-measured"></i>Measured</span></span>
    </div>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <p class="field-help live-progress-chart__note">@Note</p>
    }
</section>

@code {
    [Parameter] public string TitleId { get; set; } = "live-progress-chart-title";
    [Parameter] public string Eyebrow { get; set; } = "This run";
    [Parameter] public string Heading { get; set; } = "Live progress";
    [Parameter] public string Title { get; set; } = "Workout";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string ChartAriaLabel { get; set; } = "Live speed in kilometers per hour and incline percentage over elapsed time";
    [Parameter] public int SpeedAxisMaximum { get; set; } = 10;
    [Parameter] public int InclineAxisMaximum { get; set; } = 10;
    [Parameter] public TimeSpan Duration { get; set; } = TimeSpan.FromMinutes(1);
    [Parameter] public string PlannedSpeedPath { get; set; } = string.Empty;
    [Parameter] public string TargetSpeedPath { get; set; } = string.Empty;
    [Parameter] public string MeasuredSpeedPath { get; set; } = string.Empty;
    [Parameter] public string PlannedInclinePath { get; set; } = string.Empty;
    [Parameter] public string TargetInclinePath { get; set; } = string.Empty;
    [Parameter] public string MeasuredInclinePath { get; set; } = string.Empty;
    [Parameter] public double? CursorX { get; set; }
    [Parameter] public string ElapsedSeconds { get; set; } = "0";
    [Parameter] public string DurationSeconds { get; set; } = "0";
    [Parameter] public double? MarkerX { get; set; }
    [Parameter] public double? MarkerY { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private TimeSpan SafeDuration => Duration > TimeSpan.Zero ? Duration : TimeSpan.FromMinutes(1);
    private IEnumerable<int> SpeedAxisTicks => Enumerable.Range(1, Math.Max(1, SpeedAxisMaximum)).Reverse();
    private IEnumerable<int> InclineAxisTicks => Enumerable.Range(1, Math.Max(1, InclineAxisMaximum)).Reverse();

    private IReadOnlyList<ChartTimeTick> ChartTimeTicks
    {
        get
        {
            TimeSpan duration = SafeDuration;
            double minutes = duration.TotalMinutes;
            int intervalMinutes = AxisIntervalMinutes(minutes);
            var ticks = new List<ChartTimeTick> { new(TimeSpan.Zero, 0) };
            for (double minute = intervalMinutes; minute < minutes; minute += intervalMinutes)
            {
                TimeSpan elapsed = TimeSpan.FromMinutes(minute);
                ticks.Add(new ChartTimeTick(elapsed, elapsed.TotalSeconds / duration.TotalSeconds * 100));
            }
            if (ticks.Count > 1 && (duration - ticks[^1].Elapsed).TotalMinutes < intervalMinutes * .75) ticks.RemoveAt(ticks.Count - 1);
            ticks.Add(new ChartTimeTick(duration, 100));
            return ticks;
        }
    }

    private static double ChartY(double value, int maximum) => 210 - (Math.Clamp(value / Math.Max(1, maximum), 0, 1) * 200);
    private static string FormatAxisTime(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? elapsed.ToString(@"h\:mm", CultureInfo.InvariantCulture)
        : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    private static int AxisIntervalMinutes(double durationMinutes)
    {
        double desired = durationMinutes / 5;
        return desired <= 1 ? 1 : desired <= 2 ? 2 : desired <= 5 ? 5 : desired <= 10 ? 10 : desired <= 15 ? 15 : 30;
    }

    private sealed record ChartTimeTick(TimeSpan Elapsed, double PositionPercent);
}
