@using System.Globalization
@using System.Text
@using System.Text.Json

<dl class="workout-details-overview session-detail-overview" aria-label="Recorded session overview">
    <div><dt>Status</dt><dd>@Session.State</dd></div>
    <div><dt>Runner</dt><dd>@Session.Definition.UserProfileName</dd></div>
    <div><dt>Started</dt><dd>@(Session.StartedAt?.ToLocalTime().ToString("d MMM yyyy · HH:mm") ?? "Not recorded")</dd></div>
    <div><dt>Duration</dt><dd>@Session.Duration.ToString(@"hh\:mm\:ss")</dd></div>
    <div><dt>Distance</dt><dd>@Session.DistanceKilometers.ToString("0.00") km</dd></div>
    <div><dt>Estimated kcal</dt><dd>@Session.EstimatedKilocalories.ToString("0")</dd></div>
    <div><dt>Average speed</dt><dd>@Session.AverageSpeedKph.ToString("0.0") km/h</dd></div>
    <div><dt>Average incline</dt><dd>@Session.AverageInclinePercent.ToString("0.0")%</dd></div>
    <div><dt>Elevation gain</dt><dd>@Session.TotalAscentMeters.ToString("0.0") m</dd></div>
    <div><dt>Elevation loss</dt><dd>@Session.TotalDescentMeters.ToString("0.0") m</dd></div>
    <div><dt>Heart rate</dt><dd>@HeartRateLabel</dd></div>
</dl>

<section class="detail-graph" aria-labelledby="@GraphTitleId">
    <div class="panel-heading">
        <div><h3 id="@GraphTitleId">Live graph</h3><span class="field-help">Persisted planned, requested, and measured speed and incline. Missing samples are not estimated.</span></div>
        <span>@GraphSampleLabel</span>
    </div>
    @if (Session.Samples.Count == 0)
    {
        <p class="empty-state">No live telemetry samples were stored for this session.</p>
    }
    else
    {
        <div class="chart-plot-grid chart-plot-grid--dual session-popup-chart">
            <div class="chart-y-scale chart-y-scale--ticks" aria-label="Speed axis in kilometers per hour" style="grid-template-rows: repeat(@SpeedAxisMaximum, 1fr)">
                <strong class="chart-axis-unit">km/h</strong>
                @foreach (int tick in SpeedAxisTicks) { <span>@tick</span> }
            </div>
            <ChartInspector Series="@SpeedInclineInspectionSeries" PointFactory="@GetSpeedInclineInspectionPoints" ProjectionVersion="@Projection.Version" AriaLabel="Interactive recorded speed and incline chart. Hover, touch and drag, or use Left and Right arrow keys to inspect every plotted value.">
                <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Recorded planned, requested, and measured speed and incline over elapsed time">
                    @foreach (int tick in SpeedAxisTicks)
                    {
                        double y = ChartY(tick, SpeedAxisMaximum);
                        <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                    }
                    <path class="chart-plan" data-series="planned-speed" d="@Projection.PlannedSpeedPath" />
                    <path class="chart-requested" data-series="requested-speed" d="@Projection.RequestedSpeedPath" />
                    <path class="chart-current" data-series="measured-speed" d="@Projection.MeasuredSpeedPath" />
                    <path class="chart-plan chart-plan--incline" data-series="planned-incline" d="@Projection.PlannedInclinePath" />
                    <path class="chart-requested chart-requested--incline" data-series="requested-incline" d="@Projection.RequestedInclinePath" />
                    <path class="chart-current chart-current--incline" data-series="measured-incline" d="@Projection.MeasuredInclinePath" />
                    @if (Session.Samples.LastOrDefault() is { } latest)
                    {
                        <circle class="chart-marker" cx="@ChartX(latest.Elapsed)" cy="@ChartY(latest.MeasuredSpeedKph, SpeedAxisMaximum)" r="5" />
                    }
                </svg>
            </ChartInspector>
            <div class="chart-y-scale chart-y-scale--ticks chart-y-scale--secondary" aria-label="Incline axis in percent" style="grid-template-rows: repeat(@InclineAxisMaximum, 1fr)">
                <strong class="chart-axis-unit">%</strong>
                @foreach (int tick in InclineAxisTicks) { <span>@tick</span> }
            </div>
            <div></div>
            <div class="chart-time-scale" aria-label="Elapsed time axis">
                <span style="left: 0%">0:00</span><span style="left: 50%">@FormatElapsed(TimeSpan.FromTicks(ChartDuration.Ticks / 2))</span><span style="left: 100%">@FormatElapsed(ChartDuration)</span>
            </div>
            <div></div>
        </div>
        <div class="control-chart-legend" aria-label="Live graph legend">
            <span class="control-chart-legend__group" aria-label="Speed legend"><strong>Speed</strong><span><i class="legend-line legend-line--plan"></i>Planned</span><span><i class="legend-line legend-line--requested"></i>Requested</span><span><i class="legend-line legend-line--measured"></i>Measured</span></span>
            <span class="control-chart-legend__group" aria-label="Incline legend"><strong>Incline</strong><span><i class="legend-line legend-line--plan legend-line--incline-plan"></i>Planned</span><span><i class="legend-line legend-line--requested legend-line--incline-target"></i>Requested</span><span><i class="legend-line legend-line--measured legend-line--incline-measured"></i>Measured</span></span>
        </div>
        @if (HasHeartRateSamples)
        {
            <div class="panel-heading session-heart-rate-heading"><div><h4>Heart rate</h4><span class="field-help">Measured sensor readings; gaps are preserved.</span></div></div>
            <div class="chart-plot-grid chart-plot-grid--dual session-popup-chart">
                <div class="chart-y-scale chart-y-scale--ticks" aria-label="Heart rate axis in beats per minute" style="grid-template-rows: repeat(@HeartRateAxisTicks.Count(), 1fr)">
                    <strong class="chart-axis-unit">bpm</strong>
                    @foreach (int tick in HeartRateAxisTicks) { <span>@tick</span> }
                </div>
                <ChartInspector Series="@HeartRateInspectionSeries" PointFactory="@GetHeartRateInspectionPoints" ProjectionVersion="@Projection.Version" AriaLabel="Interactive recorded heart-rate chart. Hover, touch and drag, or use Left and Right arrow keys to inspect heart rate.">
                    <svg class="live-chart" viewBox="0 0 720 220" preserveAspectRatio="none" role="img" aria-label="Recorded heart rate over elapsed time">
                        @foreach (int tick in HeartRateAxisTicks)
                        {
                            double y = HeartRateChartY(tick);
                            <line class="chart-grid" x1="10" y1="@y" x2="710" y2="@y" />
                        }
                        @foreach (SessionHeartRateZoneSnapshot zone in HeartRateBoundaryZones)
                        {
                            double y = HeartRateChartY(zone.MinimumBpm);
                            double labelY = Math.Clamp(y - 5, 12, 208);
                            <g class="chart-zone-boundary-group" data-zone-boundary="@zone.Number" role="img" aria-label="Zone @zone.Number · @zone.Name starts at @zone.MinimumBpm bpm">
                                <line class="chart-zone-boundary" x1="10" y1="@y" x2="710" y2="@y" />
                                <text class="chart-zone-label" x="16" y="@labelY" dominant-baseline="middle" aria-hidden="true">Zone @zone.Number · @zone.MinimumBpm</text>
                            </g>
                        }
                        <path class="chart-current chart-current--heart-rate" data-series="heart-rate" d="@Projection.HeartRatePath" />
                    </svg>
                </ChartInspector>
                <div></div>
                <div></div>
                <div class="chart-time-scale" aria-label="Heart rate elapsed time axis">
                    <span style="left: 0%">0:00</span><span style="left: 50%">@FormatElapsed(TimeSpan.FromTicks(ChartDuration.Ticks / 2))</span><span style="left: 100%">@FormatElapsed(ChartDuration)</span>
                </div>
                <div></div>
            </div>
        }
    }
</section>

<section class="detail-change-section" aria-labelledby="@ChangesTitleId">
    <div class="panel-heading">
        <div><h3 id="@ChangesTitleId">All recorded changes</h3><span class="field-help">Ordered stored events; no gaps or outcomes are inferred.</span></div>
        <span>@Session.Events.Count event(s)</span>
    </div>
    <div class="detail-table-scroll" tabindex="0" role="region" aria-label="All recorded session changes">
        <table class="detail-change-table">
            <thead><tr><th scope="col">#</th><th scope="col">Elapsed</th><th scope="col">Change</th><th scope="col">Recorded detail</th></tr></thead>
            <tbody>
                @if (OrderedEvents.Count == 0)
                {
                    <tr><td colspan="4">No overrides, step transitions, pauses, connection changes, warnings, or completion events were stored.</td></tr>
                }
                else
                {
                    @foreach ((JsonElement item, int index) in OrderedEvents.Select((item, index) => (item, index)))
                    {
                        <tr><th scope="row">@(index + 1)</th><td>@EventElapsed(item)</td><td>@EventTypeLabel(item)</td><td>@EventDetail(item)</td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private static readonly IReadOnlyList<ChartInspectionSeries> SpeedInclineInspectionSeries =
    [
        new("Speed", "Plan", "km/h", 1, "legend-line--plan"),
        new("Speed", "Target", "km/h", 1, "legend-line--requested"),
        new("Speed", "Measured", "km/h", 1, "legend-line--measured"),
        new("Incline", "Plan", "%", 1, "legend-line--incline-plan"),
        new("Incline", "Target", "%", 1, "legend-line--incline-target"),
        new("Incline", "Measured", "%", 1, "legend-line--incline-measured"),
    ];
    private static readonly IReadOnlyList<ChartInspectionSeries> HeartRateInspectionSeries =
    [
        new("Heart rate", "Measured", "bpm", 0, "legend-line--heart-rate"),
    ];
    [Parameter, EditorRequired]
    public StoredWorkoutSessionView Session { get; set; } = default!;

    [Parameter]
    public string IdPrefix { get; set; } = "session-detail";

    private readonly SessionChartProjectionCache projectionCache = new();
    private SessionChartProjection Projection => projectionCache.Get(Session);

    private string GraphTitleId => $"{IdPrefix}-graph-title";
    private string ChangesTitleId => $"{IdPrefix}-changes-title";
    private string GraphSampleLabel => Session.SamplesAreDownsampled
        ? $"{Session.Samples.Count:N0} graph samples from {Session.PersistedSampleCount:N0} persisted"
        : $"{Session.PersistedSampleCount:N0} sample(s)";
    private string HeartRateLabel => Session.AverageHeartRateBpm is not { } average ? "Not recorded" : Session.MaximumHeartRateBpm is { } maximum ? $"{average:0} avg / {maximum} max bpm" : $"{average:0} bpm";
    private bool HasHeartRateSamples => Session.Samples.Any(static sample => sample.HeartRateBpm is not null);
    private int SpeedAxisMaximum => Projection.SpeedAxisMaximum;
    private int InclineAxisMaximum => Projection.InclineAxisMaximum;
    private IEnumerable<int> SpeedAxisTicks => Enumerable.Range(1, SpeedAxisMaximum).Reverse();
    private IEnumerable<int> InclineAxisTicks => Enumerable.Range(1, InclineAxisMaximum).Reverse();
    private IReadOnlyList<SessionHeartRateZoneSnapshot> HeartRateBoundaryZones => Projection.HeartRateBoundaryZones;
    private int HeartRateAxisMinimum => Projection.HeartRateAxisMinimum;
    private int HeartRateAxisMaximum => Projection.HeartRateAxisMaximum;
    private IEnumerable<int> HeartRateAxisTicks
    {
        get
        {
            int range = HeartRateAxisMaximum - HeartRateAxisMinimum;
            int interval = range <= 60 ? 10 : 20;
            return Enumerable.Range(0, (range / interval) + 1).Select(index => HeartRateAxisMinimum + (index * interval)).Reverse();
        }
    }
    private TimeSpan ChartDuration => Projection.Duration;
    private IReadOnlyList<JsonElement> OrderedEvents => Session.Events.OrderBy(EventTimestamp).ToArray();

    private double ChartX(TimeSpan elapsed) => 10 + (Math.Clamp(elapsed.TotalSeconds / Math.Max(1, ChartDuration.TotalSeconds), 0, 1) * 700);
    private static double ChartY(double value, int axisMaximum) => 210 - (Math.Clamp(value / axisMaximum, 0, 1) * 200);
    private double HeartRateChartY(double value) => 210 - (Math.Clamp((value - HeartRateAxisMinimum) / Math.Max(1, HeartRateAxisMaximum - HeartRateAxisMinimum), 0, 1) * 200);
    private IReadOnlyList<ChartInspectionPoint> GetSpeedInclineInspectionPoints() => Projection.SpeedInclineInspectionPoints;
    private IReadOnlyList<ChartInspectionPoint> GetHeartRateInspectionPoints() => Projection.HeartRateInspectionPoints;
    private static string FormatElapsed(TimeSpan elapsed) => elapsed.TotalHours >= 1 ? elapsed.ToString(@"h\:mm", CultureInfo.InvariantCulture) : elapsed.ToString(@"m\:ss", CultureInfo.InvariantCulture);

    private DateTimeOffset EventTimestamp(JsonElement item) => TryDate(item, "occurredAt") ?? TryDate(item, "occurredAtUtc") ?? DateTimeOffset.MaxValue;
    private static DateTimeOffset? TryDate(JsonElement item, string name) => item.TryGetProperty(name, out JsonElement property) && property.ValueKind == JsonValueKind.String && DateTimeOffset.TryParse(property.GetString(), CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out DateTimeOffset value) ? value : null;

    private string EventElapsed(JsonElement item)
    {
        DateTimeOffset? timestamp = TryDate(item, "occurredAt") ?? TryDate(item, "occurredAtUtc");
        DateTimeOffset? started = Session.StartedAt;
        if (timestamp is null || started is null) return "—";
        TimeSpan elapsed = timestamp.Value - started.Value;
        return elapsed < TimeSpan.Zero ? "Before start" : FormatElapsed(elapsed);
    }

    private static string EventType(JsonElement item) => item.TryGetProperty("eventType", out JsonElement type) ? type.GetString() ?? "event" : "event";
    private static string EventTypeLabel(JsonElement item) => EventType(item) switch
    {
        "physical-movement-detected" => "Movement detected",
        "manual-speed-override" => "Speed override",
        "manual-incline-override" => "Incline override",
        "workout-step-transition" => "Workout step",
        "session-paused" => "Pause",
        "session-resumed" => "Resume",
        "connection-lost" => "Connection lost",
        "connection-restored" => "Connection restored",
        "session-warning" => "Warning",
        "session-completed" => "Completion",
        string value => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('-', ' ')),
    };

    private static string EventDetail(JsonElement item)
    {
        string type = EventType(item);
        if (type == "manual-speed-override" && TryDouble(item, "previousSpeedKph") is { } previousSpeed && TryDouble(item, "requestedSpeedKph") is { } requestedSpeed)
            return $"{previousSpeed:0.0} → {requestedSpeed:0.0} km/h";
        if (type == "manual-incline-override" && TryDouble(item, "previousInclinePercent") is { } previousIncline && TryDouble(item, "requestedInclinePercent") is { } requestedIncline)
            return $"{previousIncline:0.0} → {requestedIncline:0.0}%";
        if (item.TryGetProperty("message", out JsonElement message) && message.ValueKind == JsonValueKind.String) return message.GetString() ?? "Recorded";
        if (type == "workout-step-transition") return "The planned workout advanced to the next segment.";
        if (type == "session-completed") return "The session reached its recorded completed state.";
        return "Recorded by the local session event log.";
    }

    private static double? TryDouble(JsonElement item, string name) => item.TryGetProperty(name, out JsonElement property) && property.TryGetDouble(out double value) ? value : null;
}
