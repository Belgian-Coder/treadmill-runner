{
  "schema_version": 1,
  "workflow_name": "user-story-workflow",
  "evals": [
    {
      "id": "story-workflow-validates",
      "name": "Story wiring validates",
      "assertions": [
        {
          "type": "validation_ok"
        },
        {
          "type": "file_exists",
          "path": "WORKFLOW.md"
        },
        {
          "type": "file_exists",
          "path": "instructions.md"
        },
        {
          "type": "file_exists",
          "path": "scripts/story_quality_profile.py"
        },
        {
          "type": "file_contains",
          "path": "templates/ticket-info.md",
          "text": "## Out Of Scope"
        },
        {
          "type": "file_contains",
          "path": "templates/plan.md",
          "text": "## Out Of Scope"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "## Out Of Scope"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Plan Item Progress"
        },
        {
          "type": "file_contains",
          "path": "templates/plan.md",
          "text": "## Bounded Work Packages"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Plan Variance"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Independent Review Evidence"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Implementation Observations"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Easy Fixes"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "## Validation Evidence Map"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "## Model And Cost Observations"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "Requested semantic profile"
        },
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "Observed provider/model"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "## Follow-Up Fixes"
        },
        {
          "type": "file_contains",
          "path": "templates/plan.md",
          "text": "## Model And Cost Evidence Plan"
        },
        {
          "type": "file_contains",
          "path": "templates/lean-plan.md",
          "text": "## Model And Cost Evidence Plan"
        },
        {
          "type": "repo_command_succeeds",
          "command": [
            "workflow",
            "template",
            "lint",
            "--name",
            "<workflow>",
            "--format",
            "json"
          ]
        },
        {
          "type": "repo_command_succeeds",
          "command": [
            "workflow",
            "plan-check",
            "--name",
            "<workflow>",
            "--template",
            "--format",
            "json"
          ]
        }
      ]
    },
    {
      "id": "story-execution-queue-proof-mapping",
      "name": "Story execution queue and proof mapping stay visible",
      "assertions": [
        {
          "type": "file_contains",
          "path": "templates/execution-log.md",
          "text": "## Reusable Lessons"
        },
        {
          "type": "file_contains",
          "path": "templates/pr-description.md",
          "text": "## Reusable Lessons"
        }
      ]
    },
    {
      "id": "story-contract-declares-evidence",
      "name": "Story contract declares evidence",
      "assertions": [
        {
          "type": "start_contains",
          "text": "module.json"
        },
        {
          "type": "start_contains",
          "text": "## Example Prompts"
        },
        {
          "type": "start_contains",
          "text": "## Read-Only Dogfood"
        },
        {
          "type": "start_contains",
          "text": "module.json.strict_read_only_commands"
        },
        {
          "type": "start_contains",
          "text": "Do not follow lifecycle `next_command` values"
        },
        {
          "type": "start_contains",
          "text": "avoid failure-triage cache writes"
        },
        {
          "type": "start_contains",
          "text": "workflow smoke --name user-story-workflow --dry-run"
        },
        {
          "type": "contract_contains",
          "text": "strict_read_only_commands"
        },
        {
          "type": "contract_contains",
          "text": "workflow_repo_manager.py validate-automations --root . --name user-story-workflow --strict-phase-quality"
        },
        {
          "type": "contract_contains",
          "text": "workflow template resolve --name user-story-workflow --template plan.md --profile lean"
        },
        {
          "type": "instructions_contains",
          "text": "Read-only/no-start dogfood overrides lifecycle writes"
        },
        {
          "type": "start_contains",
          "text": "Always stop after the plan is generated and before implementation"
        },
        {
          "type": "start_contains",
          "text": "Start scaffolds `ticket-info.md` and `plan.md`"
        },
        {
          "type": "start_contains",
          "text": "plan gate next action"
        },
        {
          "type": "start_contains",
          "text": "`implementation-mini`"
        },
        {
          "type": "contract_declares_related_module",
          "module": "azure-devops-ticket-intake"
        },
        {
          "type": "contract_declares_related_module",
          "module": "repo-navigation"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/run.json"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/ticket-info.md"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/plan.md"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/pr-description.md"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/execution-log.md"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/artifacts/project-context-check.json"
        },
        {
          "type": "contract_declares_output",
          "path": "runs/<run-id>/artifacts/context/context-packet.json"
        },
        {
          "type": "contract_declares_command",
          "command": "story_quality_profile.py"
        },
        {
          "type": "contract_declares_command",
          "command": "repo_navigation.py project-context"
        },
        {
          "type": "contract_declares_command",
          "command": "workflow context --name user-story-workflow"
        },
        {
          "type": "contract_declares_command",
          "command": "workflow plan-check --name user-story-workflow"
        },
        {
          "type": "contract_declares_phase",
          "phase": "validation"
        },
        {
          "type": "contract_declares_worker_profile",
          "phase": "implementation",
          "profile": "implementation-mini"
        },
        {
          "type": "contract_local_ai_use_cases",
          "use_cases": [
            "validation-triage",
            "changed-files-summary",
            "failure-cluster",
            "test-gap-summary",
            "handoff-draft"
          ]
        }
      ]
    },
    {
      "id": "story-phases-cover-acceptance",
      "name": "Story phases cover acceptance",
      "assertions": [
        {
          "type": "instructions_contains",
          "text": "acceptance criteria"
        },
        {
          "type": "instructions_contains",
          "text": "## Phase: Validation"
        },
        {
          "type": "instructions_contains",
          "text": "every acceptance criterion has planned code, test, and documentation coverage"
        },
        {
          "type": "instructions_contains",
          "text": "Hard stop after planning"
        },
        {
          "type": "instructions_contains",
          "text": "Continue to implementation only after explicit user approval is recorded"
        },
        {
          "type": "instructions_contains",
          "text": "Project context gate"
        },
        {
          "type": "instructions_contains",
          "text": "Run `rg` or direct file reads for exact seeds"
        },
        {
          "type": "instructions_contains",
          "text": "workflow plan-check --name user-story-workflow"
        },
        {
          "type": "instructions_contains",
          "text": "Use `implementation-mini` first for bounded approved plans"
        },
        {
          "type": "instructions_contains",
          "text": "escalate to `implementation-medium`"
        },
        {
          "type": "instructions_contains",
          "text": "observed provider/model and reasoning effort"
        },
        {
          "type": "instructions_contains",
          "text": "Keep deterministic command exit codes authoritative"
        },
        {
          "type": "instructions_contains",
          "text": "Separate artifact/context token estimates from provider telemetry"
        },
        {
          "type": "instructions_contains",
          "text": "No reusable lesson: <reason>"
        }
      ]
    },
    {
      "id": "story-lifecycle-smoke",
      "name": "Story lifecycle smoke has evidence",
      "assertions": [
        {
          "type": "workflow_lifecycle_smoke_ok"
        }
      ]
    }
  ]
}
